{
  "name": "mirage-ts-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "test": "pnpm -r --filter './packages/*' test",
    "test:leg:core": "pnpm -r --fail-if-no-match --filter @struktoai/mirage-core run test",
    "test:leg:cli": "pnpm -r --fail-if-no-match --filter @struktoai/mirage-cli run test",
    "test:leg:rest": "pnpm -r --fail-if-no-match --filter @struktoai/mirage-node --filter @struktoai/mirage-agents --filter @struktoai/mirage-server --filter @struktoai/mirage-browser --filter @struktoai/mirage-dsh --filter @struktoai/mirage-opencode run test",
    "typecheck": "pnpm -r --filter './packages/*' --filter './scripts' typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "mirage": "node packages/cli/dist/bin/mirage.js"
  },
  "pnpm": {
    "requiredScripts": [
      "test"
    ],
    "overrides": {
      "shell-quote@<1.11.0": ">=1.11.0 <2",
      "esbuild@<0.28.1": ">=0.28.1",
      "protobufjs@>=7.0.0 <7.6.5": ">=7.6.5 <8",
      "protobufjs@>=8.0.0 <8.6.6": ">=8.6.6 <9",
      "@anthropic-ai/sdk@>=0.79.0 <0.91.1": ">=0.91.1",
      "ip-address@>=10.0.0 <=10.5.0": ">=10.5.1 <11",
      "uuid@<11.1.1": ">=11.1.1",
      "fast-xml-parser@<5.7.0": ">=5.7.2",
      "nodemailer@<10.0.2": ">=10.0.2 <11",
      "form-data@<4.0.6": ">=4.0.6",
      "js-yaml@<3.15.2": ">=3.15.2 <4",
      "js-yaml@>=4.0.0 <4.3.2": ">=4.3.2 <5",
      "tar@<7.5.19": ">=7.5.19 <8",
      "vite@>=7.0.0 <7.3.5": ">=7.3.5 <8",
      "@opentelemetry/core@<2.8.0": ">=2.8.0",
      "@opentelemetry/propagator-jaeger@>=2.0.0 <2.9.0": ">=2.9.0 <3",
      "undici@>=7.0.0 <7.29.1": ">=7.29.1 <8",
      "undici@>=6.0.0 <6.28.1": ">=6.28.1 <7",
      "undici@>=8.0.0 <8.10.2": ">=8.10.2 <9",
      "undici8": "npm:undici@8.10.2",
      "fast-uri@>=3.0.0 <3.1.8": ">=3.1.8 <4",
      "fast-uri@>=4.0.0 <4.1.5": ">=4.1.5 <5",
      "linkify-it@>=5.0.0 <5.0.2": ">=5.0.2 <6",
      "hono@>=4.0.0 <4.13.5": ">=4.13.5 <5",
      "@hono/node-server@<2.0.5": ">=2.0.5 <3",
      "body-parser@>=2.0.0 <2.3.0": ">=2.3.0 <3",
      "qs@>=2.2.5 <6.16.0": ">=6.16.0 <7",
      "axios@>=1.0.0 <1.20.0": ">=1.20.0 <2",
      "@grpc/grpc-js@>=1.14.0 <1.14.5": ">=1.14.5 <2",
      "brace-expansion@>=1.0.0 <1.1.21": ">=1.1.21 <2",
      "brace-expansion@>=5.0.0 <5.0.12": ">=5.0.12 <6",
      "nanoid@>=3.0.0 <3.3.18": ">=3.3.18 <4",
      "find-my-way@<=9.6.0": ">=9.7.0 <10",
      "@fastify/busboy@<3.2.1": ">=3.2.1 <4",
      "postcss@<=8.5.17": ">=8.5.18 <9",
      "smol-toml@<1.9.0": ">=1.9.0 <2",
      "source-map-js@>=1.0.0 <1.2.2": ">=1.2.2 <2",
      "deepmerge-ts@<8.0.0": ">=8.0.0 <9",
      "@deepseek-ai/dsh-invariants": "0.2.0-rc.2",
      "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
      "@deepseek-ai/dsh-sandbox": "0.2.0-rc.2",
      "@deepseek-ai/dsh-subprocess": "0.2.0-rc.2",
      "@deepseek-ai/dsh-settings": "0.2.0-rc.2",
      "@deepseek-ai/dsh-attachment": "0.2.0-rc.2",
      "@deepseek-ai/dsh-brand": "0.2.0-rc.2",
      "@deepseek-ai/dsh-fs": "0.2.0-rc.2",
      "@deepseek-ai/dsh-scope": "0.2.0-rc.2",
      "@deepseek-ai/dsh-session": "0.2.0-rc.2",
      "@deepseek-ai/dsh-shell": "0.2.0-rc.2",
      "@deepseek-ai/dsh-spill": "0.2.0-rc.2",
      "@deepseek-ai/dsh-timeout": "0.2.0-rc.2",
      "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2",
      "@deepseek-ai/dsh-http-proxy": "0.2.0-rc.2"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm",
        "GHSA-hp3w-g68c-fv3c"
      ]
    }
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1033.0",
    "@aws-sdk/s3-request-presigner": "^3.1033.0",
    "@changesets/cli": "^2.30.0",
    "@eslint/js": "^9.39.4",
    "@struktoai/mirage-browser": "workspace:*",
    "@struktoai/mirage-core": "workspace:*",
    "@struktoai/mirage-node": "workspace:*",
    "@types/node": "^22.0.0",
    "aws-sdk-client-mock": "^4.1.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "knip": "^6.26.0",
    "oxfmt": "^0.71.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0"
  }
}
