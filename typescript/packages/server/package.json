{
  "name": "@struktoai/mirage-server",
  "version": "0.0.7-alpha.2",
  "description": "A Unified Virtual Filesystem For AI Agents",
  "keywords": [
    "bash",
    "fuse",
    "typescript",
    "workspace",
    "ai-agents",
    "agent-sandbox",
    "langchain",
    "virtual-filesystem",
    "llm-agents",
    "agent-tools",
    "claude-code",
    "openai-agents"
  ],
  "homepage": "https://github.com/strukto-ai/mirage#readme",
  "bugs": {
    "url": "https://github.com/strukto-ai/mirage/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/strukto-ai/mirage.git",
    "directory": "typescript/packages/server"
  },
  "license": "Apache-2.0",
  "author": "Zecheng Zhang <zecheng@strukto.ai>",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=20.10.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./paths": {
      "types": "./dist/paths.d.ts",
      "import": "./dist/paths.js"
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "import": "./dist/env.js"
    },
    "./daemon_config": {
      "types": "./dist/daemon_config.d.ts",
      "import": "./dist/daemon_config.js"
    },
    "./host_validation_constants": {
      "types": "./dist/host_validation_constants.d.ts",
      "import": "./dist/host_validation_constants.js"
    },
    "./workspace_config": {
      "types": "./dist/workspace_config.d.ts",
      "import": "./dist/workspace_config.js"
    },
    "./auth/config": {
      "types": "./dist/auth/config.d.ts",
      "import": "./dist/auth/config.js"
    },
    "./auth/storage": {
      "types": "./dist/auth/storage.d.ts",
      "import": "./dist/auth/storage.js"
    },
    "./ssh/constants": {
      "types": "./dist/ssh/constants.d.ts",
      "import": "./dist/ssh/constants.js"
    },
    "./ssh/config": {
      "types": "./dist/ssh/config.d.ts",
      "import": "./dist/ssh/config.js"
    },
    "./ssh/relay": {
      "types": "./dist/ssh/relay.d.ts",
      "import": "./dist/ssh/relay.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js"
    },
    "./rpc": {
      "types": "./dist/rpc/index.d.ts",
      "import": "./dist/rpc/index.js"
    },
    "./package.json": "./package.json",
    "./bin/daemon": "./dist/bin/daemon.js"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "mirage-daemon": "./dist/bin/daemon.js"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/websocket": "^11.3.3",
    "@modelcontextprotocol/client": "^2.3.0",
    "@modelcontextprotocol/server": "^2.3.0",
    "@struktoai/mirage-core": "workspace:*",
    "@struktoai/mirage-node": "workspace:*",
    "fastify": "^5.12.5",
    "jose": "^6.2.3",
    "rate-limiter-flexible": "^11.2.0",
    "ws": "^8.21.3"
  },
  "peerDependencies": {
    "ssh2": "^1.16.0"
  },
  "peerDependenciesMeta": {
    "ssh2": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ssh2": "^1.15.0",
    "@types/ws": "^8.18.1",
    "ssh2": "^1.16.0",
    "tsup": "^8.5.0",
    "typescript": "^6.0.0",
    "vitest": "^4.1.11"
  }
}
