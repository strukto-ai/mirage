{
  "name": "@struktoai/mirage-dsh",
  "version": "0.0.9-alpha.2",
  "description": "DeepSeek Harness (dsh) providers backed by a mirage workspace: ctx.fs and ctx.shell over mounts",
  "homepage": "https://github.com/strukto-ai/mirage#readme",
  "bugs": {
    "url": "https://github.com/strukto-ai/mirage/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/strukto-ai/mirage.git",
    "directory": "typescript/packages/dsh"
  },
  "license": "Apache-2.0",
  "icon": "icon.svg",
  "author": "Zecheng Zhang <zecheng@strukto.ai>",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": "^22.20 || ^24.12 || >=25"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./service": {
      "types": "./dist/plugin/service.d.ts",
      "import": "./dist/plugin/service.js"
    },
    "./fs": {
      "types": "./dist/plugin/fs.d.ts",
      "import": "./dist/plugin/fs.js"
    },
    "./shell": {
      "types": "./dist/plugin/shell.d.ts",
      "import": "./dist/plugin/shell.js"
    },
    "./spill-store": {
      "types": "./dist/plugin/spill-store.d.ts",
      "import": "./dist/plugin/spill-store.js"
    },
    "./subprocess": {
      "types": "./dist/plugin/subprocess.d.ts",
      "import": "./dist/plugin/subprocess.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "icon.svg",
    "locale"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@struktoai/mirage-core": "workspace:*",
    "@struktoai/mirage-node": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-fs": "0.2.2-rc.3",
    "@deepseek-ai/dsh-fs-patch": "0.2.2-rc.3",
    "@deepseek-ai/dsh-shell": "0.2.2-rc.3",
    "@deepseek-ai/dsh-spill": "0.2.2-rc.3",
    "@deepseek-ai/dsh-subprocess": "0.2.2-rc.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-fs": "0.2.2-rc.3",
    "@deepseek-ai/dsh-fs-patch": "0.2.2-rc.3",
    "@deepseek-ai/dsh-session": "0.2.2-rc.3",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.3",
    "@deepseek-ai/dsh-shell": "0.2.2-rc.3",
    "@deepseek-ai/dsh-spill": "0.2.2-rc.3",
    "@deepseek-ai/dsh-subprocess": "0.2.2-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.3",
    "@deepseek-ai/dsh-working-directory": "0.2.2-rc.3",
    "tsup": "^8.5.0",
    "typescript": "^6.0.0",
    "vitest": "^4.1.12"
  }
}
