{
  "name": "@struktoai/mirage-cloudflare",
  "version": "0.0.9-alpha.2",
  "description": "Mirage on Cloudflare Workers and Durable Objects",
  "keywords": [
    "bash",
    "typescript",
    "workspace",
    "ai-agents",
    "agent-sandbox",
    "virtual-filesystem",
    "cloudflare",
    "cloudflare-workers",
    "durable-objects",
    "edge",
    "serverless"
  ],
  "homepage": "https://github.com/strukto-ai/mirage#readme",
  "bugs": {
    "url": "https://github.com/strukto-ai/mirage/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/strukto-ai/mirage.git",
    "directory": "typescript/packages/cloudflare"
  },
  "license": "Apache-2.0",
  "author": "Zecheng Zhang <zecheng@strukto.ai>",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cpu_features": "./dist/cpu_features.js",
    "./onepassword_core": "./dist/generated/onepassword_core.js",
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "THIRD_PARTY_NOTICES"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && node scripts/bundle-monty.mjs && node scripts/bundle-onepassword.mjs && tsc -p tsconfig.build.json && node scripts/copy-generated.mjs",
    "test": "node scripts/bundle-monty.mjs && node scripts/bundle-onepassword.mjs && vitest run",
    "typecheck": "node scripts/bundle-monty.mjs && node scripts/bundle-onepassword.mjs && tsc --noEmit"
  },
  "dependencies": {
    "@bytecodealliance/preview2-shim": "^0.19.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/api-logs": "^0.222.0",
    "@struktoai/mirage-core": "workspace:*",
    "@struktoai/mirage-server": "workspace:*",
    "@xmldom/xmldom": "^0.9.12",
    "ssh2": "^1.16.0"
  },
  "peerDependencies": {
    "@1password/sdk": "0.5.0"
  },
  "peerDependenciesMeta": {
    "@1password/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@1password/sdk": "0.5.0",
    "@pydantic/monty": "1.6.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.0",
    "vitest": "^4.1.12",
    "wrangler": "4.156.2"
  }
}
