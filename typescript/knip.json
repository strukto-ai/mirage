{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreBinaries": ["diskutil", "fmt", "fusermount", "openssl", "ps"],
  "workspaces": {
    ".": {
      "entry": []
    },
    "scripts": {
      "entry": ["*.ts"]
    },
    "packages/node": {
      "ignoreDependencies": [
        "@napi-rs/lzma",
        "unbzip2-stream",
        "tree-sitter-bash",
        "web-tree-sitter"
      ],
      "entry": ["scripts/*.mjs"]
    },
    "packages/browser": {
      "entry": ["scripts/*.mjs"],
      "ignoreDependencies": ["tree-sitter-bash", "web-tree-sitter"]
    }
  }
}
