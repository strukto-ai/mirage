{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreBinaries": ["diskutil", "fmt", "mkfifo", "openssl", "ps"],
  "workspaces": {
    ".": {
      "entry": []
    },
    "scripts": {
      "entry": ["*.ts"]
    },
    "packages/core": {
      "ignoreDependencies": ["buffer"]
    },
    "packages/node": {
      "entry": ["scripts/*.mjs"]
    },
    "packages/browser": {
      "entry": ["scripts/*.mjs"]
    },
    "packages/cloudflare": {
      "entry": ["scripts/*.mjs"],
      "ignoreDependencies": [
        "@bytecodealliance/preview2-shim",
        "@opentelemetry/api-logs",
        "cloudflare"
      ]
    }
  }
}
