{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreBinaries": ["diskutil", "fmt", "openssl", "ps"],
  "workspaces": {
    ".": {
      "entry": []
    },
    "scripts": {
      "entry": ["*.ts"]
    },
    "packages/node": {
      "entry": ["scripts/*.mjs"]
    },
    "packages/browser": {
      "entry": ["scripts/*.mjs"]
    }
  }
}
