{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Mirage",
  "description": "Mirage gives AI agents one virtual filesystem for S3, Google Drive, Slack, GitHub, Notion, Postgres, and SSH, so shell commands work across services.",
  "colors": {
    "primary": "#0C0C0C",
    "light": "#FAFAFA",
    "dark": "#000000"
