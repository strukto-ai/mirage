{
  "cases": [
    {
      "id": "tree_is_read_into_its_canonical_nodes",
      "op": "tree",
      "where": "commands",
      "value": {
        "rm": {
          "--recursive": "deny",
          "*": "allow"
        }
      },
      "expect": {
        "decision": [],
        "subcommands": {
          "rm": {
            "decision": [
              {
                "decision": "allow",
                "reason": "",
                "paths": []
              }
            ],
            "subcommands": {},
            "options": {
              "--recursive": {
                "decision": [
                  {
                    "decision": "deny",
                    "reason": "",
                    "paths": []
                  }
                ],
                "values": {},
                "options": {}
              }
            },
            "other_options": [],
            "operands": {}
          }
        },
        "options": {},
        "other_options": [],
        "operands": {}
      }
    },
    {
      "id": "null_is_not_a_reason",
      "op": "tree",
      "where": "commands",
      "value": {
        "rm": {
          "decision": "deny",
          "reason": null
        }
      },
      "error": "commands.rm.reason must be a string"
    },
    {
      "id": "an_option_needs_a_command",
      "op": "tree",
      "where": "commands",
      "value": {
        "--force": "deny"
      },
      "error": "commands: the option --force needs a command"
    },
    {
      "id": "flat_lists_are_refused_naming_the_tree",
      "op": "tree",
      "where": "commands",
      "value": {
        "deny": [
          "rm"
        ]
      },
      "error": "commands is in the old flat format"
    },
    {
      "id": "a_flat_path_rule_points_at_hides",
      "op": "tree",
      "where": "commands",
      "value": {
        "deny": [
          {
            "paths": [
              "/x"
            ]
          }
        ]
      },
      "error": "hide those paths with paths.hide"
    },
    {
      "id": "grouped_hides_and_mode_aliases",
      "op": "paths",
      "where": "paths",
      "value": {
        "hide": [
          "/private",
          {
            "patterns": [
              "*.pem"
            ],
            "reason": "keys"
          }
        ],
        "show": {
          "/private/public": "r"
        }
      },
      "expect": {
        "hide": [
          "/private",
          "*.pem"
        ],
        "show": [
          {
            "path": "/private/public",
            "mode": "read"
          }
        ],
        "reasons": [
          {
            "patterns": [
              "*.pem"
            ],
            "reason": "keys"
          }
        ]
      }
    },
    {
      "id": "lone_surrogate_path_round_trip",
      "op": "paths",
      "where": "paths",
      "value": {
        "hide": [
          "/data/\udc80"
        ]
      },
      "expect": {
        "hide": [
          "/data/\udc80"
        ]
      }
    },
    {
      "id": "mount_boundary_is_a_component",
      "op": "under",
      "where": "mount.paths",
      "options": {
        "root": "/data"
      },
      "value": [
        "/database/x"
      ],
      "error": "outside the mount"
    },
    {
      "id": "relative_hide_is_refused",
      "op": "paths",
      "where": "paths",
      "value": {
        "hide": [
          "secret/file"
        ]
      },
      "error": "must be an absolute path"
    },
    {
      "id": "store_plane_defaults",
      "op": "config",
      "where": "store",
      "options": {
        "names": "store"
      },
      "value": {
        "namespace": {},
        "sessions": {
          "type": "s3",
          "bucket": "state",
          "default_content_type": "application/octet-stream"
        }
      },
      "expect": null
    },
    {
      "id": "logs_cannot_use_redis",
      "op": "config",
      "where": "store",
      "options": {
        "names": "store"
      },
      "value": {
        "logs": {
          "type": "redis"
        }
      },
      "error": "history only grows"
    },
    {
      "id": "execution_cannot_use_disk",
      "op": "config",
      "where": "store",
      "options": {
        "names": "store"
      },
      "value": {
        "execution": {
          "type": "disk"
        }
      },
      "error": "cannot be disk"
    },
    {
      "id": "s3_only_hosts_sessions",
      "op": "config",
      "where": "store",
      "options": {
        "names": "store"
      },
      "value": {
        "namespace": {
          "type": "s3"
        }
      },
      "error": "cannot be s3"
    },
    {
      "id": "index_requires_discriminator",
      "op": "config",
      "where": "index",
      "options": {
        "names": "index"
      },
      "value": {
        "ttl": 30
      },
      "error": "needs a `type`"
    },
    {
      "id": "unknown_workspace_keys_are_refused",
      "op": "config",
      "where": "config",
      "value": {
        "mount": {}
      },
      "error": "unknown config key `mount`"
    },
    {
      "id": "cache_keys_are_backend_specific",
      "op": "config",
      "where": "cache",
      "options": {
        "names": "cache"
      },
      "value": {
        "type": "ram",
        "url": "redis://x"
      },
      "error": "unknown cache (ram) key `url`"
    },
    {
      "id": "prototype_spelling_is_still_an_unknown_key",
      "op": "config",
      "where": "config",
      "value": {
        "__proto__": {}
      },
      "error": "unknown config key `__proto__`"
    }
  ]
}
