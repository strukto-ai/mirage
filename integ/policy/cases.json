   "steps": [
    {"op": "session", "id": "agent", "profile": {"mounts": {"/data": "read"}}},
    {"op": "exec", "command": "echo x > /data/f", "expect": {"value": {"exit_code": 0, "stdout": "", "stderr": "", "refusal": null}}},
    {"op": "exec", "session": "agent", "command": "cat /data/f", "expect": {"value": {"exit_code": 0, "stdout": "x\n", "stderr": "", "refusal": null}}},
    {"op": "exec", "session": "agent", "command": "echo y > /data/f", "expect": {"value": {"exit_code": 1, "stdout": "", "stderr": "/data/f: Read-only file system\n", "refusal": null}}},
    {"op": "vfs", "session": "agent", "call": "write", "args": {"path": "/data/f", "data_base64": "eQ=="}, "expect": {"errno": "EROFS"}},
