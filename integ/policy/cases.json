    {"op": "exec", "session": "agent", "command": "rm /scratch/g", "expect": {"value": {"exit_code": 0, "stdout": "", "stderr": "", "refusal": null}}}
   ]
  },
  {
   "id": "every_vfs_call_meets_the_path_rule",
   "settings": {"mode": "write", "mounts": {"/data": {"vfs": "ram", "config": {}}}},
