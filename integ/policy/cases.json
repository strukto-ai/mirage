  {
   "id": "coded_policies_join_the_chain_at_every_hook",
   "settings": {"mode": "write", "mounts": {"/data": {"vfs": "ram", "config": {}}}},
   "steps": [
    {"op": "exec", "command": "echo x > /data/locked", "expect": {"value": {"exit_code": 0, "stdout": "", "stderr": "", "refusal": null}}},
    {"op": "register_policy", "id": "cmd", "commands": ["touch"], "reason": "no touching"},
    {"op": "register_policy", "id": "path", "paths": ["/data/locked"], "reason": "locked file"},
    {"op": "register_policy", "id": "var", "vars": ["MODE"], "reason": "mode is fixed"},
    {"op": "register_policy", "id": "line", "lines": ["blocked"], "reason": "blocked line"},
    {"op": "exec", "command": "touch /data/t", "expect": {"value": {"exit_code": 126, "stdout": "", "stderr": "touch: Permission denied\n", "refusal": "no touching"}}},
    {"op": "exec", "command": "cat /data/locked", "expect": {"value": {"exit_code": 1, "stdout": "", "stderr": "cat: /data/locked: Permission denied\n", "refusal": "locked file"}}},
    {"op": "exec", "command": "export MODE=fast", "expect": {"value": {"exit_code": 1, "stdout": "", "stderr": "MODE: permission denied\n", "refusal": "mode is fixed"}}},
    {"op": "exec", "command": "echo blocked", "expect": {"value": {"exit_code": 126, "stdout": "", "stderr": "echo: Permission denied\n", "refusal": "blocked line"}}},
    {"op": "explain", "command": "touch /data/t", "expect": {"value": {"outcome": "deny", "reason": "no touching", "answers": [], "refusal": "deny", "exit_code": 126, "stderr": "touch: Permission denied\n", "commands": [{"command": "touch", "outcome": "deny", "answers": [{"kind": "deny", "policy": "RulePolicy", "reason": "no touching"}], "runtime": ""}]}}},
    {"op": "explain", "command": "echo blocked", "expect": {"value": {"outcome": "deny", "reason": "blocked line", "answers": [{"kind": "deny", "policy": "RulePolicy", "reason": "blocked line"}], "refusal": "deny", "exit_code": 126, "stderr": "echo: Permission denied\n", "commands": [{"command": "echo", "outcome": "allow", "answers": [], "runtime": ""}]}}},
    {"op": "vfs", "call": "read", "args": {"path": "/data/locked"}, "expect": {"errno": "EACCES", "reason": "locked file"}},
    {"op": "unregister_policy", "id": "cmd", "expect": {"value": true}},
    {"op": "exec", "command": "touch /data/t", "expect": {"value": {"exit_code": 0, "stdout": "", "stderr": "", "refusal": null}}}
   ]
  },
  {
   "id": "placement_routes_the_line_and_a_deny_outranks_it",
   "settings": {"mode": "exec", "mounts": {"/data": {"vfs": "ram", "config": {}}}, "runtimes": ["monty", "workspace"]},
   "steps": [
    {"op": "register_policy", "id": "route", "routes": {"heavy": "monty"}, "reason": ""},
    {"op": "register_policy", "id": "deny", "lines": ["secret"], "reason": "secrets stay put"},
