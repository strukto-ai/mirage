{
 "description": "The policy corpus. Each case builds a workspace, binds sessions to profiles and registers coded policies, then drives lines, VFS calls, tools, asks and explain through the host API, pinning what each refuses, asks or lets through and what explain says it would. Both hosts run it through the lifecycle runner: run.py and run.ts with this file's path.",
 "cases": [
  {
   "id": "the_allow_list_decides_what_is_a_command",
   "settings": {"mode": "write", "mounts": {"/data": {"vfs": "ram", "config": {}}}},
   "steps": [
    {"op": "session", "id": "agent", "profile": {"commands": {"allow": ["echo", "cat", "ls"]}}},
    {"op": "exec", "session": "agent", "command": "echo hi", "expect": {"value": {"exit_code": 0, "stdout": "hi\n", "stderr": "", "refusal": null}}},
    {"op": "exec", "session": "agent", "command": "rm /data/x", "expect": {"value": {"exit_code": 127, "stdout": "", "stderr": "rm: command not found\n", "refusal": null}}},
    {"op": "exec", "session": "agent", "command": "rm /data/x; echo after", "expect": {"value": {"exit_code": 0, "stdout": "after\n", "stderr": "rm: command not found\n", "refusal": null}}},
    {"op": "explain", "session": "agent", "command": "rm /data/x; echo after", "expect": {"value": {"outcome": "allow", "reason": "", "answers": [], "refusal": null, "exit_code": 0, "stderr": "", "commands": [{"command": "rm", "outcome": "deny", "answers": [], "runtime": ""}, {"command": "echo", "outcome": "allow", "answers": [], "runtime": ""}]}}},
    {"op": "tools", "session": "agent", "expect": {"value": ["shell", "read", "write", "edit", "ls", "glob"]}}
   ]
  },
  {
   "id": "a_command_rule_refuses_the_whole_line",
   "settings": {"mode": "write", "mounts": {"/data": {"vfs": "ram", "config": {}}}},
   "steps": [
    {"op": "session", "id": "agent", "profile": {"commands": {"deny": [{"reason": "no deletes", "commands": ["rm"]}]}}},
    {"op": "exec", "command": "echo x > /data/f", "expect": {"value": {"exit_code": 0, "stdout": "", "stderr": "", "refusal": null}}},
    {"op": "exec", "session": "agent", "command": "echo first; rm /data/f", "expect": {"value": {"exit_code": 126, "stdout": "", "stderr": "rm: Permission denied\n", "refusal": "no deletes"}}},
    {"op": "explain", "session": "agent", "command": "echo first; rm /data/f", "expect": {"value": {"outcome": "deny", "reason": "no deletes", "answers": [], "refusal": "deny", "exit_code": 126, "stderr": "rm: Permission denied\n", "commands": [{"command": "echo", "outcome": "allow", "answers": [], "runtime": ""}, {"command": "rm", "outcome": "deny", "answers": [{"kind": "deny", "policy": "PermissionsPolicy", "reason": "no deletes"}], "runtime": ""}]}}},
    {"op": "vfs", "session": "agent", "call": "exists", "args": {"path": "/data/f"}, "expect": {"value": {"exists": true}}}
   ]
  },
  {
   "id": "a_path_rule_answers_in_the_commands_own_voice",
   "settings": {"mode": "write", "mounts": {"/data": {"vfs": "ram", "config": {}}}},
   "steps": [
    {"op": "session", "id": "agent", "profile": {"commands": {"deny": [{"reason": "sealed", "paths": ["/data/sec/*"]}]}}},
    {"op": "exec", "command": "mkdir -p /data/sec; echo k > /data/sec/k; echo o > /data/open", "expect": {"value": {"exit_code": 0, "stdout": "", "stderr": "", "refusal": null}}},
    {"op": "exec", "session": "agent", "command": "cat /data/open /data/sec/k", "expect": {"value": {"exit_code": 1, "stdout": "", "stderr": "cat: /data/sec/k: Permission denied\n", "refusal": "sealed"}}},
    {"op": "explain", "session": "agent", "command": "cat /data/open /data/sec/k", "expect": {"value": {"outcome": "deny", "reason": "sealed", "answers": [], "refusal": "deny", "exit_code": 1, "stderr": "cat: /data/sec/k: Permission denied\n", "commands": [{"command": "cat", "outcome": "deny", "answers": [{"kind": "deny", "policy": "PermissionsPolicy", "reason": "sealed"}], "runtime": ""}]}}},
    {"op": "exec", "session": "agent", "command": "grep -r k /data", "expect": {"value": {"exit_code": 2, "stdout": "", "stderr": "grep: /data/sec/k: Permission denied\n", "refusal": "sealed"}}},
    {"op": "vfs", "session": "agent", "call": "read", "args": {"path": "/data/sec/k"}, "expect": {"errno": "EACCES", "reason": "sealed"}},
    {"op": "vfs", "session": "agent", "call": "read", "args": {"path": "/data/sec/k"}, "explain": true, "expect": {"value": {"call": "read", "outcome": "deny", "reason": "sealed", "answers": [{"kind": "deny", "policy": "PermissionsPolicy", "reason": "sealed"}], "refusal": "deny", "error": "EACCES"}}},
    {"op": "tool", "session": "agent", "tool": "read", "arguments": {"path": "/data/sec/k"}, "expect": {"value": {"text_contains": "policy denied: sealed\n", "is_error": true}}}
   ]
  },
  {
   "id": "the_deeper_anchor_wins_whatever_its_verb",
   "settings": {"mode": "write", "mounts": {"/data": {"vfs": "ram", "config": {}}}},
   "steps": [
    {"op": "session", "id": "agent", "profile": {"commands": {"deny": [{"reason": "no deletes in data", "commands": {"rm": ["/data/*"]}}], "ask": [{"reason": "keep needs a nod", "commands": {"rm": ["/data/keep/*"]}}]}}},
    {"op": "exec", "command": "mkdir -p /data/keep; echo a > /data/keep/a; echo b > /data/b", "expect": {"value": {"exit_code": 0, "stdout": "", "stderr": "", "refusal": null}}},
    {"op": "exec", "session": "agent", "command": "rm /data/b", "expect": {"value": {"exit_code": 1, "stdout": "", "stderr": "rm: cannot remove '/data/b': Permission denied\n", "refusal": "no deletes in data"}}},
    {"op": "exec", "session": "agent", "command": "rm /data/keep/a", "expect": {"value": {"exit_code": 126, "stdout": "", "stderr": "rm: Permission denied\n", "refusal": "keep needs a nod"}}},
    {"op": "explain", "session": "agent", "command": "rm /data/keep/a", "expect": {"value": {"outcome": "ask", "reason": "keep needs a nod", "answers": [], "refusal": "pending", "exit_code": 126, "stderr": "rm: Permission denied\n", "commands": [{"command": "rm", "outcome": "ask", "answers": [{"kind": "ask", "policy": "PermissionsPolicy", "reason": "keep needs a nod"}], "runtime": ""}]}}}
   ]
  },
  {
   "id": "an_ask_waits_for_the_host_and_each_answer_holds_as_scoped",
   "settings": {"mode": "write", "mounts": {"/data": {"vfs": "ram", "config": {}}}},
   "steps": [
    {"op": "session", "id": "agent", "profile": {"commands": {"ask": [{"reason": "removal needs sign-off", "commands": ["rm"]}]}}},
    {"op": "exec", "command": "touch /data/a /data/b /data/c /data/d", "expect": {"value": {"exit_code": 0, "stdout": "", "stderr": "", "refusal": null}}},
    {"op": "exec", "session": "agent", "command": "rm /data/a", "expect": {"value": {"exit_code": 126, "stdout": "", "stderr": "rm: Permission denied\n", "refusal": "removal needs sign-off"}}},
    {"op": "asks", "expect": {"value": [{"command": "rm", "paths": ["/data/a"], "reason": "removal needs sign-off"}]}},
    {"op": "answer", "outcome": "allow", "scope": "once"},
    {"op": "exec", "session": "agent", "command": "rm /data/a", "expect": {"value": {"exit_code": 0, "stdout": "", "stderr": "", "refusal": null}}},
    {"op": "exec", "session": "agent", "command": "rm /data/b", "expect": {"value": {"exit_code": 126, "stdout": "", "stderr": "rm: Permission denied\n", "refusal": "removal needs sign-off"}}},
    {"op": "answer", "outcome": "allow", "scope": "session"},
    {"op": "exec", "session": "agent", "command": "rm /data/b", "expect": {"value": {"exit_code": 0, "stdout": "", "stderr": "", "refusal": null}}},
    {"op": "exec", "session": "agent", "command": "rm /data/c", "expect": {"value": {"exit_code": 0, "stdout": "", "stderr": "", "refusal": null}}},
    {"op": "asks", "expect": {"value": []}}
   ]
  },
  {
   "id": "a_denied_ask_refuses_the_retry_and_asks_again",
   "settings": {"mode": "write", "mounts": {"/data": {"vfs": "ram", "config": {}}}},
   "steps": [
    {"op": "session", "id": "agent", "profile": {"commands": {"ask": [{"reason": "removal needs sign-off", "commands": ["rm"]}]}}},
    {"op": "exec", "command": "touch /data/a", "expect": {"value": {"exit_code": 0, "stdout": "", "stderr": "", "refusal": null}}},
    {"op": "exec", "session": "agent", "command": "rm /data/a", "expect": {"value": {"exit_code": 126, "stdout": "", "stderr": "rm: Permission denied\n", "refusal": "removal needs sign-off"}}},
    {"op": "answer", "outcome": "deny", "scope": "once"},
    {"op": "exec", "session": "agent", "command": "rm /data/a", "expect": {"value": {"exit_code": 126, "stdout": "", "stderr": "rm: Permission denied\n", "refusal": "removal needs sign-off"}}},
    {"op": "exec", "session": "agent", "command": "rm /data/a", "expect": {"value": {"exit_code": 126, "stdout": "", "stderr": "rm: Permission denied\n", "refusal": "removal needs sign-off"}}},
    {"op": "asks", "expect": {"value": [{"command": "rm", "paths": ["/data/a"], "reason": "removal needs sign-off"}]}}
   ]
  },
  {
   "id": "hide_and_show",
   "settings": {"mode": "write", "mounts": {"/data": {"vfs": "ram", "config": {}}}},
   "steps": [
    {"op": "session", "id": "agent", "profile": {"paths": {"hide": ["/data/private", {"patterns": ["*.env"], "reason": "dotenv"}], "show": {"/data/private/pub": "read"}}, "vars": {"hide": ["SECRET*"]}, "env": {"SECRET_TOKEN": "t0ken", "OPEN": "yes"}}},
    {"op": "exec", "command": "mkdir -p /data/private/pub; echo s > /data/private/s; echo p > /data/private/pub/p; echo k > /data/app.env; echo o > /data/open", "expect": {"value": {"exit_code": 0, "stdout": "", "stderr": "", "refusal": null}}},
    {"op": "exec", "session": "agent", "command": "ls /data", "expect": {"value": {"exit_code": 0, "stdout": "open\nprivate\n", "stderr": "", "refusal": null}}},
    {"op": "exec", "session": "agent", "command": "cat /data/private/s", "expect": {"value": {"exit_code": 1, "stdout": "", "stderr": "cat: /data/private/s: No such file or directory\n", "refusal": null}}},
    {"op": "exec", "session": "agent", "command": "cat /data/private/pub/p", "expect": {"value": {"exit_code": 0, "stdout": "p\n", "stderr": "", "refusal": null}}},
    {"op": "exec", "session": "agent", "command": "cat /data/app.env", "expect": {"value": {"exit_code": 1, "stdout": "", "stderr": "cat: /data/app.env: No such file or directory\n", "refusal": null}}},
    {"op": "vfs", "session": "agent", "call": "read", "args": {"path": "/data/private/s"}, "expect": {"errno": "ENOENT"}},
    {"op": "vfs", "session": "agent", "call": "read", "args": {"path": "/data/private/s"}, "explain": true, "expect": {"value": {"call": "read", "outcome": "allow", "reason": "", "answers": [], "refusal": null, "error": ""}}},
    {"op": "vfs", "session": "agent", "call": "readdir", "args": {"path": "/data"}, "expect": {"value": {"entries": ["/data/open", "/data/private"]}}},
    {"op": "vfs", "session": "agent", "call": "write", "args": {"path": "/data/private/pub/q", "data_base64": "eA=="}, "expect": {"errno": "EROFS"}},
    {"op": "vfs", "session": "agent", "call": "write", "args": {"path": "/data/private/new", "data_base64": "eA=="}, "expect": {"errno": "EACCES"}},
    {"op": "exec", "session": "agent", "command": "echo ${SECRET_TOKEN:-unset} $OPEN", "expect": {"value": {"exit_code": 0, "stdout": "unset yes\n", "stderr": "", "refusal": null}}},
    {"op": "exec", "session": "agent", "command": "SECRET_KEY=1", "expect": {"value": {"exit_code": 1, "stdout": "", "stderr": "SECRET_KEY: permission denied\n", "refusal": null}}}
   ]
  },
  {
   "id": "mount_modes_narrow_what_a_session_may_write",
