    {"op": "vfs", "session": "agent", "call": "unlink", "args": {"path": "/data/sec/k"}, "expect": {"errno": "EACCES", "reason": "sealed"}},
    {"op": "vfs", "session": "agent", "call": "create", "args": {"path": "/data/sec/new"}, "expect": {"errno": "EACCES", "reason": "sealed"}},
    {"op": "vfs", "session": "agent", "call": "mkdir", "args": {"path": "/data/sec/d"}, "expect": {"errno": "EACCES", "reason": "sealed"}},
    {"op": "vfs", "session": "agent", "call": "rename", "args": {"src": "/data/o", "dst": "/data/sec/o"}, "expect": {"errno": "EACCES", "reason": "sealed"}},
    {"op": "vfs", "session": "agent", "call": "rename", "args": {"src": "/data/sec/k", "dst": "/data/k"}, "expect": {"errno": "EACCES", "reason": "sealed"}},
    {"op": "vfs", "session": "agent", "call": "symlink", "args": {"path": "/data/sec/l", "target": "/data/o"}, "expect": {"errno": "EACCES", "reason": "sealed"}},
    {"op": "vfs", "session": "agent", "call": "setxattr", "args": {"path": "/data/sec/k", "name": "user.a", "value_base64": "eA=="}, "expect": {"errno": "EACCES", "reason": "sealed"}},
    {"op": "vfs", "session": "agent", "call": "getxattr", "args": {"path": "/data/sec/k", "name": "user.a"}, "expect": {"errno": "EACCES", "reason": "sealed"}},
    {"op": "vfs", "session": "agent", "call": "setattr", "args": {"path": "/data/sec/k", "mode": 420}, "expect": {"errno": "EACCES", "reason": "sealed"}},
    {"op": "vfs", "session": "agent", "call": "readdir", "args": {"path": "/data/sec/e"}, "expect": {"errno": "EACCES", "reason": "sealed"}},
    {"op": "vfs", "session": "agent", "call": "list_files", "args": {"path": "/data/sec/e"}, "expect": {"errno": "EACCES", "reason": "sealed"}},
    {"op": "vfs", "session": "agent", "call": "rmdir", "args": {"path": "/data/sec/e"}, "expect": {"errno": "EACCES", "reason": "sealed"}},
    {"op": "vfs", "session": "agent", "call": "readlink", "args": {"path": "/data/sec/m"}, "expect": {"errno": "EACCES", "reason": "sealed"}},
    {"op": "vfs", "session": "agent", "call": "listxattr", "args": {"path": "/data/sec/k"}, "expect": {"errno": "EACCES", "reason": "sealed"}},
    {"op": "vfs", "session": "agent", "call": "removexattr", "args": {"path": "/data/sec/k", "name": "user.a"}, "expect": {"errno": "EACCES", "reason": "sealed"}},
    {"op": "vfs", "session": "agent", "call": "stat", "args": {"path": "/data/sec/k"}, "expect": {"value": {"stat": {"type": "file", "size": 2}}}},
    {"op": "vfs", "session": "agent", "call": "exists", "args": {"path": "/data/sec/k"}, "expect": {"value": {"exists": true}}},
    {"op": "vfs", "session": "agent", "call": "is_dir", "args": {"path": "/data/sec/e"}, "expect": {"value": {"is_dir": true}}},
