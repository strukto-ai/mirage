// Shared store for the fake-service integ servers. Prisma allows exactly one
// datasource per schema, so every fake that wants a database lives here and
// each server pushes this schema into its own SQLite file (INTEG_DB_URL) and
// touches only its own tables. Flat scalar FKs (no @relation) — the fakes
// query each table explicitly.
//
// Slack (integ/server/slack.ts, fixtures/slack/v1.json): Channel, User,
// Message, SlackFile, Pin.
// Notion (integ/server/notion_server.ts, fixtures/notion/v1.json): the
// Notion* models, every one scoped by workspaceId so parallel scenarios can
// share one server without clobbering each other.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("INTEG_DB_URL")
}

model Channel {
  id         String  @id
  name       String
  kind       String
  created    Int
  isArchived Boolean @default(false)
  isPrivate  Boolean @default(false)
  dmUserId   String?
}

model User {
  id       String  @id
  name     String
  realName String
  email    String
  isBot    Boolean @default(false)
  deleted  Boolean @default(false)
}

model Message {
  pk            Int     @id @default(autoincrement())
  channelId     String
  ts            String
  userId        String
  text          String
  type          String  @default("message")
  threadTs      String?
  reactionsJson String?
}

model SlackFile {
  id          String  @id
  channelId   String
  messageTs   String
  name        String
  title       String
  mimetype    String
  filetype    String
  size        Int
  timestamp   Int
  content     String
  contentPath String?
}

model Pin {
  channelId String
  ts        String
  createdBy String @default("UBOT")
  created   Int    @default(0)

  @@id([channelId, ts])
}

// A Notion child page is one object seen two ways: it is a NotionPage row and
// a NotionBlock row of type child_page carrying the *same* id. Creating a page
// under a page_id parent must write both, or readdir and block-children
// disagree about the tree.
model NotionPage {
  id             String
  workspaceId    String
  parentType     String
  parentId       String?
  titleText      String
  propertiesJson String
  iconJson       String?
  coverJson      String?
  archived       Boolean @default(false)
  inTrash        Boolean @default(false)
  createdTime    String
  lastEditedTime String
  createdBy      String
  lastEditedBy   String
  url            String
  position       Int     @default(0)

  @@id([workspaceId, id])
  @@index([workspaceId, parentId])
}

model NotionDatabase {
  id              String
  workspaceId     String
  parentType      String
  parentId        String?
  titleText       String
  titleJson       String
  descriptionJson String?
  propertiesJson  String
  isInline        Boolean @default(false)
  archived        Boolean @default(false)
  inTrash         Boolean @default(false)
  createdTime     String
  lastEditedTime  String
  createdBy       String
  lastEditedBy    String
  url             String
  position        Int     @default(0)

  @@id([workspaceId, id])
  @@index([workspaceId, parentId])
}

model NotionBlock {
  id             String
  workspaceId    String
  parentId       String
  position       Int
  type           String
  payloadJson    String
  hasChildren    Boolean @default(false)
  archived       Boolean @default(false)
  inTrash        Boolean @default(false)
  createdTime    String
  lastEditedTime String
  createdBy      String
  lastEditedBy   String

  @@id([workspaceId, id])
  @@index([workspaceId, parentId, position])
}

model NotionComment {
  id             String
  workspaceId    String
  parentType     String
  parentId       String
  discussionId   String
  richTextJson   String
  createdTime    String
  lastEditedTime String
  createdBy      String
  position       Int    @default(0)

  @@id([workspaceId, id])
  @@index([workspaceId, parentId])
}
