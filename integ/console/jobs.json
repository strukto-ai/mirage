      "seq": 509000,
      "targets": [
        "ram",
        "console-redis"
      ],
      "command": "(echo out; echo err 1>&2) & wait",
      "expect": {
        "exit": 0,
        "stdout": "out\n",
        "stderr": "err\n"
      }
    },
