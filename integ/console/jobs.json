      "seq": 509022,
      "targets": [
        "ram",
        "opfs",
        "console-redis"
      ],
      "command": "[ $$ -gt 4194304 ] && echo mirage; kill 412; echo kill=$?; kill -0 412; echo probe=$?; wait 412; echo wait=$?; ps -p 412 -o pid=; echo ps=$?",
      "expect": {
        "exit": 0,
        "stdout": "mirage\nkill=1\nprobe=1\nwait=127\nps=1\n",
        "stderr": "bash: line 1: kill: (412) - No such process\nbash: line 1: kill: (412) - No such process\nbash: line 1: wait: pid 412 is not a child of this shell\n"
