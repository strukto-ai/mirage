      "id": "console_bg_wait_adopts_output",
      "seq": 509000,
      "targets": [
        "ram",
        "opfs",
        "console-redis"
      ],
      "command": "(echo out; echo err 1>&2) & wait",
      "expect": {
        "exit": 0,
        "stdout": "out\n",
        "stderr": "err\n"
      }
    },
    {
      "id": "console_bg_wait_exit_code",
      "seq": 509002,
      "targets": [
        "ram",
        "opfs",
        "console-redis"
      ],
      "command": "(sh -c 'exit 4' & wait $!; echo rc=$?) 2>/dev/null",
      "expect": {
        "exit": 0,
        "stdout": "rc=4\n",
        "stderr": ""
      }
    },
