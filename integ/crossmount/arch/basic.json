      "command": "mkdir -p /data/xmza /data2/xmzb && printf 'a\\n' > /data/xmza/a.txt && printf 'b\\n' > /data2/xmzb/b.txt && zip -qr /data2/xmzab.zip /data/xmza /data2/xmzb && unzip -Z1 /data2/xmzab.zip",
      "expect": {
