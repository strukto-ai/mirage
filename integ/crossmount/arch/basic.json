        "dropbox",
        "dropbox-root",
        "onedrive",
        "sharepoint",
        "ssh",
        "nextcloud",
        "gdrive",
        "gdrive-folder",
        "box"
      ],
      "command": "mkdir -p /data/xmz/sub && printf 'a\\n' > /data/xmz/a.txt && printf 'b\\n' > /data/xmz/sub/b.txt && (cd /data/xmz && zip -r /data2/xmz.zip .) && unzip -Z1 /data2/xmz.zip",
      "expect": {
