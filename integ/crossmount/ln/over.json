    {
      "id": "xm_ln_meets_the_name_s_directory_first",
      "seq": 15601016,
      "targets": [
        "ram",
        "disk",
        "redis",
        "opfs",
        "s3",
        "databricks",
        "gridfs",
        "s3-prefix",
        "databricks-prefix",
        "gridfs-prefix",
        "hf",
        "hf-prefix",
        "dropbox",
        "dropbox-root",
        "onedrive",
        "sharepoint",
        "sharepoint-prefix",
        "ssh",
        "nextcloud",
        "tidb-filesystem",
        "gdrive",
        "gdrive-folder",
        "box"
      ],
      "command": "echo x > /data2/xm_lnf && ln /data/a.txt /data2/xm_nodir/x; echo rc=$?; ln /data/a.txt /data2/xm_lnf/x; echo rc=$?; rm /data2/xm_lnf",
      "expect": {
        "exit": 0,
        "stdout": "rc=1\nrc=1\n",
        "stderr": "ln: failed to create hard link '/data2/xm_nodir/x' => '/data/a.txt': No such file or directory\nln: failed to create hard link '/data2/xm_lnf/x' => '/data/a.txt': Not a directory\n"
      },
      "note": "coreutils 9.7 over tmpfs mounts: link(2) resolves the new name's directory before it weighs the other filesystem. Both were `Invalid cross-device link`."
    }
  ]
