      ],
      "command": "printf '6162' > /data2/xm_xxd_missing.hex; xxd -r -p /data2/xm_xxd_missing.hex /data/xm_xxd_missing; echo reverse=$?; test -e /data/xm_xxd_missing; echo exists=$?; cat /data/xm_xxd_missing; echo; cat /data2/xm_xxd_missing.hex; echo; rm -f /data2/xm_xxd_missing.hex /data/xm_xxd_missing",
      "expect": {
        "exit": 0,
        "stdout": "reverse=0\nexists=0\nab\n6162\n",
