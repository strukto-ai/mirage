      "command": "printf 'a\\n' > /data2/xm_rt_so; (cd /data && shuf -o ./xm_rt_so -o xm_rt_so /data2/xm_rt_so; echo rc=$?); test -e /data/xm_rt_so || echo none; rm /data2/xm_rt_so",
