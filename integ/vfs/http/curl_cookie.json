{
  "cases": [
    {
      "id": "curl_cookie_jar_writes_the_login",
      "seq": 330400,
      "targets": [
        "http-ram"
      ],
      "command": "curl -s -c /data/jar_login '{http}/jar/login?c=session%3Ds3cr3t%3B%20Path%3D%2F%3B%20HttpOnly&c=theme%3Ddark%3B%20Path%3D%2F'; cat /data/jar_login",
      "expect": {
        "exit": 0,
        "stdout": "cookie=-\n# Netscape HTTP Cookie File\n# https://curl.se/docs/http-cookies.html\n# This file was generated by libcurl! Edit at your own risk.\n\n127.0.0.1\tFALSE\t/\tFALSE\t0\ttheme\tdark\n#HttpOnly_127.0.0.1\tFALSE\t/\tFALSE\t0\tsession\ts3cr3t\n",
        "stderr": ""
      }
    },
    {
      "id": "curl_cookie_b_sends_the_jar_back",
      "seq": 330401,
      "targets": [
        "http-ram"
      ],
      "command": "curl -s -b /data/jar_login '{http}/jar/private?need=session%3Ds3cr3t'",
      "expect": {
        "exit": 0,
        "stdout": "cookie=session=s3cr3t; theme=dark\n",
        "stderr": ""
      }
    },
    {
      "id": "curl_cookie_without_the_jar_is_refused",
      "seq": 330402,
      "targets": [
        "http-ram"
      ],
      "command": "curl -s '{http}/jar/private?need=session%3Ds3cr3t'",
      "expect": {
        "exit": 0,
        "stdout": "unauthorized\n",
        "stderr": ""
      }
    },
    {
      "id": "curl_cookie_login_post_then_reuse",
      "seq": 330403,
      "targets": [
        "http-ram"
      ],
      "command": "curl -s -c /data/jar_post -X POST -d '{\"username\":\"admin\"}' '{http}/jar/api/auth/login?c=session%3Dxyz%3B%20Path%3D%2F' && curl -s -b /data/jar_post '{http}/jar/api/accounts?need=session%3Dxyz'",
      "expect": {
        "exit": 0,
        "stdout": "cookie=-\ncookie=session=xyz\n",
        "stderr": ""
      }
    },
    {
      "id": "curl_cookie_literal_data_as_given",
      "seq": 330404,
      "targets": [
        "http-ram"
      ],
      "command": "curl -s -b 'a=1' -b 'b=2' {http}/jar/x; curl -s -b 'a=1; b=2' {http}/jar/x",
      "expect": {
        "exit": 0,
        "stdout": "cookie=a=1;b=2\ncookie=a=1; b=2\n",
        "stderr": ""
      }
    },
    {
      "id": "curl_cookie_literal_data_after_the_jar",
      "seq": 330405,
      "targets": [
        "http-ram"
      ],
      "command": "curl -s -b 'x=1' -b /data/jar_login {http}/jar/x",
      "expect": {
        "exit": 0,
        "stdout": "cookie=session=s3cr3t; theme=dark; x=1\n",
        "stderr": ""
      }
    },
    {
      "id": "curl_cookie_missing_file_is_no_file",
      "seq": 330406,
      "targets": [
        "http-ram"
      ],
      "command": "curl -s -b /data/no_such_jar {http}/jar/x; echo rc=$?",
      "expect": {
        "exit": 0,
        "stdout": "cookie=-\nrc=0\n",
        "stderr": ""
      }
    },
    {
      "id": "curl_cookie_empty_jar_keeps_the_header",
      "seq": 330407,
      "targets": [
        "http-ram"
      ],
      "command": "curl -s -c /data/jar_empty {http}/jar/x >/dev/null; cat /data/jar_empty",
      "expect": {
        "exit": 0,
