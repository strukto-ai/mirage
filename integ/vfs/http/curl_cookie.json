        "stderr": ""
      }
    },
    {
      "id": "curl_cookie_jar_to_stdout_comes_last",
      "seq": 330408,
      "targets": [
        "http-ram"
      ],
      "command": "curl -s -c - -w 'code=%{http_code}\\n' '{http}/jar/x?c=z%3D1'",
      "expect": {
        "exit": 0,
        "stdout": "cookie=-\ncode=200\n# Netscape HTTP Cookie File\n# https://curl.se/docs/http-cookies.html\n# This file was generated by libcurl! Edit at your own risk.\n\n127.0.0.1\tFALSE\t/jar/\tFALSE\t0\tz\t1\n",
        "stderr": ""
      }
    },
    {
      "id": "curl_cookie_round_trip_merges",
      "seq": 330409,
      "targets": [
        "http-ram"
      ],
      "command": "cp /data/jar_login /data/jar_merge && curl -s -b /data/jar_merge -c /data/jar_merge '{http}/jar/x?c=n%3D1'; cat /data/jar_merge",
      "expect": {
        "exit": 0,
        "stdout": "cookie=session=s3cr3t; theme=dark\n# Netscape HTTP Cookie File\n# https://curl.se/docs/http-cookies.html\n# This file was generated by libcurl! Edit at your own risk.\n\n127.0.0.1\tFALSE\t/jar/\tFALSE\t0\tn\t1\n#HttpOnly_127.0.0.1\tFALSE\t/\tFALSE\t0\tsession\ts3cr3t\n127.0.0.1\tFALSE\t/\tFALSE\t0\ttheme\tdark\n",
        "stderr": ""
      }
    },
    {
      "id": "curl_cookie_default_path_matches_below",
      "seq": 330410,
      "targets": [
        "http-ram"
      ],
      "command": "curl -s -c /data/jar_path '{http}/jar/a/b?c=p%3D1' >/dev/null; tail -n 1 /data/jar_path | cut -f3; curl -s -b /data/jar_path {http}/jar/a; curl -s -b /data/jar_path {http}/jar/ab",
      "expect": {
        "exit": 0,
        "stdout": "/jar/a/\ncookie=p=1\ncookie=-\n",
        "stderr": ""
      }
    },
    {
      "id": "curl_cookie_order_paths_names_then_newest",
      "seq": 330411,
      "targets": [
        "http-ram"
      ],
      "command": "curl -sL -b '' '{http}/jar/hop?c=b%3D1%3B%20Path%3D%2F&c=a%3D1%3B%20Path%3D%2F&c=long%3D1%3B%20Path%3D%2F&c=p%3D1%3B%20Path%3D%2Fjar&to=/jar/next'",
      "expect": {
        "exit": 0,
        "stdout": "cookie=p=1; long=1; a=1; b=1\n",
        "stderr": ""
      }
    },
    {
      "id": "curl_cookie_redirect_hop_carries_and_saves",
      "seq": 330412,
      "targets": [
        "http-ram"
      ],
      "command": "curl -sL -c /data/jar_hop '{http}/jar/hop?c=h%3D1%3B%20Path%3D%2F&to=/jar/next'; tail -n 1 /data/jar_hop",
      "expect": {
