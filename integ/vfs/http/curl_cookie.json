        "stderr": ""
      }
    },
    {
      "id": "curl_cookie_redirect_without_the_engine_carries_none",
      "seq": 330413,
      "targets": [
        "http-ram"
      ],
      "command": "curl -sL '{http}/jar/hop?c=h%3D1%3B%20Path%3D%2F&to=/jar/next'",
      "expect": {
        "exit": 0,
        "stdout": "cookie=-\n",
        "stderr": ""
      }
    },
    {
      "id": "curl_cookie_typed_header_rides_a_redirect",
      "seq": 330414,
      "targets": [
        "http-ram"
      ],
      "command": "curl -sL -H 'Cookie: x=1' '{http}/jar/hop?to=/jar/next'",
