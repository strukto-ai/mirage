      ],
      "command": "cp /data/jar_login /data/jar_del && curl -s -b /data/jar_del -c /data/jar_del '{http}/jar/x?c=theme%3D%3B%20Max-Age%3D0%3B%20Path%3D%2F'; tail -n 1 /data/jar_del | cut -f6",
      "expect": {
