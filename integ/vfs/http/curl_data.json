{
  "cases": [
    {
      "id": "curl_data_at_file_strips_line_ends",
      "seq": 330100,
      "targets": [
        "http-ram"
      ],
      "command": "printf '{\"q\":1}\\r\\n' > /data/payload.json && curl -s -d @/data/payload.json {http}/request",
      "expect": {
        "exit": 0,
        "stdout": "method=POST\naccept=*/*\nauthorization=-\ncontent-type=application/x-www-form-urlencoded\nbody={\"q\":1}\n",
        "stderr": ""
      }
    },
    {
      "id": "curl_data_repeated_joins_with_amp",
      "seq": 330101,
      "targets": [
        "http-ram"
      ],
      "command": "curl -s -d a=1 -d b=2 {http}/request",
      "expect": {
        "exit": 0,
        "stdout": "method=POST\naccept=*/*\nauthorization=-\ncontent-type=application/x-www-form-urlencoded\nbody=a=1&b=2\n",
        "stderr": ""
      }
    },
    {
      "id": "curl_data_empty_piece_adds_no_separator",
      "seq": 330102,
      "targets": [
        "http-ram"
      ],
      "command": "curl -s -d '' -d b {http}/request | tail -n 1; curl -s -d a -d '' -d c {http}/request | tail -n 1",
      "expect": {
        "exit": 0,
        "stdout": "body=b\nbody=a&&c\n",
        "stderr": ""
      }
    },
    {
      "id": "curl_data_at_stdin",
