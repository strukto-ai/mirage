        "stderr": ""
      }
    },
    {
      "id": "curl_data_options_join_in_line_order",
      "seq": 330106,
      "targets": [
        "http-ram"
      ],
      "command": "curl -s -d a=1 --data-binary b=2 --data-raw @c {http}/request | tail -n 1",
      "expect": {
        "exit": 0,
        "stdout": "body=a=1&b=2&@c\n",
        "stderr": ""
      }
    },
    {
      "id": "curl_data_urlencode_forms",
      "seq": 330107,
      "targets": [
        "http-ram"
      ],
      "command": "curl -s --data-urlencode 'q=a b&c' --data-urlencode '=x=y' --data-urlencode 'plain text' --data-urlencode 'a b=c' {http}/request | tail -n 1",
      "expect": {
        "exit": 0,
        "stdout": "body=q=a+b%26c&x%3Dy&plain+text&a b=c\n",
        "stderr": ""
      }
    },
    {
      "id": "curl_data_urlencode_file",
      "seq": 330108,
      "targets": [
        "http-ram"
      ],
      "command": "printf 'a b\\n' > /data/u.txt && curl -s --data-urlencode n@/data/u.txt {http}/request | tail -n 1",
      "expect": {
        "exit": 0,
        "stdout": "body=n=a+b%0A\n",
        "stderr": ""
      }
    },
    {
