      "targets": [
        "http-ram"
      ],
      "command": "printf 'a\\r\\nb\\n' > /data/bin.txt && curl -s --data-binary @/data/bin.txt {http}/request | tail -n 3",
      "expect": {
        "exit": 0,
        "stdout": "body=a\r\nb\n\n",
        "stderr": ""
      }
    },
    {
