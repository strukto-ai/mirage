    {
      "id": "search_word_drops_a_hidden_hit_unread",
      "seq": 540254,
      "targets": [
        "box",
        "dropbox"
      ],
      "session": "veiled",
      "note": "beta.txt is hidden and holds the word: the mount's search still names it, the session drops it, and only alpha.txt is read; a walk without the search would read gamma.txt too.",
      "command": "grep -rlw wombat /search",
      "clear_cache": true,
      "expect": {
        "exit": 0,
        "stdout": "/search/alpha.txt\n",
        "stderr": "",
        "check": "[\"/search/alpha.txt\"]\n"
      },
      "check": {
        "read_paths": true
      }
    },
    {
      "id": "search_word_rg_drops_a_hidden_hit_unread",
      "seq": 540255,
      "targets": [
        "box",
        "dropbox"
      ],
      "session": "veiled",
      "command": "rg -lw wombat /search",
      "clear_cache": true,
      "expect": {
        "exit": 0,
        "stdout": "/search/alpha.txt\n",
        "stderr": "",
        "check": "[\"/search/alpha.txt\"]\n"
