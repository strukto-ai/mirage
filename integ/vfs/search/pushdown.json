    },
    {
      "id": "search_word_reports_a_denied_file_it_rules_out",
      "seq": 540256,
      "targets": [
        "box",
        "dropbox"
      ],
      "session": "walled",
      "note": "gamma.txt is denied and holds no match: the search stays on and reads only beta.txt, and gamma.txt still answers Permission denied with exit 2, as a full scan does.",
      "command": "grep -rw sleeps /search",
      "clear_cache": true,
      "expect": {
        "exit": 2,
        "stdout": "/search/beta.txt:the wombat sleeps\n",
        "stderr": "grep: /search/gamma.txt: Permission denied\n",
        "check": "[\"/search/beta.txt\"]\n"
      },
      "check": {
        "read_paths": true
      }
    },
    {
      "id": "search_word_lists_around_a_denied_file",
      "seq": 540257,
      "targets": [
        "box",
        "dropbox"
      ],
      "session": "walled",
      "command": "grep -rlw wombat /search",
      "clear_cache": true,
      "expect": {
        "exit": 2,
        "stdout": "/search/alpha.txt\n/search/beta.txt\n",
