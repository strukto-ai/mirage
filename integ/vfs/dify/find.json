    {
      "id": "dify_find_refuses_a_denied_subtree",
      "targets": [
        "dify"
      ],
      "session": "find-deny",
      "session_profiles": {
        "find-deny": {
          "commands": {
            "deny": [
              {
                "paths": [
                  "/knowledge/guides"
                ],
                "reason": "sealed"
              }
            ]
          }
        }
      },
      "command": "set -o pipefail; find /knowledge -type f 2>/dev/null | grep guides; echo find=$?",
      "expect": {
        "exit": 0,
        "stdout": "find=1\n",
        "stderr": ""
      },
