      "seq": 640036,
      "targets": [
        "qdrant"
      ],
      "command": "cat /db/__nf_missing__.txt; echo rc=$?; search; echo rc=$?; search --method hybrid dog /db/cat; echo rc=$?; search '' /db; echo rc=$?",
      "expect": {
        "exit": 0,
        "stdout": "rc=1\nrc=2\nrc=1\nrc=2\n",
        "stderr": "cat: /db/__nf_missing__.txt: Is a directory\nsearch: query is required\nsearch: only the 'semantic' method is supported\nsearch: query is required\n"
      }
    },
    {
      "id": "qdrant_write_rejected",
      "seq": 640037,
      "targets": [
        "qdrant"
      ],
      "command": "echo hi > /db/cat/big/1.txt",
      "expect": {
        "exit": 1,
        "stdout": "",
        "stderr": "/db/cat/big/1.txt: Read-only file system\n"
      }
    },
    {
      "id": "qdrant_sed_stream_1p",
      "seq": 640038,
      "targets": [
        "qdrant"
      ],
      "command": "sed -n 1p /db/cat/big/1.txt",
      "expect": {
        "exit": 0,
        "stdout": "a big orange cat\n",
        "stderr": ""
      }
    },
    {
      "id": "qdrant_sed_i_readonly",
      "seq": 640039,
      "targets": [
