        "exit": 0,
        "stdout": "authors\nbooks\n",
        "stderr": ""
      }
    },
    {
      "id": "pg_ls_views",
      "seq": 610003,
      "targets": [
        "postgres"
      ],
      "command": "ls /pg/public/views/",
      "expect": {
        "exit": 0,
        "stdout": "recent_books\n",
        "stderr": ""
      }
    },
    {
      "id": "pg_ls_entity",
