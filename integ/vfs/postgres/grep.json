        "stderr": ""
      },
      "seq": 610059
    },
    {
      "id": "pg_grep_a_key_every_row_holds",
      "targets": [
        "postgres"
      ],
      "command": "grep books /pg/public/tables/authors/rows.jsonl",
      "expect": {
        "exit": 0,
        "stdout": "public/tables/authors/rows.jsonl:{\"id\":1,\"name\":\"ada\",\"books\":2}\npublic/tables/authors/rows.jsonl:{\"id\":2,\"name\":\"ben\",\"books\":2}\npublic/tables/authors/rows.jsonl:{\"id\":3,\"name\":\"cara\",\"books\":1}\n",
        "stderr": ""
      },
      "seq": 610060
    },
    {
      "id": "pg_grep_regex_pattern_scans_instead_of_pushing_down",
      "seq": 610061,
      "targets": [
        "postgres"
      ],
      "command": "grep a.a /pg/public/tables/books/rows.jsonl",
      "expect": {
        "exit": 0,
        "stdout": "{\"id\":1,\"title\":\"alpha\",\"author\":\"ada\",\"year\":2020,\"rating\":4.5}\n{\"id\":3,\"title\":\"gamma\",\"author\":\"cara\",\"year\":2022,\"rating\":5}\n{\"id\":4,\"title\":\"delta\",\"author\":\"ada\",\"year\":2023,\"rating\":4}\n",
        "stderr": ""
      }
    },
    {
      "id": "postgres_grep_keeps_a_hidden_table_out",
      "seq": 610068,
      "targets": [
        "postgres"
      ],
      "command": "grep -r epsilon /pg/public/tables; echo grep=$?; grep -rF epsilon /pg/public/tables; echo grepF=$?; rg -F epsilon /pg/public/tables; echo rgF=$?",
      "expect": {
        "exit": 0,
        "stdout": "grep=1\ngrepF=1\nrgF=1\n",
        "stderr": ""
      },
      "session": "postgres-hide",
      "session_profiles": {
        "postgres-hide": {
          "paths": {
            "hide": [
              "/pg/public/tables/books"
            ]
          }
        }
      }
    },
    {
      "id": "postgres_grep_refuses_a_denied_table",
      "seq": 610069,
      "targets": [
        "postgres"
      ],
      "command": "grep -r epsilon /pg/public/tables 2>/dev/null; echo grep=$?; grep -rF epsilon /pg/public/tables 2>/dev/null; echo grepF=$?; rg -F epsilon /pg/public/tables 2>/dev/null; echo rgF=$?",
      "expect": {
        "exit": 0,
        "stdout": "grep=2\ngrepF=2\nrgF=2\n",
        "stderr": ""
      },
      "session": "postgres-deny",
      "session_profiles": {
        "postgres-deny": {
          "commands": {
            "deny": [
              {
                "reason": "sealed",
                "paths": [
                  "/pg/public/tables/books/*"
                ]
              }
            ]
          }
        }
      }
    }
  ]
}
