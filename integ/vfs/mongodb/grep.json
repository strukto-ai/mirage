    {
      "id": "mongodb_grep_refuses_a_denied_table",
      "seq": 620078,
      "targets": [
        "mongodb"
      ],
      "command": "grep -r epsilon /mongodb/mirage_integ/collections 2>/dev/null; echo grep=$?; grep -rF epsilon /mongodb/mirage_integ/collections 2>/dev/null; echo grepF=$?; rg -F epsilon /mongodb/mirage_integ/collections 2>/dev/null; echo rgF=$?",
      "expect": {
        "exit": 0,
        "stdout": "grep=2\ngrepF=2\nrgF=2\n",
