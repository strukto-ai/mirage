    {
      "id": "mongodb_grep_keeps_a_hidden_table_out",
      "seq": 620077,
      "targets": [
        "mongodb"
      ],
      "command": "grep -r epsilon /mongodb/mirage_integ/collections; echo grep=$?; grep -rF epsilon /mongodb/mirage_integ/collections; echo grepF=$?; rg -F epsilon /mongodb/mirage_integ/collections; echo rgF=$?",
      "expect": {
        "exit": 0,
        "stdout": "grep=1\ngrepF=1\nrgF=1\n",
        "stderr": ""
      },
      "session": "mongodb-hide",
      "session_profiles": {
        "mongodb-hide": {
          "paths": {
            "hide": [
              "/mongodb/mirage_integ/collections/books"
            ]
          }
        }
