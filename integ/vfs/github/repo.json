        "stdout": "77\t/repo/docs/architecture.md\n77\t/repo/docs/contributing.md\n73\t/repo/docs/release.md\n227\t/repo/docs\n14364\t/repo/src\n62\t/repo/README.md\n",
        "stderr": ""
      }
    },
