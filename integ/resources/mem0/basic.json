{
  "cases": [
    {
      "id": "mem0_ls_paginated",
      "seq": 590000,
      "targets": [
        "mem0"
      ],
      "command": "ls /memories",
      "expect": {
        "exit": 0,
        "stdout": "mem-alpha.json\nmem-beta.json\nmem-gamma.json\n",
        "stderr": ""
      }
    },
    {
      "id": "mem0_read_memory",
      "seq": 590001,
      "targets": [
        "mem0"
      ],
      "command": "jq -r '.memory' /memories/mem-alpha.json",
      "expect": {
        "exit": 0,
        "stdout": "Quarterly planning happens on Tuesday.\n",
        "stderr": ""
      }
    },
    {
      "id": "mem0_read_metadata",
      "seq": 590002,
      "targets": [
        "mem0"
      ],
      "command": "jq -r '.metadata.topic' /memories/mem-beta.json",
