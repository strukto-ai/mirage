        "exit": 0,
        "stdout": "preferences\n",
        "stderr": ""
      }
    },
    {
      "id": "mem0_find_json",
      "seq": 590003,
      "targets": [
        "mem0"
      ],
      "command": "find /memories -type f | sort",
      "expect": {
        "exit": 0,
        "stdout": "/memories/mem-alpha.json\n/memories/mem-beta.json\n/memories/mem-gamma.json\n",
        "stderr": ""
      }
    },
    {
