{
  "cases": [
    {
      "id": "wget_o_writes_vfs",
      "seq": 330011,
      "targets": [
        "http-ram"
      ],
      "command": "wget -q -O /data/wgot.txt {http}/hello",
      "expect": {
        "exit": 0,
        "stdout": "",
        "stderr": ""
      }
    },
    {
      "id": "wget_o_content_landed",
      "seq": 330012,
      "targets": [
        "http-ram"
      ],
      "command": "cat /data/wgot.txt",
      "expect": {
        "exit": 0,
        "stdout": "hello from http\n",
        "stderr": ""
      }
    },
    {
      "id": "wget_default_reports_path",
      "seq": 330013,
      "targets": [
        "http-ram"
      ],
      "command": "wget -O /data/wgot2.txt {http}/hello",
      "expect": {
        "exit": 0,
        "stdout": "saved 16 bytes to /data/wgot2.txt",
        "stderr": ""
      }
    },
    {
      "id": "wget_spider_reports_size",
      "seq": 330014,
      "targets": [
        "http-ram"
      ],
      "command": "wget --spider {http}/hello",
      "expect": {
        "exit": 0,
        "stdout": "Spider mode: {http}/hello exists (16 bytes)",
        "stderr": ""
      }
    },
    {
      "id": "wget_spider_quiet",
      "seq": 330015,
      "targets": [
        "http-ram"
      ],
      "command": "wget -q --spider {http}/hello",
      "expect": {
        "exit": 0,
        "stdout": "",
        "stderr": ""
      }
    },
    {
      "id": "wget_missing_url",
      "seq": 330016,
      "targets": [
        "http-ram"
      ],
      "command": "wget",
      "expect": {
        "exit": 1,
        "stdout": "",
        "stderr": "wget: missing URL\n"
      }
    }
  ]
}
