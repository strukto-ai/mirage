    },
    {
      "id": "grep-match-before-slow-line",
      "command": "printf 'ok\\n%s\\n' 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa!' | grep -E 'ok|^(a+)+$' | head -n1",
      "stdout": "ok\n",
      "exit_code": 0
    },
    {
      "id": "search-skips-slow-unread-line",
      "command": "for s in 'grep -E' rg; do printf 'ok\\n%s\\nok2\\n' 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa!' | $s 'ok|^(a+)+zz$' | head -n2; done",
      "stdout": "ok\nok2\nok\nok2\n",
      "exit_code": 0
    },
    {
      "id": "rg-multiline-cancel-pattern-control",
