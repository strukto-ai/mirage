  "stream": [
    {
      "id": "sed-first",
      "command": "seq inf | sed 1q",
      "stdout": "1\n",
      "exit_code": 0
    },
    {
      "id": "sed-loop-output",
      "command": "printf 'x\\n' | sed ':a;p;ba' | head -n1",
      "stdout": "x\n",
      "exit_code": 0
    },
    {
      "id": "xargs-first",
      "command": "seq inf | xargs -n1 echo | head -n1",
      "stdout": "1\n",
      "exit_code": 0
    },
    {
      "id": "xargs-close-status",
      "command": "printf x | xargs sh -c 'echo row; exit 1' sh | head -n1; echo ${PIPESTATUS[1]}",
      "stdout": "row\n123\n",
      "exit_code": 0
    },
    {
      "id": "xargs-close-keeps-stderr",
      "command": "{ printf x | xargs sh -c 'echo oops >&2; seq 100000; exit 1' sh | head -n1; echo ${PIPESTATUS[1]}; } 2>/xargs-err; cat /xargs-err",
      "stdout": "1\n123\noops\n",
      "exit_code": 0
    },
    {
      "id": "xargs-parallel",
      "command": "seq inf | xargs -P2 -n1 echo | head -n1",
      "stdout": "1\n",
      "exit_code": 0
    },
    {
      "id": "cmp-prefix",
      "command": "printf 1 > /one; seq inf | cmp -n 1 - /one",
      "stdout": "",
      "exit_code": 0
    },
    {
      "id": "bc-quit",
      "command": "{ printf 'quit\\n'; seq inf; } | bc",
      "stdout": "",
      "exit_code": 0
    },
    {
      "id": "bc-output",
      "command": "seq inf | bc | head -n1",
      "stdout": "1\n",
      "exit_code": 0
    },
    {
      "id": "sed-write-close",
      "command": "printf 'x\\n' | sed 'w /saved' | head -n1; cat /saved",
      "stdout": "x\nx\n",
      "exit_code": 0
    },
    {
      "id": "rg-multiline-context",
