  "cases": [
    {
      "id": "sro_prep",
      "seq": 1231020,
      "command": "mkdir -p /res/sro && printf 'hello\\n' > /res/sro/f.txt && cd /res/sro && gzip -k f.txt && tar -cf a.tar f.txt && zip -q a.zip f.txt",
      "expect": {
        "exit": 0,
        "stdout": "",
        "stderr": ""
      }
    },
    {
      "id": "sro_gunzip_c_reads_a_read_only_archive",
      "seq": 1231021,
      "session": "narrowed",
      "command": "gunzip -c /res/sro/f.txt.gz",
      "expect": {
        "exit": 0,
        "stdout": "hello\n",
        "stderr": ""
      },
      "flags": [
        "c"
      ]
    },
    {
      "id": "sro_gunzip_t_tests_a_read_only_archive",
      "seq": 1231022,
      "session": "narrowed",
      "command": "gunzip -t /res/sro/f.txt.gz && echo ok",
      "expect": {
        "exit": 0,
        "stdout": "ok\n",
        "stderr": ""
      },
      "flags": [
        "t"
      ]
    },
    {
      "id": "sro_gzip_c_compresses_to_stdout",
      "seq": 1231023,
