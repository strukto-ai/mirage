      "command": "rm /ro/rolink && readlink /ro/rolink || echo gone",
      "note": "Removal is a node-table write on the same read-only mount, so it follows the create; it also leaves no residue for a later listing.",
      "expect": {
        "exit": 0,
        "stdout": "gone\n",
        "stderr": ""
