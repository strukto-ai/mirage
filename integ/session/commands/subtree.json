{
  "cases": [
    {
      "id": "subtree_prep",
      "seq": 923079,
      "targets": [
        "ram-commands"
      ],
      "command": "mkdir -p /scratch/other && echo g > /scratch/other/k && touch /scratch/mv1 /scratch/mv2",
      "expect": {
        "exit": 0,
        "stdout": "",
        "stderr": ""
      }
    },
    {
      "id": "glob_into_a_denied_subtree_is_judged_expanded",
      "seq": 923080,
      "targets": [
        "ram-commands"
      ],
      "command": "cat /scratch/*/k",
      "explain_blind": "the runtime expands the glob, so the dry run reads the pattern and not the paths it names",
      "expect": {
        "exit": 1,
        "stdout": "",
        "stderr": "cat: /scratch/private/k: Permission denied\n"
      }
    },
    {
      "id": "glob_that_misses_the_subtree_runs",
      "seq": 923081,
      "targets": [
        "ram-commands"
      ],
      "command": "cat /scratch/o*/k",
      "expect": {
        "exit": 0,
        "stdout": "g\n",
        "stderr": ""
      }
    },
    {
      "id": "glob_naming_the_denied_directory",
      "seq": 923082,
      "targets": [
        "ram-commands"
      ],
      "command": "ls -d /scratch/priv*",
      "explain_blind": "the runtime expands the glob, so the dry run reads the pattern and not the paths it names",
      "expect": {
        "exit": 1,
        "stdout": "",
        "stderr": "ls: cannot access '/scratch/private': Permission denied\n"
      }
    },
    {
      "id": "glob_under_a_pure_path_rule_is_judged_expanded",
      "seq": 923083,
      "targets": [
        "ram-commands"
      ],
      "session": "frozen",
      "command": "cat /scratch/lock*/y",
      "explain_blind": "the runtime expands the glob, so the dry run reads the pattern and not the paths it names",
      "expect": {
        "exit": 1,
        "stdout": "",
        "stderr": "cat: /scratch/locked/y: Permission denied\n"
      }
    },
    {
      "id": "subtree_rm_on_the_directory_holding_the_scope",
      "seq": 923084,
      "targets": [
        "ram-commands"
      ],
      "session": "granted",
      "command": "rm -r /scratch/both",
      "expect": {
        "exit": 1,
        "stdout": "",
        "stderr": "rm: cannot remove '/scratch/both': Permission denied\n"
      }
    },
    {
      "id": "subtree_rm_kept_the_scope",
      "seq": 923085,
      "targets": [
        "ram-commands"
      ],
      "command": "test -e /scratch/both/locked/y && echo kept",
      "expect": {
        "exit": 0,
        "stdout": "kept\n",
        "stderr": ""
      }
    },
    {
      "id": "subtree_rm_on_an_ancestor_of_a_pure_path_scope",
      "seq": 923086,
      "targets": [
        "ram-commands"
      ],
      "session": "frozen",
      "command": "rm -r /scratch/locked",
      "expect": {
        "exit": 1,
        "stdout": "",
        "stderr": "rm: cannot remove '/scratch/locked': Permission denied\n"
      }
    },
    {
      "id": "subtree_mv_of_the_holding_directory",
      "seq": 923087,
      "targets": [
        "ram-commands"
      ],
      "session": "frozen",
      "command": "mv /scratch/locked /scratch/moved",
      "expect": {
        "exit": 1,
        "stdout": "",
        "stderr": "mv: /scratch/locked: Permission denied\n"
      }
    },
    {
      "id": "subtree_mv_into_the_holding_directory",
