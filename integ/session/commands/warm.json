{
  "targets": [
    "s3-walled"
  ],
  "cases": [
    {
      "id": "warm_walk_prep",
      "seq": 13740001,
      "command": "mkdir -p /data/warmwalk && echo 'secret open' > /data/warmwalk/open.txt && echo 'secret sealed' > /data/warmwalk/sealed.txt && echo 'secret locked' > /data/warmwalk/locked.txt",
      "expect": {
        "exit": 0,
        "stdout": "",
        "stderr": ""
      }
    },
    {
      "id": "warm_walk_cold_walk_meets_the_rules",
      "seq": 13740002,
      "session": "walled",
      "command": "grep -r secret /data/warmwalk",
      "expect": {
        "exit": 2,
        "stdout": "/data/warmwalk/open.txt:secret open\n",
        "stderr": "grep: /data/warmwalk/locked.txt: Permission denied\ngrep: /data/warmwalk/sealed.txt: Permission denied\n"
      }
    },
    {
      "id": "warm_walk_another_session_warms_the_cache",
      "seq": 13740003,
      "command": "cat /data/warmwalk/sealed.txt /data/warmwalk/locked.txt",
      "expect": {
        "exit": 0,
        "stdout": "secret sealed\nsecret locked\n",
        "stderr": ""
      }
    },
    {
      "id": "warm_walk_the_cache_holds_the_refused_bytes",
      "seq": 13740004,
      "command": "cat /data/warmwalk/sealed.txt /data/warmwalk/locked.txt",
      "expect": {
        "exit": 0,
        "stdout": "secret sealed\nsecret locked\n",
        "stderr": "",
        "check": "[]\n"
      },
      "check": {
        "read_paths": true
      }
    },
    {
      "id": "warm_walk_cached_bytes_stay_refused",
      "seq": 13740005,
      "session": "walled",
      "command": "grep -r secret /data/warmwalk",
      "expect": {
        "exit": 2,
        "stdout": "/data/warmwalk/open.txt:secret open\n",
        "stderr": "grep: /data/warmwalk/locked.txt: Permission denied\ngrep: /data/warmwalk/sealed.txt: Permission denied\n",
        "check": "[]\n"
      },
      "check": {
        "read_paths": true
      }
    },
    {
      "id": "warm_walk_a_relayed_archive_meets_the_rules",
      "seq": 13740006,
      "session": "walled",
      "command": "tar -cf - /data/warmwalk | tar -tf -",
      "expect": {
        "exit": 0,
        "stdout": "data/warmwalk/\ndata/warmwalk/open.txt\n",
        "stderr": "tar: Removing leading `/' from member names\ntar: /data/warmwalk/locked.txt: Cannot open: Permission denied\ntar: /data/warmwalk/sealed.txt: Cannot open: Permission denied\ntar: Exiting with failure status due to previous errors\n"
      }
    }
  ]
}
