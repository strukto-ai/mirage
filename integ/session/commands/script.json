    {
      "id": "scriptops_drop_descriptor_writes_without_reading",
      "seq": 923284,
      "targets": [
        "ram-commands"
      ],
      "session": "scriptedops",
      "command": "exec 3>/scratch/drop/f; echo a >&3; echo b >&3; echo XYZ >> /scratch/drop/f; echo c >&3; exec 3>&-; echo rc=$?",
      "note": "bash on a file with write permission only (debian:stable-slim, chmod 200): a write-only descriptor writes at its own offset, so c lands over the XY the append added, and <> is refused because it opens the file to read.",
      "expect": {
        "exit": 0,
        "stdout": "rc=0\n",
        "stderr": ""
      }
    },
