{
  "cases": [
    {
      "id": "cmd_profile_keeps_what_both_tiers_list",
      "seq": 923009,
      "targets": [
        "ram-commands"
      ],
      "session": "reviewer",
      "command": "cat /scratch/locked/y",
      "expect": {
        "exit": 0,
        "stdout": "y\n",
        "stderr": ""
      }
    },
    {
      "id": "cmd_profile_hides_what_it_does_not_list",
      "seq": 923010,
      "targets": [
        "ram-commands"
      ],
      "session": "reviewer",
      "command": "python3 -c 1",
      "expect": {
        "exit": 127,
        "stdout": "",
        "stderr": "python3: command not found\n"
      }
    },
    {
      "id": "cmd_profile_verb_pattern_keeps_the_head_visible",
