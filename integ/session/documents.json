    {
      "id": "documents_subtree_mode",
      "seq": 960007,
      "targets": [
        "ram",
        "disk",
        "s3",
        "s3-prefix",
        "redis",
        "opfs"
      ],
      "session": "docs-a",
      "session_profiles": {
        "docs-a": {
          "paths": {
            "hide": [
              "/data2"
