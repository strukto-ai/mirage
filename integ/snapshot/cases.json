    {
      "id": "ram_coded_policy_is_named_not_carried",
      "target": {
        "id": "snap-ram-policy",
        "hosts": ["python", "typescript-node"],
        "mounts": [
          {
            "path": "/work",
            "resource": "ram",
            "backend": "ram"
          }
        ]
      },
      "policies": [
        {
          "id": "gate",
          "commands": ["rm"],
          "paths": ["/work/sealed.txt"],
          "reason": "coded gate"
        }
      ],
      "seed": [
        {
          "op": "write",
          "path": "/work/f.txt",
          "data": "hi\n"
        },
        {
          "op": "write",
          "path": "/work/sealed.txt",
          "data": "sealed\n"
        }
      ],
      "verify": [
        {
          "op": "policies"
        },
        {
          "op": "exec",
          "command": "rm /work/f.txt",
          "expect": {
            "exit": 126
          }
        },
        {
          "op": "exec",
          "command": "cat /work/f.txt",
          "expect": {
            "exit": 0
          }
        }
      ],
      "load": {
        "profiles": false,
        "runtimes": false,
        "policies": true
      }
    },
    {
      "id": "ram_profile_policy_script_per_host_runtime",
      "target": {
        "id": "snap-ram-script",
        "hosts": ["python", "typescript-node"],
        "mounts": [
          {
            "path": "/work",
            "resource": "ram",
            "backend": "ram"
          }
        ],
        "profiles": {
          "guard": "@script"
        },
        "profile": "guard"
      },
      "script": {
        "python": {
          "source": "def pre_command(ctx):\n    if ctx['command']['name'] == 'rm':\n        return {'deny': 'script says no'}\n    return None\n",
          "language": "python",
          "runtime": "monty"
        },
        "typescript": {
          "source": "def pre_command(ctx):\n    if ctx['command']['name'] == 'rm':\n        return {'deny': 'script says no'}\n    return None\n",
          "language": "python",
          "runtime": "pyodide"
        }
      },
      "seed": [
        {
          "op": "write",
          "path": "/work/f.txt",
          "data": "hi\n"
        }
      ],
      "verify": [
        {
          "op": "exec",
          "command": "rm /work/f.txt",
          "expect": {
            "exit": 126,
            "refusal": "script says no"
          }
        },
        {
          "op": "exec",
          "command": "cat /work/f.txt",
          "expect": {
            "exit": 0
          }
        }
      ],
      "load": {
        "profiles": true,
        "runtimes": true
      }
    },
    {
      "id": "ram_script_cli_per_host_runtime",
      "target": {
        "id": "snap-ram-cli",
        "hosts": ["python", "typescript-node"],
        "mounts": [
          {
            "path": "/work",
            "resource": "ram",
            "backend": "ram"
          }
        ]
      },
      "script_cli": {
        "name": "tally",
        "python": {
          "source": "try:\n    _args = argv\nexcept NameError:\n    import sys\n    _args = sys.argv\nprint('tally', ' '.join(_args[1:]))\n",
          "language": "python",
          "runtime": "monty"
        },
        "typescript": {
          "source": "try:\n    _args = argv\nexcept NameError:\n    import sys\n    _args = sys.argv\nprint('tally', ' '.join(_args[1:]))\n",
          "language": "python",
          "runtime": "pyodide"
        }
      },
      "seed": [
        {
          "op": "write",
          "path": "/work/f.txt",
          "data": "hi\n"
        }
      ],
      "verify": [
        {
          "op": "clis"
        },
        {
          "op": "exec",
          "command": "tally one two",
          "expect": {
            "exit": 0,
            "stdout_contains": "tally one two"
          }
        }
      ],
      "load": {
        "profiles": false,
        "runtimes": true
      }
    },
