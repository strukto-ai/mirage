{
  "cases": [
    {
      "id": "ram_document_sessions_and_asks",
      "target": {
        "id": "snap-ram",
        "hosts": ["python", "typescript-node"],
        "mounts": [
          {
            "path": "/work",
            "resource": "ram",
            "backend": "ram"
          },
          {
            "path": "/vault",
            "resource": "ram",
            "backend": "ram"
          }
        ],
        "profiles": {
          "default": {
            "commands": {
              "allow": ["echo", "cat", "ls", "rm", "mv", "touch", "export", "mkdir"]
            }
          },
          "crew": {
            "env": {
              "SLACK_TOKEN": "xoxb-secret",
              "ROLE": "crew"
            },
            "vars": {
              "hide": ["SLACK_TOKEN"]
            },
            "paths": {
              "hide": ["/vault"],
              "show": {
                "/vault/public": "r"
              },
              "reasons": [
                {
                  "patterns": ["/vault"],
                  "reason": "operator sealed it"
                }
              ]
            },
            "commands": {
              "allow": ["echo", "cat", "ls", "rm", "mv", "touch", "export", "mkdir"],
              "deny": ["rm"],
              "ask": [
                {
                  "reason": "moves files",
                  "commands": ["mv"]
                }
              ]
            }
          }
        },
        "sessions": {
          "agent": "crew"
        }
      },
      "seed": [
        {
          "op": "exec",
          "command": "mkdir -p /vault/public"
        },
        {
          "op": "write",
          "path": "/work/kept.txt",
          "data": "kept\n"
        },
        {
          "op": "write",
          "path": "/vault/secret.txt",
          "data": "sealed\n"
        },
        {
          "op": "write",
          "path": "/vault/public/open.txt",
          "data": "open\n"
        },
        {
          "op": "exec",
          "session": "agent",
          "command": "mv /work/kept.txt /work/moved.txt"
        },
        {
          "op": "answer",
          "mode": "allow_session"
        },
        {
          "op": "exec",
          "session": "agent",
          "command": "mv /work/kept.txt /work/moved.txt"
        }
      ],
      "verify": [
        {
          "op": "sessions"
        },
        {
          "op": "profile_of",
          "session": "agent"
        },
        {
          "op": "exec",
          "session": "agent",
          "command": "echo tok=[$SLACK_TOKEN] role=$ROLE"
        },
        {
          "op": "exec",
          "session": "agent",
          "command": "rm /work/moved.txt",
          "expect": {
            "exit": 126
          }
        },
        {
          "op": "exec",
          "session": "agent",
          "command": "cat /vault/public/open.txt",
          "expect": {
            "exit": 0
          }
        },
        {
          "op": "exec",
          "session": "agent",
          "command": "cat /vault/secret.txt"
        },
        {
          "op": "exec",
          "session": "agent",
          "command": "ls /work"
        },
        {
          "op": "exec",
          "command": "cat /work/moved.txt",
          "expect": {
            "exit": 0
          }
        },
        {
          "op": "hides",
          "session": "agent"
        },
        {
          "op": "decisions",
          "session": "agent"
        }
      ],
      "load": {
        "profiles": false,
        "runtimes": false
      }
    },
