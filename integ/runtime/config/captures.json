{
  "cases": [
    {
      "id": "monty_cannot_take_node",
      "note": "A runtime that only interprets one language refuses a name outside it, where the capture would run JavaScript through the Python interpreter.",
      "world": {
        "machines": {
          "monty": {
            "provider": "in_process",
            "runtime": "monty",
            "captures": [
              "python3",
              "node"
            ]
          }
        }
      },
      "build_error": {
        "contains": "machine 'monty' does not run 'node'"
      }
    },
    {
      "id": "monty_cannot_take_a_program",
      "world": {
        "machines": {
          "monty": {
            "provider": "in_process",
            "runtime": "monty",
            "captures": [
              "python3",
              "gcc"
            ]
          }
        }
      },
      "build_error": {
        "contains": "machine 'monty' does not run 'gcc'"
      }
    },
    {
      "id": "monty_cannot_take_the_js_group",
      "world": {
        "machines": {
          "monty": {
            "provider": "in_process",
            "runtime": "monty",
            "captures": [
              "@js"
            ]
          }
        }
      },
      "build_error": {
        "contains": "machine 'monty' does not run 'node'"
      }
    },
    {
      "id": "unknown_group",
      "world": {
        "machines": {
          "monty": {
            "provider": "in_process",
            "runtime": "monty",
            "captures": [
              "@pyton"
            ]
          }
        }
      },
      "build_error": {
        "contains": "'@pyton' is not a program or a group; the groups are '@external', '@line', '@python' and '@js'"
      }
    }
  ]
}
