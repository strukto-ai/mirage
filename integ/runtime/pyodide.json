          "command": "python3 -c \"import errno, os\nfor call in (lambda: os.getxattr('/data/t.txt', 'user.none'),\n             lambda: os.setxattr('/data/t.txt', 'user.guest', b'x', os.XATTR_CREATE),\n             lambda: os.listxattr('/data/none.txt')):\n    try:\n        call()\n    except OSError as exc:\n        print(errno.errorcode[exc.errno])\"",
