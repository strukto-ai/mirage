{
  "suite": "pyodide",
  "cases": [
    {
      "id": "eval",
      "hosts": [
        "typescript"
      ],
      "world": {
        "runtimes": [
          "pyodide",
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "python3 -c \"print(6 * 7)\"",
          "expect": {
            "exit": 0,
            "stdout": "42\n"
          }
        }
      ]
    },
    {
      "id": "read_mount",
