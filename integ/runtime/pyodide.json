{
  "suite": "pyodide",
  "cases": [
    {
      "id": "eval",
      "hosts": [
        "typescript"
      ],
      "world": {
        "runtimes": [
          "pyodide",
          "vfs"
        ],
        "mounts": {
          "/ram": {
            "resource": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "python3 -c \"print(6 * 7)\"",
          "expect": {
            "exit": 0,
            "stdout": "42\n"
          }
        }
      ]
    },
    {
      "id": "read_mount",
      "hosts": [
        "typescript"
      ],
      "world": {
        "runtimes": [
          "pyodide",
          "vfs"
        ],
        "mounts": {
          "/ram": {
            "resource": "ram",
            "files": {
              "data.txt": "hello from ram\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "python3 -c \"print(open('/ram/data.txt').read().strip() + '-pyodide')\"",
          "expect": {
            "exit": 0,
            "stdout": "hello from ram-pyodide\n"
          }
        }
      ]
    },
    {
      "id": "write_mount",
      "hosts": [
        "typescript"
      ],
      "world": {
        "runtimes": [
          "pyodide",
          "vfs"
        ],
        "mounts": {
          "/ram": {
            "resource": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "python3 -c \"open('/ram/from-pyodide.txt', 'w').write('pyodide-wrote-this')\" && cat /ram/from-pyodide.txt",
          "expect": {
            "exit": 0,
            "stdout": "pyodide-wrote-this"
          }
        }
      ]
    }
  ]
}
