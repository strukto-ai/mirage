            }
          }
        }
      },
      "steps": [
        {
          "command": "python3 -c \"import os\nos.symlink('t.txt', '/data/made')\nos.rename('/data/made', '/data/moved')\nprint(os.readlink('/data/moved'))\nprint(os.path.islink('/data/made'))\"",
          "expect": {
            "exit": 0,
            "stdout": "t.txt\nFalse\n"
          }
        },
        {
          "command": "readlink /data/moved",
