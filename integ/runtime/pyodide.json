          "expect": {
            "exit": 0,
            "stdout": "",
            "stderr": ""
          }
        },
        {
          "command": "python3 -c \"print('hello world')\"",
          "expect": {
            "exit": 0,
            "stdout": "hello world\n",
            "stderr": ""
          }
        },
        {
          "command": "python3 -c \"print('hello')\"",
          "expect": {
            "exit": 0,
            "stdout": "hello\n",
            "stderr": ""
          }
        },
        {
          "command": "python3 -c \"import sys; print('hello world'); sys.stderr.write('stderr — café 🌍\\n')\"",
