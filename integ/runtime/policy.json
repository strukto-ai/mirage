{
  "suite": "policy",
  "cases": [
    {
      "id": "runtime_arg_per_line",
      "world": {
        "runtimes": [
          "monty",
          "local",
          "vfs"
        ],
        "mounts": {
          "/ram": {
            "resource": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "python3 -c \"print(argv[0])\"",
          "expect": {
            "exit": 0,
            "stdout": "main.py\n"
          }
        },
        {
          "command": "python3 -c \"import sys; print('routed-to-local')\"",
          "runtime": "local",
          "expect": {
            "exit": 0,
            "stdout": "routed-to-local\n"
          }
        },
        {
          "command": "python3 -c \"print(argv[0])\"",
          "expect": {
            "exit": 0,
            "stdout": "main.py\n"
          }
        }
      ]
    },
    {
      "id": "entry_script_fallthrough",
      "world": {
        "runtimes": [
          {
            "name": "monty",
            "script": "'use-local' not in ctx['line']"
          },
          "local",
          "vfs"
        ],
        "mounts": {
          "/ram": {
            "resource": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "python3 -c \"print(argv[0])\"",
          "expect": {
            "exit": 0,
            "stdout": "main.py\n"
          }
        },
        {
          "command": "python3 -c \"import sys; print('routed-to-local')\" && echo use-local",
          "expect": {
            "exit": 0,
            "stdout": "routed-to-local\nuse-local\n"
          }
        }
      ]
    },
    {
      "id": "entry_script_refused",
      "world": {
        "runtimes": [
          {
            "name": "monty",
            "script": "False"
          },
          "vfs"
        ],
        "mounts": {
          "/ram": {
            "resource": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "python3 -c \"x\"",
          "expect": {
            "exit": 126,
            "stderr": "python3: no runtime accepted this line\n"
          }
        },
        {
          "command": "echo vfs-open",
          "expect": {
            "exit": 0,
            "stdout": "vfs-open\n"
          }
        }
      ]
    },
    {
      "id": "global_policy",
      "world": {
        "runtimes": [
          "monty",
          "local",
          "vfs"
        ],
        "mounts": {
          "/ram": {
            "resource": "ram"
          }
        },
        "policy": "'local' if 'go-local' in ctx['line'] else None"
      },
      "steps": [
        {
          "command": "python3 -c \"print(argv[0])\"",
          "expect": {
            "exit": 0,
            "stdout": "main.py\n"
          }
        },
        {
          "command": "python3 -c \"import sys; print('went-local')\" && echo go-local",
          "expect": {
            "exit": 0,
            "stdout": "went-local\ngo-local\n"
          }
        }
      ]
    },
    {
      "id": "add_runtime_local",
      "world": {
        "runtimes": [
          "monty",
          "vfs"
        ],
        "mounts": {
          "/ram": {
            "resource": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "python3 -c \"x\"",
          "runtime": "local",
          "expect": {
            "throws_contains": "unknown runtime"
          }
        },
        {
          "add_runtime": "local"
        },
        {
          "command": "python3 -c \"import sys; print('added-local')\"",
          "runtime": "local",
          "expect": {
            "exit": 0,
            "stdout": "added-local\n"
          }
        }
      ]
    },
    {
      "id": "add_runtime_monty",
      "hosts": [
        "typescript"
      ],
      "world": {
        "runtimes": [
          "quickjs",
          "vfs"
        ],
        "mounts": {
          "/ram": {
            "resource": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "python3 -c \"x\"",
          "runtime": "monty",
          "expect": {
            "throws_contains": "unknown runtime"
          }
        },
        {
          "add_runtime": "monty"
        },
        {
          "command": "python3 -c \"print(40 + 2)\"",
          "runtime": "monty",
          "expect": {
            "exit": 0,
            "stdout": "42\n"
          }
        }
      ]
    },
    {
      "id": "ctx_command_pipeline",
      "world": {
        "runtimes": [
          {
            "name": "monty",
            "script": "ctx['command'] == 'python3'"
          },
          "vfs"
        ],
        "mounts": {
          "/ram": {
            "resource": "ram",
            "files": {
              "pipe.py": "print('came-through-pipe')"
            }
          }
        }
      },
      "steps": [
        {
          "command": "cat /ram/pipe.py | python3",
          "expect": {
            "exit": 0,
            "stdout": "came-through-pipe\n"
          }
        }
      ]
    },
    {
      "id": "runtime_arg_uncaptured_inert",
      "world": {
        "runtimes": [
          "monty"
        ],
        "mounts": {
          "/ram": {
            "resource": "ram",
            "files": {
              "a.txt": "hello\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "grep -r hello",
          "runtime": "monty",
          "expect": {
            "exit": 0,
            "stdout": "ram/a.txt:hello\n"
          }
        },
        {
          "command": "grep -r xxx",
          "runtime": "monty",
          "expect": {
            "exit": 1,
            "stdout": ""
          }
        },
        {
          "command": "grep -r xxx /ram",
          "runtime": "monty",
          "expect": {
            "exit": 1,
            "stdout": ""
          }
        },
        {
          "command": "grep -r hello /ram",
          "runtime": "monty",
          "expect": {
            "exit": 0,
            "stdout": "/ram/a.txt:hello\n"
          }
        }
      ]
    },
    {
      "id": "runtime_arg_vfs_refused",
      "world": {
        "runtimes": [
          "monty"
        ]
      },
      "steps": [
        {
          "command": "echo hi",
          "runtime": "vfs",
          "expect": {
            "throws_contains": "not a runtime you can select"
          }
        }
      ]
    },
    {
      "id": "policy_script_bad_name",
      "world": {
        "runtimes": [
          "monty"
        ],
        "mounts": {
          "/ram": {
            "resource": "ram"
          }
        },
        "policy": "'nope'"
      },
      "steps": [
        {
          "command": "python3 -c \"print(1)\"",
          "expect": {
            "throws_contains": "unknown runtime"
          }
        }
      ]
    },
    {
      "id": "captures_narrowed_entry",
      "world": {
        "runtimes": [
          {
            "name": "monty",
            "captures": [
              "python3"
            ]
          }
        ],
        "mounts": {
          "/ram": {
            "resource": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "python3 -c \"print(40 + 2)\"",
          "expect": {
            "exit": 0,
            "stdout": "42\n"
          }
        }
      ]
    },
    {
      "id": "nested_eval_inherits_routing",
      "world": {
        "runtimes": [
          {
            "name": "monty",
            "script": "'magic' in ctx['line']"
          }
        ],
        "mounts": {
          "/ram": {
            "resource": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "echo $(python3 -c \"print(42)\") magic",
          "expect": {
            "exit": 0,
            "stdout": "42 magic\n"
          }
        },
        {
          "command": "echo $(python3 -c \"print(42)\")",
          "expect": {
            "exit": 0,
            "stdout": "\n"
          }
        }
      ]
    },
    {
      "id": "captures_narrowed_miss",
      "world": {
        "runtimes": [
          {
            "name": "monty",
            "captures": [
              "python3"
            ]
          }
        ],
        "mounts": {
          "/ram": {
            "resource": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "python -c \"print(1)\"",
          "expect": {
            "exit": 127,
            "stderr_contains": "python3: command not found"
          }
        }
      ]
    },
    {
      "id": "policy_deny_blocks_line",
      "world": {
        "runtimes": [
          "monty",
          "vfs"
        ],
        "mounts": {
          "/ram": {
            "resource": "ram"
          }
        },
        "policy": "{'deny': 'python3 is blocked here'} if ctx['command'] == 'python3' else None"
      },
      "steps": [
        {
          "command": "python3 -c \"print(1)\"",
          "expect": {
            "exit": 126,
            "stderr": "python3: policy denied: python3 is blocked here\n"
          }
        },
        {
          "command": "echo still-open",
          "expect": {
            "exit": 0,
            "stdout": "still-open\n"
          }
        }
      ]
    },
    {
      "id": "policy_verdict_places_runtime",
      "world": {
        "runtimes": [
          "monty",
          "vfs"
        ],
        "mounts": {
          "/ram": {
            "resource": "ram"
          }
        },
        "policy": "{'runtime': 'monty'}"
      },
      "steps": [
        {
          "command": "python3 -c \"print(40 + 2)\"",
          "expect": {
            "exit": 0,
            "stdout": "42\n"
          }
        }
      ]
    },
    {
      "id": "policy_script_bad_verdict",
      "world": {
        "runtimes": [
          "monty",
          "vfs"
        ],
        "mounts": {
          "/ram": {
            "resource": "ram"
          }
        },
        "policy": "{'runtme': 'monty'}"
      },
      "steps": [
        {
          "command": "python3 -c \"print(1)\"",
          "expect": {
            "throws_contains": "unknown policy verdict keys"
          }
        }
      ]
    },
    {
      "id": "entry_script_verdict_shape",
      "world": {
        "runtimes": [
          {
            "name": "monty",
            "script": "{'deny': 'nope'}"
          },
          "vfs"
        ],
        "mounts": {
          "/ram": {
            "resource": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "python3 -c \"print(1)\"",
          "expect": {
            "throws_contains": "entry scripts answer a boolean"
          }
        }
      ]
    }
  ]
}
