{
  "requires": {
    "python": [
      "env:MIRAGE_QUICKJS_HOME"
    ],
    "typescript": []
  },
  "cases": [
    {
      "id": "js_policy_reads_file",
      "world": {
        "runtimes": [
          "quickjs",
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram",
            "files": {
              "route.txt": "quickjs\n"
            }
          }
        },
        "route_policy": "const f = std.open('/ram/route.txt', 'r'); const name = f !== null ? f.readAsString().trim() : 'ghost'; if (f !== null) f.close(); ctx.commands.some((c) => c.command === 'node') ? name : null"
      },
      "steps": [
        {
          "command": "node -e \"console.log(1)\"",
          "expect": {
            "exit": 0,
            "stdout": "1\n"
          }
        },
        {
          "command": "echo still-open",
          "expect": {
            "exit": 0,
            "stdout": "still-open\n"
          }
        }
      ]
    },
    {
      "id": "js_policy_places_the_line",
      "world": {
        "runtimes": [
          "quickjs",
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        },
        "route_policy": "ctx.commands.some((c) => c.command === 'node') ? 'quickjs' : null"
      },
      "steps": [
        {
          "command": "node -e \"console.log(1)\"",
          "expect": {
            "exit": 0,
            "stdout": "1\n"
          }
        },
        {
          "command": "echo still-open",
          "expect": {
            "exit": 0,
            "stdout": "still-open\n"
          }
        }
      ]
    },
    {
      "id": "js_entry_script",
      "world": {
        "runtimes": [
          {
            "name": "quickjs",
            "script": "!ctx.line.includes('keep-out')"
          },
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "node -e \"console.log('served')\"",
          "expect": {
            "exit": 0,
            "stdout": "served\n"
          }
        },
        {
          "command": "node -e \"console.log('keep-out')\"",
          "expect": {
            "exit": 126,
            "stderr": "node: no runtime accepted this line\n"
          }
        }
      ]
    }
  ]
}
