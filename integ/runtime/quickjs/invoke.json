{
  "requires": {
    "python": [
      "env:MIRAGE_QUICKJS_HOME"
    ],
    "typescript": []
  },
  "cases": [
    {
      "id": "version_names_quickjs_for_both_aliases",
      "world": {
        "machines": {
          "quickjs": {
            "provider": "in_process",
            "runtime": "quickjs"
          }
        },
        "mounts": {
          "/ram": {
            "vfs": "ram",
            "files": {
              "version.js": "console.log(scriptArgs[0])\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "for n in js node; do for f in --version -v; do $n $f 2>&1 | grep -cE '^JavaScript \\((quickjs [0-9]{4}-[0-9]{2}-[0-9]{2}|quickjs-ng [0-9]+\\.[0-9]+\\.[0-9]+)\\)$'; done; done",
          "expect": {
            "exit": 0,
            "stdout": "1\n1\n1\n1\n",
            "stderr": ""
          }
        },
        {
          "command": "node -e \"console.log(scriptArgs[0])\" -- --version",
          "expect": {
            "exit": 0,
            "stdout": "--version\n",
            "stderr": ""
          }
        },
        {
          "command": "js /ram/version.js --version",
          "expect": {
            "exit": 0,
            "stdout": "--version\n",
            "stderr": ""
          }
        },
        {
          "command": "echo 'console.log(scriptArgs[0])' | node - --version",
          "expect": {
            "exit": 0,
            "stdout": "--version\n",
            "stderr": ""
          }
        }
      ]
    },
    {
      "id": "stdin_and_module_mode",
      "world": {
        "machines": {
          "quickjs": {
            "provider": "in_process",
            "runtime": "quickjs"
          }
        },
        "mounts": {
          "/ram": {
            "vfs": "ram",
            "files": {
              "mod.mjs": "const k = await Promise.resolve(5);\nconsole.log(k * 2)\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "echo hello | js -e \"console.log(std.in.readAsString().trim().toUpperCase())\"",
          "expect": {
            "exit": 0,
            "stdout": "HELLO\n",
            "stderr": ""
          }
        },
        {
          "command": "js -m -e \"const x = await Promise.resolve(41); console.log(x + 1)\"",
          "expect": {
            "exit": 0,
            "stdout": "42\n",
            "stderr": ""
          }
        },
        {
          "command": "node /ram/mod.mjs",
          "expect": {
            "exit": 0,
            "stdout": "10\n",
            "stderr": ""
          }
        }
      ]
    },
    {
      "id": "errors_and_the_sandbox",
      "world": {
        "machines": {
          "quickjs": {
            "provider": "in_process",
            "runtime": "quickjs"
          }
        }
      },
      "steps": [
        {
          "command": "js -e \"this is not js\"",
          "expect": {
            "exit": 1,
            "stderr_contains": "SyntaxError"
          }
        },
        {
          "command": "js -e \"console.log(typeof process, typeof require, typeof fetch)\"",
          "expect": {
            "exit": 0,
            "stdout": "object function undefined\n",
            "stderr": ""
          }
        },
        {
          "command": "js -e \"console.error('x')\"",
          "expect": {
            "exit": 0,
            "stdout": "",
            "stderr": "x\n"
          }
        },
        {
          "command": "js",
          "expect": {
            "exit": 1,
            "stderr_contains": "js: no input"
          }
        },
        {
          "command": "js /missing-script",
          "expect": {
            "exit": 1,
            "stdout": "",
            "stderr": "js: /missing-script: No such file\n"
          }
        },
        {
          "command": "node /missing-script",
          "expect": {
            "exit": 1,
            "stdout": "",
            "stderr": "node: /missing-script: No such file\n"
          }
        }
      ]
    },
    {
      "id": "a_classic_script_is_sloppy_in_any_directory",
      "world": {
        "machines": {
          "quickjs": {
            "provider": "in_process",
            "runtime": "quickjs"
          }
        },
        "mounts": {
          "/ram": {
            "vfs": "ram",
            "files": {
              "s.js": "y = 7\nconsole.log(y, typeof this)\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "node -e 'x = 5; var a = 1; console.log(x, globalThis.a, typeof this)'",
          "expect": {
            "exit": 0,
            "stdout": "5 1 object\n",
            "stderr": ""
          }
        },
        {
          "command": "node /ram/s.js",
          "expect": {
            "exit": 0,
            "stdout": "7 object\n",
            "stderr": ""
          }
        },
        {
          "command": "cd /ram && node -e 'x = 5; console.log(x)'",
          "expect": {
            "exit": 0,
            "stdout": "5\n",
            "stderr": ""
          }
        }
      ]
    },
    {
      "id": "a_max_memory_below_its_start_refuses_the_run",
      "note": "QuickJS starts on 4 wasm pages (256 KiB), so a workspace with less left refuses the run rather than lending it more.",
      "world": {
        "machines": {
          "quickjs": {
            "provider": "in_process",
            "runtime": "quickjs"
          }
        },
        "max_memory": "200KB",
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "js -e 'console.log(1)'",
          "expect": {
            "exit": 1,
            "stdout": "",
            "stderr": "js: cannot start within max_memory (204800 bytes): memory minimum size of 4 pages exceeds memory limits\n"
          }
        }
      ]
    }
  ]
}
