{
  "requires": {
    "python": [
      "env:MIRAGE_QUICKJS_HOME"
    ],
    "typescript": []
  },
  "cases": [
    {
      "id": "quickjs_cannot_take_python3",
      "world": {
        "machines": {
          "quickjs": {
            "provider": "in_process",
            "runtime": "quickjs",
            "captures": [
              "node",
              "python3"
            ]
          }
        }
      },
      "build_error": {
        "contains": "machine 'quickjs' does not run 'python3'"
      }
    }
  ]
}
