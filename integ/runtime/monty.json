    {
      "id": "limit_timeout",
      "world": {
        "runtimes": [
          "monty",
          "vfs"
        ],
        "mounts": {
          "/ram": {
            "resource": "ram",
            "files": {
              "slow.py": "n = 0\nfor i in range(300000000):\n    n = n + 1\n"
            },
            "limits": {
