    {
      "id": "nested_rename_exdev",
      "world": {
        "runtimes": [
          "monty",
          "vfs"
        ],
        "mounts": {
          "/data": {
            "resource": "ram",
            "files": {
              "top.txt": "top\n"
            }
          },
          "/data/inner": {
            "resource": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "printf 'from pathlib import Path\\ntry:\\n    Path(\"/data/top.txt\").rename(\"/data/inner/moved.txt\")\\n    print(\"renamed\")\\nexcept OSError as e:\\n    print(\"exdev\" if \"Invalid cross-device link\" in str(e) else e)\\n' > /data/x.py",
          "expect": {
            "exit": 0
          }
        },
        {
          "command": "python3 /data/x.py",
          "expect": {
            "exit": 0,
            "stdout": "exdev\n"
          }
        },
        {
          "command": "cat /data/top.txt",
          "expect": {
            "exit": 0,
            "stdout": "top\n"
          }
        }
      ]
    },
