          "vfs"
        ],
        "mounts": {
          "/ram": {
            "resource": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "printf 'from pathlib import Path\\ntry:\\n    Path(\"/ram/nope.txt\").read_text()\\nexcept FileNotFoundError:\\n    print(\"caught-typed\")\\n' > /ram/t.py",
          "expect": {
            "exit": 0
          }
        },
        {
          "command": "python3 /ram/t.py",
