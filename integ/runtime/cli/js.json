{
  "requires": {
    "python": [
      "env:MIRAGE_QUICKJS_HOME"
    ],
    "typescript": []
  },
  "cases": [
    {
      "id": "js_program_is_named_and_gets_its_flags",
      "world": {
        "machines": {
          "quickjs": {
            "provider": "in_process",
            "runtime": "quickjs"
          }
        },
        "clis": {
          "pager": {
            "script": "console.log('prog', scriptArgs[0]);\nconsole.log('args', JSON.stringify(scriptArgs.slice(1)));\n",
            "language": "js"
          }
        }
      },
      "steps": [
        {
          "command": "pager --width 80 report.txt",
          "expect": {
            "exit": 0,
            "stdout": "prog pager\nargs [\"--width\",\"80\",\"report.txt\"]\n",
            "stderr": ""
          }
        }
      ]
    },
    {
      "id": "js_on_a_worker_exits_127",
      "world": {
        "machines": {
          "monty": {
            "provider": "worker"
          },
          "quickjs": {
            "provider": "in_process",
            "runtime": "quickjs"
          }
        },
        "clis": {
          "pager": {
            "script": "console.log('unreachable');\n",
            "language": "js",
            "machine": "worker"
          }
        }
      },
      "steps": [
        {
          "command": "pager",
          "expect": {
            "exit": 127,
            "stdout": "",
            "stderr_contains": "no worker machine runs js scripts"
          }
        }
      ]
    }
  ]
}
