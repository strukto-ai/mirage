{
  "optional": true,
  "optional_reason": "Requires the Sandlock CLI and Linux Landlock ABI v6. Set MIRAGE_INTEG_SANDLOCK to run the same cases through both SDKs on a supported host.",
  "requires": {
    "python": [
      "env:MIRAGE_INTEG_SANDLOCK"
    ],
    "typescript": [
      "env:MIRAGE_INTEG_SANDLOCK"
    ]
  },
  "cases": [
    {
      "id": "granted_path_is_writable",
      "world": {
        "runtimes": [
          {
            "name": "sandlock",
            "config": {
              "fs_writable": [
                "/tmp"
              ]
            },
            "captures": [
              "python3",
              "node",
              "@external"
            ]
          }
        ]
      },
      "steps": [
        {
          "command": "python3 -c \"open('/tmp/.mirage_sandlock_probe','w').write('ok'); print(open('/tmp/.mirage_sandlock_probe').read())\"",
          "expect": {
            "exit": 0,
            "stdout": "ok\n"
          }
        }
      ]
    },
    {
      "id": "ungranted_write_is_refused",
      "world": {
        "runtimes": [
          {
            "name": "sandlock",
            "config": {
              "fs_writable": [
                "/tmp"
              ]
            },
            "captures": [
              "python3",
              "node",
              "@external"
            ]
          }
        ]
      },
      "steps": [
        {
          "command": "python3 -c \"open('/etc/.mirage_sandlock_probe','w')\"",
          "expect": {
            "exit": 1,
            "stderr_contains": "PermissionError"
          }
        }
      ]
    },
    {
      "id": "mirage_environment_is_not_inherited",
      "world": {
        "runtimes": [
          {
            "name": "sandlock",
            "config": {
              "env": {
                "BOX_MARKER": "from-config"
              }
            },
            "captures": [
              "python3",
              "node",
              "@external"
            ]
          }
        ]
      },
      "steps": [
        {
          "command": "python3 -c \"import os; print(os.environ.get('BOX_MARKER'), os.environ.get('MIRAGE_INTEG_SANDLOCK'))\"",
          "expect": {
            "exit": 0,
            "stdout": "from-config None\n"
          }
        }
      ]
    }
  ]
}
