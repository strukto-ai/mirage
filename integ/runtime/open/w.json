            "stdout": ""
          }
        }
      ]
    },
    {
      "id": "w_handle_stats",
      "runtimes": [
        "monty",
        "wasi",
        "pyodide",
        "quickjs"
      ],
      "backends": [
        "ram",
        "disk",
        "ssh",
        "s3",
        "redis"
      ],
      "world": {
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "seed.txt": "seed\n",
              "sub/inner.txt": "in\n"
            }
          }
        }
      },
      "steps": [
        {
          "program": {
            "python": "import os\nf = open('/data/seed.txt', 'w')\nprint(os.fstat(f.fileno()).st_mtime > 0)"
          },
          "expect": {
            "exit": 0,
            "stdout": "True\n"
          },
          "expect_on": {
            "monty": {
              "exit": 1,
              "stdout": "",
              "stderr_contains": "'_io.TextIOWrapper' object has no attribute 'fileno'"
            }
          }
        }
      ]
    }
  ]
}
