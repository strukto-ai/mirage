{
  "cases": [
    {
      "id": "w_plus_reads_back_what_it_wrote",
      "runtimes": [
        "wasi",
        "pyodide",
        "quickjs",
        "host"
      ],
      "backends": [
        "ram",
        "disk",
        "ssh",
        "s3",
        "redis"
      ],
      "world": {
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "seed.txt": "seed\n"
            }
          }
        }
      },
      "steps": [
        {
          "program": {
            "python": "f = open('/data/seed.txt', 'w+')\nf.write('fresh')\nf.seek(0)\nprint(f.read())\nf.close()",
            "js": "const f = std.open('/data/seed.txt', 'w+')\nf.puts('fresh')\nf.seek(0, 0)\nconsole.log(f.readAsString())\nf.close()"
          },
          "expect": {
            "exit": 0,
            "stdout": "fresh\n",
            "ops_contain": [
              "truncate /data/seed.txt"
            ]
          }
        },
        {
          "command": "cat /data/seed.txt",
          "expect": {
            "exit": 0,
            "stdout": "fresh"
          }
        }
      ]
    },
    {
      "id": "w_plus_keeps_another_handles_later_edit",
      "runtimes": [
        "wasi",
        "pyodide",
        "quickjs",
        "host"
      ],
      "backends": [
        "ram",
        "disk",
        "ssh",
        "s3",
        "redis"
      ],
      "world": {
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "seed.txt": "seed\n"
            }
          }
        }
      },
      "steps": [
        {
          "program": {
            "python": "a = open('/data/seed.txt', 'w+')\nb = open('/data/seed.txt', 'r+')\nb.seek(2)\nb.write('XY')\nb.close()\na.write('ab')\na.close()",
            "js": "const a = std.open('/data/seed.txt', 'w+')\nconst b = std.open('/data/seed.txt', 'r+')\nb.seek(2, 0)\nb.puts('XY')\nb.close()\na.puts('ab')\na.close()"
          },
          "expect": {
            "exit": 0
          }
        },
        {
          "command": "cat /data/seed.txt",
          "expect": {
            "exit": 0,
            "stdout": "abXY"
          }
        }
      ]
    }
  ]
}
