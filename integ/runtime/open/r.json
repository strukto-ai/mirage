{
  "cases": [
    {
      "id": "r_refuses_a_missing_file",
      "runtimes": [
        "monty",
        "wasi",
        "pyodide",
        "quickjs"
      ],
      "backends": [
        "ram",
        "disk",
        "ssh",
        "s3",
        "redis"
      ],
      "world": {
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "seed.txt": "seed\n",
              "sub/inner.txt": "in\n"
            }
          }
        }
      },
      "steps": [
        {
          "program": {
            "python": "try:\n    open('/data/nope.txt', 'r').close()\n    print('opened')\nexcept OSError as e:\n    print(type(e).__name__)",
            "js": "const f = std.open('/data/nope.txt', 'r')\nif (f !== null) f.close()\nconsole.log(f === null ? 'refused' : 'opened')"
          },
          "expect": {
            "exit": 0,
            "stdout": "FileNotFoundError\n",
            "ops_absent": [
              "create /data/nope.txt"
            ]
          },
          "expect_on": {
            "quickjs": {
              "stdout": "refused\n"
            }
          }
        }
      ]
    },
    {
      "id": "r_opens_without_writing",
      "runtimes": [
        "monty",
        "wasi",
        "pyodide",
        "quickjs"
      ],
      "backends": [
        "ram",
        "disk",
        "ssh",
        "s3",
        "redis"
      ],
      "world": {
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "seed.txt": "seed\n",
              "sub/inner.txt": "in\n"
            }
          }
        }
      },
      "steps": [
        {
          "program": {
            "python": "try:\n    open('/data/seed.txt', 'r').close()\n    print('opened')\nexcept OSError as e:\n    print(type(e).__name__)",
            "js": "const f = std.open('/data/seed.txt', 'r')\nif (f !== null) f.close()\nconsole.log(f === null ? 'refused' : 'opened')"
          },
          "expect": {
            "exit": 0,
            "stdout": "opened\n",
            "ops_absent": [
              "create /data/seed.txt",
              "truncate /data/seed.txt",
              "write /data/seed.txt"
            ]
          }
        }
      ]
    },
    {
      "id": "a_missing_file_is_a_typed_error",
      "runtimes": [
        "monty",
        "wasi",
        "pyodide",
        "quickjs"
      ],
      "world": {
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "seed.txt": "seed\n",
              "sub/inner.txt": "in\n"
            }
          }
        }
      },
      "steps": [
        {
          "program": {
            "python": "from pathlib import Path\ntry:\n    Path('/data/nope.txt').read_text()\nexcept FileNotFoundError as e:\n    print('caught', type(e).__name__)\n    print(e.strerror)\n    print(e.filename)"
          },
          "expect": {
            "exit": 0,
            "stdout": "caught FileNotFoundError\nNo such file or directory\n/data/nope.txt\n"
          },
          "expect_on": {
            "monty": {
              "exit": 1,
              "stdout": "caught FileNotFoundError\n",
              "stderr_contains": "'FileNotFoundError' object has no attribute 'strerror'"
            }
          }
        },
        {
          "program": {
            "js": "const err = {}\nconsole.log(std.open('/data/nope.txt', 'r', err), err.errno)"
          },
          "expect": {
            "exit": 0,
            "stdout": "null 44\n"
          }
        }
      ]
    }
  ]
}
