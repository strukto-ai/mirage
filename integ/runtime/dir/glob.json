{
  "cases": [
    {
      "id": "globs_a_mount",
      "runtimes": [
        "monty",
        "wasi",
        "pyodide",
        "quickjs"
      ],
      "backends": [
        "ram",
        "disk",
        "ssh",
        "s3",
        "redis"
      ],
      "filesystem": {
        "monty": {
          "glob": false
        },
        "wasi": {
          "glob": true
        },
        "pyodide": {
          "glob": true
        },
        "quickjs": {
          "glob": false
        }
      },
      "world": {
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "seed.txt": "seed\n",
              "sub/inner.txt": "in\n"
            }
          }
        }
      },
      "steps": [
        {
          "script": {
            "python": "dir/py/glob.py",
            "js": "dir/js/glob.js"
          },
          "expect": {
            "exit": 0,
            "stdout": "seed.txt\nsub/inner.txt\n"
          },
          "expect_on": {
            "monty": {
              "exit": 1,
              "stdout": "",
              "stderr_contains": "No module named 'glob'"
            },
            "quickjs": {
              "stdout": "unsupported\n"
            }
          }
        }
      ]
    },
    {
      "id": "glob_and_walk_reach_the_mount",
      "runtimes": [
        "monty",
        "wasi",
        "pyodide",
        "quickjs"
      ],
      "backends": [
        "ram",
        "disk",
        "ssh",
        "s3",
        "redis"
      ],
      "world": {
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "a.txt": "a\n",
              "sub/b.txt": "b\n",
              "sub/deep/c.txt": "c\n"
            }
          }
        }
      },
      "steps": [
        {
          "program": {
            "python": "import glob\nprint(sorted(glob.glob('/data/**/*.txt', recursive=True)))"
          },
          "expect": {
            "exit": 0,
            "stdout": "['/data/a.txt', '/data/sub/b.txt', '/data/sub/deep/c.txt']\n"
          },
          "expect_on": {
            "monty": {
              "exit": 1,
              "stdout": "",
              "stderr_contains": "No module named 'glob'"
            }
          }
        },
        {
          "program": {
            "python": "from pathlib import Path\nprint(sorted(str(p) for p in Path('/data').rglob('*.txt')))"
          },
          "expect": {
            "exit": 0,
            "stdout": "['/data/a.txt', '/data/sub/b.txt', '/data/sub/deep/c.txt']\n"
          },
          "expect_on": {
            "monty": {
              "exit": 1,
              "stdout": "",
              "stderr_contains": "'PosixPath' object has no attribute 'rglob'"
            }
          }
        },
        {
          "program": {
            "python": "import os\nprint([(r, sorted(d), sorted(f)) for r, d, f in os.walk('/data')])"
          },
          "expect": {
            "exit": 0,
            "stdout": "[('/data', ['sub'], ['a.txt']), ('/data/sub', ['deep'], ['b.txt']), ('/data/sub/deep', [], ['c.txt'])]\n"
          },
          "expect_on": {
            "monty": {
              "exit": 1,
              "stdout": "",
              "stderr_contains": "module 'os' has no attribute 'walk'"
            }
          }
        },
        {
          "program": {
            "python": "import os\nprint(sorted((e.name, e.is_dir()) for e in os.scandir('/data')))"
          },
          "expect": {
            "exit": 0,
            "stdout": "[('a.txt', False), ('sub', True)]\n"
          },
          "expect_on": {
            "monty": {
              "exit": 1,
              "stdout": "",
              "stderr_contains": "module 'os' has no attribute 'scandir'"
            }
          }
        }
      ]
    }
  ]
}
