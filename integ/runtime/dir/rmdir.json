{
  "cases": [
    {
      "id": "rmdir_refuses_a_nonempty_directory",
      "runtimes": [
        "monty",
        "wasi",
        "pyodide",
        "quickjs"
      ],
      "backends": [
        "ram",
        "disk",
        "ssh",
        "s3",
        "redis"
      ],
      "world": {
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "d/a.txt": "xy\n",
              "e/keep.txt": "k\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "mkdir /data/d1",
          "expect": {
            "exit": 0
          }
        },
        {
          "program": {
            "python": "import os\nos.rmdir('/data/d1')",
            "js": "console.log(os.remove('/data/d1'))"
          },
          "expect": {
            "exit": 0
          }
        },
        {
          "program": {
            "python": "from pathlib import Path\ntry:\n    Path('/data/d').rmdir()\nexcept OSError as e:\n    print(type(e).__name__)",
            "js": "console.log(os.remove('/data/d') !== 0)"
          },
          "expect": {
            "exit": 0,
            "stdout": "OSError\n"
          },
          "expect_on": {
            "quickjs": {
              "stdout": "true\n"
            }
          }
        },
        {
          "command": "cat /data/d/a.txt",
          "expect": {
            "exit": 0,
            "stdout": "xy\n"
          }
        },
        {
          "program": {
            "python": "from pathlib import Path\nPath('/data/d/a.txt').unlink()\nPath('/data/d').rmdir()\nprint(Path('/data/d').exists())",
            "js": "console.log(os.remove('/data/d/a.txt'), os.remove('/data/d'), os.stat('/data/d')[1])"
          },
          "expect": {
            "exit": 0,
            "stdout": "False\n"
          },
          "expect_on": {
            "quickjs": {
              "stdout": "0 0 44\n"
            }
          }
        },
        {
          "program": {
            "python": "from pathlib import Path\ntry:\n    Path('/data/gone').rmdir()\nexcept OSError as e:\n    print(type(e).__name__)",
            "js": "console.log(os.remove('/data/gone'))"
          },
          "expect": {
            "exit": 0,
            "stdout": "FileNotFoundError\n"
          },
          "expect_on": {
            "quickjs": {
              "stdout": "-44\n"
            }
          }
        },
        {
          "program": {
            "python": "import os, shutil\nshutil.rmtree('/data/e')\nprint(os.path.exists('/data/e'))"
          },
          "expect": {
            "exit": 0,
            "stdout": "False\n"
          },
          "expect_on": {
            "monty": {
              "exit": 1,
              "stdout": "",
              "stderr_contains": "No module named 'shutil'"
            }
          }
        },
        {
          "command": "ls /data",
          "expect": {
            "exit": 0,
            "stdout": ""
          },
          "expect_on": {
            "monty": {
              "stdout": "e\n"
            },
            "quickjs": {
              "stdout": "e\n"
            }
          }
        }
      ]
    }
  ]
}
