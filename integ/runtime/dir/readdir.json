{
  "cases": [
    {
      "id": "lists_a_mount",
      "runtimes": [
        "monty",
        "wasi",
        "pyodide",
        "quickjs"
      ],
      "backends": [
        "ram",
        "disk",
        "ssh",
        "s3",
        "redis"
      ],
      "filesystem": {
        "monty": {
          "list": true
        },
        "wasi": {
          "list": true
        },
        "pyodide": {
          "list": true
        },
        "quickjs": {
          "list": true
        }
      },
      "world": {
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "seed.txt": "seed\n",
              "sub/inner.txt": "in\n"
            }
          }
        }
      },
      "steps": [
        {
          "script": {
            "python": "dir/py/list.py",
            "js": "dir/js/list.js"
          },
          "expect": {
            "exit": 0,
            "stdout": "seed.txt\nsub\n"
          }
        }
      ]
    },
    {
      "id": "listing_a_missing_directory_is_enoent",
      "runtimes": [
        "monty",
        "wasi",
        "pyodide",
        "quickjs"
      ],
      "world": {
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "seed.txt": "seed\n",
              "sub/inner.txt": "in\n"
            }
          }
        }
      },
      "steps": [
        {
          "program": {
            "python": "import os\ntry:\n    os.listdir('/data/nope')\nexcept OSError as e:\n    print(type(e).__name__)",
            "js": "console.log(JSON.stringify(os.readdir('/data/nope')))"
          },
          "expect": {
            "exit": 0,
            "stdout": "FileNotFoundError\n"
          },
          "expect_on": {
            "quickjs": {
              "stdout": "[[],44]\n"
            }
          }
        }
      ]
    },
    {
      "id": "listing_survives_a_failing_record",
      "runtimes": [
        "monty",
        "wasi",
        "pyodide",
        "quickjs"
      ],
      "world": {
        "mounts": {
          "/api": {
            "vfs": "ram",
            "files": {
              "items/0.json": "{\"id\": 0}\n",
              "items/1.json": "{\"id\": 1}\n",
              "items/2.json": "{\"id\": 2}\n",
              "items/3.json": "{\"id\": 3}\n"
            },
            "failing": [
              "items/2.json"
            ]
          }
        }
      },
      "steps": [
        {
          "program": {
            "python": "import os\nprint(sorted(os.listdir('/api/items')))\nprint(os.stat('/api/items/1.json').st_size)\nfor probe in (os.stat, lambda p: open(p).read()):\n    try:\n        probe('/api/items/2.json')\n        print('served')\n    except OSError as e:\n        print(type(e).__name__, e.strerror)",
            "js": "const [names, err] = os.readdir('/api/items')\nconsole.log(err, names.filter((n) => n.endsWith('.json')).sort().join(','))\nconst [good] = os.stat('/api/items/1.json')\nconst [bad, badErr] = os.stat('/api/items/2.json')\nconsole.log(good.size, bad, badErr === 0 ? 'served' : 'failed', std.open('/api/items/2.json', 'r'))"
          },
          "expect": {
            "exit": 0,
            "stdout": "['0.json', '1.json', '2.json', '3.json']\n10\nOSError I/O error\nOSError I/O error\n"
          },
          "expect_on": {
            "monty": {
              "exit": 1,
              "stdout": "['0.json', '1.json', '2.json', '3.json']\n10\n",
              "stderr_contains": "'OSError' object has no attribute 'strerror'"
            },
            "quickjs": {
              "stdout": "0 0.json,1.json,2.json,3.json\n10 null failed null\n"
            }
          }
        }
      ]
    },
    {
      "id": "lists_nested_mounts",
      "runtimes": [
        "monty",
        "wasi",
        "pyodide",
        "quickjs"
      ],
      "world": {
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "top.txt": "top\n"
            }
          },
          "/data/inner": {
            "vfs": "ram",
            "files": {
              "leaf.txt": "deep\n"
            }
          }
        }
      },
      "steps": [
        {
          "program": {
            "python": "import os\nprint(sorted(os.listdir('/data')))",
            "js": "const [names] = os.readdir('/data')\nconsole.log(JSON.stringify(names.filter((n) => n[0] !== '.').sort()))"
          },
          "expect": {
            "exit": 0,
            "stdout": "['inner', 'top.txt']\n"
          },
          "expect_on": {
            "quickjs": {
              "stdout": "[\"inner\",\"top.txt\"]\n"
            }
          }
        },
        {
          "program": {
            "python": "print(open('/data/inner/leaf.txt').read().strip())",
            "js": "console.log(std.open('/data/inner/leaf.txt', 'r').readAsString().trim())"
          },
          "expect": {
            "exit": 0,
            "stdout": "deep\n"
          }
        },
        {
          "program": {
            "python": "f = open('/data/inner/w.txt', 'w')\nf.write('guest')\nf.close()",
            "js": "const f = std.open('/data/inner/w.txt', 'w')\nf.puts('guest')\nf.close()"
          },
          "expect": {
            "exit": 0
          }
        },
        {
          "command": "cat /data/inner/w.txt",
          "expect": {
            "exit": 0,
            "stdout": "guest"
          }
        },
        {
          "command": "ln -s /data/inner /data/lnk",
          "expect": {
            "exit": 0
          }
        },
        {
          "program": {
            "python": "import os\nprint(sorted(os.listdir('/data')))",
            "js": "const [names] = os.readdir('/data')\nconsole.log(JSON.stringify(names.filter((n) => n[0] !== '.').sort()))"
          },
          "expect": {
            "exit": 0,
            "stdout": "['inner', 'lnk', 'top.txt']\n"
          },
          "expect_on": {
            "quickjs": {
              "stdout": "[\"inner\",\"lnk\",\"top.txt\"]\n"
            }
          }
        },
        {
          "program": {
            "python": "print(open('/data/lnk/leaf.txt').read().strip())",
            "js": "console.log(std.open('/data/lnk/leaf.txt', 'r').readAsString().trim())"
          },
          "expect": {
            "exit": 0,
            "stdout": "deep\n"
          }
        }
      ]
    },
    {
      "id": "a_mount_point_stats_as_a_directory",
      "runtimes": [
        "monty",
        "wasi",
        "pyodide",
        "quickjs"
      ],
      "world": {
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "top.txt": "top\n"
            }
          },
          "/data/inner": {
            "vfs": "ram",
            "files": {
              "leaf.txt": "deep\n"
            }
          }
        }
      },
      "steps": [
        {
          "facade": {
            "method": "is_dir",
            "path": "/data/inner"
          },
          "expect": {
            "value": true
          }
        },
        {
          "program": {
            "python": "from pathlib import Path\nprint(Path('/data/inner').is_dir())",
            "js": "console.log((os.stat('/data/inner')[0].mode & os.S_IFMT) === os.S_IFDIR)"
          },
          "expect": {
            "exit": 0,
            "stdout": "True\n"
          },
          "expect_on": {
            "quickjs": {
              "stdout": "true\n"
            }
          }
        }
      ]
    },
    {
      "id": "structure_is_open_above_mounts_and_links",
      "note": "Pyodide is not on the shared view rule yet: a write under a directory only a nested mount implies (/parent/new.txt) lands in the interpreter's own MEMFS, and a link outside every mount (/alias) is not mounted.",
      "runtimes": [
        "monty",
        "wasi",
        "pyodide",
        "quickjs"
      ],
      "backends": [
        "ram",
        "disk",
        "ssh",
        "s3",
        "redis"
      ],
      "filesystem": {
        "monty": {
          "stat": true
        },
        "wasi": {
          "stat": true
        },
        "pyodide": {
          "stat": true
        },
        "quickjs": {
          "stat": true
        }
      },
      "world": {
        "mounts": {
          "/parent/child": {
            "vfs": "ram",
            "files": {
              "a.txt": "a\n"
            }
          }
        }
      },
      "steps": [
        {
          "program": {
            "python": "from pathlib import Path\np = Path('/parent')\nprint(p.is_dir(), p.exists(), oct(p.stat().st_mode & 0o170000), sorted(c.name for c in p.iterdir()))",
            "js": "const [st, e] = os.stat('/parent')\nconst [names] = os.readdir('/parent')\nconsole.log(e, (st.mode & os.S_IFMT).toString(8), JSON.stringify(names.filter((n) => n[0] !== '.').sort()))"
          },
          "expect": {
            "exit": 0,
            "stdout": "True True 0o40000 ['child']\n"
          },
          "expect_on": {
            "quickjs": {
              "stdout": "0 40000 [\"child\"]\n"
            }
          }
        },
        {
          "program": {
            "python": "try:\n    open('/parent/new.txt', 'w')\n    print('opened')\nexcept OSError as e:\n    print(type(e).__name__)",
            "js": "console.log(std.open('/parent/new.txt', 'w') === null ? 'refused' : 'opened')"
          },
          "expect": {
            "exit": 0,
            "stdout": "FileNotFoundError\n",
            "ops_absent": [
              "create /parent/new.txt"
            ]
          },
          "expect_on": {
            "quickjs": {
              "stdout": "refused\n"
            },
            "pyodide": {
              "stdout": "opened\n"
            }
          }
        },
        {
          "command": "ln -s /parent/child/a.txt /alias",
          "expect": {
            "exit": 0
          }
        },
        {
          "program": {
            "python": "from pathlib import Path\na = Path('/alias')\nprint(a.is_symlink(), sorted(c.name for c in Path('/').iterdir() if c.name in ('alias', 'parent')), a.read_text(), end='')",
            "js": "const [st, e] = os.stat('/alias')\nconst [names] = os.readdir('/')\nconsole.log(e, (st.mode & os.S_IFMT) === os.S_IFREG, JSON.stringify(names.filter((n) => n === 'alias' || n === 'parent').sort()), std.open('/alias', 'r').readAsString())"
          },
          "expect": {
            "exit": 0,
            "stdout": "True ['alias', 'parent'] a\n"
          },
          "expect_on": {
            "quickjs": {
              "stdout": "0 true [\"alias\",\"parent\"] a\n\n"
            },
            "pyodide": {
              "exit": 1,
              "stdout": "",
              "stderr_contains": "FileNotFoundError: [Errno 44] No such file or directory: '/alias'"
            }
          }
        }
      ]
    }
  ]
}
