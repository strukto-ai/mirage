      "note": "mirage-fuse shows a served file as the box user's own, as sshfs does, keeping the workspace's modes.",
      "runtimes": [
        "docker",
        "e2b",
        "microsandbox"
      ],
      "requires": [
        "env:MIRAGE_INTEG_BOX_MOUNTS"
      ],
      "world": {
