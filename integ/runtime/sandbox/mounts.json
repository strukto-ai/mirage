    {
      "id": "mount_type_ssh_shows_mirages_change_to_the_next_command",
      "note": "The box's kernel keeps a served name, its absence and its attributes for a second, so an import's folder checks stay in the box; a command after a change Mirage made waits that out, so it sees the new size, a new file and a removed one at once.",
      "runtimes": ["docker", "e2b", "microsandbox", "kubernetes"],
      "requires": ["env:MIRAGE_INTEG_BOX_MOUNTS"],
      "world": {
        "mounts": {
          "/served": { "vfs": "ram", "files": { "plan.txt": "plan\n" } }
        }
      },
      "entry": { "captures": ["dash"], "config": { "mount_type": "ssh" } },
      "steps": [
        {
          "command": "dash -c 'cat /served/plan.txt; stat -c %s /served/plan.txt'; echo PLAN > /served/plan.txt; dash -c 'cat /served/plan.txt'; echo longer > /served/plan.txt; dash -c 'stat -c %s /served/plan.txt; cat /served/plan.txt'",
          "expect": { "exit": 0, "stdout": "plan\n5\nPLAN\n7\nlonger\n", "stderr": "" }
        },
        {
          "command": "dash -c 'ls /served; test -e /served/new.txt || echo missing'; echo made > /served/new.txt; dash -c 'ls /served; cat /served/new.txt'",
          "expect": { "exit": 0, "stdout": "plan.txt\nmissing\nnew.txt\nplan.txt\nmade\n", "stderr": "" }
        },
        {
          "command": "dash -c 'ls /served; test -e /served/new.txt && echo there'; rm /served/new.txt; dash -c 'ls /served; test -e /served/new.txt || echo gone'",
          "expect": { "exit": 0, "stdout": "new.txt\nplan.txt\nthere\nplan.txt\ngone\n", "stderr": "" }
        }
      ]
    },
    {
      "id": "mount_type_mirage_shows_mirages_change_to_the_next_command",
      "note": "mirage-fuse keeps what a RAM mount answers until Mirage pushes a change; a command after a change waits until the client dropped what it touched, so it sees the new size, a new file and a removed one at once.",
      "runtimes": [
        "docker",
        "e2b",
        "microsandbox",
        "kubernetes"
      ],
      "requires": [
        "env:MIRAGE_INTEG_BOX_MOUNTS"
