          "command": "dash -c 'ls /restart'",
          "expect": {
            "exit": 0,
            "stdout": "plan.txt\n"
          }
        },
        {
          "command": "ls /restart",
          "expect": {
            "exit": 0,
            "stdout": "plan.txt\n"
          }
        }
      ]
    },
