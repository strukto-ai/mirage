{
  "cases": [
    {
      "id": "mount_type_ssh_fails_a_line_whose_write_cannot_land",
      "note": "sshfs lands a file's writes after close(2) told the program they were done, so the line reports the landing that failed.",
      "runtimes": ["docker", "e2b", "microsandbox"],
      "requires": ["env:MIRAGE_INTEG_BOX_MOUNTS"],
      "world": {
        "mounts": {
          "/capped": { "vfs": "ram", "config": { "capacity": 100 } }
        }
      },
      "entry": {
        "captures": ["dash"],
        "config": { "mount_type": "ssh" }
      },
      "steps": [
        {
          "command": "dash -c 'head -c 500 /dev/zero > /capped/big.bin; echo rc=$?'",
          "expect": {
            "exit": 1,
            "stdout": "rc=0\n",
            "stderr_contains": ": /capped/big.bin: Disk quota exceeded\n"
          }
        },
        {
          "command": "dash -c 'head -c 50 /dev/zero > /capped/small.bin; echo rc=$?'",
          "expect": { "exit": 0, "stdout": "rc=0\n", "stderr": "" }
        },
        {
          "command": "wc -c /capped/small.bin",
          "expect": { "exit": 0, "stdout": "50 /capped/small.bin\n" }
        }
      ]
    },
    {
      "id": "mount_type_ssh_leaves_the_box_its_own_tmp",
      "sdk_only": "The case serves /served into the one shared docker box over sshfs; the CLI lanes of both hosts run beside the SDK drivers on that box, so it runs on the SDK pass only, serialized like the rest of sandbox/mounts.",
      "note": "/tmp is the box's own, as / and /dev are, and the workspace shows it as a machine mount: sshfs does not serve over it, a file a program writes there is the file Mirage reads, and a line runs from it.",
      "runtimes": ["docker", "e2b", "microsandbox"],
      "requires": ["env:MIRAGE_INTEG_BOX_MOUNTS"],
      "world": {
        "mounts": {
          "/served": { "vfs": "ram", "files": { "seed.txt": "seed\n" } }
        }
      },
      "entry": {
        "captures": ["dash"],
        "config": { "mount_type": "ssh" }
      },
      "steps": [
        {
          "command": "dash -c 'cat /served/seed.txt'",
          "expect": { "exit": 0, "stdout": "seed\n", "stderr": "" }
        },
        {
          "command": "f=/tmp/mirage-integ-own-tmp.$$.$RANDOM && dash -c 'echo box > \"$1\"' dash $f && cat $f",
          "expect": { "exit": 0, "stdout": "box\n", "stderr": "" }
        },
        {
          "command": "cd /tmp && dash -c 'grep -c \" /tmp fuse.sshfs \" /proc/mounts || true'",
          "expect": { "exit": 0, "stdout": "0\n", "stderr": "" }
        },
        {
          "command": "cd / && rm $f && echo gone",
          "expect": { "exit": 0, "stdout": "gone\n", "stderr": "" }
        }
      ]
    },
    {
      "id": "mount_type_ssh_serves_links_that_leave_their_folder",
      "sdk_only": "The case serves /served into the one shared docker box over sshfs and writes in the box's own /tmp, so it runs on the SDK pass only, serialized like the rest of sandbox/mounts.",
      "note": "sshfs since the fix for CVE-2026-47187 refuses a link whose target is absolute or holds a `..` unless told otherwise; the server is the workspace, so a box's sshfs that knows the option passes every target. An absolute target shows relative to the link's folder, so the box resolves it on its own disk.",
      "runtimes": ["docker", "e2b", "microsandbox"],
      "requires": ["env:MIRAGE_INTEG_BOX_MOUNTS"],
      "world": {
        "mounts": {
          "/served": { "vfs": "ram", "files": { "up.txt": "up\n" } }
        }
      },
      "entry": {
        "captures": ["dash"],
        "config": { "mount_type": "ssh" }
      },
      "steps": [
        {
          "command": "mkdir -p /served/a && ln -s ../up.txt /served/a/up && ln -s /tmp/mirage-integ-link-out.txt /served/a/out && dash -c 'echo box > /tmp/mirage-integ-link-out.txt'",
          "expect": { "exit": 0, "stdout": "", "stderr": "" }
        },
        {
          "command": "dash -c 'readlink /served/a/up /served/a/out; cat /served/a/up /served/a/out'",
          "expect": {
            "exit": 0,
            "stdout": "../up.txt\n../../tmp/mirage-integ-link-out.txt\nup\nbox\n",
            "stderr": ""
          }
        },
        {
          "command": "dash -c 'ln -s ../up.txt /served/a/again' && readlink /served/a/again && cat /served/a/again",
          "expect": { "exit": 0, "stdout": "../up.txt\nup\n", "stderr": "" }
        },
        {
          "command": "rm /tmp/mirage-integ-link-out.txt && echo gone",
          "expect": { "exit": 0, "stdout": "gone\n", "stderr": "" }
        }
      ]
    },
    {
      "id": "mount_type_ssh_shows_served_files_as_the_box_users",
      "sdk_only": "The case serves /served into the one shared docker box over sshfs, so it runs on the SDK pass only, serialized like the rest of sandbox/mounts.",
      "note": "A served file shows as owned by the box's user, as on a disk that user mounted: the host's uid means nothing in the box, and git refuses a repository another user owns. The modes stay the workspace's.",
      "runtimes": ["docker", "e2b", "microsandbox"],
      "requires": ["env:MIRAGE_INTEG_BOX_MOUNTS"],
      "world": {
        "mounts": {
          "/served": { "vfs": "ram", "files": { "seed.txt": "seed\n" } }
        }
      },
      "entry": {
        "captures": ["dash"],
        "config": { "mount_type": "ssh" }
      },
      "steps": [
        {
          "command": "chmod 640 /served/seed.txt && dash -c 'test -O /served/seed.txt && test -G /served/seed.txt && test -O /served && echo mine; stat -c %a /served/seed.txt'",
          "expect": { "exit": 0, "stdout": "mine\n640\n", "stderr": "" }
        }
      ]
    },
    {
      "id": "mount_type_ssh_renames_over_an_existing_name",
      "sdk_only": "The case serves /served into the one shared docker box over sshfs, so it runs on the SDK pass only, serialized like the rest of sandbox/mounts.",
      "note": "sshfs renames over an existing name only through the posix-rename extension; SFTP v3's own rename refuses the target. The server names the extension, so `mv` over a file, git's config writes and every save through a temporary file work in the box.",
      "runtimes": ["docker", "e2b", "microsandbox"],
      "requires": ["env:MIRAGE_INTEG_BOX_MOUNTS"],
      "world": {
        "mounts": { "/served": { "vfs": "ram" } }
      },
      "entry": {
        "captures": ["dash"],
        "config": { "mount_type": "ssh" }
      },
      "steps": [
        {
          "command": "dash -c 'cd /served && echo a > x && echo b > y && mv y x && cat x && ls'",
          "expect": { "exit": 0, "stdout": "b\nx\n", "stderr": "" }
        },
        {
          "command": "cat /served/x",
          "expect": { "exit": 0, "stdout": "b\n" }
        }
      ]
    },
    {
      "id": "mount_type_ssh_leaves_a_file_mount_off_the_box",
      "sdk_only": "The case serves /served into the one shared docker box over sshfs and places VFS.md through the SDK, so it runs on the SDK pass only, serialized like the rest of sandbox/mounts.",
      "note": "sshfs mounts only a directory: a file mounted at a path of its own, such as the workspace's VFS.md, stays in the workspace, and the box sees the directories beside it.",
      "runtimes": ["docker", "e2b", "microsandbox"],
      "requires": ["env:MIRAGE_INTEG_BOX_MOUNTS"],
      "world": {
        "mounts": {
          "/served": { "vfs": "ram", "files": { "seed.txt": "seed\n" } }
        },
        "vfs_md": "/VFS.md"
      },
      "entry": {
        "captures": ["dash"],
        "config": { "mount_type": "ssh" }
      },
      "steps": [
        {
          "command": "dash -c 'cat /served/seed.txt; test -e /VFS.md; echo $?'",
          "expect": { "exit": 0, "stdout": "seed\n1\n", "stderr": "" }
        },
        {
          "command": "test -s /VFS.md && echo placed",
          "expect": { "exit": 0, "stdout": "placed\n" }
        }
      ]
    },
    {
      "id": "mount_type_ssh_serves_the_sessions_view",
      "runtimes": [
        "docker",
        "e2b",
        "microsandbox",
        "kubernetes"
      ],
      "requires": [
        "env:MIRAGE_INTEG_BOX_MOUNTS"
      ],
      "world": {
        "mounts": {
          "/served": {
            "vfs": "ram",
            "files": {
              "plan.txt": "plan\n",
              "secret.txt": "salaries\n"
            }
          },
          "/served/ro": {
            "vfs": "ram",
            "mode": "read"
          }
        }
      },
      "entry": {
        "captures": [
          "dash"
        ],
        "config": {
          "mount_type": "ssh"
        }
      },
      "steps": [
        {
          "profile": {
            "paths": {
              "hide": [
                "/served/secret.txt"
              ]
            }
          }
        },
        {
          "command": "dash -c 'ls /served'",
          "expect": {
            "exit": 0,
            "stdout": "plan.txt\nro\n"
          }
        },
        {
          "command": "dash -c 'cat /served/secret.txt'",
          "expect": {
            "exit": 1,
            "stdout": "",
            "stderr": "cat: /served/secret.txt: No such file or directory\n"
          }
        },
        {
          "command": "dash -c 'ln -s plan.txt /served/link && cat /served/link && readlink /served/link && rm /served/link'",
          "expect": {
            "exit": 0,
            "stdout": "plan\nplan.txt\n",
            "stderr": ""
          }
        },
        {
          "command": "dash -c 'echo made > /served/new.txt'",
          "expect": {
            "exit": 0,
            "stdout": ""
          }
        },
        {
          "command": "cat /served/new.txt",
          "expect": {
            "exit": 0,
            "stdout": "made\n"
          }
        },
        {
          "command": "dash -c 'echo x > /served/ro/f'",
          "expect": {
            "exit": 2,
            "stdout": "",
            "stderr": "dash: 1: cannot create /served/ro/f: Permission denied\n"
          }
        },
        {
          "command": "rm /served/plan.txt",
          "expect": {
            "exit": 0
          }
        },
        {
          "command": "dash -c 'ls /served'",
          "expect": {
            "exit": 0,
            "stdout": "new.txt\nro\n"
          }
        }
      ]
    },
    {
      "id": "mount_type_ssh_shows_mirages_change_to_the_next_command",
      "note": "The box's kernel keeps a served name, its absence and its attributes for a second, so an import's folder checks stay in the box; a command after a change Mirage made waits that out, so it sees the new size, a new file and a removed one at once.",
      "runtimes": ["docker", "e2b", "microsandbox", "kubernetes"],
      "requires": ["env:MIRAGE_INTEG_BOX_MOUNTS"],
      "world": {
        "mounts": {
          "/served": { "vfs": "ram", "files": { "plan.txt": "plan\n" } }
        }
      },
      "entry": { "captures": ["dash"], "config": { "mount_type": "ssh" } },
      "steps": [
        {
          "command": "dash -c 'stat -c %s /served/plan.txt'; echo longer > /served/plan.txt; dash -c 'stat -c %s /served/plan.txt; cat /served/plan.txt'",
          "expect": { "exit": 0, "stdout": "5\n7\nlonger\n", "stderr": "" }
        },
        {
          "command": "dash -c 'test -e /served/new.txt || echo missing'; echo made > /served/new.txt; dash -c 'cat /served/new.txt'",
          "expect": { "exit": 0, "stdout": "missing\nmade\n", "stderr": "" }
        },
        {
          "command": "dash -c 'test -e /served/new.txt && echo there'; rm /served/new.txt; dash -c 'test -e /served/new.txt || echo gone'",
          "expect": { "exit": 0, "stdout": "there\ngone\n", "stderr": "" }
        }
      ]
    },
    {
      "id": "mount_type_both_leaves_the_boxs_own_mounts_and_refuses_rules_on_them",
      "runtimes": [
        "docker",
        "e2b",
        "microsandbox",
        "kubernetes"
      ],
      "requires": [
        "env:MIRAGE_INTEG_BOX_MOUNTS"
      ],
      "world": {
        "mounts": {
          "/boxdata": {
            "vfs": "ram"
          },
          "/hostdata": {
            "vfs": "ram",
            "files": {
              "f.txt": "host\n"
            }
          }
        }
      },
      "entry": {
        "captures": [
          "dash"
        ],
        "config": {
          "mount_type": "both"
        }
      },
      "steps": [
        {
          "profile": {
            "paths": {
              "hide": [
                "/hostdata/secret.txt"
              ]
            }
          }
        },
        {
          "command": "dash -c 'cat /hostdata/f.txt /boxdata/own.txt'",
          "expect": {
            "exit": 0,
            "stdout": "host\nbox\n"
          }
        },
        {
          "profile": {
            "paths": {
              "hide": [
                "/boxdata/secret.txt"
              ]
            }
          }
        },
        {
          "command": "dash -c 'cat /hostdata/f.txt'",
          "expect": {
            "exit": 126,
            "stdout": "",
            "stderr_contains": ": Permission denied\n"
          }
        },
        {
          "profile": {
            "paths": {
              "hide": [
                "/boxdata"
              ]
            }
          }
        },
        {
          "command": "dash -c 'cat /hostdata/f.txt'",
          "expect": {
            "exit": 126,
            "stdout": "",
            "stderr_contains": ": Permission denied\n"
          }
        },
        {
          "profile": {
            "mounts": {
              "/boxdata": "r"
            }
          }
        },
        {
          "command": "dash -c 'cat /hostdata/f.txt'",
          "expect": {
            "exit": 126,
            "stdout": "",
            "stderr_contains": ": Permission denied\n"
          }
        }
      ]
    },
    {
      "id": "mount_type_ssh_runs_no_line_over_a_mount_the_box_lost",
      "runtimes": [
        "docker"
      ],
      "requires": [
        "env:MIRAGE_INTEG_BOX_MOUNTS"
      ],
      "world": {
        "mounts": {
          "/restart": {
            "vfs": "ram",
            "files": {
              "plan.txt": "plan\n"
            }
          }
        }
      },
      "entry": {
        "captures": [
          "dash"
        ],
        "config": {
          "mount_type": "ssh"
        }
      },
      "steps": [
        {
          "command": "dash -c 'cat /restart/plan.txt'",
          "expect": {
            "exit": 0,
            "stdout": "plan\n"
          }
        },
        {
          "command": "dash -c 'mount --move /restart \"$(mktemp -d)\"'",
          "expect": {
            "exit": 0,
            "stdout": ""
          }
        },
        {
          "command": "dash -c 'echo lost > /restart/lost.txt'",
          "expect": {
            "exit": 126,
            "stdout": "",
            "stderr": "docker: /restart is no longer mounted in the machine (did it restart?); the line did not run\n"
          }
        },
        {
          "command": "dash -c 'ls /restart'",
          "expect": {
            "exit": 0,
            "stdout": "plan.txt\n"
          }
        },
        {
          "command": "ls /restart",
          "expect": {
            "exit": 0,
            "stdout": "plan.txt\n"
          }
        }
      ]
    },
    {
      "id": "mount_type_ssh_refuses_a_cwd_the_box_cannot_see",
      "sdk_only": "The case serves /served into the one shared docker box over sshfs; the CLI lanes of both hosts run beside the SDK drivers on that box, so it runs on the SDK pass only, serialized like the rest of sandbox/mounts.",
      "runtimes": [
        "docker"
      ],
      "requires": [
        "env:MIRAGE_INTEG_BOX_MOUNTS"
      ],
      "world": {
        "mounts": {
          "/served": {
            "vfs": "ram"
          }
        }
      },
      "entry": {
        "captures": [
          "@external"
        ],
        "config": {
          "mount_type": "ssh"
        }
      },
      "steps": [
        {
          "command": "mkdir -p /notes",
          "expect": {
            "exit": 0
          }
        },
        {
          "command": "cd /notes && make",
          "expect": {
            "exit": 126,
            "stdout": "",
            "stderr": "docker: the machine cannot see the working directory /notes; cd into a mount first\n"
          }
        },
        {
          "command": "cd /served && dash -c pwd",
          "expect": {
            "exit": 0,
            "stdout": "/served\n"
          }
        }
      ]
    }
  ]
}
