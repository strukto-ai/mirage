{
  "cases": [
    {
      "id": "mount_type_ssh_fails_a_line_whose_write_cannot_land",
      "note": "sshfs lands a file's writes after close(2) told the program they were done, so the line reports the landing that failed.",
      "runtimes": ["docker", "e2b", "microsandbox"],
      "requires": ["env:MIRAGE_INTEG_BOX_MOUNTS"],
      "world": {
        "mounts": {
          "/capped": { "vfs": "ram", "config": { "capacity": 100 } }
        }
      },
      "entry": {
        "captures": ["dash"],
        "config": { "mount_type": "ssh" }
      },
      "steps": [
        {
          "command": "dash -c 'head -c 500 /dev/zero > /capped/big.bin; echo rc=$?'",
          "expect": {
            "exit": 1,
            "stdout": "rc=0\n",
            "stderr_contains": ": /capped/big.bin: Disk quota exceeded\n"
          }
        },
        {
          "command": "dash -c 'head -c 50 /dev/zero > /capped/small.bin; echo rc=$?'",
          "expect": { "exit": 0, "stdout": "rc=0\n", "stderr": "" }
        },
        {
          "command": "wc -c /capped/small.bin",
          "expect": { "exit": 0, "stdout": "50 /capped/small.bin\n" }
        }
      ]
    },
    {
      "id": "mount_type_ssh_leaves_the_box_its_own_tmp",
      "sdk_only": "The case serves /served into the one shared docker box over sshfs; the CLI lanes of both hosts run beside the SDK drivers on that box, so it runs on the SDK pass only, serialized like the rest of sandbox/mounts.",
      "note": "/tmp is the box's own, as / and /dev are: a workspace /tmp is not served over it, a file a program writes there stays on the box, and a line run from the workspace's /tmp exits 126.",
      "runtimes": ["docker", "e2b", "microsandbox"],
      "requires": ["env:MIRAGE_INTEG_BOX_MOUNTS"],
      "world": {
        "mounts": {
          "/served": { "vfs": "ram", "files": { "seed.txt": "seed\n" } },
          "/tmp": { "vfs": "ram", "files": { "note.txt": "workspace\n" } }
        }
      },
      "entry": {
        "captures": ["dash"],
        "config": { "mount_type": "ssh" }
      },
      "steps": [
        {
          "command": "dash -c 'cat /served/seed.txt'",
          "expect": { "exit": 0, "stdout": "seed\n", "stderr": "" }
        },
        {
          "command": "dash -c 'test -e /tmp/note.txt; echo $?'",
          "expect": { "exit": 0, "stdout": "1\n" }
        },
        {
          "command": "dash -c 'echo box > /tmp/mirage-integ-own-tmp.txt'",
          "expect": { "exit": 0, "stdout": "", "stderr": "" }
        },
        {
          "command": "cat /tmp/mirage-integ-own-tmp.txt",
          "expect": { "exit": 1, "stdout": "", "stderr_contains": "No such file or directory" }
        },
        {
          "command": "cd /tmp && dash -c true",
          "expect": {
            "exit": 126,
            "stdout": "",
            "stderr_contains": "cannot see the working directory /tmp; cd into a mount first"
          }
        }
      ]
    },
    {
      "id": "mount_type_ssh_serves_the_sessions_view",
      "runtimes": [
        "docker",
        "e2b",
        "microsandbox",
        "kubernetes"
      ],
      "requires": [
        "env:MIRAGE_INTEG_BOX_MOUNTS"
      ],
      "world": {
        "mounts": {
          "/served": {
            "vfs": "ram",
            "files": {
              "plan.txt": "plan\n",
              "secret.txt": "salaries\n"
            }
          },
          "/served/ro": {
            "vfs": "ram",
            "mode": "read"
          }
        }
      },
      "entry": {
        "captures": [
          "dash"
        ],
        "config": {
          "mount_type": "ssh"
        }
      },
      "steps": [
        {
          "profile": {
            "paths": {
              "hide": [
                "/served/secret.txt"
              ]
            }
          }
        },
        {
          "command": "dash -c 'ls /served'",
          "expect": {
            "exit": 0,
            "stdout": "plan.txt\nro\n"
          }
        },
        {
          "command": "dash -c 'cat /served/secret.txt'",
          "expect": {
            "exit": 1,
            "stdout": "",
            "stderr": "cat: /served/secret.txt: No such file or directory\n"
          }
        },
        {
          "command": "dash -c 'ln -s plan.txt /served/link && cat /served/link && readlink /served/link && rm /served/link'",
          "expect": {
            "exit": 0,
            "stdout": "plan\nplan.txt\n",
            "stderr": ""
          }
        },
        {
          "command": "dash -c 'echo made > /served/new.txt'",
          "expect": {
            "exit": 0,
            "stdout": ""
          }
        },
        {
          "command": "cat /served/new.txt",
          "expect": {
            "exit": 0,
            "stdout": "made\n"
          }
        },
        {
          "command": "dash -c 'echo x > /served/ro/f'",
          "expect": {
            "exit": 2,
            "stdout": "",
            "stderr": "dash: 1: cannot create /served/ro/f: Permission denied\n"
          }
        },
        {
          "command": "rm /served/plan.txt",
          "expect": {
            "exit": 0
          }
        },
        {
          "command": "dash -c 'ls /served'",
          "expect": {
            "exit": 0,
            "stdout": "new.txt\nro\n"
          }
        }
      ]
    },
    {
      "id": "mount_type_both_leaves_the_boxs_own_mounts_and_refuses_rules_on_them",
      "runtimes": [
        "docker",
        "e2b",
        "microsandbox",
        "kubernetes"
      ],
      "requires": [
        "env:MIRAGE_INTEG_BOX_MOUNTS"
      ],
      "world": {
        "mounts": {
          "/boxdata": {
            "vfs": "ram"
          },
          "/hostdata": {
            "vfs": "ram",
            "files": {
              "f.txt": "host\n"
            }
          }
        }
      },
      "entry": {
        "captures": [
          "dash"
        ],
        "config": {
          "mount_type": "both"
        }
      },
      "steps": [
        {
          "profile": {
            "paths": {
              "hide": [
                "/hostdata/secret.txt"
              ]
            }
          }
        },
        {
          "command": "dash -c 'cat /hostdata/f.txt /boxdata/own.txt'",
          "expect": {
            "exit": 0,
            "stdout": "host\nbox\n"
          }
        },
        {
          "profile": {
            "paths": {
              "hide": [
                "/boxdata/secret.txt"
              ]
            }
          }
        },
        {
          "command": "dash -c 'cat /hostdata/f.txt'",
          "expect": {
            "exit": 126,
            "stdout": "",
            "stderr_contains": ": Permission denied\n"
          }
        },
        {
          "profile": {
            "paths": {
              "hide": [
                "/boxdata"
              ]
            }
          }
        },
        {
          "command": "dash -c 'cat /hostdata/f.txt'",
          "expect": {
            "exit": 126,
            "stdout": "",
            "stderr_contains": ": Permission denied\n"
          }
        },
        {
          "profile": {
            "mounts": {
              "/boxdata": "r"
            }
          }
        },
        {
          "command": "dash -c 'cat /hostdata/f.txt'",
          "expect": {
            "exit": 126,
            "stdout": "",
            "stderr_contains": ": Permission denied\n"
          }
        }
      ]
    },
    {
      "id": "mount_type_ssh_runs_no_line_over_a_mount_the_box_lost",
      "runtimes": [
        "docker"
      ],
      "requires": [
        "env:MIRAGE_INTEG_BOX_MOUNTS"
      ],
      "world": {
        "mounts": {
          "/restart": {
            "vfs": "ram",
            "files": {
              "plan.txt": "plan\n"
            }
          }
        }
      },
      "entry": {
        "captures": [
          "dash"
        ],
        "config": {
          "mount_type": "ssh"
        }
      },
      "steps": [
        {
          "command": "dash -c 'cat /restart/plan.txt'",
          "expect": {
            "exit": 0,
            "stdout": "plan\n"
          }
        },
        {
          "command": "dash -c 'mount --move /restart \"$(mktemp -d)\"'",
          "expect": {
            "exit": 0,
            "stdout": ""
          }
        },
        {
          "command": "dash -c 'echo lost > /restart/lost.txt'",
          "expect": {
            "exit": 126,
            "stdout": "",
            "stderr": "docker: /restart is no longer mounted in the machine (did it restart?); the line did not run\n"
          }
        },
        {
          "command": "dash -c 'ls /restart'",
          "expect": {
            "exit": 0,
            "stdout": "plan.txt\n"
          }
        },
        {
          "command": "ls /restart",
          "expect": {
            "exit": 0,
            "stdout": "plan.txt\n"
          }
        }
      ]
    },
    {
      "id": "mount_type_ssh_refuses_a_cwd_the_box_cannot_see",
      "sdk_only": "The case serves /served into the one shared docker box over sshfs; the CLI lanes of both hosts run beside the SDK drivers on that box, so it runs on the SDK pass only, serialized like the rest of sandbox/mounts.",
      "runtimes": [
        "docker"
      ],
      "requires": [
        "env:MIRAGE_INTEG_BOX_MOUNTS"
      ],
      "world": {
        "mounts": {
          "/served": {
            "vfs": "ram"
          }
        }
      },
      "entry": {
        "captures": [
          "@external"
        ],
        "config": {
          "mount_type": "ssh"
        }
      },
      "steps": [
        {
          "command": "mkdir -p /notes",
          "expect": {
            "exit": 0
          }
        },
        {
          "command": "cd /notes && make",
          "expect": {
            "exit": 126,
            "stdout": "",
            "stderr": "docker: the machine cannot see the working directory /notes; cd into a mount first\n"
          }
        },
        {
          "command": "cd /served && dash -c pwd",
          "expect": {
            "exit": 0,
            "stdout": "/served\n"
          }
        }
      ]
    }
  ]
}
