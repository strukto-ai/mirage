      ],
      "requires": [
        "env:MIRAGE_INTEG_BOX_MOUNTS"
      ],
      "world": {
        "mounts": {
          "/served": {
            "vfs": "ram",
            "files": {
              "plan.txt": "plan\n",
              "secret.txt": "salaries\n"
            }
          },
          "/served/ro": {
            "vfs": "ram",
            "mode": "read"
          }
        }
      },
      "entry": {
        "captures": [
          "dash"
        ],
        "config": {
          "mount_type": "ssh"
