              "seed.txt": "seed\n"
            }
          }
        }
      },
      "entry": {
        "captures": [
          "dash"
        ],
        "config": {
          "mount_type": "mirage"
        }
      },
      "steps": [
        {
          "command": "chmod 640 /served/seed.txt && dash -c 'test -O /served/seed.txt && test -G /served/seed.txt && test -O /served && echo mine; stat -c %a /served/seed.txt'",
          "expect": {
            "exit": 0,
            "stdout": "mine\n640\n",
            "stderr": ""
          }
        }
      ]
    },
    {
      "id": "mount_type_ssh_renames_over_an_existing_name",
      "sdk_only": "The case serves /served into the one shared docker box over sshfs, so it runs on the SDK pass only, serialized like the rest of sandbox/mounts.",
      "note": "sshfs renames over an existing name only through the posix-rename extension; SFTP v3's own rename refuses the target. The server names the extension, so `mv` over a file, git's config writes and every save through a temporary file work in the box.",
      "runtimes": ["docker", "e2b", "microsandbox"],
      "requires": ["env:MIRAGE_INTEG_BOX_MOUNTS"],
      "world": {
        "mounts": { "/served": { "vfs": "ram" } }
      },
      "entry": {
        "captures": ["dash"],
        "config": { "mount_type": "ssh" }
      },
      "steps": [
        {
          "command": "dash -c 'cd /served && echo a > x && echo b > y && mv y x && cat x && ls'",
          "expect": { "exit": 0, "stdout": "b\nx\n", "stderr": "" }
        },
        {
          "command": "cat /served/x",
          "expect": { "exit": 0, "stdout": "b\n" }
        }
      ]
    },
    {
      "id": "mount_type_mirage_renames_over_an_existing_name",
      "sdk_only": "The case serves /served into the one shared docker box through mirage-fuse, so it runs on the SDK pass only, serialized like the rest of sandbox/mounts.",
      "note": "mirage-fuse renames over an existing name, refusing it only when the program asks for RENAME_NOREPLACE.",
      "runtimes": [
        "docker",
