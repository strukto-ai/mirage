              "plan.txt": "plan\n"
            }
          }
        }
      },
      "entry": {
        "captures": [
          "dash"
        ],
        "config": {
          "mount_type": "mirage"
        }
      },
      "steps": [
        {
          "command": "dash -c 'cat /served/plan.txt; stat -c %s /served/plan.txt'; echo PLAN > /served/plan.txt; dash -c 'cat /served/plan.txt'; echo longer > /served/plan.txt; dash -c 'stat -c %s /served/plan.txt; cat /served/plan.txt'",
          "expect": {
            "exit": 0,
            "stdout": "plan\n5\nPLAN\n7\nlonger\n",
            "stderr": ""
          }
        },
        {
          "command": "dash -c 'ls /served; test -e /served/new.txt || echo missing'; echo made > /served/new.txt; dash -c 'ls /served; cat /served/new.txt'",
          "expect": {
            "exit": 0,
            "stdout": "plan.txt\nmissing\nnew.txt\nplan.txt\nmade\n",
            "stderr": ""
          }
        },
        {
          "command": "dash -c 'ls /served; test -e /served/new.txt && echo there'; rm /served/new.txt; dash -c 'ls /served; test -e /served/new.txt || echo gone'",
          "expect": {
            "exit": 0,
            "stdout": "new.txt\nplan.txt\nthere\nplan.txt\ngone\n",
            "stderr": ""
          }
        }
      ]
    },
    {
      "id": "mount_type_both_leaves_the_boxs_own_mounts_and_refuses_rules_on_them",
      "runtimes": [
        "docker",
        "e2b",
        "microsandbox",
        "kubernetes"
      ],
      "requires": [
        "env:MIRAGE_INTEG_BOX_MOUNTS"
      ],
      "world": {
        "mounts": {
          "/boxdata": {
            "vfs": "ram"
          },
          "/hostdata": {
            "vfs": "ram",
            "files": {
              "f.txt": "host\n"
            }
          }
        }
      },
      "entry": {
        "captures": [
          "dash"
        ],
        "config": {
          "mount_type": "both"
        }
      },
      "steps": [
        {
          "profile": {
            "paths": {
              "hide": [
                "/hostdata/secret.txt"
              ]
            }
          }
        },
        {
          "command": "dash -c 'cat /hostdata/f.txt /boxdata/own.txt'",
          "expect": {
            "exit": 0,
            "stdout": "host\nbox\n"
          }
        },
        {
          "profile": {
            "paths": {
              "hide": [
                "/boxdata/secret.txt"
              ]
            }
          }
        },
        {
          "command": "dash -c 'cat /hostdata/f.txt'",
          "expect": {
            "exit": 126,
            "stdout": "",
            "stderr_contains": ": Permission denied\n"
          }
        },
        {
          "profile": {
            "paths": {
              "hide": [
                "/boxdata"
              ]
            }
          }
        },
        {
          "command": "dash -c 'cat /hostdata/f.txt'",
          "expect": {
            "exit": 126,
            "stdout": "",
            "stderr_contains": ": Permission denied\n"
          }
        },
        {
          "profile": {
            "mounts": {
              "/boxdata": "r"
            }
          }
        },
        {
          "command": "dash -c 'cat /hostdata/f.txt'",
          "expect": {
            "exit": 126,
            "stdout": "",
            "stderr_contains": ": Permission denied\n"
          }
        }
      ]
    },
    {
      "id": "mount_type_ssh_runs_no_line_over_a_mount_the_box_lost",
      "runtimes": [
        "docker"
      ],
