{
  "cases": [
    {
      "id": "captured_only",
      "runtimes": [
        "docker",
        "ssh",
        "e2b",
        "smolvm",
        "microsandbox",
        "apple_container",
        "kubernetes"
      ],
      "entry": {
        "captures": [
          "uname"
        ]
      },
      "steps": [
        {
          "command": "uname",
          "expect": {
            "exit": 0,
            "stdout": "Linux\n"
          }
        },
        {
          "command": "echo local-vfs",
          "expect": {
            "exit": 0,
            "stdout": "local-vfs\n"
          }
        }
      ]
    },
    {
      "id": "jobs_and_processes_span_two_machines",
      "runtimes": [
        "docker"
      ],
      "also_machines": [
        "second"
      ],
      "also_entries": [
        {
          "machine": "second",
          "captures": [
            "dash"
          ]
        }
      ],
      "entry": {
        "captures": [
          "dash"
        ]
      },
      "steps": [
        {
          "command": "dash -c 'exec sleep 30' &",
          "expect": {
            "exit": 0
          }
        },
        {
          "command": "dash -c 'exec sleep 31' &",
          "machine": "second",
          "expect": {
            "exit": 0
          }
        },
        {
          "command": "sleep 1; jobs; ps -o machine | sort -u",
          "expect": {
            "exit": 0,
            "stdout": "[1]-  Running                 dash -c 'exec sleep 30' &\n[2]+  Running                 dash -c 'exec sleep 31' &\nMACHINE\ndocker:docker\ndocker:second\nmirage\n"
          }
        },
        {
          "command": "kill %1; wait %1; echo rc=$?; jobs; ps -o machine | sort -u",
          "expect": {
            "exit": 0,
            "stdout": "rc=143\n[2]+  Running                 dash -c 'exec sleep 31' &\nMACHINE\ndocker:second\nmirage\n"
          }
        },
        {
          "command": "kill %2; wait %2; echo rc=$?; jobs; ps -o machine | sort -u",
          "expect": {
            "exit": 0,
            "stdout": "rc=143\nMACHINE\nmirage\n"
          }
        }
      ]
    },
    {
      "id": "each_machine_takes_a_remote_entry_of_its_own",
      "runtimes": [
        "docker"
      ],
      "also_machines": [
        "second"
      ],
      "also_entries": [
        {
          "machine": "second",
          "captures": [
            "perl"
          ]
        }
      ],
      "entry": {
        "captures": [
          "dash"
        ]
      },
      "steps": [
        {
          "command": "dash -c 'echo one' | perl -pe 's/one/two/'",
          "expect": {
            "exit": 0,
            "stdout": "two\n"
          }
        },
        {
          "command": "perl -e 'open my $f, \"<\", $ARGV[0] or die \"open: $!\"; print <$f>' <(dash -c 'echo across')",
          "expect": {
            "exit": 0,
            "stdout": "across\n"
          }
        },
        {
          "command": "( true; perl -e 'sleep 2' ) & sleep 0.5; ps -o ppid=,comm= | awk -v s=$$ '$2 == \"perl\" { print ($1 == s ? \"shell\" : \"other\") }'; wait",
          "expect": {
            "exit": 0,
            "stdout": "shell\n"
          }
        },
        {
          "command": "dash -c 'exec sleep 30' & perl -e 'sleep 31' & sleep 1; ps -o machine | sort -u",
          "expect": {
            "exit": 0,
            "stdout": "MACHINE\ndocker:docker\ndocker:second\nmirage\n"
          }
        },
        {
          "command": "kill %1 %2; wait; ps -o machine | sort -u",
          "expect": {
            "exit": 0,
            "stdout": "MACHINE\nmirage\n"
          }
        }
      ]
    },
    {
      "id": "a_signal_reaches_the_program_as_sent",
      "runtimes": [
        "docker",
        "microsandbox",
        "kubernetes"
      ],
      "entry": {
        "captures": [
          "dash"
        ]
      },
      "steps": [
        {
          "command": "t=/tmp/ready.$RANDOM$RANDOM; dash -c 'trap \"echo usr1\" USR1; : > \"$1\"; while :; do sleep 0.2; done' dash \"$t\" & p=$!; until dash -c 'test -e \"$1\"' dash \"$t\"; do sleep 0.1; done; kill -USR1 $p; sleep 1; kill -0 $p && echo alive; [ \"$p\" -lt 4194305 ] && echo mpid; kill \"$p\"; wait $p 2>/dev/null; echo rc=$?",
          "expect": {
            "exit": 0,
            "stdout": "usr1\nalive\nmpid\nrc=143\n"
          }
        }
      ]
    }
  ]
}
