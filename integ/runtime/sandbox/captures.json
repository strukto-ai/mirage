{
  "cases": [
    {
      "id": "captured_only",
      "runtimes": [
        "docker",
        "ssh",
        "e2b",
        "smolvm",
        "microsandbox",
        "apple_container",
        "kubernetes"
      ],
      "entry": {
        "captures": [
          "uname"
        ]
      },
      "steps": [
        {
          "command": "uname",
          "expect": {
            "exit": 0,
            "stdout": "Linux\n"
          }
        },
        {
          "command": "echo local-vfs",
          "expect": {
            "exit": 0,
            "stdout": "local-vfs\n"
          }
        }
      ]
    },
    {
      "id": "jobs_and_processes_span_two_machines",
      "runtimes": [
        "docker"
      ],
      "also_machines": [
        "second"
      ],
      "also_entries": [
        {
          "machine": "second",
          "captures": [
            "dash"
          ]
        }
      ],
      "entry": {
        "captures": [
          "dash"
        ]
      },
      "steps": [
        {
          "command": "dash -c 'exec sleep 30' &",
          "expect": {
            "exit": 0
          }
        },
        {
          "command": "dash -c 'exec sleep 31' &",
          "machine": "second",
          "expect": {
            "exit": 0
          }
        },
        {
          "command": "sleep 1; jobs; ps -o machine | sort -u",
          "expect": {
            "exit": 0,
            "stdout": "[1]-  Running                 dash -c 'exec sleep 30' &\n[2]+  Running                 dash -c 'exec sleep 31' &\nMACHINE\ndocker:docker\ndocker:second\nmirage\n"
          }
        },
        {
          "command": "kill %1; wait %1; echo rc=$?; jobs; ps -o machine | sort -u",
          "expect": {
            "exit": 0,
            "stdout": "rc=143\n[2]+  Running                 dash -c 'exec sleep 31' &\nMACHINE\ndocker:second\nmirage\n"
          }
        },
        {
          "command": "kill %2; wait %2; echo rc=$?; jobs; ps -o machine | sort -u",
          "expect": {
            "exit": 0,
            "stdout": "rc=143\nMACHINE\nmirage\n"
          }
        }
      ]
    },
    {
      "id": "a_pid_two_machines_share_names_a_machine",
      "note": "Two containers can each run a program under the same pid. The second machine's container sets its next pid to the first one's, retrying while other drivers' runs fork there too (a lock directory keeps their tries apart), so kill refuses the bare pid as bash refuses an ambiguous job spec, and -m names the machine.",
      "runtimes": [
        "docker"
      ],
      "requires": [
        "env:MIRAGE_INTEG_DOCKER_SECOND_CONTAINER"
      ],
      "also_machines": [
        "second"
      ],
      "also_entries": [
        {
          "machine": "second",
          "captures": [
            "dash"
          ],
          "config": {
            "container": "${MIRAGE_INTEG_DOCKER_SECOND_CONTAINER}"
          }
        }
      ],
      "entry": {
        "captures": [
          "dash"
        ]
      },
      "steps": [
        {
          "command": "dash -c 'exec sleep 30' & p=$!",
          "expect": {
            "exit": 0
          }
        },
        {
          "command": "dash -c 'i=0; until mkdir /tmp/pid.lock 2>/dev/null; do i=$((i + 1)); [ $i -lt 600 ] || exit 1; sleep 0.1; done'; x=$((p - 1)); n=0; q=; until [ \"$q\" = \"$p\" ] || [ $n -ge 30 ]; do dash -c 'echo \"$1\" > /proc/sys/kernel/ns_last_pid' dash \"$x\"; dash -c 'exec sleep 31' & q=$!; if [ \"$q\" != \"$p\" ]; then kill \"$q\"; wait \"$q\" 2>/dev/null; x=$((x - q + p)); fi; n=$((n + 1)); done; dash -c 'rmdir /tmp/pid.lock'; [ \"$q\" = \"$p\" ] && echo same",
          "machine": "second",
          "expect": {
            "exit": 0,
            "stdout": "same\n"
          }
        },
        {
          "command": "kill $p; echo rc=$?",
          "expect": {
            "exit": 0,
            "stdout": "rc=1\n",
            "stderr_contains": ": ambiguous job spec\n"
          }
        },
        {
          "command": "kill -m second $p; wait -m second $p; echo rc=$?; ps -o machine | sort -u",
          "expect": {
            "exit": 0,
            "stdout": "rc=143\nMACHINE\ndocker:docker\nmirage\n"
          }
        },
        {
          "command": "kill $p; wait $p; echo rc=$?; ps -o machine | sort -u",
          "expect": {
            "exit": 0,
            "stdout": "rc=143\nMACHINE\nmirage\n"
          }
        }
      ]
    },
    {
      "id": "each_machine_takes_a_remote_entry_of_its_own",
      "runtimes": [
        "docker"
      ],
      "also_machines": [
        "second"
      ],
      "also_entries": [
        {
          "machine": "second",
          "captures": [
            "perl"
          ]
        }
      ],
      "entry": {
        "captures": [
          "dash"
        ]
      },
      "steps": [
        {
          "command": "dash -c 'echo one' | perl -pe 's/one/two/'",
          "expect": {
            "exit": 0,
            "stdout": "two\n"
          }
        },
        {
          "command": "perl -e 'open my $f, \"<\", $ARGV[0] or die \"open: $!\"; print <$f>' <(dash -c 'echo across')",
          "expect": {
            "exit": 0,
            "stdout": "across\n"
          }
        },
        {
          "command": "dash -c 'ls -A /tmp | grep \"^[.]mirage\"; echo clean'",
          "expect": {
            "exit": 0,
            "stdout": "clean\n"
          }
        },
        {
          "command": "( true; perl -e 'sleep 2' ) & sleep 0.5; ps -o ppid=,comm= | awk -v s=$$ '$2 == \"perl\" { print ($1 == s ? \"shell\" : \"other\") }'; wait",
          "expect": {
            "exit": 0,
            "stdout": "shell\n"
          }
        },
        {
          "command": "dash -c 'exec sleep 30' & perl -e 'sleep 31' & sleep 1; ps -o machine | sort -u",
          "expect": {
            "exit": 0,
            "stdout": "MACHINE\ndocker:docker\ndocker:second\nmirage\n"
          }
        },
        {
          "command": "kill %1 %2; wait; ps -o machine | sort -u",
          "expect": {
            "exit": 0,
            "stdout": "MACHINE\nmirage\n"
          }
        }
      ]
    },
    {
      "id": "a_signal_reaches_the_program_as_sent",
      "runtimes": [
        "docker",
        "microsandbox",
        "kubernetes"
      ],
      "entry": {
        "captures": [
          "dash"
        ]
      },
      "steps": [
        {
          "command": "t=/tmp/ready.$RANDOM$RANDOM; dash -c 'trap \"echo usr1\" USR1; : > \"$1\"; while :; do sleep 0.2; done' dash \"$t\" & p=$!; until dash -c 'test -e \"$1\"' dash \"$t\"; do sleep 0.1; done; kill -USR1 $p; sleep 1; kill -0 $p && echo alive; [ \"$p\" -lt 4194305 ] && echo mpid; kill \"$p\"; wait $p 2>/dev/null; echo rc=$?",
          "expect": {
            "exit": 0,
            "stdout": "usr1\nalive\nmpid\nrc=143\n"
          }
        }
      ]
    },
    {
      "id": "a_program_the_machine_lacks_is_reported_in_bash_s_words",
      "note": "A captured program the machine cannot run is reported as bash reports it, not in the words of the machine's sh, which runs it: the shell's voice and `command not found` (127), the line it stands on, a file PATH holds that cannot run named by its path with `Permission denied` (126), and under `timeout` GNU timeout's own words. The wrapper that reports it leaves the program's environment as it was. Each run makes its own folder, as the Python and TypeScript drivers share one container; its name holds no character a sed pattern reads specially, so the check matches the real path.",
      "runtimes": [
        "docker",
        "ssh",
        "e2b",
        "smolvm",
        "microsandbox",
        "apple_container",
        "kubernetes"
      ],
      "entry": {
        "captures": [
          "@external"
        ]
      },
      "steps": [
        {
          "command": "mirage-no-such-program a b",
          "expect": {
            "exit": 127,
            "stdout": "",
            "stderr": "bash: line 1: mirage-no-such-program: command not found\n"
          }
        },
        {
          "command": "echo a\nmirage-no-such-program",
          "expect": {
            "exit": 127,
            "stdout": "a\n",
            "stderr": "bash: line 2: mirage-no-such-program: command not found\n"
          }
        },
        {
          "command": "timeout 5 mirage-no-such-program",
          "expect": {
            "exit": 127,
            "stdout": "",
            "stderr": "timeout: failed to run command 'mirage-no-such-program': No such file or directory\n"
          }
        },
        {
          "command": "p=keep-p w=keep-w dash -c 'echo \"$p $w\"'",
          "expect": {
            "exit": 0,
            "stdout": "keep-p keep-w\n",
            "stderr": ""
          }
        },
        {
          "command": "d=$(dash -c 'mktemp -d /tmp/mirage-np-XXXXXX') && dash -c 'printf \"echo x\\\\n\" > \"$1/mirage-np-prog\"' dash \"$d\" && echo made",
          "expect": {
            "exit": 0,
            "stdout": "made\n",
            "stderr": ""
          }
        },
        {
          "command": "{ PATH=$d:$PATH mirage-np-prog; echo \"status=$?\"; } 2>&1 | sed \"s|$d|DIR|\"",
          "expect": {
            "exit": 0,
            "stdout": "bash: line 1: DIR/mirage-np-prog: Permission denied\nstatus=126\n",
            "stderr": ""
          }
        },
        {
          "command": "PATH=$d:$PATH timeout 5 mirage-np-prog",
          "expect": {
            "exit": 126,
            "stdout": "",
            "stderr": "timeout: failed to run command 'mirage-np-prog': Permission denied\n"
          }
        },
        {
          "command": "dash -c 'printf \"#!/bin/sh\\\\necho ran\\\\n\" > \"$1/mirage-ep-prog\" && chmod +x \"$1/mirage-ep-prog\"' dash \"$d\"",
          "expect": {
            "exit": 0,
            "stdout": "",
            "stderr": ""
          }
        },
        {
          "command": "cd $d && PATH=/nowhere: mirage-ep-prog",
          "expect": {
            "exit": 0,
            "stdout": "ran\n",
            "stderr": ""
          }
        },
        {
          "command": "dash -c 'rm -r \"$1\"' dash \"$d\"",
          "expect": {
            "exit": 0,
            "stdout": "",
            "stderr": ""
          }
        }
      ]
    }
  ]
}
