{
  "cases": [
    {
      "id": "line_timeout",
      "runtimes": [
        "docker",
        "ssh",
        "e2b",
        "smolvm",
        "microsandbox",
        "apple_container"
      ],
      "world": {
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        },
        "command_limits": {
          "@line": {
            "timeout_seconds": 1
          }
        }
      },
      "steps": [
        {
          "command": "sleep 5",
          "expect": {
            "exit": 124
          }
        }
      ]
    }
  ]
}
