{
  "cases": [
    {
      "id": "config_env",
      "runtimes": [
        "apple_container",
        "docker",
        "e2b",
        "microsandbox",
        "smolvm",
        "ssh"
      ],
      "steps": [
        {
          "command": "echo \"$BOX_MARKER\"",
          "expect": {
            "exit": 0,
            "stdout": "from-config\n"
          }
        }
      ],
      "entry": {
        "config": {
          "env": {
            "BOX_MARKER": "from-config"
          }
        }
      }
    }
  ]
}
