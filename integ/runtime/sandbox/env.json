{
  "cases": [
    {
      "id": "config_env",
      "runtimes": [
        "docker",
        "ssh",
        "e2b",
        "smolvm",
        "microsandbox",
        "apple_container"
      ],
      "steps": [
        {
          "command": "echo \"$BOX_MARKER\"",
          "expect": {
            "exit": 0,
            "stdout": "from-config\n"
          }
        }
      ],
      "entry": {
        "config": {
          "env": {
            "BOX_MARKER": "from-config"
          }
        }
      }
    },
    {
      "id": "a_path_without_sh_still_runs_the_line",
      "runtimes": [
        "docker",
        "ssh",
        "e2b",
        "smolvm",
        "microsandbox",
        "apple_container"
      ],
      "steps": [
        {
          "command": "/bin/echo ok",
          "expect": {
            "exit": 0,
            "stdout": "ok\n"
          }
        }
      ],
      "entry": {
        "config": {
          "env": {
            "PATH": "/nowhere"
          }
        }
      }
    }
  ]
}
