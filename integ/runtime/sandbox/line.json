{
  "cases": [
    {
      "id": "echo",
      "runtimes": [
        "docker",
        "ssh",
        "e2b",
        "smolvm",
        "microsandbox",
        "apple_container"
      ],
      "steps": [
        {
          "command": "echo hi-from-box",
          "expect": {
            "exit": 0,
            "stdout": "hi-from-box\n"
          }
        }
      ]
    },
    {
      "id": "exit_code",
      "runtimes": [
        "docker",
        "ssh",
        "e2b",
        "smolvm",
        "microsandbox",
        "apple_container"
      ],
      "steps": [
        {
          "command": "sh -c 'exit 7'",
          "expect": {
            "exit": 7
          }
        }
      ]
    },
    {
      "id": "an_unserved_cwd_exits_126",
      "runtimes": [
        "docker",
        "ssh",
        "e2b",
        "smolvm",
        "microsandbox",
        "apple_container"
      ],
      "entry": {
        "captures": [
          "dash"
        ]
      },
      "world": {
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "cd /ram",
          "expect": {
            "exit": 0
          }
        },
        {
          "command": "dash -c pwd",
          "expect": {
            "exit": 126,
            "stdout": ""
          }
        }
      ]
    },
    {
      "id": "a_rule_reads_the_path_where_the_lines_cd_leaves_it",
      "runtimes": [
        "docker",
        "ssh",
        "e2b",
        "smolvm",
        "microsandbox",
        "apple_container"
      ],
      "world": {
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "secret.txt": "s\n"
            }
          }
        }
      },
      "steps": [
        {
          "profile": {
            "commands": {
              "deny": [
                {
                  "reason": "sealed",
                  "paths": [
                    "/data/secret.txt"
                  ]
                }
              ]
            }
          }
        },
        {
          "command": "cd /data && cat secret.txt",
          "expect": {
            "exit": 1,
            "stdout": "",
            "stderr": "cat: secret.txt: Permission denied\n"
          }
        },
        {
          "command": "grep -r x /data",
          "expect": {
            "exit": 126,
            "stdout": "",
            "stderr": "grep: Permission denied\n"
          }
        }
      ]
    },
    {
      "id": "quoting",
      "runtimes": [
        "ssh",
        "e2b"
      ],
      "steps": [
        {
          "command": "printf '%s\\n' \"it's\" 'two  spaces'",
          "expect": {
            "exit": 0,
            "stdout": "it's\ntwo  spaces\n"
          }
        }
      ]
    }
  ]
}
