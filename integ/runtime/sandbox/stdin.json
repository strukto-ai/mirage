{
  "cases": [
    {
      "id": "stdin",
      "runtimes": [
        "apple_container",
        "docker",
        "e2b",
        "microsandbox",
        "smolvm",
        "ssh"
      ],
      "steps": [
        {
          "command": "wc -l",
          "stdin": "a\nb\nc\n",
          "expect": {
            "exit": 0,
            "stdout": "3\n"
          }
        }
      ]
    },
    {
      "id": "stdin_absent_eof",
      "runtimes": [
        "e2b",
        "ssh"
      ],
      "steps": [
        {
          "command": "timeout 5 wc -c",
          "expect": {
            "exit": 0,
            "stdout": "0\n"
          }
        }
      ]
    },
    {
      "id": "stdin_empty_eof",
      "runtimes": [
        "e2b",
        "ssh"
      ],
      "steps": [
        {
          "command": "timeout 5 wc -c",
          "expect": {
            "exit": 0,
            "stdout": "0\n"
          },
          "stdin": ""
        }
      ]
    }
  ]
}
