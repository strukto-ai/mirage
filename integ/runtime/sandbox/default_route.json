{
  "cases": [
    {
      "id": "a_line_needing_the_box_files_runs_there_whole",
      "runtimes": [
        "docker",
        "e2b",
        "microsandbox"
      ],
      "requires": [
        "env:MIRAGE_INTEG_BOX_MOUNTS"
      ],
      "sdk_only": "Every case mounts /route into the one shared docker box over sshfs; the CLI lane runs beside the SDK drivers on that box, so these run on the SDK pass only, serialized like sandbox/mounts.",
      "world": {
        "mounts": {
          "/route": {
            "vfs": "ram",
            "files": {
              "a.txt": "hello\n"
            }
          }
        }
      },
      "entry": {
        "captures": [
          "@external"
        ],
        "config": {
          "mount_type": "ssh"
        }
      },
      "steps": [
        {
          "command": "cd /route",
          "expect": {
            "exit": 0
          }
        },
        {
          "command": "cd /etc && test -e os-release && echo box; nproc >/dev/null",
          "expect": {
            "exit": 0,
            "stdout": "box\n"
          }
        },
        {
          "command": "pwd",
          "expect": {
            "exit": 0,
            "stdout": "/route\n"
          }
        }
      ]
    },
    {
      "id": "a_whole_line_runs_in_bash",
      "runtimes": [
        "docker",
        "e2b",
        "microsandbox"
      ],
      "requires": [
        "env:MIRAGE_INTEG_BOX_MOUNTS"
      ],
      "sdk_only": "Every case mounts /route into the one shared docker box over sshfs; the CLI lane runs beside the SDK drivers on that box, so these run on the SDK pass only, serialized like sandbox/mounts.",
      "world": {
        "mounts": {
          "/route": {
            "vfs": "ram",
            "files": {
              "a.txt": "hello\n"
            }
          }
        }
      },
      "entry": {
        "captures": [
          "@external"
        ],
        "config": {
          "mount_type": "ssh"
        }
      },
      "steps": [
        {
          "command": "cd /etc && [[ -e os-release ]] && echo bash; nproc >/dev/null",
          "expect": {
            "exit": 0,
