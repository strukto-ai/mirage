{
  "cases": [
    {
      "id": "a_workspace_line_splits_and_python3_runs_in_the_box",
      "runtimes": [
        "docker",
        "e2b",
        "microsandbox"
      ],
      "requires": [
        "env:MIRAGE_INTEG_BOX_MOUNTS"
      ],
      "sdk_only": "Every case mounts /route into the one shared docker box over sshfs; the CLI lane runs beside the SDK drivers on that box, so these run on the SDK pass only, serialized like sandbox/mounts.",
      "world": {
        "mounts": {
          "/route": {
            "vfs": "ram",
            "files": {
              "a.txt": "hello\n"
            }
          }
        }
      },
      "entry": {
        "captures": [
          "@external"
        ],
        "config": {
          "mount_type": "ssh"
        }
      },
      "steps": [
        {
          "command": "cd /route && cat a.txt | python3 -c 'import sys; print(sys.stdin.read().strip())'",
          "expect": {
            "exit": 0,
            "stdout": "hello\n"
          }
        },
        {
          "command": "pwd",
          "expect": {
            "exit": 0,
            "stdout": "/route\n"
          }
        },
        {
          "command": "python3 -c 'import os; print(os.path.exists(\"/etc/os-release\"))'",
          "expect": {
            "exit": 0,
            "stdout": "True\n"
          }
        }
      ]
    },
    {
      "id": "a_binary_built_in_a_workspace_folder_runs_in_the_box",
      "runtimes": [
        "docker",
        "e2b",
        "microsandbox"
      ],
      "requires": [
        "env:MIRAGE_INTEG_BOX_MOUNTS"
      ],
      "sdk_only": "Every case mounts /route into the one shared docker box over sshfs; the CLI lane runs beside the SDK drivers on that box, so these run on the SDK pass only, serialized like sandbox/mounts.",
      "world": {
        "mounts": {
          "/route": {
            "vfs": "ram",
            "files": {
              "a.txt": "hello\n"
            }
          }
        }
      },
      "entry": {
        "captures": [
          "@external"
        ],
        "config": {
          "mount_type": "ssh"
        }
      },
      "steps": [
        {
          "command": "cd /route",
          "expect": {
            "exit": 0
          }
        },
        {
          "command": "python3 -c 'import shutil; shutil.copy(\"/bin/true\", \"t\")'",
          "expect": {
            "exit": 0
          }
        },
        {
          "command": "./t; echo $?",
          "expect": {
            "exit": 0,
            "stdout": "0\n"
          }
        }
      ]
    }
  ]
}
