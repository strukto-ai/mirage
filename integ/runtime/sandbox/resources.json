          }
        }
      ]
    },
    {
      "id": "a_wrapper_gives_the_programs_own_pid",
      "runtimes": [
        "docker",
        "ssh",
        "e2b",
        "microsandbox",
        "apple_container",
        "kubernetes"
      ],
      "entry": {
        "captures": [
          "@external"
        ]
      },
      "world": {
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "nohup perl -e 'sleep 29' >/dev/null 2>&1 & p=$!; [ \"$p\" -lt 4194304 ] && echo real; kill $p; wait $p; echo $?",
          "expect": {
            "exit": 0,
            "stdout": "real\n143\n"
          }
        }
      ]
    },
    {
      "id": "kill_of_timeout_stops_its_program",
      "runtimes": [
        "docker",
        "ssh",
        "e2b",
        "microsandbox",
        "apple_container",
        "kubernetes"
      ],
      "entry": {
        "captures": [
          "@python",
          "perl"
        ]
      },
      "world": {
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "timeout 29 perl -e 'sleep 28' & p=$!; sleep 0.5; kill $p; wait $p; echo $?; sleep 1; pgrep -c perl; true",
          "expect": {
            "exit": 0,
            "stdout": "143\n0\n"
          }
        }
      ]
    },
    {
      "id": "pkill_full_reads_the_program_not_the_wrapper",
      "runtimes": [
        "docker",
        "ssh",
        "e2b",
        "microsandbox",
        "apple_container",
        "kubernetes"
      ],
      "entry": {
        "captures": [
          "@python",
          "perl"
        ]
      },
      "world": {
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "perl -e 'sleep 27' & p=$!; sleep 0.5; pgrep -c -f 'sleep 27'; pkill -f 'sleep 27'; echo $?; wait $p; echo $?",
          "expect": {
            "exit": 0,
            "stdout": "1\n0\n143\n"
          }
        }
      ]
    },
    {
      "id": "a_function_takes_a_views_name",
      "runtimes": [
        "docker",
        "ssh",
        "e2b",
        "microsandbox",
        "apple_container",
        "kubernetes"
      ],
      "entry": {
        "captures": [
          "@python",
          "perl"
        ]
      },
      "world": {
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "nproc(){ echo mine; }; hostname(){ echo too; }; lscpu(){ echo also; }; nproc; hostname; lscpu",
          "expect": {
            "exit": 0,
            "stdout": "mine\ntoo\nalso\n"
          }
        }
      ]
    }
  ]
}
