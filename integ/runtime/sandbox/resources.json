    {
      "id": "an_unknown_machine_is_refused",
      "runtimes": [
        "docker",
        "ssh",
        "e2b",
        "microsandbox",
        "apple_container",
        "kubernetes"
      ],
      "entry": {
        "captures": [
          "@python",
          "perl"
        ]
      },
      "world": {
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "nproc --machine nosuch 2>&1; echo $?",
          "expect": {
