{
  "cases": [
    {
      "id": "nproc_is_the_machines",
      "runtimes": [
        "docker",
        "ssh",
        "e2b",
        "microsandbox",
        "apple_container",
        "kubernetes"
      ],
      "entry": {
        "captures": [
          "@python",
          "perl"
        ]
      },
      "world": {
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "nproc | grep -c ' mirage$'",
          "expect": {
            "exit": 0,
            "stdout": "1\n"
          }
        },
        {
          "command": "nproc | grep -c .",
          "expect": {
            "exit": 0,
            "stdout": "2\n"
          }
        },
        {
          "command": "nproc --machine mirage",
          "expect": {
            "exit": 0,
            "stdout": "1\n"
          }
        },
        {
          "command": "n=$(nproc); echo \"$n\" | grep -c '^[0-9][0-9]*$'",
          "expect": {
            "exit": 0,
            "stdout": "1\n"
          }
        }
      ]
    },
    {
      "id": "hostname_lists_the_workspace_and_its_machine",
      "runtimes": [
        "docker",
        "ssh",
        "e2b",
        "microsandbox",
        "apple_container",
        "kubernetes"
      ],
      "entry": {
        "captures": [
          "@python",
          "perl"
        ]
      },
      "world": {
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "hostname | head -n 1",
          "expect": {
            "exit": 0,
            "stdout": "mirage\n"
          }
        },
        {
          "command": "hostname | wc -l",
          "expect": {
            "exit": 0,
            "stdout": "2\n"
          }
        },
        {
          "command": "hostname -s",
          "expect": {
            "exit": 0,
            "stdout": "mirage\n"
          }
        },
        {
          "command": "[ \"$(hostname)\" != mirage ] && echo real",
          "expect": {
            "exit": 0,
            "stdout": "real\n"
          }
        }
      ]
    },
    {
      "id": "lscpu_has_a_column_for_the_workspace_and_its_machine",
      "runtimes": [
        "docker",
        "ssh",
        "e2b",
        "microsandbox",
        "apple_container",
        "kubernetes"
      ],
      "entry": {
        "captures": [
          "@python",
          "perl"
        ]
      },
      "world": {
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "lscpu | head -n 1 | grep -c mirage",
          "expect": {
            "exit": 0,
            "stdout": "1\n"
          }
        },
        {
          "command": "lscpu | awk '/^CPU\\(s\\):/{print $2}'",
          "expect": {
            "exit": 0,
            "stdout": "1\n"
          }
        },
        {
          "command": "lscpu | awk '/^Architecture:/{print $2}'",
          "expect": {
            "exit": 0,
            "stdout": "-\n"
          }
        },
        {
          "command": "lscpu | grep -c '^Flags:' || true",
          "expect": {
            "exit": 0,
            "stdout": "0\n"
          }
        },
        {
          "command": "lscpu | awk '/^Byte Order:/{print $3, $4}'",
          "expect": {
            "exit": 0,
            "stdout": "Little Endian\n"
          }
        },
        {
          "command": "lscpu --machine mirage",
          "expect": {
            "exit": 0,
            "stdout": "Byte Order:                              Little Endian\nCPU(s):                                  1\n"
          }
        }
      ]
    },
    {
      "id": "free_reads_the_machine",
      "runtimes": [
        "docker",
        "ssh",
        "e2b",
        "microsandbox",
        "apple_container",
        "kubernetes"
      ],
      "entry": {
        "captures": [
          "@python",
          "perl"
        ]
      },
      "world": {
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "free | grep -c '^Mem:'",
          "expect": {
            "exit": 0,
            "stdout": "2\n"
          }
        },
        {
          "command": "free -m | awk '/^Mem:/ && !/mirage$/{exit !($2 > 0)}'; echo $?",
          "expect": {
            "exit": 0,
            "stdout": "0\n"
          }
        },
        {
          "command": "free -m | awk '/^Mem:/ && /mirage$/{print $2, $5, $6}'",
          "expect": {
            "exit": 0,
            "stdout": "96 - -\n"
          }
        },
        {
          "command": "free -m --machine mirage | awk '/^Mem:/{print $2, NF}'",
          "expect": {
            "exit": 0,
            "stdout": "96 7\n"
          }
        }
      ]
    },
