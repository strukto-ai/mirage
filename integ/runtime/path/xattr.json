{
  "cases": [
    {
      "id": "extended_attribute_calls_are_pyodides_alone",
      "runtimes": [
        "monty",
        "wasi",
        "pyodide",
        "quickjs"
      ],
      "world": {
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "t.txt": "hello\n"
            }
          }
        }
      },
      "steps": [
        {
          "program": {
            "python": "import os\nprint([n for n in ('getxattr', 'listxattr', 'removexattr', 'setxattr') if hasattr(os, n)])",
            "js": "console.log(['getxattr', 'listxattr', 'removexattr', 'setxattr'].filter((n) => n in os).length)"
          },
          "expect": {
            "python": {
              "exit": 0,
              "stdout": "[]\n"
            },
            "js": {
              "exit": 0,
              "stdout": "0\n"
            }
          },
          "expect_on": {
            "pyodide": {
              "stdout": "['getxattr', 'listxattr', 'removexattr', 'setxattr']\n"
            }
          }
        }
      ]
    },
    {
      "id": "extended_attributes_round_trip_with_the_shell",
      "runtimes": [
        "pyodide"
      ],
      "world": {
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "t.txt": "hello\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "setfattr -n user.tag -v shell /data/t.txt",
          "expect": {
            "exit": 0
          }
        },
        {
          "program": {
            "python": "import os\nprint(os.getxattr('/data/t.txt', 'user.tag'))\nos.setxattr('/data/t.txt', 'user.guest', b'g')\nprint(os.listxattr('/data/t.txt'))"
          },
          "expect": {
            "exit": 0,
            "stdout": "b'shell'\n['user.guest', 'user.tag']\n"
          }
        },
        {
          "command": "getfattr -n user.guest --only-values /data/t.txt",
          "expect": {
            "exit": 0,
            "stdout": "g"
          }
        },
        {
          "program": {
            "python": "import errno, os\nfor call in (lambda: os.getxattr('/data/t.txt', 'user.none'),\n             lambda: os.setxattr('/data/t.txt', 'user.guest', b'x', os.XATTR_CREATE),\n             lambda: os.listxattr('/data/none.txt')):\n    try:\n        call()\n    except OSError as exc:\n        print(errno.errorcode[exc.errno])"
          },
          "expect": {
            "exit": 0,
            "stdout": "ENODATA\nEEXIST\nENOENT\n"
          }
        },
        {
          "program": {
            "python": "import os\nos.removexattr('/data/t.txt', 'user.tag')\nprint(os.listxattr('/data/t.txt'))"
          },
          "expect": {
            "exit": 0,
            "stdout": "['user.guest']\n"
          }
        }
      ]
    }
  ]
}
