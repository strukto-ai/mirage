{
  "cases": [
    {
      "id": "symlink_roundtrip",
      "note": "monty has no link calls (symlink, readlink, lstat, scandir) and quickjs has none on either host: qjs-wasi builds without os.symlink, os.readlink and os.lstat, and the TypeScript shim matches it.",
      "runtimes": [
        "wasi",
        "pyodide",
        "host"
      ],
      "world": {
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "t.txt": "hello\n"
            }
          }
        }
      },
      "steps": [
        {
          "program": {
            "python": "import os\nos.symlink('t.txt', '/data/made')"
          },
          "expect": {
            "exit": 0
          }
        },
        {
          "command": "readlink /data/made",
          "expect": {
            "exit": 0,
            "stdout": "t.txt\n"
          }
        },
        {
          "command": "cat /data/made",
          "expect": {
            "exit": 0,
            "stdout": "hello\n"
          }
        }
      ],
      "backends": [
        "ram",
        "disk",
        "ssh",
        "s3",
        "redis",
        "ram+cache",
        "disk+cache",
        "redis+cache"
      ]
    },
    {
      "id": "readlink_and_lstat_a_shell_link",
      "note": "monty has no link calls (symlink, readlink, lstat, scandir) and quickjs has none on either host: qjs-wasi builds without os.symlink, os.readlink and os.lstat, and the TypeScript shim matches it.",
      "runtimes": [
        "wasi",
        "pyodide",
        "host"
      ],
      "world": {
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "t.txt": "hello\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "ln -s t.txt /data/l",
          "expect": {
            "exit": 0
          }
        },
        {
          "program": {
            "python": "import os, stat\nprint(os.readlink('/data/l'))\nst = os.lstat('/data/l')\nprint(stat.S_ISLNK(st.st_mode), st.st_size)\nprint(os.path.islink('/data/l'), os.path.islink('/data/t.txt'))"
          },
          "expect": {
            "exit": 0,
            "stdout": "t.txt\nTrue 5\nTrue False\n"
          }
        }
      ],
      "backends": [
        "ram",
        "disk",
        "ssh",
        "s3",
        "redis",
        "ram+cache",
        "disk+cache",
        "redis+cache"
      ]
    },
    {
      "id": "is_symlink_reads_the_name_plane",
      "note": "Pyodide does not mount a link outside every mount (/alias).",
      "runtimes": [
        "monty",
        "wasi",
        "pyodide",
        "host"
      ],
      "world": {
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "t.txt": "hello\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "ln -s t.txt /data/l",
          "expect": {
            "exit": 0
          }
        },
        {
          "program": {
            "python": "from pathlib import Path\nprint(Path('/data/l').is_symlink(), Path('/data/t.txt').is_symlink())"
          },
          "expect": {
            "exit": 0,
            "stdout": "True False\n"
          }
        },
        {
          "command": "ln -s /data/t.txt /alias",
          "expect": {
            "exit": 0
          }
        },
        {
          "program": {
            "python": "from pathlib import Path\na = Path('/alias')\nprint(a.is_symlink(), a.exists(), a.read_text(), end='')"
          },
          "expect": {
            "exit": 0,
            "stdout": "True True hello\n"
          },
          "expect_on": {
            "pyodide": {
              "exit": 1,
              "stdout": "",
              "stderr_contains": "No such file or directory: '/alias'"
            },
            "host": {
              "exit": 1,
              "stdout": "",
              "stderr_contains": "No such file or directory: '/alias'"
            }
          }
        }
      ],
      "backends": [
        "ram",
        "disk",
        "ssh",
        "s3",
        "redis",
        "ram+cache",
        "disk+cache",
        "redis+cache"
      ]
    },
    {
      "id": "readlink_splits_its_two_misses",
      "note": "monty has no link calls (symlink, readlink, lstat, scandir) and quickjs has none on either host: qjs-wasi builds without os.symlink, os.readlink and os.lstat, and the TypeScript shim matches it.",
      "runtimes": [
        "wasi",
        "pyodide",
        "host"
      ],
      "world": {
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "t.txt": "hello\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "mkdir /data/d",
          "expect": {
            "exit": 0
          }
        },
        {
          "program": {
            "python": "import errno, os\nfor p in ('/data/t.txt', '/data/d', '/data/missing', '/data/d/deep/missing'):\n    try:\n        os.readlink(p)\n    except OSError as exc:\n        print(p, errno.errorcode[exc.errno])"
          },
          "expect": {
            "exit": 0,
            "stdout": "/data/t.txt EINVAL\n/data/d EINVAL\n/data/missing ENOENT\n/data/d/deep/missing ENOENT\n"
          }
        }
      ],
      "backends": [
        "ram",
        "disk",
        "ssh",
        "s3",
        "redis",
        "ram+cache",
        "disk+cache",
        "redis+cache"
      ]
    },
    {
      "id": "symlink_refuses_an_occupied_name",
      "note": "monty has no link calls (symlink, readlink, lstat, scandir) and quickjs has none on either host: qjs-wasi builds without os.symlink, os.readlink and os.lstat, and the TypeScript shim matches it.",
      "runtimes": [
        "wasi",
        "pyodide",
        "host"
      ],
      "world": {
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "t.txt": "hello\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "mkdir /data/d && ln -s t.txt /data/lk",
          "expect": {
            "exit": 0
          }
        },
        {
          "program": {
            "python": "import os\nfor p in ('/data/t.txt', '/data/d', '/data/lk', '/data'):\n    try:\n        os.symlink('elsewhere', p)\n        print(p, 'created')\n    except OSError as exc:\n        print(p, type(exc).__name__)"
          },
          "expect": {
            "exit": 0,
            "stdout": "/data/t.txt FileExistsError\n/data/d FileExistsError\n/data/lk FileExistsError\n/data FileExistsError\n"
          }
        },
        {
          "command": "cat /data/t.txt",
          "expect": {
            "exit": 0,
            "stdout": "hello\n"
          }
        },
        {
          "command": "readlink /data/lk",
          "expect": {
            "exit": 0,
            "stdout": "t.txt\n"
          }
        }
      ],
      "backends": [
        "ram",
        "disk",
        "ssh",
        "s3",
        "redis",
        "ram+cache",
        "disk+cache",
        "redis+cache"
      ]
    },
    {
      "id": "scandir_reports_a_link_as_a_link",
      "note": "monty has no link calls (symlink, readlink, lstat, scandir) and quickjs has none on either host: qjs-wasi builds without os.symlink, os.readlink and os.lstat, and the TypeScript shim matches it.",
      "runtimes": [
        "wasi",
        "pyodide",
        "host"
      ],
      "world": {
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "t.txt": "hello\n",
              "d/inner.txt": "x\n",
              "real/t.txt": "hello\n",
              "real/sub/deep.txt": "x\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "ln -s t.txt /data/lk && ln -s d /data/dlk",
          "expect": {
            "exit": 0
          }
        },
        {
          "command": "ln -s /data/real/t.txt /data/real/lk && ln -s /data/real/sub /data/real/dlk && ln -s /data/real /data/alias",
          "expect": {
            "exit": 0
          }
        },
        {
          "program": {
            "python": "import os\nfor root in ('/data', '/data/alias'):\n    for e in sorted(os.scandir(root), key=lambda x: x.name):\n        print(e.name, 'link' if e.is_symlink() else ('dir' if e.is_dir() else 'file'))"
          },
          "expect": {
            "exit": 0,
            "stdout": "alias link\nd dir\ndlk link\nlk link\nreal dir\nt.txt file\ndlk link\nlk link\nsub dir\nt.txt file\n"
          }
        }
      ],
      "backends": [
        "ram",
        "disk",
        "ssh",
        "s3",
        "redis",
        "ram+cache",
        "disk+cache",
        "redis+cache"
      ]
    },
    {
      "id": "rename_a_link_moves_the_name",
      "note": "monty has no link calls (symlink, readlink, lstat, scandir) and quickjs has none on either host: qjs-wasi builds without os.symlink, os.readlink and os.lstat, and the TypeScript shim matches it.",
      "runtimes": [
        "wasi",
        "pyodide",
        "host"
      ],
      "world": {
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "t.txt": "hello\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "ln -s t.txt /data/lk",
          "expect": {
            "exit": 0
          }
        },
        {
          "program": {
            "python": "import os\nos.rename('/data/lk', '/data/moved')\nprint(os.readlink('/data/moved'))\nprint(os.path.islink('/data/lk'))"
          },
          "expect": {
            "exit": 0,
            "stdout": "t.txt\nFalse\n"
          }
        },
        {
          "command": "readlink /data/moved",
          "expect": {
            "exit": 0,
            "stdout": "t.txt\n"
          }
        },
        {
          "command": "readlink /data/lk",
          "expect": {
            "exit": 1
          }
        }
      ],
      "backends": [
        "ram",
        "disk",
        "ssh",
        "s3",
        "redis",
        "ram+cache",
        "disk+cache",
        "redis+cache"
      ]
    },
    {
      "id": "removing_a_link_to_a_directory_leaves_the_directory",
      "runtimes": [
        "pyodide",
        "quickjs",
        "host"
      ],
      "world": {
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "d/f.txt": "f\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "ln -s d /data/lk",
          "expect": {
            "exit": 0
          }
        },
        {
          "program": {
            "python": "import os\nos.remove('/data/lk')",
            "js": "console.log(os.remove('/data/lk'))",
            "node": "await require('node:fs').promises.unlink('/data/lk')"
          },
          "expect": {
            "python": {
              "exit": 0
            },
            "js": {
              "exit": 0,
              "stdout": "0\n"
            },
            "node": {
              "exit": 0
            }
          }
        },
        {
          "command": "ls /data /data/d",
          "expect": {
            "exit": 0,
            "stdout": "/data:\nd\n\n/data/d:\nf.txt\n"
          }
        }
      ],
      "backends": [
        "ram",
        "disk",
        "ssh",
        "s3",
        "redis",
        "ram+cache",
        "disk+cache",
        "redis+cache"
      ]
    },
    {
      "id": "a_file_through_a_link_is_the_same_file",
      "runtimes": [
        "wasi",
        "pyodide",
        "quickjs",
        "host"
      ],
      "world": {
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "d/f.txt": "f\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "ln -s d /data/lk",
          "expect": {
            "exit": 0
          }
        },
        {
          "program": {
            "python": "import os, shutil\na, b = os.stat('/data/d/f.txt'), os.stat('/data/lk/f.txt')\nprint(a.st_ino == b.st_ino, a.st_dev == b.st_dev, os.path.samefile('/data/d/f.txt', '/data/lk/f.txt'))\nf = open('/data/lk/f.txt')\nf.close()\nfd = os.open('/data/lk/f.txt', os.O_RDONLY)\ns = os.fstat(fd)\nos.close(fd)\nprint(f.name, s.st_ino == a.st_ino, s.st_dev == a.st_dev)\ntry:\n    shutil.copyfile('/data/d/f.txt', '/data/lk/f.txt')\nexcept shutil.SameFileError:\n    print('same file')\nprint(open('/data/d/f.txt').read(), end='')",
            "js": "const [a] = os.stat('/data/d/f.txt')\nconst [b] = os.stat('/data/lk/f.txt')\nconsole.log(a.ino === b.ino, a.dev === b.dev)",
            "node": "const fsp = require('node:fs').promises\nconst [a, b] = [await fsp.stat('/data/d/f.txt'), await fsp.stat('/data/lk/f.txt')]\nconsole.log(a.ino === b.ino, a.dev === b.dev)\nconst h = await fsp.open('/data/lk/f.txt')\nconst s = await h.stat()\nawait h.close()\nconsole.log(s.ino === a.ino, s.dev === a.dev)\nawait fsp.cp('/data/d/f.txt', '/data/lk/f.txt').catch((e) => console.log(e.code))\nconsole.log((await fsp.readFile('/data/d/f.txt', 'utf8')).trimEnd())"
          },
          "expect": {
            "python": {
              "exit": 0,
              "stdout": "True True True\n/data/lk/f.txt True True\nsame file\nf\n"
            },
            "js": {
              "exit": 0,
              "stdout": "true true\n"
            },
            "node": {
              "exit": 0,
              "stdout": "true true\ntrue true\nERR_FS_CP_EINVAL\nf\n"
            }
          }
        }
      ],
      "backends": [
        "ram",
        "disk",
        "ssh",
        "s3",
        "redis",
        "ram+cache",
        "disk+cache",
        "redis+cache"
      ]
    },
    {
      "id": "a_link_across_mounts_names_its_target_file",
      "runtimes": [
        "wasi",
        "pyodide",
        "quickjs",
        "host"
      ],
      "world": {
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "f.txt": "f\n"
            }
          },
          "/other": {
            "vfs": "ram",
            "files": {
              "g.txt": "g\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "ln -s /other/g.txt /data/lo",
          "expect": {
            "exit": 0
          }
        },
        {
          "program": {
            "python": "import os\nl, t = os.stat('/data/lo'), os.stat('/other/g.txt')\nf = open('/data/lo')\nf.close()\nfd = os.open('/data/lo', os.O_RDONLY)\nos.remove('/data/lo')\ns = os.fstat(fd)\nos.close(fd)\nprint(l.st_ino == t.st_ino, l.st_dev == t.st_dev, s.st_ino == t.st_ino, s.st_dev == t.st_dev, f.name)",
            "js": "const [l] = os.stat('/data/lo')\nconst [t] = os.stat('/other/g.txt')\nconsole.log(l.ino === t.ino, l.dev === t.dev)",
            "node": "const fsp = require('node:fs').promises\nconst [l, t] = [await fsp.stat('/data/lo'), await fsp.stat('/other/g.txt')]\nconst h = await fsp.open('/data/lo')\nawait fsp.unlink('/data/lo')\nconst s = await h.stat()\nawait h.close()\nconsole.log(l.ino === t.ino, l.dev === t.dev, s.ino === t.ino, s.dev === t.dev)"
          },
          "expect": {
            "python": {
              "exit": 0,
              "stdout": "True True True True /data/lo\n"
            },
            "js": {
              "exit": 0,
              "stdout": "true true\n"
            },
            "node": {
              "exit": 0,
              "stdout": "true true true true\n"
            }
          }
        }
      ]
    }
  ]
}
