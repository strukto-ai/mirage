{
  "cases": [
    {
      "id": "unlink_reaches_the_mount",
      "runtimes": [
        "monty",
        "wasi",
        "pyodide",
        "quickjs"
      ],
      "backends": [
        "ram",
        "disk",
        "ssh",
        "s3",
        "redis"
      ],
      "world": {
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "a.txt": "a\n",
              "d/b.txt": "b\n"
            }
          }
        }
      },
      "steps": [
        {
          "program": {
            "python": "from pathlib import Path\nPath('/data/a.txt').unlink()\nprint(Path('/data/a.txt').exists())",
            "js": "console.log(os.remove('/data/a.txt'), os.stat('/data/a.txt')[1])"
          },
          "expect": {
            "exit": 0,
            "stdout": "False\n"
          },
          "expect_on": {
            "quickjs": {
              "stdout": "0 44\n"
            }
          }
        },
        {
          "program": {
            "python": "from pathlib import Path\ntry:\n    Path('/data/a.txt').unlink()\nexcept OSError as e:\n    print(type(e).__name__)",
            "js": "console.log(os.remove('/data/a.txt'))"
          },
          "expect": {
            "exit": 0,
            "stdout": "FileNotFoundError\n"
          },
          "expect_on": {
            "quickjs": {
              "stdout": "-44\n"
            }
          }
        },
        {
          "program": {
            "python": "from pathlib import Path\ntry:\n    Path('/data/d').unlink()\nexcept OSError as e:\n    print(type(e).__name__)"
          },
          "expect": {
            "exit": 0,
            "stdout": "IsADirectoryError\n"
          }
        },
        {
          "command": "echo -n x > /data/f1.txt",
          "expect": {
            "exit": 0
          }
        },
        {
          "program": {
            "python": "import os\nos.remove('/data/f1.txt')",
            "js": "console.log(os.remove('/data/f1.txt'))"
          },
          "expect": {
            "exit": 0
          }
        },
        {
          "command": "ls /data /data/d",
          "expect": {
            "exit": 0,
            "stdout": "/data:\nd\n\n/data/d:\nb.txt\n"
          }
        }
      ]
    }
  ]
}
