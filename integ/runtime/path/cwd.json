{
  "cases": [
    {
      "id": "the_shell_cwd_reaches_the_guest",
      "runtimes": [
        "monty",
        "wasi",
        "pyodide",
        "quickjs"
      ],
      "world": {
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "in.txt": "hello",
              "sub/item": "hello\n",
              "sub/child.txt": "child",
              "entry.mjs": "console.log(os.getcwd()[0])\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "cd /data/sub",
          "expect": {
            "exit": 0
          }
        },
        {
          "program": {
            "python": "from pathlib import Path\nprint(Path.cwd())\nprint(Path('item').read_text(), end='')\nPath('out').write_text('written')",
            "js": "console.log(os.getcwd()[0])\nconsole.log(std.open('item', 'r').readAsString().trim())\nconst f = std.open('out', 'w')\nf.puts('written')\nf.close()"
          },
          "expect": {
            "exit": 0,
            "stdout": "/data/sub\nhello\n"
          }
        },
        {
          "command": "cat /data/sub/out",
          "expect": {
            "exit": 0,
            "stdout": "written"
          }
        },
        {
          "command": {
            "python": "PWD=/wrong python3 -c \"import os; print(os.getcwd()); os.chdir('..'); raise ValueError('expected')\"",
            "js": "PWD=/wrong node -e \"console.log(os.getcwd()[0]); os.chdir('..'); throw new Error('expected')\""
          },
          "expect": {
            "exit": 1,
            "stdout": "/data/sub\n",
            "stderr_contains": "expected"
          }
        },
        {
          "command": "pwd",
          "expect": {
            "exit": 0,
            "stdout": "/data/sub\n"
          }
        },
        {
          "program": {
            "python": "import os\nprint(os.getcwd())",
            "js": "console.log(os.getcwd()[0])"
          },
          "expect": {
            "exit": 0,
            "stdout": "/data/sub\n"
          }
        },
        {
          "command": {
            "python": "printf \"import os; print(os.getcwd())\" > script.py; python3 script.py",
            "js": "node /data/entry.mjs"
          },
          "expect": {
            "exit": 0,
            "stdout": "/data/sub\n"
          }
        },
        {
          "program": {
            "python": "from __future__ import annotations\nimport os\nprint(os.getcwd())",
            "js": "'use strict'\ntry { missingName = 1 } catch (e) { console.log(e.name) }\nconsole.log(os.getcwd()[0])"
          },
          "expect": {
            "python": {
              "exit": 0,
              "stdout": "/data/sub\n"
            },
            "js": {
              "exit": 0,
              "stdout": "ReferenceError\n/data/sub\n"
            }
          }
        },
        {
          "command": {
            "js": "node -m -e \"console.log(os.getcwd()[0]); console.log(std.open('item', 'r').readAsString().trim())\""
          },
          "expect": {
            "exit": 0,
            "stdout": "/data/sub\nhello\n"
          }
        },
        {
          "program": {
            "python": "import os\nos.chdir = lambda _: None\nprint(os.getcwd())"
          },
          "expect": {
            "exit": 0,
            "stdout": "/data/sub\n"
          },
          "expect_on": {
            "monty": {
              "exit": 1,
              "stdout": "",
              "stderr_contains": "no __dict__ for setting new attributes"
            }
          }
        },
        {
          "command": {
            "python": "python3 <<'PY'\nfrom pathlib import Path\nprint(Path('item').read_text(), end='')\nPY",
            "js": "node <<'JS'\nconsole.log(std.open('item', 'r').readAsString().trim())\nJS"
          },
          "expect": {
            "exit": 0,
            "stdout": "hello\n"
          }
        }
      ]
    },
    {
      "id": "relative_paths_resolve_against_the_cwd",
      "runtimes": [
        "monty",
        "wasi",
        "pyodide",
        "quickjs"
      ],
      "world": {
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "in.txt": "hello",
              "sub/item": "hello\n",
              "sub/child.txt": "child",
              "entry.mjs": "console.log(os.getcwd()[0])\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "cd /data",
          "expect": {
            "exit": 0
          }
        },
        {
          "program": {
            "python": "import os\nfrom pathlib import Path\nprint(open('in.txt').read())\nPath('out.txt').write_text('written')\nPath('out.txt').rename('renamed.txt')\nprint(Path('./sub/../renamed.txt').read_text())\nprint(sorted(p.name for p in Path('.').iterdir()))\nprint(Path('in.txt').absolute())\nprint(os.listdir('sub'))",
            "js": "console.log(std.open('in.txt', 'r').readAsString())\nconst f = std.open('out.txt', 'w')\nf.puts('written')\nf.close()\nos.rename('out.txt', 'renamed.txt')\nconsole.log(std.open('./sub/../renamed.txt', 'r').readAsString())\nconsole.log(JSON.stringify(os.readdir('.')[0].filter((n) => n[0] !== '.').sort()))\nconsole.log(os.getcwd()[0] + '/in.txt')\nconsole.log(JSON.stringify(os.readdir('sub')[0].filter((n) => n[0] !== '.').sort()))"
          },
          "expect": {
            "python": {
              "exit": 0,
              "stdout": "hello\nwritten\n['entry.mjs', 'in.txt', 'renamed.txt', 'sub']\n/data/in.txt\n['child.txt', 'item']\n"
            },
            "js": {
              "exit": 0,
              "stdout": "hello\nwritten\n[\"entry.mjs\",\"in.txt\",\"renamed.txt\",\"sub\"]\n/data/in.txt\n[\"child.txt\",\"item\"]\n"
            }
          }
        },
        {
          "command": "cat /data/renamed.txt",
          "expect": {
            "exit": 0,
            "stdout": "written"
          }
        },
        {
          "program": {
            "python": "import os\nos.mkdir('empty')\nprint(os.stat('in.txt').st_size)\nos.rmdir('empty')\nos.remove('renamed.txt')\nprint('empty' in os.listdir('.'), 'renamed.txt' in os.listdir('.'))",
            "js": "console.log(os.mkdir('empty'))\nconsole.log(os.stat('in.txt')[0].size)\nconsole.log(os.remove('empty'), os.remove('renamed.txt'))\nconst names = os.readdir('.')[0]\nconsole.log(names.includes('empty'), names.includes('renamed.txt'))"
          },
          "expect": {
            "python": {
              "exit": 0,
              "stdout": "5\nFalse False\n"
            },
            "js": {
              "exit": 0,
              "stdout": "0\n5\n0 0\nfalse false\n"
            }
          }
        },
        {
          "program": {
            "python": "from pathlib import Path\nprint([(type(p).__name__, str(p), p.name) for p in Path('sub').iterdir() if p.name == 'item'])"
          },
          "expect": {
            "exit": 0,
            "stdout": "[('PosixPath', 'sub/item', 'item')]\n"
          }
        }
      ]
    },
    {
      "id": "guest_chdir_stays_in_the_guest",
      "note": "A guest chdir moves the guest only. The monty JS binding wants a namedtuple stat from os.chdir's host call and refuses the mapping mirage returns, and the python host's preview1 layer (wasi, quickjs) keeps '..' in the cwd it reports.",
      "runtimes": [
        "monty",
        "wasi",
        "pyodide",
        "quickjs"
      ],
      "world": {
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "in.txt": "hello",
              "sub/item": "hello\n",
              "sub/child.txt": "child",
              "entry.mjs": "console.log(os.getcwd()[0])\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "cd /data",
          "expect": {
            "exit": 0
          }
        },
        {
          "program": {
            "python": "import os\nos.chdir('sub')\nprint(os.getcwd())\nprint(open('child.txt').read())\nprint(open('../in.txt').read())\nos.chdir('..')\nprint(os.getcwd())",
            "js": "console.log(os.chdir('sub'))\nconsole.log(os.getcwd()[0])\nconsole.log(std.open('child.txt', 'r').readAsString())\nconsole.log(std.open('../in.txt', 'r').readAsString())\nos.chdir('..')\nconsole.log(os.getcwd()[0])"
          },
          "expect": {
            "python": {
              "exit": 0,
              "stdout": "/data/sub\nchild\nhello\n/data\n"
            },
            "js": {
              "exit": 0,
              "stdout": "0\n/data/sub\nchild\nhello\n/data\n"
            }
          },
          "expect_on": {
            "wasi": {
              "stdout": "/data/sub\nchild\nhello\n/data/sub/..\n"
            },
            "quickjs@python": {
              "stdout": "0\n/data/sub\nchild\nhello\n/data/sub/..\n"
            },
            "monty@typescript": {
              "exit": 1,
              "stdout": "",
              "stderr_contains": "os.chdir requires the host to return a stat result"
            }
          }
        },
        {
          "command": "pwd",
          "expect": {
            "exit": 0,
            "stdout": "/data\n"
          }
        },
        {
          "program": {
            "python": "import os\nfor p in ('missing', 'in.txt'):\n    try:\n        os.chdir(p)\n    except OSError as e:\n        print(type(e).__name__)\nprint(os.getcwd())",
            "js": "console.log(os.chdir('missing'), os.chdir('in.txt'), os.getcwd()[0])"
          },
          "expect": {
            "python": {
              "exit": 0,
              "stdout": "FileNotFoundError\nNotADirectoryError\n/data\n"
            },
            "js": {
              "exit": 0,
              "stdout": "-44 -54 /data\n"
            }
          },
          "expect_on": {
            "monty@typescript": {
              "exit": 1,
              "stdout": "FileNotFoundError\n",
              "stderr_contains": "os.chdir requires the host to return a stat result"
            }
          }
        },
        {
          "program": {
            "python": "import os\nos.chdir('/data/sub')\nos.mkdir('m4')",
            "js": "os.chdir('/data/sub')\nconsole.log(os.mkdir('m4'))"
          },
          "expect": {
            "exit": 0
          },
          "expect_on": {
            "monty@typescript": {
              "exit": 1,
              "stderr_contains": "os.chdir requires the host to return a stat result"
            }
          }
        },
        {
          "command": "ls -d /data/sub/m4",
          "expect": {
            "exit": 0,
            "stdout": "/data/sub/m4\n"
          },
          "expect_on": {
            "monty@typescript": {
              "exit": 2,
              "stdout": ""
            }
          }
        },
        {
          "program": {
            "js": "const f = std.open('anchored', 'w')\nos.chdir('sub')\nf.puts('kept')\nf.close()"
          },
          "expect": {
            "exit": 0
          }
        },
        {
          "command": {
            "js": "cat /data/anchored"
          },
          "expect": {
            "exit": 0,
            "stdout": "kept"
          }
        }
      ]
    }
  ]
}
