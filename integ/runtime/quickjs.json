{
  "suite": "quickjs",
  "requires": {
    "python": [
      "env:MIRAGE_QUICKJS_HOME"
    ],
    "typescript": []
  },
  "cases": [
    {
      "id": "eval",
      "world": {
        "runtimes": [
          "quickjs",
          "vfs"
        ]
      },
      "steps": [
        {
          "command": "node -e \"console.log(6 * 7)\"",
          "expect": {
            "exit": 0,
            "stdout": "42\n",
            "stderr": ""
          }
        }
      ]
    },
    {
      "id": "pipe_to_grep",
      "world": {
        "runtimes": [
          "quickjs",
          "vfs"
        ]
      },
      "steps": [
        {
          "command": "node -e \"console.log('alpha'); console.log('beta')\" | grep beta",
          "expect": {
            "exit": 0,
            "stdout": "beta\n"
          }
        }
      ]
    },
    {
      "id": "read_mount",
      "world": {
        "runtimes": [
          "quickjs",
          "vfs"
        ],
        "mounts": {
          "/ram": {
            "resource": "ram",
            "files": {
              "data.txt": "hello from ram\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "js -e \"const f = std.open('/ram/data.txt', 'r'); console.log(f.readAsString().trim())\"",
          "expect": {
            "exit": 0,
            "stdout": "hello from ram\n"
          }
        }
      ]
    },
    {
      "id": "write_mount",
      "world": {
        "runtimes": [
          "quickjs",
          "vfs"
        ],
        "mounts": {
          "/ram": {
            "resource": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "js -e \"const w = std.open('/ram/from-js.txt', 'w'); w.puts('js-wrote-this'); w.close()\" && cat /ram/from-js.txt",
          "expect": {
            "exit": 0,
            "stdout": "js-wrote-this"
          }
        }
      ]
    },
    {
      "id": "puts_print_raw",
      "world": {
        "runtimes": [
          "quickjs",
          "vfs"
        ]
      },
      "steps": [
        {
          "command": "node -e \"std.out.puts('a'); std.out.puts('b'); print('c'); console.log({k: 1}, [1, 2])\"",
          "expect": {
            "exit": 0,
            "stdout": "abc\n[object Object] 1,2\n",
            "stderr": ""
          }
        }
      ]
    },
    {
      "id": "os_surface",
      "world": {
        "runtimes": [
          "quickjs",
          "vfs"
        ],
        "mounts": {
          "/ram": {
            "resource": "ram"
          },
          "/other": {
            "resource": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "node -e \"console.log(os.mkdir('/ram/d'), os.mkdir('/ram/d'))\"",
          "expect": {
            "exit": 0,
            "stdout": "0 -20\n"
          }
        },
        {
          "command": "echo xy > /ram/d/a.txt",
          "expect": {
            "exit": 0
          }
        },
        {
          "command": "node -e \"console.log(os.rename('/ram/d/a.txt', '/ram/d/b.txt'), os.rename('/ram/zz', '/ram/yy'))\"",
          "expect": {
            "exit": 0,
            "stdout": "0 -44\n"
          }
        },
        {
          "command": "echo keep > /ram/cross.txt && node -e \"console.log(os.rename('/ram/cross.txt', '/other/cross.txt'))\" && cat /ram/cross.txt",
          "expect": {
            "exit": 0,
            "stdout": "-44\nkeep\n"
          }
        },
        {
          "command": "node -e \"const [st, e] = os.stat('/ram/d/b.txt'); console.log(e, st.size, (st.mode & os.S_IFMT) === os.S_IFREG, JSON.stringify(os.stat('/ram/nope')))\"",
          "expect": {
            "exit": 0,
            "stdout": "0 3 true [null,44]\n"
          }
        },
        {
          "command": "node -e \"console.log(os.remove('/ram/d/b.txt'), os.remove('/ram/d/b.txt'), os.remove('/ram/d'))\"",
          "expect": {
            "exit": 0,
            "stdout": "0 -44 0\n"
          }
        },
        {
          "command": "node -e \"console.log(JSON.stringify(os.readdir('/ram/nope')))\"",
          "expect": {
            "exit": 0,
            "stdout": "[[],44]\n"
          }
        }
      ]
    },
    {
      "id": "printf",
      "world": {
        "runtimes": [
          "quickjs",
          "vfs"
        ]
      },
      "steps": [
        {
          "command": "node -e \"const n = std.out.printf('[%s|%05d|%.2f|%x|%c|%%]', 'ab', 42, 3.14159, 255, 65); std.out.puts('\\n' + n)\"",
          "expect": {
            "exit": 0,
            "stdout": "[ab|00042|3.14|ff|A|%]\n22"
          }
        },
        {
          "command": "node -e \"std.out.printf('e[%e]g[%g]plus[%+d]hash[%#x]prec[%.3d]sp[% d]', 1234.5678, 1234.5678, 42, 255, 7, 9); std.out.puts('\\n')\"",
          "expect": {
            "exit": 0,
            "stdout": "e[1.234568e+03]g[1234.57]plus[+42]hash[0xff]prec[007]sp[ 9]\n"
          }
        },
        {
          "command": "node -e \"std.out.printf('star[%*d]prec[%.*f]', 6, 42, 2, 3.14159); std.out.puts('\\n')\"",
          "expect": {
            "exit": 0,
            "stdout": "star[    42]prec[3.14]\n"
          }
        },
        {
          "command": "node -e \"std.out.printf('%q', 1)\"",
          "expect": {
            "exit": 1,
            "stderr_contains": "TypeError: invalid conversion specifier in format string"
          }
        }
      ]
    },
    {
      "id": "js_policy_reads_file",
      "world": {
        "runtimes": [
          "quickjs",
          "vfs"
        ],
        "mounts": {
          "/ram": {
            "resource": "ram",
            "files": {
              "deny.txt": "node\n"
            }
          }
        },
        "route_policy": "const f = std.open('/ram/deny.txt', 'r'); const blocked = f !== null && f.readAsString().includes(ctx.command); if (f !== null) f.close(); blocked ? {deny: 'listed in /ram/deny.txt'} : null"
      },
      "steps": [
        {
          "command": "node -e \"console.log(1)\"",
          "expect": {
            "exit": 126,
            "stderr": "node: Permission denied\n"
          }
        },
        {
          "command": "echo still-open",
          "expect": {
            "exit": 0,
            "stdout": "still-open\n"
          }
        }
      ]
    },
    {
      "id": "js_policy_deny",
      "world": {
        "runtimes": [
          "quickjs",
          "vfs"
        ],
        "mounts": {
          "/ram": {
            "resource": "ram"
          }
        },
        "route_policy": "ctx.command === 'node' ? {deny: 'no js here'} : null"
      },
      "steps": [
        {
          "command": "node -e \"console.log(1)\"",
          "expect": {
            "exit": 126,
            "stderr": "node: Permission denied\n"
          }
        },
        {
          "command": "echo still-open",
          "expect": {
            "exit": 0,
            "stdout": "still-open\n"
          }
        }
      ]
    },
    {
      "id": "js_entry_script",
      "world": {
        "runtimes": [
          {
            "name": "quickjs",
            "script": "!ctx.line.includes('keep-out')"
          },
          "vfs"
        ],
        "mounts": {
          "/ram": {
            "resource": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "node -e \"console.log('served')\"",
          "expect": {
            "exit": 0,
            "stdout": "served\n"
          }
        },
        {
          "command": "node -e \"console.log('keep-out')\"",
          "expect": {
            "exit": 126,
            "stderr": "node: no runtime accepted this line\n"
          }
        }
      ]
    },
    {
      "id": "stdin_operand",
      "world": {
        "runtimes": [
          "quickjs",
          "vfs"
        ]
      },
      "steps": [
        {
          "command": "echo 'console.log(scriptArgs.join(\",\"))' | node - a b",
          "expect": {
            "exit": 0,
            "stdout": "a,b\n"
          }
        },
        {
          "command": "echo 'console.log(\"stdin:\" + scriptArgs.join(\",\"))' | node - -e 'console.log(\"flag\")'",
          "expect": {
            "exit": 0,
            "stdout": "stdin:-e,console.log(\"flag\")\n"
          }
        },
        {
          "command": "echo 'console.log(scriptArgs.join(\",\"))' | node - -m",
          "expect": {
            "exit": 0,
            "stdout": "-m\n"
          }
        }
      ]
    },
    {
      "id": "utimes_reaches_the_mount",
      "world": {
        "runtimes": [
          "quickjs",
          "vfs"
        ],
        "mounts": {
          "/ram": {
            "resource": "ram",
            "files": {
              "t.txt": "hello\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "node -e \"console.log(os.utimes('/ram/t.txt', 100000, 200000), os.utimes('/ram/nope.txt', 1, 2))\"",
          "expect": {
            "exit": 0,
            "stdout": "0 -44\n"
          }
        },
        {
          "command": "stat -c %Y /ram/t.txt",
          "expect": {
            "exit": 0,
            "stdout": "200\n"
          }
        }
      ]
    }
  ]
}
