{
  "cases": [
    {
      "id": "getconf_counts_pages_of_max_memory",
      "note": "The default 96 MB is 24576 pages, and a workspace's own max_memory replaces it.",
      "world": {
        "runtimes": [
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "getconf _PHYS_PAGES",
          "expect": {
            "exit": 0,
            "stdout": "24576\n"
          }
        }
      ]
    },
    {
      "id": "getconf_follows_a_workspaces_max_memory",
      "world": {
        "runtimes": [
          "workspace"
        ],
        "max_memory": "64MB"
      },
      "steps": [
        {
          "command": "getconf _PHYS_PAGES",
          "expect": {
            "exit": 0,
            "stdout": "16384\n"
          }
        }
      ]
    },
    {
      "id": "free_in_a_substitution_answers_for_the_workspace",
      "note": "With no machine the workspace is the default one, so a script reading free still gets its row.",
      "world": {
        "runtimes": [
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "x=$(free -m); echo \"$x\" | awk '/^Mem:/ {print $2}'",
          "expect": {
            "exit": 0,
            "stdout": "96\n"
          }
        }
      ]
    }
  ]
}
