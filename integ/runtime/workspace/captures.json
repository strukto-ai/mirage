{
  "cases": [
    {
      "id": "captures_restrict_py",
      "hosts": [
        "python"
      ],
      "world": {
        "machines": {
          "monty": {
            "provider": "in_process",
            "runtime": "monty"
          },
          "workspace": {
            "provider": "in_process",
            "captures": [
              "echo",
              "cat"
            ]
          }
        },
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "echo vfs-captured",
          "expect": {
            "exit": 0,
            "stdout": "vfs-captured\n"
          }
        },
        {
          "command": "ls /ram",
          "expect": {
            "exit": 126,
            "stderr": "ls: no runtime accepted this line\n"
          }
        },
        {
          "command": "python3 -c \"print(6 * 7)\"",
          "expect": {
            "exit": 0,
            "stdout": "42\n"
          }
        }
      ]
    },
    {
      "id": "captures_restrict_js",
      "hosts": [
        "typescript"
      ],
      "world": {
        "machines": {
          "quickjs": {
            "provider": "in_process",
            "runtime": "quickjs"
          },
          "workspace": {
            "provider": "in_process",
            "captures": [
              "echo",
              "cat"
            ]
          }
        },
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "echo vfs-captured",
          "expect": {
            "exit": 0,
            "stdout": "vfs-captured\n"
          }
        },
        {
          "command": "ls /ram",
          "expect": {
            "exit": 126,
            "stderr": "ls: no runtime accepted this line\n"
          }
        },
        {
          "command": "node -e \"console.log(6 * 7)\"",
          "expect": {
            "exit": 0,
            "stdout": "42\n"
          }
        }
      ]
    }
  ]
}
