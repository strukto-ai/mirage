{
  "cases": [
    {
      "id": "lockdown_script",
      "world": {
        "machines": {
          "monty": {
            "provider": "in_process",
            "runtime": "monty",
            "captures": []
          }
        },
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        },
        "route_policy": {
          "script": "def pre_execute(ctx):\n    if 'secret' in ctx['line']:\n        return {\"kind\": \"deny\", \"reason\": \"sealed\"}\n",
          "runtime": "monty"
        }
      },
      "steps": [
        {
          "command": "echo fine",
          "expect": {
            "exit": 0,
            "stdout": "fine\n"
          }
        },
        {
          "command": "cat /ram/secret.txt",
          "expect": {
            "exit": 126,
            "stderr_contains": "Permission denied"
          }
        }
      ]
    },
    {
      "id": "allow_list_narrows_what_the_workspace_runs",
      "world": {
        "machines": {
          "monty": {
            "provider": "in_process",
            "runtime": "monty"
          }
        },
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        },
        "profiles": {
          "narrow": {
            "commands": {
              "allow": [
                "echo",
                "cat",
                "python3"
              ]
            }
          }
        },
        "profile": "narrow"
      },
      "steps": [
        {
          "command": "echo allowed",
          "expect": {
            "exit": 0,
            "stdout": "allowed\n"
          }
        },
        {
          "command": "ls /ram",
          "expect": {
            "exit": 126,
            "stderr": "ls: Permission denied\n"
          }
        },
        {
          "command": "python3 -c \"print(6 * 7)\"",
          "expect": {
            "exit": 0,
            "stdout": "42\n"
          }
        }
      ]
    }
  ]
}
