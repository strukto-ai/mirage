{
  "cases": [
    {
      "id": "lockdown_script",
      "world": {
        "runtimes": [
          "workspace",
          {
            "name": "monty",
            "captures": []
          }
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        },
        "route_policy": {
          "script": "def pre_execute(ctx):\n    if 'secret' in ctx['line']:\n        return {\"kind\": \"deny\", \"reason\": \"sealed\"}\n",
          "runtime": "monty"
        }
      },
      "steps": [
        {
          "command": "echo fine",
          "expect": {
            "exit": 0,
            "stdout": "fine\n"
          }
        },
        {
          "command": "cat /ram/secret.txt",
          "expect": {
            "exit": 126,
            "stderr_contains": "Permission denied"
          }
        }
      ]
    }
  ]
}
