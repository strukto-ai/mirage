{
  "suite": "smolvm",
  "optional": true,
  "optional_reason": "smolvm needs a hypervisor (/dev/kvm on Linux), which GitHub-hosted runners do not provide, so the machine cannot be created in CI. Run locally or on a bare-metal/nested-virt host with MIRAGE_INTEG_SMOLVM_MACHINE set; drop this flag once the gate has such a host.",
  "requires": [
    "env:MIRAGE_INTEG_SMOLVM_MACHINE"
  ],
  "cases": [
    {
      "id": "echo",
      "world": {
        "runtimes": [
          {
            "name": "smolvm",
            "captures": [
              "*"
            ],
            "config": {
              "machine": "${MIRAGE_INTEG_SMOLVM_MACHINE}"
            }
          },
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "echo hi-from-microvm",
          "expect": {
            "exit": 0,
            "stdout": "hi-from-microvm\n"
          }
        }
      ]
    },
    {
      "id": "exit_code",
      "world": {
        "runtimes": [
          {
            "name": "smolvm",
            "captures": [
              "*"
            ],
            "config": {
              "machine": "${MIRAGE_INTEG_SMOLVM_MACHINE}"
            }
          },
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "sh -c 'exit 7'",
          "expect": {
            "exit": 7
          }
        }
      ]
    },
    {
      "id": "stdin",
      "world": {
        "runtimes": [
          {
            "name": "smolvm",
            "captures": [
              "*"
            ],
            "config": {
              "machine": "${MIRAGE_INTEG_SMOLVM_MACHINE}"
            }
          },
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "wc -l",
          "stdin": "a\nb\nc\n",
          "expect": {
            "exit": 0,
            "stdout": "3\n"
          }
        }
      ]
    },
    {
      "id": "config_env",
      "world": {
        "runtimes": [
          {
            "name": "smolvm",
            "captures": [
              "*"
            ],
            "config": {
              "machine": "${MIRAGE_INTEG_SMOLVM_MACHINE}",
              "env": {
                "BOX_MARKER": "from-config"
              }
            }
          },
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "echo $BOX_MARKER",
          "expect": {
            "exit": 0,
            "stdout": "from-config\n"
          }
        }
      ]
    },
    {
      "id": "own_guest_kernel",
      "world": {
        "runtimes": [
          {
            "name": "smolvm",
            "captures": [
              "*"
            ],
            "config": {
              "machine": "${MIRAGE_INTEG_SMOLVM_MACHINE}"
            }
          },
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "uname -s",
          "expect": {
            "exit": 0,
            "stdout": "Linux\n"
          }
        }
      ]
    },
    {
      "id": "line_timeout",
      "world": {
        "runtimes": [
          {
            "name": "smolvm",
            "captures": [
              "*"
            ],
            "config": {
              "machine": "${MIRAGE_INTEG_SMOLVM_MACHINE}"
            }
          },
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram",
            "limits": {
              "sleep": {
                "timeout_seconds": 1
              }
            }
          }
        }
      },
      "steps": [
        {
          "command": "sleep 5",
          "expect": {
            "exit": 124
          }
        }
      ]
    },
    {
      "id": "captured_only",
      "world": {
        "runtimes": [
          {
            "name": "smolvm",
            "captures": [
              "uname"
            ],
            "config": {
              "machine": "${MIRAGE_INTEG_SMOLVM_MACHINE}"
            }
          },
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "uname",
          "expect": {
            "exit": 0,
            "stdout": "Linux\n"
          }
        },
        {
          "command": "echo local-vfs",
          "expect": {
            "exit": 0,
            "stdout": "local-vfs\n"
          }
        }
      ]
    }
  ]
}
