{
  "cases": [
    {
      "id": "whole_line_capture",
      "world": {
        "machines": {
          "echobox": {
            "provider": "in_process",
            "runtime": "echobox",
            "captures": [
              "@line"
            ]
          },
          "monty": {
            "provider": "in_process",
            "runtime": "monty",
            "captures": []
          }
        },
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        },
        "route_policy": {
          "script": "def pre_execute(ctx):\n    if 'keep-out' in ctx['line']:\n        return {\"kind\": \"route\", \"machine\": \"workspace\"}\n",
          "runtime": "monty"
        }
      },
      "steps": [
        {
          "command": "ls /ram && echo done",
          "expect": {
            "exit": 0,
            "stdout": "box:ls /ram && echo done\n"
          }
        },
        {
          "command": "echo keep-out",
          "expect": {
            "exit": 0,
            "stdout": "keep-out\n"
          }
        },
        {
          "command": "X=ls; $X /ram",
          "expect": {
            "exit": 0,
            "stdout": "box:X=ls; $X /ram\n"
          }
        }
      ]
    },
    {
      "id": "whole_line_named_off",
      "note": "A line that names a machine other than the @line one does not run whole on it: the named machine runs what it captures, and each other command runs where its own capture sends it, or in Mirage. Naming the @line machine keeps the line whole there. On a line the @line machine runs whole, a command that a pre_command route sends to another machine that captures it, even statically, exits 126.",
      "world": {
        "machines": {
          "echobox": {
            "provider": "in_process",
            "runtime": "echobox",
            "captures": [
              "@line"
            ]
          },
          "processbox": {
            "provider": "in_process",
            "runtime": "processbox",
            "captures": [
              "gcc"
            ]
          }
        },
        "register_runtimes": {
          "processbox": "processbox"
        },
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        },
        "profiles": {
          "default": {
            "policy": {
              "pre_command": [
                {
                  "script": {
                    "language": "python",
                    "source": "def pre_command(ctx):\n    if ctx['command'] == 'gcc' and '-s' in ctx['argv']:\n        return {'kind': 'route', 'machine': 'processbox'}\n    return None\n"
                  },
                  "runtime": "monty"
                }
              ]
            }
          }
        }
      },
      "steps": [
        {
          "command": "gcc x.c && echo hi",
          "expect": {
            "exit": 0,
            "stdout": "box:gcc x.c && echo hi\n"
          }
        },
        {
          "command": "gcc x.c && echo hi",
          "machine": "echobox",
          "expect": {
            "exit": 0,
            "stdout": "box:gcc x.c && echo hi\n"
          }
        },
        {
          "command": "gcc x.c && echo hi",
          "machine": "processbox",
          "expect": {
            "exit": 0,
            "stdout": "[\"gcc\",\"x.c\"]\nhi\n"
          }
        },
        {
          "command": "gcc -s x.c",
          "expect": {
            "exit": 126,
            "stderr": "gcc: Permission denied\n"
          }
        }
      ]
    },
    {
      "id": "whole_line_literal_words",
      "note": "A whole-line runtime expands the line itself, so the gate reads it as typed. Dynamic command names are refused under any rule, and dynamic arguments are refused when a rule reads that command's arguments. Nested commands (eval, sh -c, xargs, timeout) are admitted in turn; files and unsupported shell options remain unreadable. Shell program selection uses only a literal prefix including glob quoting, because expansion can shift an option's value onto --version or -c. A known version response or literal -c payload stays readable with dynamic positional words. Literal words, and dynamic ones no rule reads, reach the runtime.",
      "world": {
        "machines": {
          "echobox": {
            "provider": "in_process",
            "runtime": "echobox",
            "captures": [
              "@line"
            ]
          }
        },
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        },
        "profiles": {
          "default": {
            "commands": {
              "rm": {
                "decision": "deny",
                "reason": "no deletes"
              },
              "cat": {
                "decision": "deny",
                "reason": "sealed",
                "paths": [
                  "/ram/secret*"
                ]
              }
            }
          }
        }
      },
      "steps": [
        {
          "command": "rm /ram/x",
          "expect": {
            "exit": 126,
            "stderr": "rm: Permission denied\n"
          }
        },
        {
          "command": "$cmd /ram/x",
          "expect": {
            "exit": 126,
            "stderr": "$cmd: Permission denied\n"
          }
        },
        {
          "command": "r? /ram/x",
          "expect": {
            "exit": 126,
            "stderr": "r?: Permission denied\n"
          }
        },
        {
          "command": "PAYLOAD='rm /ram/x'; eval \"$PAYLOAD\"",
          "expect": {
            "exit": 126,
            "stderr": "\"$PAYLOAD\": Permission denied\n"
          }
        },
        {
          "command": "eval 'rm /ram/x'",
          "expect": {
            "exit": 126,
            "stderr": "rm: Permission denied\n"
          }
        },
        {
          "command": "cat \"$f\"",
          "expect": {
            "exit": 126,
            "stderr": "cat: Permission denied\n"
          }
        },
        {
          "command": "'cat' \"/ram/secret\"",
          "expect": {
            "exit": 1,
            "stderr": "cat: /ram/secret: Permission denied\n"
          }
        },
        {
          "command": "ls /ram | xargs rm",
          "expect": {
            "exit": 126,
            "stderr": "rm: Permission denied\n"
          }
        },
        {
          "command": "ls /ram | xargs cat",
          "expect": {
            "exit": 126,
            "stderr": "cat: Permission denied\n"
          }
        },
        {
          "command": "sh -c 'timeout 5 rm /ram/x'",
          "expect": {
            "exit": 126,
            "stderr": "rm: Permission denied\n"
          }
        },
        {
          "command": "source /ram/env.sh",
          "expect": {
            "exit": 126,
            "stderr": "source: Permission denied\n"
          }
        },
        {
          "command": "bash --restricted -c 'rm /ram/x'",
          "expect": {
            "exit": 126,
            "stderr": "bash: Permission denied\n"
          }
        },
        {
          "command": "bash --version",
          "expect": {
            "exit": 0,
            "stdout": "box:bash --version\n"
          }
        },
        {
          "command": "unset SKIP; bash --rcfile $SKIP --version -c 'rm /ram/x'",
          "expect": {
            "exit": 126,
            "stderr": "bash: Permission denied\n"
          }
        },
        {
          "command": "shopt -s nullglob; bash --rcfile missing-* --version -c 'rm /ram/x'",
          "expect": {
            "exit": 126,
            "stderr": "bash: Permission denied\n"
          }
        },
        {
          "command": "bash --rcfile missing-[ab] --version -c 'rm /ram/x'",
          "expect": {
            "exit": 126,
            "stderr": "bash: Permission denied\n"
          }
        },
        {
          "command": "bash --rcfile missing-\"*\" --version -c 'rm /ram/x'",
          "expect": {
            "exit": 0,
            "stdout": "box:bash --rcfile missing-\"*\" --version -c 'rm /ram/x'\n"
          }
        },
        {
          "command": "bash --rcfile missing-\\* --version -c 'rm /ram/x'",
          "expect": {
            "exit": 0,
            "stdout": "box:bash --rcfile missing-\\* --version -c 'rm /ram/x'\n"
          }
        },
        {
          "command": "bash --rcfile 'missing-*' --version -c 'rm /ram/x'",
          "expect": {
            "exit": 0,
            "stdout": "box:bash --rcfile 'missing-*' --version -c 'rm /ram/x'\n"
          }
        },
        {
          "command": "unset SKIP; sh --init-file $SKIP --help -c 'rm /ram/x'",
          "expect": {
            "exit": 126,
            "stderr": "sh: Permission denied\n"
          }
        },
        {
          "command": "SKIP='rc -c rm'; bash --rcfile $SKIP --version -c 'echo safe'",
          "expect": {
            "exit": 126,
            "stderr": "bash: Permission denied\n"
          }
        },
        {
          "command": "bash --rcfile rc --version -c 'rm /ram/x'",
          "expect": {
            "exit": 0,
            "stdout": "box:bash --rcfile rc --version -c 'rm /ram/x'\n"
          }
        },
        {
          "command": "bash --version $SKIP -c 'rm /ram/x'",
          "expect": {
            "exit": 0,
            "stdout": "box:bash --version $SKIP -c 'rm /ram/x'\n"
          }
        },
        {
          "command": "bash -c 'echo \"$1\"' name \"$ARG\"",
          "expect": {
            "exit": 0,
            "stdout": "box:bash -c 'echo \"$1\"' name \"$ARG\"\n"
          }
        },
        {
          "command": "echo \"$HOME\" $(date)",
          "expect": {
            "exit": 0,
            "stdout": "box:echo \"$HOME\" $(date)\n"
          }
        },
        {
          "command": "ls /ram | xargs echo",
          "expect": {
            "exit": 0,
            "stdout": "box:ls /ram | xargs echo\n"
          }
        },
        {
          "command": "cat /ram/a",
          "expect": {
            "exit": 0,
            "stdout": "box:cat /ram/a\n"
          }
        }
      ]
    },
    {
      "id": "whole_line_coded_policy",
      "note": "A whole-line runtime expands the line itself, so a pre_command policy reads it as typed. While one is installed, in code or in the profile, a word only the runtime can expand and a line the gate cannot read are refused, as under a rule that reads every command's arguments.",
      "world": {
        "machines": {
          "echobox": {
            "provider": "in_process",
            "runtime": "echobox",
            "captures": [
              "@line"
            ]
          }
        },
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        },
        "policies": [
          {
            "name": "deny_flag",
            "command": "rm",
            "flag": "-rf",
            "reason": "no recursive deletes"
          }
        ]
      },
      "steps": [
        {
          "command": "rm -rf /ram/x",
          "expect": {
            "exit": 126,
            "stderr": "rm: Permission denied\n"
          }
        },
        {
          "command": "F=-rf; rm $F /ram/x",
          "expect": {
            "exit": 126,
            "stderr": "rm: Permission denied\n"
          }
        },
        {
          "command": "echo 'rm -rf /ram/x' | sh",
          "expect": {
            "exit": 126,
            "stderr": "sh: Permission denied\n"
          }
        },
        {
          "command": "r? -rf /ram/x",
          "expect": {
            "exit": 126,
            "stderr": "r?: Permission denied\n"
          }
        },
        {
          "command": "rm -r? /ram/x",
          "expect": {
            "exit": 126,
            "stderr": "rm: Permission denied\n"
          }
        },
        {
          "command": "[[ abc == a* ]]",
          "expect": {
            "exit": 0,
            "stdout": "box:[[ abc == a* ]]\n"
          }
        },
        {
          "command": "rm /ram/x",
          "expect": {
            "exit": 0,
            "stdout": "box:rm /ram/x\n"
          }
        }
      ]
    },
    {
