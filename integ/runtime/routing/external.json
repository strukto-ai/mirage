{
  "cases": [
    {
      "id": "public_process_capability",
      "world": {
        "register_runtimes": {
          "processbox": "processbox"
        },
        "runtimes": [
          "processbox"
        ]
      },
      "steps": [
        {
          "command": "native-tool 'a b' '$(echo literal)' '' | grep native-tool > /ram/argv.json",
          "expect": {
            "exit": 0,
            "stdout": ""
          }
        },
        {
          "command": "cat /ram/argv.json",
          "expect": {
            "exit": 0,
            "stdout": "[\"native-tool\",\"a b\",\"$(echo literal)\",\"\"]\n"
          }
        }
      ]
    },
    {
      "id": "external_capture_path_policy",
      "world": {
        "register_runtimes": {
          "processbox": "processbox"
        },
        "runtimes": [
          {
            "name": "processbox",
            "captures": [
              "cat",
              "grep"
            ]
          }
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram",
            "files": {
              "secret.txt": "secret\n",
              "public.txt": "public\n"
            }
          }
        },
        "profiles": {
          "default": {
            "commands": {
              "deny": [
                {
                  "reason": "protected",
                  "commands": {
                    "cat": [
                      "/ram/secret.txt"
                    ],
                    "grep": [
                      "/ram/secret.txt"
                    ]
                  }
                }
              ]
            }
          }
        }
      },
      "steps": [
        {
          "command": "cd /ram",
          "expect": {
            "exit": 0
          }
        },
        {
          "command": "cat secret.txt",
          "expect": {
            "exit": 1,
            "stdout": "",
            "stderr": "cat: secret.txt: Permission denied\n"
          }
        },
        {
          "command": "cat s*.txt",
          "expect": {
            "exit": 1,
            "stdout": "",
            "stderr": "cat: secret.txt: Permission denied\n"
          }
        },
        {
          "command": "grep secret.txt public*.txt",
          "expect": {
            "exit": 0,
            "stdout": "[\"grep\",\"secret.txt\",\"public.txt\"]\n"
          }
        }
      ]
    },
    {
      "id": "external_wrapper_admits_its_program",
      "world": {
        "register_runtimes": {
          "processbox": "processbox"
        },
        "runtimes": [
          "processbox"
        ],
        "profiles": {
          "default": {
            "commands": {
              "allow": [
                "nohup",
                "nice",
                "ionice",
                "time",
                "echo"
              ]
            }
          }
        }
      },
      "steps": [
        {
          "command": "native-tool a",
          "expect": {
            "exit": 126,
            "stdout": "",
            "stderr": "native-tool: Permission denied\n"
          }
        },
        {
          "command": "nohup native-tool a",
          "expect": {
            "exit": 126,
            "stdout": "",
            "stderr": "native-tool: Permission denied\n"
          }
        },
        {
          "command": "nice -n 5 native-tool a",
          "expect": {
            "exit": 126,
            "stdout": "",
            "stderr": "native-tool: Permission denied\n"
          }
        },
        {
          "command": "nohup ionice -c 3 native-tool a",
          "expect": {
            "exit": 126,
            "stdout": "",
            "stderr": "native-tool: Permission denied\n"
          }
        },
        {
          "command": "nohup time native-tool a",
          "expect": {
            "exit": 126,
            "stdout": "",
            "stderr": "native-tool: Permission denied\n"
          }
        },
        {
          "command": "nohup /usr/bin/native-tool a",
          "expect": {
            "exit": 126,
            "stdout": "",
            "stderr": "/usr/bin/native-tool: Permission denied\n"
          }
        },
        {
          "command": "/opt/native-tool a",
          "expect": {
            "exit": 126,
            "stdout": "",
            "stderr": "/opt/native-tool: Permission denied\n"
          }
        },
        {
          "command": "nohup echo hi",
          "expect": {
            "exit": 0,
            "stdout": "hi\n"
          }
        }
      ]
    },
    {
      "id": "external_capture_expands_text_slot_globs",
      "world": {
        "register_runtimes": {
          "processbox": "processbox"
        },
        "runtimes": [
          {
            "name": "processbox",
            "captures": [
              "grep",
              "python3"
            ]
          }
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram",
            "files": {
              "a.txt": "a\n",
              "b.txt": "b\n",
              "secret.txt": "secret\n",
              ".hidden.txt": "hidden\n",
              "x=1": "one\n"
            }
          }
        },
        "profiles": {
          "default": {
            "commands": {
              "deny": [
                {
                  "reason": "protected",
                  "commands": {
                    "grep": [
                      "/ram/secret.txt"
                    ]
                  }
                }
              ]
            }
          }
        }
      },
      "steps": [
        {
          "command": "cd /ram",
          "expect": {
            "exit": 0
          }
        },
        {
          "command": "python3 s.py *.txt",
          "expect": {
            "exit": 0,
            "stdout": "[\"python3\",\"s.py\",\"a.txt\",\"b.txt\",\"secret.txt\"]\n"
          }
        },
        {
          "command": "python3 -c p /ram/?.txt",
          "expect": {
            "exit": 0,
            "stdout": "[\"python3\",\"-c\",\"p\",\"/ram/a.txt\",\"/ram/b.txt\"]\n"
          }
        },
        {
          "command": "python3 s.py .*.txt x=*",
          "expect": {
            "exit": 0,
            "stdout": "[\"python3\",\"s.py\",\".hidden.txt\",\"x=1\"]\n"
          }
        },
        {
          "command": "python3 s.py '*.txt' \\*.txt *.none",
          "expect": {
            "exit": 0,
            "stdout": "[\"python3\",\"s.py\",\"*.txt\",\"*.txt\",\"*.none\"]\n"
          }
        },
        {
          "command": "grep *.txt",
          "expect": {
            "exit": 1,
            "stdout": "",
            "stderr": "grep: secret.txt: Permission denied\n"
          }
        },
        {
          "command": "grep s*.txt a.txt",
          "expect": {
            "exit": 0,
            "stdout": "[\"grep\",\"secret.txt\",\"a.txt\"]\n"
          }
        }
      ]
    },
    {
      "id": "interpreter_script_path_policy",
      "note": "An interpreter's script operand is a file the runtime reads on its own machine, so the gate types it as a path and a path rule refuses it before the line is handed over, whatever option run precedes it. The words after the script, and every operand once -c, -m or -e named the program, are the program's argv and reach the runtime as typed. A lone dash selects stdin and carries no path, while ./-, absolute dash filenames and stdin redirects still name protected files.",
      "world": {
        "register_runtimes": {
          "processbox": "processbox"
        },
        "runtimes": [
          {
            "name": "processbox",
            "captures": [
              "python",
              "python3",
              "js",
              "node"
            ]
          }
        ],
        "mounts": {
          "/vault": {
            "vfs": "ram"
          }
        },
        "profiles": {
          "default": {
            "commands": {
              "deny": [
                {
                  "reason": "credentials are never read by hand",
                  "paths": [
                    "/vault/*"
                  ]
                }
              ]
            }
          }
        }
      },
      "steps": [
        {
          "command": "python3 /vault/steal.py",
          "expect": {
            "exit": 1,
            "stdout": "",
            "stderr": "python3: /vault/steal.py: Permission denied\n"
          }
        },
        {
          "command": "node /vault/steal.js",
          "expect": {
            "exit": 1,
            "stdout": "",
            "stderr": "node: /vault/steal.js: Permission denied\n"
          }
        },
        {
          "command": "python3 -u /vault/steal.py",
          "expect": {
            "exit": 1,
            "stdout": "",
            "stderr": "python3: /vault/steal.py: Permission denied\n"
          }
        },
        {
          "command": "python3 -W ignore -- /vault/steal.py",
          "expect": {
            "exit": 1,
            "stdout": "",
            "stderr": "python3: /vault/steal.py: Permission denied\n"
          }
        },
        {
          "command": "cd /vault",
          "expect": {
            "exit": 0
          }
        },
        {
          "command": "python3 steal.py",
          "expect": {
            "exit": 1,
            "stdout": "",
            "stderr": "python3: steal.py: Permission denied\n"
          }
        },
        {
          "command": "node steal.js",
          "expect": {
            "exit": 1,
            "stdout": "",
            "stderr": "node: steal.js: Permission denied\n"
          }
        },
        {
          "command": "python3 -c 'print(1)' steal.py",
          "expect": {
            "exit": 0,
            "stdout": "[\"python3\",\"-c\",\"print(1)\",\"steal.py\"]\n"
          }
        },
        {
          "command": "python3 -m json.tool steal.py",
          "expect": {
            "exit": 0,
            "stdout": "[\"python3\",\"-m\",\"json.tool\",\"steal.py\"]\n"
          }
        },
        {
          "command": "node -e 1 steal.js",
          "expect": {
            "exit": 0,
            "stdout": "[\"node\",\"-e\",\"1\",\"steal.js\"]\n"
          }
        },
        {
          "command": "python - /vault/arg",
          "stdin": "print(1)\n",
          "expect": {
            "exit": 0,
            "stdout": "[\"python\",\"-\",\"/vault/arg\"]\n",
            "stderr": ""
          }
        },
        {
          "command": "python3 -u -- - -c x",
          "stdin": "print(1)\n",
          "expect": {
            "exit": 0,
            "stdout": "[\"python3\",\"-u\",\"--\",\"-\",\"-c\",\"x\"]\n",
            "stderr": ""
          }
        },
        {
          "command": "js -- - /vault/arg",
          "stdin": "print(1)\n",
          "expect": {
            "exit": 0,
            "stdout": "[\"js\",\"--\",\"-\",\"/vault/arg\"]\n",
            "stderr": ""
          }
        },
        {
          "command": "node - -e x",
          "stdin": "print(1)\n",
          "expect": {
            "exit": 0,
            "stdout": "[\"node\",\"-\",\"-e\",\"x\"]\n",
            "stderr": ""
          }
        },
        {
          "command": "python -- ./-",
          "expect": {
            "exit": 1,
            "stdout": "",
            "stderr": "python: ./-: Permission denied\n"
          }
        },
        {
          "command": "python3 -- /vault/-",
          "expect": {
            "exit": 1,
            "stdout": "",
            "stderr": "python3: /vault/-: Permission denied\n"
          }
        },
        {
          "command": "js -- ./-",
          "expect": {
            "exit": 1,
            "stdout": "",
            "stderr": "js: ./-: Permission denied\n"
          }
        },
        {
          "command": "node -- /vault/-",
          "expect": {
            "exit": 1,
            "stdout": "",
            "stderr": "node: /vault/-: Permission denied\n"
          }
        },
        {
          "command": "python3 - < /vault/secret.py",
          "expect": {
            "exit": 1,
            "stdout": "",
            "stderr": "python3: /vault/secret.py: Permission denied\n"
          }
        }
      ]
    },
    {
      "id": "native_captures_preserve_shell_builtins",
      "world": {
        "register_runtimes": {
          "processbox": "processbox"
        },
        "runtimes": [
          {
            "name": "processbox",
            "captures": [
              "cd",
              "export",
              "echo",
              "pwd",
              "printf",
              "type",
              "python3",
              "node"
            ]
          }
        ]
      },
      "steps": [
        {
          "command": "cd /ram; export BUILTIN_VALUE=kept; printf \"%s\\n\" \"$BUILTIN_VALUE\"; echo shell; pwd; type -a echo",
          "expect": {
            "exit": 0,
            "stdout": "kept\nshell\n/ram\necho is a shell builtin\necho is /usr/bin/echo\n"
          }
        },
        {
          "command": "python3 --version",
          "expect": {
            "exit": 0,
            "stdout": "[\"python3\",\"--version\"]\n"
          }
        },
        {
          "command": "node --version",
          "expect": {
            "exit": 0,
            "stdout": "[\"node\",\"--version\"]\n"
          }
        }
      ]
    },
    {
      "id": "a_wrapper_runs_where_the_program_it_runs_is_captured",
      "world": {
        "register_runtimes": {
          "processbox": "processbox"
        },
        "runtimes": [
          {
            "name": "processbox",
            "captures": [
              "@external"
            ]
          },
          {
            "name": "echobox",
            "captures": [
              "gcc"
            ]
          },
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "nice -n 5 gcc x.c",
          "expect": {
            "exit": 0,
            "stdout": "box:nice -n 5 gcc x.c\n"
          }
        },
        {
          "command": "nice nohup gcc x.c",
          "expect": {
            "exit": 0,
            "stdout": "box:nice nohup gcc x.c\n"
          }
        },
        {
          "command": "nice make",
          "expect": {
            "exit": 0,
            "stdout": "[\"nice\",\"make\"]\n"
          }
        }
      ]
    },
    {
      "id": "a_wrapper_around_a_mirage_command_runs_it_in_mirage",
      "world": {
        "register_runtimes": {
          "processbox": "processbox"
        },
        "runtimes": [
          {
            "name": "processbox",
            "captures": [
              "@external"
            ]
          },
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram",
            "files": {
              "f": "python here\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "nice -n 5 grep python /ram/f",
          "expect": {
            "exit": 0,
            "stdout": "python here\n"
          }
        },
        {
          "command": "nice nohup cat /ram/f",
          "expect": {
            "exit": 0,
            "stdout": "python here\n"
          }
        },
        {
          "command": "nice make",
          "expect": {
            "exit": 0,
            "stdout": "[\"nice\",\"make\"]\n"
          }
        }
      ]
    },
    {
      "id": "a_wrapper_refuses_a_shell_word_and_a_bad_option_as_gnu_does",
      "world": {
        "mounts": {
          "/ram": {
            "vfs": "ram",
            "files": {
              "f": "kept\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "nice cd /ram",
          "expect": {
            "exit": 127,
            "stdout": "",
            "stderr": "nice: 'cd': No such file or directory\n"
          }
        },
        {
          "command": "pwd",
          "expect": {
            "exit": 0,
            "stdout": "/\n"
          }
        },
        {
          "command": "nice --bogus rm /ram/f",
          "expect": {
            "exit": 125,
            "stdout": "",
            "stderr": "nice: unrecognized option '--bogus'\nTry 'nice --help' for more information.\n"
          }
        },
        {
          "command": "cat /ram/f",
          "expect": {
            "exit": 0,
            "stdout": "kept\n"
          }
        }
      ]
    },
    {
      "id": "a_group_takes_both_interpreter_names",
      "note": "@python is python3 and python, so one entry moves both to the runtime; a tool such as pip is no interpreter name and reaches the runtime through @external.",
      "world": {
        "register_runtimes": {
          "processbox": "processbox"
        },
        "runtimes": [
          {
            "name": "processbox",
            "captures": [
              "@python",
              "@external"
            ]
          }
        ]
      },
      "steps": [
        {
          "command": "python3 -c 'print(1)'",
          "expect": {
            "exit": 0,
            "stdout": "[\"python3\",\"-c\",\"print(1)\"]\n"
          }
        },
        {
          "command": "python -c 'print(2)'",
          "expect": {
            "exit": 0,
            "stdout": "[\"python\",\"-c\",\"print(2)\"]\n"
          }
        },
        {
          "command": "pip install x",
          "expect": {
            "exit": 0,
            "stdout": "[\"pip\",\"install\",\"x\"]\n"
          }
        }
      ]
    },
    {
      "id": "external_wrapper_goes_where_its_program_is_placed",
      "world": {
        "register_runtimes": {
          "processbox": "processbox"
        },
        "runtimes": [
          "processbox",
          {
            "name": "echobox",
            "captures": [
              "@external"
            ]
          }
        ],
        "policies": [
          {
            "name": "place_command",
            "contains": "native-tool",
            "runtime": "echobox"
          }
        ]
      },
      "steps": [
        {
          "command": "other-tool a",
          "expect": {
            "exit": 0,
            "stdout": "[\"other-tool\",\"a\"]\n"
          }
        },
        {
          "command": "native-tool a",
          "expect": {
            "exit": 0,
            "stdout": "box:native-tool a\n"
          }
        },
        {
          "command": "nohup native-tool a",
          "expect": {
            "exit": 0,
            "stdout": "box:nohup native-tool a\n"
          }
        },
        {
          "command": "nice -n 5 native-tool a",
          "expect": {
            "exit": 0,
            "stdout": "box:nice -n 5 native-tool a\n"
          }
        },
        {
          "command": "nohup other-tool a",
          "expect": {
            "exit": 0,
            "stdout": "[\"nohup\",\"other-tool\",\"a\"]\n"
          }
        }
      ]
    },
    {
      "id": "external_path_mirage_has_no_file_for",
      "world": {
        "register_runtimes": {
          "processbox": "processbox"
        },
        "runtimes": [
          "processbox"
        ]
      },
      "steps": [
        {
          "command": "/opt/native-tool a",
          "expect": {
            "exit": 0,
            "stdout": "[\"/opt/native-tool\",\"a\"]\n"
          }
        },
        {
          "command": "env /opt/native-tool a",
          "expect": {
            "exit": 0,
            "stdout": "[\"/opt/native-tool\",\"a\"]\n"
          }
        },
        {
          "command": "printf 'echo in-mirage\\n' > /ram/s.sh; /ram/s.sh",
          "expect": {
            "exit": 0,
            "stdout": "in-mirage\n"
          }
        },
        {
          "command": "./native-tool a",
          "expect": {
            "exit": 127,
            "stdout": "",
            "stderr": "bash: line 1: ./native-tool: No such file or directory\n"
          }
        }
      ]
    }
  ]
}
