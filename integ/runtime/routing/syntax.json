{
  "cases": [
    {
      "id": "syntax_error_exit2",
      "world": {
        "runtimes": [
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "echo (",
          "expect": {
            "exit": 2,
            "stderr": "mirage: syntax error near '('\n"
          }
        }
      ]
    },
    {
      "id": "syntax_error_unclamped",
      "world": {
        "runtimes": [
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "if ; this-is-a-deliberately-long-unparsable-line-well-past-forty-chars",
          "expect": {
            "exit": 2,
            "stderr": "mirage: syntax error near 'if ; this-is-a-deliberately-long-unparsable-line-well-past-forty-chars'\n"
          }
        }
      ]
    },
    {
      "id": "syntax_error_beats_policy",
      "world": {
        "runtimes": [
          "monty",
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        },
        "route_policy": "{'deny': 'nothing runs'}"
      },
      "steps": [
        {
          "command": "echo (",
          "expect": {
            "exit": 2,
            "stderr_contains": "syntax error"
          }
        },
        {
          "command": "echo hi",
          "expect": {
            "exit": 126,
            "stderr_contains": "echo: Permission denied"
          }
        }
      ]
    }
  ]
}
