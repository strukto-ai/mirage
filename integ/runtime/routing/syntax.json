{
  "cases": [
    {
      "id": "syntax_error_exit2",
      "world": {
        "machines": {},
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "echo (",
          "expect": {
            "exit": 2,
            "stderr": "bash: -c: line 1: syntax error near unexpected token `newline'\nbash: -c: line 1: `echo ('\n"
          }
        }
      ]
    },
    {
      "id": "syntax_error_unclamped",
      "world": {
        "machines": {},
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "echo ( this-is-a-deliberately-long-unparsable-line-well-past-forty-chars",
          "expect": {
            "exit": 2,
            "stderr": "bash: -c: line 1: syntax error near unexpected token `this-is-a-deliberately-long-unparsable-line-well-past-forty-chars'\nbash: -c: line 1: `echo ( this-is-a-deliberately-long-unparsable-line-well-past-forty-chars'\n"
          }
        }
      ]
    },
    {
      "id": "syntax_error_beats_policy",
      "world": {
        "machines": {
          "monty": {
            "provider": "worker"
          }
        },
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        },
        "policies": [
          {
            "name": "place_line",
            "contains": "echo",
            "deny": "nothing runs"
          }
        ]
      },
      "steps": [
        {
          "command": "echo (",
          "expect": {
            "exit": 2,
            "stderr_contains": "syntax error"
          }
        },
        {
          "command": "echo hi",
          "expect": {
            "exit": 126,
            "stderr_contains": "echo: Permission denied"
          }
        }
      ]
    }
  ]
}
