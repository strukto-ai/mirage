{
  "cases": [
    {
      "id": "default_world_runs_no_interpreter",
      "world": {},
      "steps": [
        {
          "command": "python3 -c \"print(6 * 7)\"",
          "expect": {
            "exit": 127,
            "stdout": "",
            "stderr": "python3: command not found\n"
          }
        },
        {
          "command": "node -e \"console.log(1)\"",
          "expect": {
            "exit": 127,
            "stdout": "",
            "stderr": "node: command not found\n"
          }
        },
        {
          "command": "command -v python3",
          "expect": {
            "exit": 1,
            "stdout": "",
            "stderr": ""
          }
        }
      ]
    }
  ]
}
