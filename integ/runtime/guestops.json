        "runtimes": ["quickjs", "vfs"],
        "mounts": { "/data": { "resource": "ram", "files": { "seed.txt": "seed\n" } } }
      },
      "steps": [
        {
          "command": "js -e \"const f = std.open('/data/seed.txt', 'w'); f.close()\"",
          "expect": {
            "exit": 0,
            "ops_contain": ["truncate /data/seed.txt"],
            "ops_absent": ["create /data/seed.txt"]
