        "mounts": { "/data": { "resource": "ram", "files": { "seed.txt": "seed\n" } } }
      },
      "steps": [
        {
          "command": "js -e \"std.open('/data/seed.txt', 'rr')\"",
          "expect": {
            "exit": 1,
            "stderr_contains": "invalid file mode"
