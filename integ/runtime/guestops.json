      "hosts": ["typescript"],
      "world": {
        "runtimes": ["pyodide", "vfs"],
        "mounts": { "/data": { "resource": "ram", "files": { "seed.txt": "seed\n" } } }
      },
      "steps": [
        {
          "command": "python3 -c \"open('/data/nope.txt', 'r+')\"",
          "expect": {
            "exit": 1,
            "stderr_contains": "FileNotFoundError"
          }
