      "hosts": ["typescript"],
      "world": {
        "runtimes": ["quickjs", "vfs"],
        "mounts": { "/data": { "resource": "ram", "files": { "seed.txt": "seed\n" } } }
      },
      "steps": [
        {
          "command": "js -e \"console.log(std.open('/data/seed.txt', 'wx') === null)\"",
          "expect": {
