{
  "suite": "ssh",
  "requires": [
    "env:MIRAGE_INTEG_SSH_HOST"
  ],
  "cases": [
    {
      "id": "echo",
      "world": {
        "runtimes": [
          {
            "name": "ssh",
            "captures": [
              "*"
            ],
            "config": {
              "host": "${MIRAGE_INTEG_SSH_HOST}",
              "port": 2222,
              "username": "${MIRAGE_INTEG_SSH_USERNAME}",
              "identity_file": "${MIRAGE_INTEG_SSH_KEY}"
            }
          },
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "echo hi-from-ssh-box",
          "expect": {
            "exit": 0,
            "stdout": "hi-from-ssh-box\n"
          }
        }
      ]
    },
    {
      "id": "exit_code",
      "world": {
        "runtimes": [
          {
            "name": "ssh",
            "captures": [
              "*"
            ],
            "config": {
              "host": "${MIRAGE_INTEG_SSH_HOST}",
              "port": 2222,
              "username": "${MIRAGE_INTEG_SSH_USERNAME}",
              "identity_file": "${MIRAGE_INTEG_SSH_KEY}"
            }
          },
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "sh -c 'exit 7'",
          "expect": {
            "exit": 7
          }
        }
      ]
    },
    {
      "id": "stdin",
      "world": {
        "runtimes": [
          {
            "name": "ssh",
            "captures": [
              "*"
            ],
            "config": {
              "host": "${MIRAGE_INTEG_SSH_HOST}",
              "port": 2222,
              "username": "${MIRAGE_INTEG_SSH_USERNAME}",
              "identity_file": "${MIRAGE_INTEG_SSH_KEY}"
            }
          },
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "wc -l",
          "stdin": "a\nb\nc\n",
          "expect": {
            "exit": 0,
            "stdout": "3\n"
          }
        }
      ]
    },
    {
      "id": "stdin_absent_eof",
      "world": {
        "runtimes": [
          {
            "name": "ssh",
            "captures": [
              "*"
            ],
            "config": {
              "host": "${MIRAGE_INTEG_SSH_HOST}",
              "port": 2222,
              "username": "${MIRAGE_INTEG_SSH_USERNAME}",
              "identity_file": "${MIRAGE_INTEG_SSH_KEY}"
            }
          },
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "timeout 5 wc -c",
          "expect": {
            "exit": 0,
            "stdout": "0\n"
          }
        }
      ]
    },
    {
      "id": "stdin_empty_eof",
      "world": {
        "runtimes": [
          {
            "name": "ssh",
            "captures": [
              "*"
            ],
            "config": {
              "host": "${MIRAGE_INTEG_SSH_HOST}",
              "port": 2222,
              "username": "${MIRAGE_INTEG_SSH_USERNAME}",
              "identity_file": "${MIRAGE_INTEG_SSH_KEY}"
            }
          },
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "timeout 5 wc -c",
          "expect": {
            "exit": 0,
            "stdout": "0\n"
          },
          "stdin": ""
        }
      ]
    },
    {
      "id": "config_env",
      "world": {
        "runtimes": [
          {
            "name": "ssh",
            "captures": [
              "*"
            ],
            "config": {
              "host": "${MIRAGE_INTEG_SSH_HOST}",
              "port": 2222,
              "username": "${MIRAGE_INTEG_SSH_USERNAME}",
              "identity_file": "${MIRAGE_INTEG_SSH_KEY}",
              "env": {
                "BOX_MARKER": "from config"
              }
            }
          },
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "echo \"$BOX_MARKER\"",
          "expect": {
            "exit": 0,
            "stdout": "from config\n"
          }
        }
      ]
    },
    {
      "id": "quoting",
      "world": {
        "runtimes": [
          {
            "name": "ssh",
            "captures": [
              "*"
            ],
            "config": {
              "host": "${MIRAGE_INTEG_SSH_HOST}",
              "port": 2222,
              "username": "${MIRAGE_INTEG_SSH_USERNAME}",
              "identity_file": "${MIRAGE_INTEG_SSH_KEY}"
            }
          },
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "printf '%s\\n' \"it's\" 'two  spaces'",
          "expect": {
            "exit": 0,
            "stdout": "it's\ntwo  spaces\n"
          }
        }
      ]
    },
    {
      "id": "line_timeout",
      "world": {
        "runtimes": [
          {
            "name": "ssh",
            "captures": [
              "*"
            ],
            "config": {
              "host": "${MIRAGE_INTEG_SSH_HOST}",
              "port": 2222,
              "username": "${MIRAGE_INTEG_SSH_USERNAME}",
              "identity_file": "${MIRAGE_INTEG_SSH_KEY}"
            }
          },
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram",
            "limits": {
              "sleep": {
                "timeout_seconds": 1
              }
            }
          }
        }
      },
      "steps": [
        {
          "command": "sleep 5",
          "expect": {
            "exit": 124
          }
        }
      ]
    },
    {
      "id": "captured_only",
      "world": {
        "runtimes": [
          {
            "name": "ssh",
            "captures": [
              "uname"
            ],
            "config": {
              "host": "${MIRAGE_INTEG_SSH_HOST}",
              "port": 2222,
              "username": "${MIRAGE_INTEG_SSH_USERNAME}",
              "identity_file": "${MIRAGE_INTEG_SSH_KEY}"
            }
          },
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "uname",
          "expect": {
            "exit": 0,
            "stdout": "Linux\n"
          }
        },
        {
          "command": "echo local-vfs",
          "expect": {
            "exit": 0,
            "stdout": "local-vfs\n"
          }
        }
      ]
    }
  ]
}
