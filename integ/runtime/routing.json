{
  "suite": "routing",
  "cases": [
    {
      "id": "runtime_arg_per_line",
      "hosts": [
        "python"
      ],
      "world": {
        "runtimes": [
          "monty",
          "local",
          "vfs"
        ],
        "mounts": {
          "/ram": {
            "resource": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "python3 -c \"print(argv[0])\"",
          "expect": {
            "exit": 0,
            "stdout": "main.py\n"
          }
        },
        {
          "command": "python3 -c \"import sys; print('routed-to-local')\"",
          "runtime": "local",
          "expect": {
            "exit": 0,
            "stdout": "routed-to-local\n"
          }
        },
        {
          "command": "python3 -c \"print(argv[0])\"",
          "expect": {
            "exit": 0,
            "stdout": "main.py\n"
          }
        }
      ]
    },
    {
      "id": "entry_script_fallthrough",
      "hosts": [
        "python"
      ],
      "world": {
        "runtimes": [
          {
            "name": "monty",
            "script": "'use-local' not in ctx['line']"
          },
          "local",
          "vfs"
        ],
        "mounts": {
          "/ram": {
            "resource": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "python3 -c \"print(argv[0])\"",
          "expect": {
            "exit": 0,
            "stdout": "main.py\n"
          }
        },
        {
          "command": "python3 -c \"import sys; print('routed-to-local')\" && echo use-local",
          "expect": {
            "exit": 0,
            "stdout": "routed-to-local\nuse-local\n"
          }
        }
      ]
    },
    {
      "id": "entry_script_refused",
      "world": {
        "runtimes": [
          {
            "name": "monty",
            "script": "False"
          },
          "vfs"
        ],
        "mounts": {
          "/ram": {
            "resource": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "python3 -c \"x\"",
          "expect": {
            "exit": 126,
            "stderr": "mirage: python3: no runtime accepted this line\n"
          }
        },
        {
          "command": "echo vfs-open",
          "expect": {
            "exit": 0,
            "stdout": "vfs-open\n"
          }
        }
      ]
    },
    {
      "id": "global_route",
      "hosts": [
        "python"
      ],
      "world": {
        "runtimes": [
          "monty",
          "local",
          "vfs"
        ],
        "mounts": {
          "/ram": {
            "resource": "ram"
          }
        },
        "route": "'local' if 'go-local' in ctx['line'] else None"
      },
      "steps": [
        {
          "command": "python3 -c \"print(argv[0])\"",
          "expect": {
            "exit": 0,
            "stdout": "main.py\n"
          }
        },
        {
          "command": "python3 -c \"import sys; print('went-local')\" && echo go-local",
          "expect": {
            "exit": 0,
            "stdout": "went-local\ngo-local\n"
          }
        }
      ]
    },
    {
      "id": "add_runtime_local",
      "hosts": [
        "python"
      ],
      "world": {
        "runtimes": [
          "monty",
          "vfs"
        ],
        "mounts": {
          "/ram": {
            "resource": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "python3 -c \"x\"",
          "runtime": "local",
          "expect": {
            "throws_contains": "unknown runtime"
          }
        },
        {
          "add_runtime": "local"
        },
        {
          "command": "python3 -c \"import sys; print('added-local')\"",
          "runtime": "local",
          "expect": {
            "exit": 0,
            "stdout": "added-local\n"
          }
        }
      ]
    },
    {
      "id": "add_runtime_monty",
      "hosts": [
        "typescript"
      ],
      "world": {
        "runtimes": [
          "quickjs",
          "vfs"
        ],
        "mounts": {
          "/ram": {
            "resource": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "python3 -c \"x\"",
          "runtime": "monty",
          "expect": {
            "throws_contains": "unknown runtime"
          }
        },
        {
          "add_runtime": "monty"
        },
        {
          "command": "python3 -c \"print(40 + 2)\"",
          "runtime": "monty",
          "expect": {
            "exit": 0,
            "stdout": "42\n"
          }
        }
      ]
    },
    {
      "id": "ctx_command_pipeline",
      "world": {
        "runtimes": [
          {
            "name": "monty",
            "script": "ctx['command'] == 'python3'"
          },
          "vfs"
        ],
        "mounts": {
          "/ram": {
            "resource": "ram",
            "files": {
              "pipe.py": "print('came-through-pipe')"
            }
          }
        }
      },
      "steps": [
        {
          "command": "cat /ram/pipe.py | python3",
          "expect": {
            "exit": 0,
            "stdout": "came-through-pipe\n"
          }
        }
      ]
    },
    {
      "id": "runtime_arg_uncaptured_inert",
      "world": {
        "runtimes": [
          "monty"
        ],
        "mounts": {
          "/ram": {
            "resource": "ram",
            "files": {
              "a.txt": "hello\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "grep -r xxx /ram",
          "runtime": "monty",
          "expect": {
            "exit": 1,
            "stdout": ""
          }
        },
        {
          "command": "grep -r hello /ram",
          "runtime": "monty",
          "expect": {
            "exit": 0,
            "stdout": "/ram/a.txt:hello\n"
          }
        }
      ]
    },
    {
      "id": "runtime_arg_vfs_refused",
      "world": {
        "runtimes": [
          "monty"
        ]
      },
      "steps": [
        {
          "command": "echo hi",
          "runtime": "vfs",
          "expect": {
            "throws_contains": "not a runtime you can select"
          }
        }
      ]
    }
  ]
}
