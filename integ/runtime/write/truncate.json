{
  "cases": [
    {
      "id": "truncate_cuts_then_a_write_past_the_cut_leaves_zeros",
      "runtimes": [
        "wasi",
        "pyodide",
        "host"
      ],
      "backends": [
        "ram",
        "disk",
        "ssh",
        "s3",
        "redis",
        "ram+cache",
        "disk+cache",
        "redis+cache"
      ],
      "world": {
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "digits.txt": "0123456789"
            }
          }
        }
      },
      "steps": [
        {
          "program": {
            "python": "f = open('/data/digits.txt', 'r+')\nf.truncate(4)\nf.seek(6)\nf.write('Q')\nf.close()\nprint(repr(open('/data/digits.txt').read()))"
          },
          "expect": {
            "exit": 0,
            "stdout": "'0123\\x00\\x00Q'\n",
            "ops_contain": [
              "truncate /data/digits.txt"
            ]
          }
        }
      ]
    },
    {
      "id": "os_truncate_needs_no_handle",
      "runtimes": [
        "wasi",
        "pyodide",
        "host"
      ],
      "backends": [
        "ram",
        "disk",
        "ssh",
        "s3",
        "redis",
        "ram+cache",
        "disk+cache",
        "redis+cache"
      ],
      "world": {
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "digits.txt": "0123456789"
            }
          }
        }
      },
      "steps": [
        {
          "program": {
            "python": "import os\nos.truncate('/data/digits.txt', 3)"
          },
          "expect": {
            "exit": 0,
            "ops_contain": [
              "truncate /data/digits.txt"
            ]
          }
        },
        {
          "command": "cat /data/digits.txt",
          "expect": {
            "exit": 0,
            "stdout": "012"
          }
        },
        {
          "program": {
            "python": "import os\ntry:\n    os.truncate('/data/nope.txt', 3)\nexcept OSError as e:\n    print(type(e).__name__)"
          },
          "expect": {
            "exit": 0,
            "stdout": "FileNotFoundError\n",
            "ops_absent": [
              "create /data/nope.txt",
              "truncate /data/nope.txt"
            ]
          }
        }
      ]
    },
    {
      "id": "truncate_to_the_length_at_open_drops_what_another_handle_appended",
      "runtimes": [
        "wasi",
        "pyodide",
        "host"
      ],
      "backends": [
        "ram",
        "disk",
        "ssh",
        "s3",
        "redis",
        "ram+cache",
        "disk+cache",
        "redis+cache"
      ],
      "world": {
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "f.txt": "abcd"
            }
          }
        }
      },
      "steps": [
        {
          "program": {
            "python": "a = open('/data/f.txt', 'r+')\nwith open('/data/f.txt', 'a') as b:\n    b.write('XY')\na.truncate(4)\na.close()\nprint(repr(open('/data/f.txt').read()))"
          },
          "expect": {
            "exit": 0,
            "stdout": "'abcd'\n",
            "ops_contain": [
              "truncate /data/f.txt"
            ]
          }
        },
        {
          "command": "cat /data/f.txt",
          "expect": {
            "exit": 0,
            "stdout": "abcd"
          }
        }
      ]
    },
    {
      "id": "ftruncate_cuts_through_a_descriptor",
      "runtimes": [
        "wasi",
        "pyodide",
        "host"
      ],
      "backends": [
        "ram",
        "disk",
        "ssh",
        "s3",
        "redis",
        "ram+cache",
        "disk+cache",
        "redis+cache"
      ],
      "world": {
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "digits.txt": "0123456789"
            }
          }
        }
      },
      "steps": [
        {
          "program": {
            "python": "import os\nfd = os.open('/data/digits.txt', os.O_RDWR)\nos.ftruncate(fd, 3)\nprint(os.fstat(fd).st_size, os.pread(fd, 10, 0))\nos.close(fd)",
            "node": "const h = await require('node:fs').promises.open('/data/digits.txt', 'r+')\nawait h.truncate(3)\nconst { bytesRead, buffer } = await h.read(Buffer.alloc(10), 0, 10, 0)\nconsole.log((await h.stat()).size, buffer.toString('utf8', 0, bytesRead))\nawait h.close()"
          },
          "expect": {
            "python": {
              "exit": 0,
              "stdout": "3 b'012'\n"
            },
            "node": {
              "exit": 0,
              "stdout": "3 012\n"
            }
          }
        },
        {
          "command": "cat /data/digits.txt",
          "expect": {
            "exit": 0,
            "stdout": "012"
          }
        }
      ]
    }
  ]
}
