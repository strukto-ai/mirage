{
  "cases": [
    {
      "id": "truncate_cuts_then_a_write_past_the_cut_leaves_zeros",
      "runtimes": [
        "wasi",
        "pyodide"
      ],
      "backends": [
        "ram",
        "disk",
        "ssh",
        "s3",
        "redis"
      ],
      "world": {
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "digits.txt": "0123456789"
            }
          }
        }
      },
      "steps": [
        {
          "program": {
            "python": "f = open('/data/digits.txt', 'r+')\nf.truncate(4)\nf.seek(6)\nf.write('Q')\nf.close()\nprint(repr(open('/data/digits.txt').read()))"
          },
          "expect": {
            "exit": 0,
            "stdout": "'0123\\x00\\x00Q'\n",
            "ops_contain": [
              "truncate /data/digits.txt"
            ]
          }
        }
      ]
    },
    {
      "id": "os_truncate_needs_no_handle",
      "runtimes": [
        "wasi",
        "pyodide"
      ],
      "backends": [
        "ram",
        "disk",
        "ssh",
        "s3",
        "redis"
      ],
      "world": {
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "digits.txt": "0123456789"
            }
          }
        }
      },
      "steps": [
        {
          "program": {
            "python": "import os\nos.truncate('/data/digits.txt', 3)"
          },
          "expect": {
            "exit": 0,
            "ops_contain": [
              "truncate /data/digits.txt"
            ]
          }
        },
        {
          "command": "cat /data/digits.txt",
          "expect": {
            "exit": 0,
            "stdout": "012"
          }
        }
      ]
    }
  ]
}
