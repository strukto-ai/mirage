{
  "cases": [
    {
      "id": "a_file_left_open_lands_at_exit",
      "runtimes": [
        "wasi",
        "pyodide",
        "quickjs"
      ],
      "backends": [
        "ram",
        "disk",
        "ssh",
        "s3",
        "redis",
        "ram+cache",
        "disk+cache",
        "redis+cache"
      ],
      "world": {
        "mounts": {
          "/data": {
            "vfs": "ram"
          }
        }
      },
      "steps": [
        {
          "program": {
            "python": "import os\nfd = os.open('/data/out.txt', os.O_WRONLY | os.O_CREAT)\nos.write(fd, b'kept')\nos._exit(0)",
            "js": "const f = std.open('/data/out.txt', 'w')\nf.puts('kept')\nstd.exit(0)"
          },
          "expect": {
            "exit": 0
          }
        },
        {
          "command": "cat /data/out.txt",
          "expect": {
            "exit": 0,
            "stdout": "kept"
          }
        }
      ]
    },
    {
      "id": "a_run_its_deadline_stops_keeps_what_it_wrote",
      "note": "A write(2) a killed process made stays in its file, so a run timeout stops keeps what the program wrote, though it never closed the file. The JavaScript loop never yields. A first run compiles the WASI module before timing the guest. Pyodide creates a fresh interpreter for every run, so warming an earlier run cannot remove its startup from the deadline. The Python deadline includes room for that startup while the CLI and SDK batteries share a busy runner; both exit 124 and the retained file are required.",
      "runtimes": [
        "wasi",
        "pyodide",
        "quickjs"
      ],
      "backends": [
        "ram",
        "disk",
        "ssh",
        "s3",
        "redis",
        "ram+cache",
        "disk+cache",
        "redis+cache"
      ],
      "world": {
        "mounts": {
          "/data": {
            "vfs": "ram"
          }
        }
      },
      "steps": [
        {
          "program": {
            "python": "pass",
            "js": "0"
          },
          "expect": {
            "exit": 0
          }
        },
        {
          "command": {
            "python": "timeout 15 python3 -c 'import os\nfd = os.open(\"/data/out.txt\", os.O_WRONLY | os.O_CREAT)\nos.write(fd, b\"kept\")\nwhile True:\n    pass'",
            "js": "timeout 2 node -e \"const f = std.open('/data/out.txt', 'w'); f.puts('kept'); f.flush(); for (;;) {}\""
          },
          "expect": {
            "exit": 124,
            "stdout": ""
          }
        },
        {
          "command": "cat /data/out.txt",
          "expect": {
            "exit": 0,
            "stdout": "kept"
          }
        }
      ]
    },
    {
      "id": "a_caught_exit_still_ends_the_program",
      "runtimes": [
        "wasi",
        "pyodide"
      ],
      "world": {
        "mounts": {
          "/data": {
            "vfs": "ram"
          }
        }
      },
      "steps": [
        {
          "program": {
            "python": "import os\ntry:\n    os._exit(7)\nexcept BaseException:\n    pass\nopen('/data/after.txt', 'w').write('late')\nprint('after')"
          },
          "expect": {
            "exit": 7,
            "stdout": "",
            "ops_absent": [
              "create /data/after.txt"
            ]
          }
        },
        {
          "command": "ls /data",
          "expect": {
            "exit": 0,
            "stdout": ""
          }
        }
      ],
      "backends": [
        "ram",
        "disk",
        "ssh",
        "s3",
        "redis",
        "ram+cache",
        "disk+cache",
        "redis+cache"
      ]
    }
  ]
}
