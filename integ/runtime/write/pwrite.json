{
  "cases": [
    {
      "id": "os_pwrite_writes_at_an_offset",
      "runtimes": [
        "wasi",
        "pyodide"
      ],
      "backends": [
        "ram",
        "disk",
        "ssh",
        "s3",
        "redis"
      ],
      "world": {
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "digits.txt": "0123456789"
            }
          }
        }
      },
      "steps": [
        {
          "program": {
            "python": "import os\nfd = os.open('/data/digits.txt', os.O_RDWR)\nos.pwrite(fd, b'XY', 3)\nos.close(fd)"
          },
          "expect": {
            "exit": 0,
            "ops_contain": [
              "pwrite /data/digits.txt"
            ]
          },
          "expect_on": {
            "s3": {
              "ops_contain": [
                "write /data/digits.txt"
              ],
              "ops_absent": []
            },
            "redis": {
              "ops_contain": [
                "write /data/digits.txt"
              ],
              "ops_absent": []
            }
          }
        },
        {
          "command": "cat /data/digits.txt",
          "expect": {
            "exit": 0,
            "stdout": "012XY56789"
          }
        }
      ]
    },
    {
      "id": "a_write_past_the_end_leaves_zeros",
      "runtimes": [
        "wasi",
        "pyodide",
        "quickjs"
      ],
      "backends": [
        "ram",
        "disk",
        "ssh",
        "s3",
        "redis"
      ],
      "world": {
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "digits.txt": "0123456789"
            }
          }
        }
      },
      "steps": [
        {
          "program": {
            "python": "f = open('/data/digits.txt', 'r+b')\nf.seek(12)\nf.write(b'Z')\nf.close()\nprint(open('/data/digits.txt', 'rb').read())",
            "js": "const f = std.open('/data/digits.txt', 'r+')\nf.seek(12, 0)\nf.puts('Z')\nf.close()\nconsole.log(JSON.stringify(std.open('/data/digits.txt', 'r').readAsString()))"
          },
          "expect": {
            "exit": 0,
            "stdout": "b'0123456789\\x00\\x00Z'\n"
          },
          "expect_on": {
            "quickjs": {
              "stdout": "\"0123456789\\u0000\\u0000Z\"\n"
            }
          }
        }
      ]
    }
  ]
}
