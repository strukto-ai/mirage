{
  "requires": {
    "python": [],
    "typescript": [
      "env:S3_ENDPOINT"
    ]
  },
  "cases": [
    {
      "id": "multi_mount_script",
      "world": {
        "runtimes": [
          "monty",
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram",
            "files": {
              "data.txt": "hello from ram\n",
              "analyze.py": "from pathlib import Path\nram = Path('/ram/data.txt').read_text().strip()\ns3 = Path('/s3/greeting.txt').read_text().strip()\nprint('ram:', ram)\nprint('s3:', s3)\nprint('argv sum:', int(argv[1]) + int(argv[2]))\n"
            }
          },
          "/s3": {
            "vfs": "s3"
          }
        }
      },
      "steps": [
        {
          "command": "python3 /ram/analyze.py 40 2",
          "expect": {
            "exit": 0,
            "stdout": "ram: hello from ram\ns3: hello from s3\nargv sum: 42\n"
          }
        }
      ]
    },
    {
      "id": "link_op_limit",
      "world": {
        "runtimes": [
          "monty",
          "workspace"
        ],
        "mounts": {
          "/data": {
            "vfs": "ram",
            "limits": {
              "read": {
                "max_bytes": 8
              }
            }
          },
          "/r": {
            "vfs": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "echo 0123456789abcdef > /data/big.txt"
        },
        {
          "command": "ln -s /data/big.txt /r/link"
        },
        {
          "command": "python3 -c \"from pathlib import Path; print(Path('/r/link').read_text())\"",
          "expect": {
            "exit": 0,
            "stdout": "01234567\n"
          }
        }
      ]
    },
    {
      "id": "xmount_rename_refused",
      "world": {
        "runtimes": [
          "monty",
          "workspace"
        ],
        "mounts": {
          "/a": {
            "vfs": "ram"
          },
          "/b": {
            "vfs": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "echo moved-bytes > /a/x.txt"
        },
        {
          "rename": {
            "src": "/a/x.txt",
            "dst": "/b/y.txt"
          },
          "expect": {
            "errno": "EXDEV"
          }
        },
        {
          "command": "cat /a/x.txt",
          "expect": {
            "exit": 0,
            "stdout": "moved-bytes\n"
          }
        },
        {
          "command": "cat /a/b/y.txt",
          "expect": {
            "exit": 1
          }
        },
        {
          "command": "cat /b/y.txt",
          "expect": {
            "exit": 1
          }
        }
      ]
    }
  ]
}
