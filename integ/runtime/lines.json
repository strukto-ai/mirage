{
  "suite": "lines",
  "cases": [
    {
      "id": "public_process_capability",
      "world": {
        "register_runtimes": {
          "processbox": "processbox"
        },
        "runtimes": [
          "processbox"
        ]
      },
      "steps": [
        {
          "command": "native-tool 'a b' '$(echo literal)' '' | grep native-tool > /ram/argv.json",
          "expect": {
            "exit": 0,
            "stdout": ""
          }
        },
        {
          "command": "cat /ram/argv.json",
          "expect": {
            "exit": 0,
            "stdout": "[\"native-tool\",\"a b\",\"$(echo literal)\",\"\"]\n"
          }
        }
      ]
    },
    {
      "id": "external_script_pipeline_stage",
      "world": {
        "register_runtimes": {
          "processbox": "processbox"
        },
        "runtimes": [
          {
            "name": "processbox",
            "script": "ctx['command'] == 'native-tool' and not ctx['builtin']"
          },
          {
            "name": "monty",
            "captures": []
          },
          "vfs"
        ]
      },
      "steps": [
        {
          "command": "echo ok | native-tool",
          "expect": {
            "exit": 0,
            "stdout": "[\"native-tool\"]\n"
          }
        },
        {
          "command": "echo ok | denied-tool",
          "expect": {
            "exit": 126,
            "stderr": "denied-tool: no runtime accepted this line\n"
          }
        }
      ]
    },
    {
      "id": "external_capture_path_policy",
      "world": {
        "register_runtimes": {
          "processbox": "processbox"
        },
        "runtimes": [
          {
            "name": "processbox",
            "captures": [
              "cat",
              "grep"
            ]
          }
        ],
        "mounts": {
          "/ram": {
            "resource": "ram",
            "files": {
              "secret.txt": "secret\n",
              "public.txt": "public\n"
            }
          }
        },
        "profiles": {
          "default": {
            "commands": {
              "deny": [
                {
                  "reason": "protected",
                  "commands": {
                    "cat": [
                      "/ram/secret.txt"
                    ],
                    "grep": [
                      "/ram/secret.txt"
                    ]
                  }
                }
              ]
            }
          }
        }
      },
      "steps": [
        {
          "command": "cd /ram",
          "expect": {
            "exit": 0
          }
        },
        {
          "command": "cat secret.txt",
          "expect": {
            "exit": 1,
            "stdout": "",
            "stderr": "cat: secret.txt: protected\n"
          }
        },
        {
          "command": "cat s*.txt",
          "expect": {
            "exit": 1,
            "stdout": "",
            "stderr": "cat: secret.txt: protected\n"
          }
        },
        {
          "command": "grep secret.txt public*.txt",
          "expect": {
            "exit": 0,
            "stdout": "[\"grep\",\"secret.txt\",\"public.txt\"]\n"
          }
        }
      ]
    },
    {
      "id": "native_captures_preserve_shell_builtins",
      "world": {
        "register_runtimes": {
          "processbox": "processbox"
        },
        "runtimes": [
          {
            "name": "processbox",
            "captures": [
              "cd",
              "export",
              "echo",
              "pwd",
              "printf",
              "type",
              "python3",
              "node"
            ]
          }
        ]
      },
      "steps": [
        {
          "command": "cd /ram; export BUILTIN_VALUE=kept; printf \"%s\\n\" \"$BUILTIN_VALUE\"; echo shell; pwd; type -a echo",
          "expect": {
            "exit": 0,
            "stdout": "kept\nshell\n/ram\necho is a shell builtin\n"
          }
        },
        {
          "command": "python3 --version",
          "expect": {
            "exit": 0,
            "stdout": "[\"python3\",\"--version\"]\n"
          }
        },
        {
          "command": "node --version",
          "expect": {
            "exit": 0,
            "stdout": "[\"node\",\"--version\"]\n"
          }
        }
      ]
    },
    {
      "id": "captured_program_pipeline",
      "world": {
        "runtimes": [
          {
            "name": "echobox"
          },
          "vfs"
        ],
        "mounts": {
          "/ram": {
            "resource": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "nvidia-smi -L | grep box > /ram/output.txt",
          "expect": {
            "exit": 0,
            "stdout": ""
          }
        },
        {
          "command": "cat /ram/output.txt",
          "expect": {
            "exit": 0,
            "stdout": "box:nvidia-smi -L\n"
          }
        },
        {
          "command": "echo still-the-workspace",
          "expect": {
            "exit": 0,
            "stdout": "still-the-workspace\n"
          }
        }
      ]
    },
    {
      "id": "external_fallback_keeps_mirage_commands",
      "world": {
        "runtimes": [
          {
            "name": "echobox",
            "captures": [
              "@external"
            ]
          }
        ]
      },
      "steps": [
        {
          "command": "native-tool --version | grep box > /ram/version.txt",
          "expect": {
            "exit": 0,
            "stdout": ""
          }
        },
        {
          "command": "cat /ram/version.txt",
          "expect": {
            "exit": 0,
            "stdout": "box:native-tool --version\n"
          }
        },
        {
          "command": "echo mirage",
          "expect": {
            "exit": 0,
            "stdout": "mirage\n"
          }
        }
      ]
    },
    {
      "id": "whole_line_star",
      "world": {
        "runtimes": [
          {
            "name": "echobox",
            "captures": [
              "*"
            ],
            "script": "'keep-out' not in ctx['line']"
          },
          {
            "name": "monty",
            "captures": []
          },
          "vfs"
        ],
        "mounts": {
          "/ram": {
            "resource": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "ls /ram && echo done",
          "expect": {
            "exit": 0,
            "stdout": "box:ls /ram && echo done\n"
          }
        },
        {
          "command": "echo keep-out",
          "expect": {
            "exit": 0,
            "stdout": "keep-out\n"
          }
        }
      ]
    },
    {
      "id": "whole_line_literal_words",
      "note": "A whole-line runtime expands the line itself, so the gate reads it as typed: a word only the runtime could expand is refused where a rule in force would have read it (the command name under any rule, an argument where a rule reads that command's arguments), the lines a word runs (eval, sh -c, xargs, timeout) are admitted in turn, and a line the gate cannot see into (a sourced file) is refused. Literal words, and dynamic ones no rule reads, reach the runtime.",
      "world": {
        "runtimes": [
          {
            "name": "echobox",
            "captures": [
              "*"
            ]
          },
          "vfs"
        ],
        "mounts": {
          "/ram": {
            "resource": "ram"
          }
        },
        "profiles": {
          "default": {
            "commands": {
              "deny": [
                {
                  "reason": "no deletes",
                  "commands": [
                    "rm"
                  ]
                },
                {
                  "reason": "sealed",
                  "commands": {
                    "cat": [
                      "/ram/secret*"
                    ]
                  }
                }
              ]
            }
          }
        }
      },
      "steps": [
        {
          "command": "rm /ram/x",
          "expect": {
            "exit": 126,
            "stderr": "rm: Permission denied\n"
          }
        },
        {
          "command": "$cmd /ram/x",
          "expect": {
            "exit": 126,
            "stderr": "$cmd: Permission denied\n"
          }
        },
        {
          "command": "PAYLOAD='rm /ram/x'; eval \"$PAYLOAD\"",
          "expect": {
            "exit": 126,
            "stderr": "\"$PAYLOAD\": Permission denied\n"
          }
        },
        {
          "command": "eval 'rm /ram/x'",
          "expect": {
            "exit": 126,
            "stderr": "rm: Permission denied\n"
          }
        },
        {
          "command": "cat \"$f\"",
          "expect": {
            "exit": 126,
            "stderr": "cat: Permission denied\n"
          }
        },
        {
          "command": "'cat' \"/ram/secret\"",
          "expect": {
            "exit": 1,
            "stderr": "cat: /ram/secret: sealed\n"
          }
        },
        {
          "command": "ls /ram | xargs rm",
          "expect": {
            "exit": 126,
            "stderr": "rm: Permission denied\n"
          }
        },
        {
          "command": "ls /ram | xargs cat",
          "expect": {
            "exit": 126,
            "stderr": "cat: Permission denied\n"
          }
        },
        {
          "command": "sh -c 'timeout 5 rm /ram/x'",
          "expect": {
            "exit": 126,
            "stderr": "rm: Permission denied\n"
          }
        },
        {
          "command": "source /ram/env.sh",
          "expect": {
            "exit": 126,
            "stderr": "source: Permission denied\n"
          }
        },
        {
          "command": "echo \"$HOME\" $(date)",
          "expect": {
            "exit": 0,
            "stdout": "box:echo \"$HOME\" $(date)\n"
          }
        },
        {
          "command": "ls /ram | xargs echo",
          "expect": {
            "exit": 0,
            "stdout": "box:ls /ram | xargs echo\n"
          }
        },
        {
          "command": "cat /ram/a",
          "expect": {
            "exit": 0,
            "stdout": "box:cat /ram/a\n"
          }
        }
      ]
    }
  ]
}
