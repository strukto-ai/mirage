{
  "cases": [
    {
      "id": "a_program_meets_the_refusals_the_shell_meets",
      "runtimes": [
        "monty",
        "wasi",
        "pyodide",
        "quickjs",
        "host"
      ],
      "world": {
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "secret.txt": "s\n",
              "sealed/f.txt": "f\n",
              "open.txt": "o\n"
            }
          },
          "/ro": {
            "vfs": "ram",
            "mode": "read"
          }
        }
      },
      "steps": [
        {
          "profile": {
            "paths": {
              "hide": [
                "/data/secret.txt"
              ]
            },
            "commands": {
              "deny": [
                {
                  "reason": "sealed",
                  "paths": [
                    "/data/sealed/*"
                  ]
                }
              ]
            }
          }
        },
        {
          "program": {
            "python": "import os\ncalls = [('/data/secret.txt', 'r'), ('/data/sealed/f.txt', 'r'), ('/ro/new.txt', 'w'), ('/data/open.txt', 'r')]\nfor path, mode in calls:\n    try:\n        with open(path, mode) as f:\n            if mode == 'r':\n                f.read()\n            else:\n                f.write('x')\n        print('opened')\n    except OSError as e:\n        print(type(e).__name__)\nprint(' '.join(sorted(os.listdir('/data'))))",
            "node": "const fsp = require('node:fs').promises\nconst calls = [\n  () => fsp.readFile('/data/secret.txt'),\n  () => fsp.readFile('/data/sealed/f.txt'),\n  () => fsp.writeFile('/ro/new.txt', 'x'),\n  () => fsp.readFile('/data/open.txt'),\n]\nfor (const call of calls) {\n  try {\n    await call()\n    console.log('opened')\n  } catch (e) {\n    console.log(e.code)\n  }\n}\nconsole.log((await fsp.readdir('/data')).sort().join(' '))",
            "js": "const calls = [['/data/secret.txt', 'r'], ['/data/sealed/f.txt', 'r'], ['/ro/new.txt', 'w'], ['/data/open.txt', 'r']]\nfor (const [path, mode] of calls) {\n  const err = {}\n  const f = std.open(path, mode, err)\n  if (f === null) {\n    console.log(err.errno)\n    continue\n  }\n  if (mode === 'r') f.readAsString()\n  else f.puts('x')\n  const failed = f.error()\n  f.close()\n  console.log(failed ? 'failed' : 'opened')\n}\nconst [entries] = os.readdir('/data')\nconsole.log(entries.filter((n) => n !== '.' && n !== '..').sort().join(' '))"
          },
          "expect": {
            "python": {
              "exit": 0,
              "stdout": "FileNotFoundError\nPermissionError\nOSError\nopened\nopen.txt sealed\n",
              "ops_absent": [
                "read /data/secret.txt",
                "read /data/sealed/f.txt",
                "create /ro/new.txt"
              ]
            },
            "node": {
              "exit": 0,
              "stdout": "ENOENT\nEACCES\nEROFS\nopened\nopen.txt sealed\n",
              "ops_absent": [
                "read /data/secret.txt",
                "read /data/sealed/f.txt",
                "create /ro/new.txt"
              ]
            },
            "js": {
              "exit": 0,
              "stdout": "44\nfailed\n69\nopened\nopen.txt sealed\n",
              "ops_absent": [
                "read /data/secret.txt",
                "read /data/sealed/f.txt",
                "create /ro/new.txt"
              ]
            }
          }
        },
        {
          "facade": {
            "method": "read",
            "path": "/data/secret.txt"
          },
          "expect": {
            "errno": "ENOENT"
          }
        },
        {
          "facade": {
            "method": "read",
            "path": "/data/sealed/f.txt"
          },
          "expect": {
            "errno": "EACCES"
          }
        },
        {
          "facade": {
            "method": "write",
            "path": "/ro/new.txt",
            "data": "x"
          },
          "expect": {
            "errno": "EROFS"
          }
        },
        {
          "command": "cat /data/secret.txt",
          "expect": {
            "exit": 1,
            "stderr_contains": "No such file or directory"
          }
        },
        {
          "command": "cat /data/sealed/f.txt",
          "expect": {
            "exit": 1,
            "stderr_contains": "Permission denied"
          }
        },
        {
          "command": "ls /data",
          "expect": {
            "exit": 0,
            "stdout": "open.txt\nsealed\n"
          }
        }
      ]
    },
    {
      "id": "a_rule_scoped_to_the_program_reaches_its_own_calls",
      "runtimes": [
        "monty",
        "wasi",
        "pyodide",
        "quickjs"
      ],
      "world": {
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "sealed/f.txt": "f\n",
              "open.txt": "o\n"
            }
          }
        }
      },
      "steps": [
        {
          "profile": {
            "commands": {
              "deny": [
                {
                  "reason": "sealed",
                  "commands": {
                    "python3": [
                      "/data/sealed/*"
                    ],
                    "node": [
                      "/data/sealed/*"
                    ]
                  }
                }
              ]
            }
          }
        },
        {
          "program": {
            "python": "for path in ['/data/sealed/f.txt', '/data/open.txt']:\n    try:\n        with open(path) as f:\n            f.read()\n        print('opened')\n    except OSError as e:\n        print(type(e).__name__)",
            "js": "for (const path of ['/data/sealed/f.txt', '/data/open.txt']) {\n  const err = {}\n  const f = std.open(path, 'r', err)\n  if (f === null) {\n    console.log(err.errno)\n    continue\n  }\n  f.readAsString()\n  const failed = f.error()\n  f.close()\n  console.log(failed ? 'failed' : 'opened')\n}"
          },
          "expect": {
            "python": {
              "exit": 0,
              "stdout": "PermissionError\nopened\n",
              "ops_absent": [
                "read /data/sealed/f.txt"
              ]
            },
            "js": {
              "exit": 0,
              "stdout": "failed\nopened\n",
              "ops_absent": [
                "read /data/sealed/f.txt"
              ]
            }
          }
        },
        {
          "command": "cat /data/sealed/f.txt",
          "expect": {
            "exit": 0,
            "stdout": "f\n"
          }
        }
      ]
    },
    {
      "id": "a_hidden_mount_is_not_named",
      "runtimes": [
        "monty",
        "wasi",
        "pyodide",
        "quickjs"
      ],
      "world": {
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "a.txt": "a\n"
            }
          },
          "/secret": {
            "vfs": "ram",
            "files": {
              "k.txt": "k\n"
            }
          }
        }
      },
      "steps": [
        {
          "profile": {
            "paths": {
              "hide": [
                "/secret"
              ]
            }
          }
        },
        {
          "program": {
            "python": "import os\nfrom pathlib import Path\nprint(sorted(n for n in os.listdir('/') if n in ('data', 'secret')), Path('/secret').is_dir())",
            "js": "const [names] = os.readdir('/')\nconsole.log(JSON.stringify(names.filter((n) => n === 'data' || n === 'secret').sort()), os.stat('/secret')[1])"
          },
          "expect": {
            "python": {
              "exit": 0,
              "stdout": "['data'] False\n"
            },
            "js": {
              "exit": 0,
              "stdout": "[\"data\"] 44\n"
            }
          }
        }
      ]
    },
    {
      "id": "a_hidden_link_is_no_road_past_its_dots",
      "runtimes": [
        "host"
      ],
      "world": {
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "f.txt": "top\n",
              "public/f.txt": "public\n",
              "public/sub/keep.txt": ""
            }
          }
        }
      },
      "steps": [
        {
          "command": "ln -s /data/public/sub /data/secretlink",
          "expect": {
            "exit": 0
          }
        },
        {
          "profile": {
            "paths": {
              "hide": [
                "/data/secretlink"
              ]
            }
          }
        },
        {
          "command": "cat /data/secretlink/../f.txt",
          "expect": {
            "exit": 1,
            "stdout": "",
            "stderr": "cat: /data/secretlink/../f.txt: No such file or directory\n"
          }
        },
        {
          "program": {
            "python": "import errno, os\ncalls = (\n    lambda: open('/data/secretlink/../f.txt').read(),\n    lambda: os.stat('/data/secretlink/../f.txt'),\n)\nfor call in calls:\n    try:\n        call()\n        print('reached')\n    except OSError as e:\n        print(errno.errorcode[e.errno])",
            "node": "const fsp = require('node:fs').promises\nconst calls = [\n  () => fsp.readFile('/data/secretlink/../f.txt', 'utf8'),\n  () => fsp.stat('/data/secretlink/../f.txt'),\n]\nfor (const call of calls) {\n  try {\n    await call()\n    console.log('reached')\n  } catch (e) {\n    console.log(e.code)\n  }\n}"
          },
          "expect": {
            "exit": 0,
            "stdout": "ENOENT\nENOENT\n"
          }
        },
        {
          "command": "cat /data/f.txt /data/public/f.txt",
          "expect": {
            "exit": 0,
            "stdout": "top\npublic\n"
          }
        }
      ]
    }
  ]
}
