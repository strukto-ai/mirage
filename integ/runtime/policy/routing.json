{
  "cases": [
    {
      "id": "runtime_arg_per_line",
      "world": {
        "runtimes": [
          "monty",
          "local",
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "python3 -c \"print(argv[0])\"",
          "expect": {
            "exit": 0,
            "stdout": "-c\n"
          }
        },
        {
          "command": "python3 -c \"import sys; print('routed-to-local')\"",
          "runtime": "local",
          "expect": {
            "exit": 0,
            "stdout": "routed-to-local\n"
          }
        },
        {
          "command": "python3 -c \"print(argv[0])\"",
          "expect": {
            "exit": 0,
            "stdout": "-c\n"
          }
        }
      ]
    },
    {
      "id": "entry_script_fallthrough",
      "world": {
        "runtimes": [
          {
            "name": "monty",
            "script": "'use-local' not in ctx['line']"
          },
          "local",
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "python3 -c \"print(argv[0])\"",
          "expect": {
            "exit": 0,
            "stdout": "-c\n"
          }
        },
        {
          "command": "python3 -c \"import sys; print('routed-to-local')\" && echo use-local",
          "expect": {
            "exit": 0,
            "stdout": "routed-to-local\nuse-local\n"
          }
        }
      ]
    },
    {
      "id": "entry_script_refused",
      "world": {
        "runtimes": [
          {
            "name": "monty",
            "script": "False"
          },
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "python3 -c \"x\"",
          "expect": {
            "exit": 126,
            "stderr": "python3: no runtime accepted this line\n"
          }
        },
        {
          "command": "echo vfs-open",
          "expect": {
            "exit": 0,
            "stdout": "vfs-open\n"
          }
        }
      ]
    },
    {
      "id": "global_policy",
      "world": {
        "runtimes": [
          "monty",
          "local",
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        },
        "route_policy": "'local' if 'go-local' in ctx['line'] else None"
      },
      "steps": [
        {
          "command": "python3 -c \"print(argv[0])\"",
          "expect": {
            "exit": 0,
            "stdout": "-c\n"
          }
        },
        {
          "command": "python3 -c \"import sys; print('went-local')\" && echo go-local",
          "expect": {
            "exit": 0,
            "stdout": "went-local\ngo-local\n"
          }
        }
      ]
    },
    {
      "id": "add_runtime_local",
      "world": {
        "runtimes": [
          "monty",
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "python3 -c \"x\"",
          "runtime": "local",
          "expect": {
            "throws_contains": "unknown runtime"
          }
        },
        {
          "add_runtime": "local"
        },
        {
          "command": "python3 -c \"import sys; print('added-local')\"",
          "runtime": "local",
          "expect": {
            "exit": 0,
            "stdout": "added-local\n"
          }
        }
      ]
    },
    {
      "id": "add_runtime_monty",
      "hosts": [
        "typescript"
      ],
      "world": {
        "runtimes": [
          "quickjs",
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "python3 -c \"x\"",
          "runtime": "monty",
          "expect": {
            "throws_contains": "unknown runtime"
          }
        },
        {
          "add_runtime": "monty"
        },
        {
          "command": "python3 -c \"print(40 + 2)\"",
          "runtime": "monty",
          "expect": {
            "exit": 0,
            "stdout": "42\n"
          }
        }
      ]
    },
    {
      "id": "ctx_command_pipeline",
      "world": {
        "runtimes": [
          {
            "name": "monty",
            "script": "ctx['command'] == 'python3'"
          },
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram",
            "files": {
              "pipe.py": "print('came-through-pipe')"
            }
          }
        }
      },
      "steps": [
        {
          "command": "cat /ram/pipe.py | python3",
          "expect": {
            "exit": 0,
            "stdout": "came-through-pipe\n"
          }
        }
      ]
    },
    {
      "id": "runtime_arg_uncaptured_inert",
      "world": {
        "runtimes": [
          "monty"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram",
            "files": {
              "a.txt": "hello\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "grep -r hello",
          "runtime": "monty",
          "expect": {
            "exit": 0,
            "stdout": "ram/a.txt:hello\n"
          }
        },
        {
          "command": "grep -r xxx",
          "runtime": "monty",
          "expect": {
            "exit": 1,
            "stdout": ""
          }
        },
        {
          "command": "grep -r xxx /ram",
          "runtime": "monty",
          "expect": {
            "exit": 1,
            "stdout": ""
          }
        },
        {
          "command": "grep -r hello /ram",
          "runtime": "monty",
          "expect": {
            "exit": 0,
            "stdout": "/ram/a.txt:hello\n"
          }
        }
      ]
    },
    {
      "id": "runtime_arg_vfs_refused",
      "world": {
        "runtimes": [
          "monty"
        ]
      },
      "steps": [
        {
          "command": "echo hi",
          "runtime": "workspace",
          "expect": {
            "throws_contains": "not a runtime you can select"
          }
        }
      ]
    },
    {
      "id": "policy_script_bad_name",
      "world": {
        "runtimes": [
          "monty"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        },
        "route_policy": "'nope'"
      },
      "steps": [
        {
          "command": "python3 -c \"print(1)\"",
          "expect": {
            "throws_contains": "unknown runtime"
          }
        }
      ]
    },
    {
      "id": "captures_narrowed_entry",
      "world": {
        "runtimes": [
          {
            "name": "monty",
            "captures": [
              "python3"
            ]
          }
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "python3 -c \"print(40 + 2)\"",
          "expect": {
            "exit": 0,
            "stdout": "42\n"
          }
        }
      ]
    },
    {
      "id": "nested_eval_inherits_routing",
      "world": {
        "runtimes": [
          {
            "name": "monty",
            "script": "'magic' in ctx['line']"
          }
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "echo $(python3 -c \"print(42)\") magic",
          "expect": {
            "exit": 0,
            "stdout": "42 magic\n"
          }
        },
        {
          "command": "echo $(python3 -c \"print(42)\")",
          "expect": {
            "exit": 0,
            "stdout": "\n"
          }
        }
      ]
    },
    {
      "id": "captures_narrowed_miss",
      "world": {
        "runtimes": [
          {
            "name": "monty",
            "captures": [
              "python3"
            ]
          }
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "python -c \"print(1)\"",
          "expect": {
            "exit": 127,
            "stderr_contains": "python: command not found"
          }
        }
      ]
    },
    {
      "id": "policy_deny_blocks_line",
      "world": {
        "runtimes": [
          "monty",
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        },
        "route_policy": "{'deny': 'python3 is blocked here'} if ctx['command'] == 'python3' else None"
      },
      "steps": [
        {
          "command": "python3 -c \"print(1)\"",
          "expect": {
            "exit": 126,
            "stderr": "python3: Permission denied\n"
          }
        },
        {
          "command": "echo still-open",
          "expect": {
            "exit": 0,
            "stdout": "still-open\n"
          }
        }
      ]
    },
    {
      "id": "policy_verdict_places_runtime",
      "world": {
        "runtimes": [
          "monty",
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        },
        "route_policy": "{'runtime': 'monty'}"
      },
      "steps": [
        {
          "command": "python3 -c \"print(40 + 2)\"",
          "expect": {
            "exit": 0,
            "stdout": "42\n"
          }
        }
      ]
    },
    {
      "id": "policy_script_bad_verdict",
      "world": {
        "runtimes": [
          "monty",
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        },
        "route_policy": "{'runtme': 'monty'}"
      },
      "steps": [
        {
          "command": "python3 -c \"print(1)\"",
          "expect": {
            "throws_contains": "unknown policy verdict keys"
          }
        }
      ]
    },
    {
      "id": "entry_script_verdict_shape",
      "world": {
        "runtimes": [
          {
            "name": "monty",
            "script": "{'deny': 'nope'}"
          },
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "python3 -c \"print(1)\"",
          "expect": {
            "throws_contains": "entry scripts answer a boolean"
          }
        }
      ]
    },
    {
      "id": "pre_execute_places_the_line",
      "note": "A coded policy answers at pre_execute like the route policy does: a Route places the line on the runtime it names.",
      "world": {
        "runtimes": [
          "monty",
          "local",
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        },
        "policies": [
          {
            "name": "place_line",
            "contains": "go-local",
            "runtime": "local"
          }
        ]
      },
      "steps": [
        {
          "command": "python3 -c \"print(argv[0])\"",
          "expect": {
            "exit": 0,
            "stdout": "-c\n"
          }
        },
        {
          "command": "python3 -c \"import sys; print('went-local')\" && echo go-local",
          "expect": {
            "exit": 0,
            "stdout": "went-local\ngo-local\n"
          }
        }
      ]
    },
    {
      "id": "pre_execute_deny_outranks_a_route",
      "note": "A Deny at pre_execute refuses the line whoever placed it, in bash's words.",
      "world": {
        "runtimes": [
          "monty",
          "local",
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        },
        "route_policy": "'local'",
        "policies": [
          {
            "name": "place_line",
            "contains": "blocked",
            "deny": "blocked here"
          }
        ]
      },
      "steps": [
        {
          "command": "python3 -c \"print('blocked')\"",
          "expect": {
            "exit": 126,
            "stderr": "python3: Permission denied\n"
          }
        },
        {
          "command": "python3 -c \"import sys; print('went-local')\"",
          "expect": {
            "exit": 0,
            "stdout": "went-local\n"
          }
        }
      ]
    },
    {
      "id": "placements_that_disagree_refuse_the_line",
      "note": "Two policies placing one line on different runtimes refuse it: neither choice is the line's.",
      "world": {
        "runtimes": [
          "monty",
          "local",
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        },
        "route_policy": "'local'",
        "policies": [
          {
            "name": "place_line",
            "contains": "python3",
            "runtime": "monty"
          }
        ]
      },
      "steps": [
        {
          "command": "python3 -c \"print(1)\"",
          "expect": {
            "exit": 126,
            "stderr": "python3: Permission denied\n"
          }
        },
        {
          "command": "echo still-open",
          "expect": {
            "exit": 0,
            "stdout": "still-open\n"
          }
        }
      ]
    },
    {
      "id": "admission_comes_before_placement",
      "note": "A line a rule refuses is never shown to a placing policy: the rule's refusal arrives in GNU's words, not the route policy's deny, which still answers every line the rules admit.",
      "world": {
        "runtimes": [
          "monty",
          "local",
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        },
        "route_policy": "{'deny': 'routed away'}",
        "profiles": {
          "sealed": {
            "commands": {
              "deny": [
                {
                  "reason": "sealed",
                  "paths": [
                    "/ram/sec/*"
                  ]
                }
              ]
            }
          }
        },
        "profile": "sealed"
      },
      "steps": [
        {
          "command": "cat /ram/sec/x",
          "expect": {
            "exit": 1,
            "stderr": "cat: /ram/sec/x: Permission denied\n"
          }
        },
        {
          "command": "echo hi",
          "expect": {
            "exit": 126,
            "stderr": "echo: Permission denied\n"
          }
        }
      ]
    }
  ]
}
