{
  "cases": [
    {
      "id": "machine_arg_per_line",
      "world": {
        "machines": {
          "monty": {
            "provider": "worker"
          },
          "local": {
            "provider": "host"
          }
        },
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "python3 -c \"print(argv[0])\"",
          "expect": {
            "exit": 0,
            "stdout": "-c\n"
          }
        },
        {
          "command": "python3 -c \"import sys; print('routed-to-local')\"",
          "expect": {
            "exit": 0,
            "stdout": "routed-to-local\n"
          },
          "machine": "local"
        },
        {
          "command": "python3 -c \"print(argv[0])\"",
          "expect": {
            "exit": 0,
            "stdout": "-c\n"
          }
        }
      ]
    },
    {
      "id": "global_policy",
      "world": {
        "machines": {
          "monty": {
            "provider": "worker"
          },
          "local": {
            "provider": "host"
          }
        },
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        },
        "route_policy": {
          "script": "def pre_execute(ctx):\n    if 'go-local' in ctx['line']:\n        return {\"kind\": \"route\", \"machine\": \"local\"}\n",
          "runtime": "monty"
        }
      },
      "steps": [
        {
          "command": "python3 -c \"print(argv[0])\"",
          "expect": {
            "exit": 0,
            "stdout": "-c\n"
          }
        },
        {
          "command": "python3 -c \"import sys; print('went-local')\" && echo go-local",
          "expect": {
            "exit": 0,
            "stdout": "went-local\ngo-local\n"
          }
        }
      ]
    },
    {
      "id": "add_machine_local",
      "world": {
        "machines": {
          "monty": {
            "provider": "worker"
          }
        },
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "python3 -c \"x\"",
          "expect": {
            "throws_contains": "unknown machine"
          },
          "machine": "local"
        },
        {
          "add_machine": {
            "local": {
              "provider": "host"
            }
          }
        },
        {
          "command": "python3 -c \"import sys; print('added-local')\"",
          "expect": {
            "exit": 0,
            "stdout": "added-local\n"
          },
          "machine": "local"
        }
      ]
    },
    {
      "id": "add_machine_monty",
      "hosts": [
        "typescript"
      ],
      "world": {
        "machines": {
          "quickjs": {
            "provider": "in_process",
            "runtime": "quickjs"
          }
        },
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "python3 -c \"x\"",
          "expect": {
            "throws_contains": "unknown machine"
          },
          "machine": "monty"
        },
        {
          "add_machine": {
            "monty": {
              "provider": "worker"
            }
          }
        },
        {
          "command": "python3 -c \"print(40 + 2)\"",
          "expect": {
            "exit": 0,
            "stdout": "42\n"
          },
          "machine": "monty"
        }
      ]
    },
    {
      "id": "ctx_command_pipeline",
      "world": {
        "machines": {
          "monty": {
            "provider": "worker"
          }
        },
        "mounts": {
          "/ram": {
            "vfs": "ram",
            "files": {
              "pipe.py": "print('came-through-pipe')"
            }
          }
        },
        "route_policy": {
          "script": "def pre_execute(ctx):\n    if any(c['command'] == 'python3' for c in ctx['commands']):\n        return {\"kind\": \"route\", \"machine\": \"monty\"}\n",
          "runtime": "monty"
        }
      },
      "steps": [
        {
          "command": "cat /ram/pipe.py | python3",
          "expect": {
            "exit": 0,
            "stdout": "came-through-pipe\n"
          }
        }
      ]
    },
    {
      "id": "machine_arg_uncaptured_inert",
      "world": {
        "machines": {
          "monty": {
            "provider": "worker"
          }
        },
        "mounts": {
          "/ram": {
            "vfs": "ram",
            "files": {
              "a.txt": "hello\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "grep -r hello",
          "expect": {
            "exit": 0,
            "stdout": "ram/a.txt:hello\n"
          },
          "machine": "monty"
        },
        {
          "command": "grep -r xxx",
          "expect": {
            "exit": 1,
            "stdout": ""
          },
          "machine": "monty"
        },
        {
          "command": "grep -r xxx /ram",
          "expect": {
            "exit": 1,
            "stdout": ""
          },
          "machine": "monty"
        },
        {
          "command": "grep -r hello /ram",
          "expect": {
            "exit": 0,
            "stdout": "/ram/a.txt:hello\n"
          },
          "machine": "monty"
        }
      ]
    },
    {
      "id": "machine_arg_workspace_refused",
      "world": {
        "machines": {
          "monty": {
            "provider": "worker"
          }
        }
      },
      "steps": [
        {
          "command": "echo hi",
          "expect": {
            "throws_contains": "not a machine you can select"
          },
          "machine": "workspace"
        }
      ]
    },
    {
      "id": "policy_script_bad_name",
      "world": {
        "machines": {
          "monty": {
            "provider": "worker"
          }
        },
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        },
        "route_policy": {
          "script": "def pre_execute(ctx):\n    return {\"kind\": \"route\", \"machine\": \"nope\"}\n",
          "runtime": "monty"
        }
      },
      "steps": [
        {
          "command": "python3 -c \"print(1)\"",
          "expect": {
            "throws_contains": "unknown machine"
          }
        }
      ]
    },
    {
      "id": "captures_narrowed_entry",
      "world": {
        "machines": {
          "monty": {
            "provider": "worker",
            "captures": [
              "python3"
            ]
          }
        },
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "python3 -c \"print(40 + 2)\"",
          "expect": {
            "exit": 0,
            "stdout": "42\n"
          }
        }
      ]
    },
    {
      "id": "nested_eval_inherits_routing",
      "world": {
        "machines": {
          "monty": {
            "provider": "worker"
          },
          "local": {
            "provider": "host"
          }
        },
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        },
        "route_policy": {
          "script": "def pre_execute(ctx):\n    if 'magic' in ctx['line']:\n        return {\"kind\": \"route\", \"machine\": \"local\"}\n",
          "runtime": "monty"
        }
      },
      "steps": [
        {
          "command": "echo $(python3 -c \"import sys; print(sys.platform == 'monty')\") magic",
          "expect": {
            "exit": 0,
            "stdout": "False magic\n"
          }
        },
        {
          "command": "echo $(python3 -c \"import sys; print(sys.platform == 'monty')\")",
          "expect": {
            "exit": 0,
            "stdout": "True\n"
          }
        }
      ]
    },
    {
      "id": "captures_narrowed_miss",
      "world": {
        "machines": {
          "monty": {
            "provider": "worker",
            "captures": [
              "python3"
            ]
          }
        },
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "python -c \"print(1)\"",
          "expect": {
            "exit": 127,
            "stderr_contains": "python: command not found"
          }
        }
      ]
    },
    {
      "id": "policy_deny_blocks_line",
      "world": {
        "machines": {
          "monty": {
            "provider": "worker"
          }
        },
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        },
        "policies": [
          {
            "name": "place_line",
            "contains": "python3",
            "deny": "python3 is blocked here"
          }
        ]
      },
      "steps": [
        {
          "command": "python3 -c \"print(1)\"",
          "expect": {
            "exit": 126,
            "stderr": "python3: Permission denied\n"
          }
        },
        {
          "command": "echo still-open",
          "expect": {
            "exit": 0,
            "stdout": "still-open\n"
          }
        }
      ]
    },
    {
      "id": "policy_verdict_places_machine",
      "world": {
        "machines": {
          "monty": {
            "provider": "worker"
          }
        },
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        },
        "route_policy": {
          "script": "def pre_execute(ctx):\n    return {\"kind\": \"route\", \"machine\": \"monty\"}\n",
          "runtime": "monty"
        }
      },
      "steps": [
        {
          "command": "python3 -c \"print(40 + 2)\"",
          "expect": {
            "exit": 0,
            "stdout": "42\n"
          }
        }
      ]
    },
    {
      "id": "policy_script_bad_verdict",
      "world": {
        "machines": {
          "monty": {
            "provider": "worker"
          }
        },
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        },
        "route_policy": {
          "script": "def pre_execute(ctx):\n    return {\"runtme\": \"monty\"}\n",
          "runtime": "monty"
        }
      },
      "steps": [
        {
          "command": "python3 -c \"print(1)\"",
          "expect": {
            "throws_contains": "route_policy must return an answer"
          }
        }
      ]
    },
    {
      "id": "pre_execute_places_the_line",
      "note": "A coded policy answers at pre_execute like the route policy does: a Route places the line on the runtime it names.",
      "world": {
        "machines": {
          "monty": {
            "provider": "worker"
          },
          "local": {
            "provider": "host"
          }
        },
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        },
        "policies": [
          {
            "name": "place_line",
            "contains": "go-local",
            "machine": "local"
          }
        ]
      },
      "steps": [
        {
          "command": "python3 -c \"print(argv[0])\"",
          "expect": {
            "exit": 0,
            "stdout": "-c\n"
          }
        },
        {
          "command": "python3 -c \"import sys; print('went-local')\" && echo go-local",
          "expect": {
            "exit": 0,
            "stdout": "went-local\ngo-local\n"
          }
        }
      ]
    },
    {
      "id": "pre_execute_deny_outranks_a_route",
      "note": "A Deny at pre_execute refuses the line whoever placed it, in bash's words.",
      "world": {
        "machines": {
          "monty": {
            "provider": "worker"
          },
          "local": {
            "provider": "host"
          }
        },
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        },
        "route_policy": {
          "script": "def pre_execute(ctx):\n    return {\"kind\": \"route\", \"machine\": \"local\"}\n",
          "runtime": "monty"
        },
        "policies": [
          {
            "name": "place_line",
            "contains": "blocked",
            "deny": "blocked here"
          }
        ]
      },
      "steps": [
        {
          "command": "python3 -c \"print('blocked')\"",
          "expect": {
            "exit": 126,
            "stderr": "python3: Permission denied\n"
          }
        },
        {
          "command": "python3 -c \"import sys; print('went-local')\"",
          "expect": {
            "exit": 0,
            "stdout": "went-local\n"
          }
        }
      ]
    },
    {
      "id": "placements_that_disagree_refuse_the_line",
      "note": "Two policies placing one line on different runtimes refuse it: neither choice is the line's.",
      "world": {
        "machines": {
          "monty": {
            "provider": "worker"
          },
          "local": {
            "provider": "host"
          }
        },
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        },
        "route_policy": {
          "script": "def pre_execute(ctx):\n    return {\"kind\": \"route\", \"machine\": \"local\"}\n",
          "runtime": "monty"
        },
        "policies": [
          {
            "name": "place_line",
            "contains": "python3",
            "machine": "monty"
          }
        ]
      },
      "steps": [
        {
          "command": "python3 -c \"print(1)\"",
          "expect": {
            "exit": 126,
            "stderr": "python3: Permission denied\n"
          }
        },
        {
          "command": "echo still-open",
          "expect": {
            "exit": 0,
            "stdout": "still-open\n"
          }
        }
      ]
    },
    {
      "id": "admission_comes_before_placement",
      "note": "A line a rule refuses is never shown to a pre_execute policy: the rule's refusal arrives in GNU's words, not the policy's deny, which still answers every line the rules admit.",
      "world": {
        "machines": {
          "monty": {
            "provider": "worker"
          },
          "local": {
            "provider": "host"
          }
        },
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        },
        "policies": [
          {
            "name": "place_line",
            "contains": "echo",
            "deny": "routed away"
          }
        ],
        "profiles": {
          "sealed": {
            "commands": {
              "deny": [
                {
                  "reason": "sealed",
                  "paths": [
                    "/ram/sec/*"
                  ]
                }
              ]
            }
          }
        },
        "profile": "sealed"
      },
      "steps": [
        {
          "command": "cat /ram/sec/x",
          "expect": {
            "exit": 1,
            "stderr": "cat: /ram/sec/x: Permission denied\n"
          }
        },
        {
          "command": "echo hi",
          "expect": {
            "exit": 126,
            "stderr": "echo: Permission denied\n"
          }
        }
      ]
    },
    {
      "id": "a_route_program_reads_the_workspace",
      "note": "A route program reads the mounts as the session does.",
      "world": {
        "machines": {
          "monty": {
            "provider": "worker"
          },
          "local": {
            "provider": "host"
          }
        },
        "mounts": {
          "/ram": {
            "vfs": "ram",
            "files": {
              "route.txt": "local\n"
            }
          }
        },
        "route_policy": {
          "script": "def pre_execute(ctx):\n    if any(c['command'] == 'python3' for c in ctx['commands']):\n        name = open('/ram/route.txt').read().strip()\n        return {\"kind\": \"route\", \"machine\": name}\n",
          "runtime": "monty"
        }
      },
      "steps": [
        {
          "command": "python3 -c \"import sys; print(sys.platform == 'monty')\"",
          "expect": {
            "exit": 0,
            "stdout": "False\n"
          }
        }
      ]
    },
    {
      "id": "a_route_program_reads_a_commands_own_prefix",
      "note": "Each command holds the env it runs with, its own NAME=value prefix included; the prefix is that command's alone.",
      "world": {
        "machines": {
          "monty": {
            "provider": "worker"
          },
          "local": {
            "provider": "host"
          }
        },
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        },
        "route_policy": {
          "script": "def pre_execute(ctx):\n    if any(c['command'] == 'python3' and c['env'].get('PLACE') == 'local' for c in ctx['commands']):\n        return {\"kind\": \"route\", \"machine\": \"local\"}\n",
          "runtime": "monty"
        }
      },
      "steps": [
        {
          "command": "PLACE=local python3 -c \"import sys; print(sys.platform == 'monty')\"",
          "expect": {
            "exit": 0,
            "stdout": "False\n"
          }
        },
        {
          "command": "PLACE=local true; python3 -c \"import sys; print(sys.platform == 'monty')\"",
          "expect": {
            "exit": 0,
            "stdout": "True\n"
          }
        },
        {
          "command": "python3 -c \"import sys; print(sys.platform == 'monty')\"",
          "expect": {
            "exit": 0,
            "stdout": "True\n"
          }
        }
      ]
    },
    {
      "id": "a_route_program_that_fails_is_a_routing_error",
      "world": {
        "machines": {
          "monty": {
            "provider": "worker"
          }
        },
        "route_policy": {
          "script": "def pre_execute(ctx):\n    1 / 0\n",
          "runtime": "monty"
        }
      },
      "steps": [
        {
          "command": "python3 -c \"print(1)\"",
          "expect": {
            "throws_contains": "route_policy exited 1"
          }
        }
      ]
    }
  ]
}
