{
  "cases": [
    {
      "id": "command_environment_isolation",
      "hosts": [
        "typescript"
      ],
      "world": {
        "runtimes": [
          "pyodide",
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "MIRAGE_ENV_LEAK_PROBE=guest python3 -c \"import os; print(os.environ['MIRAGE_ENV_LEAK_PROBE'])\"",
          "expect": {
            "exit": 0,
            "stdout": "guest\n"
          }
        },
        {
          "command": "python3 -c \"import os; print(os.environ.get('MIRAGE_ENV_LEAK_PROBE', '<unset>'))\"",
          "expect": {
            "exit": 0,
            "stdout": "<unset>\n"
          }
        }
      ]
    },
    {
      "id": "each_call_starts_with_a_clean_interpreter",
      "hosts": [
        "typescript"
      ],
      "world": {
        "runtimes": [
          "pyodide",
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "python3 -c \"import os; os.environ['LEAKED'] = 'yes'\"",
          "expect": {
            "exit": 0
          }
        },
        {
          "command": "python3 -c \"import os; print(os.environ.get('LEAKED', 'absent'))\"",
          "expect": {
            "exit": 0,
            "stdout": "absent\n",
            "stderr": ""
          }
        },
        {
          "command": "python3 -c 'leaked_var = 42'",
          "expect": {
            "exit": 0
          }
        },
        {
          "command": "python3 -c \"print('leaked_var' in dir())\"",
          "expect": {
            "exit": 0,
            "stdout": "False\n",
            "stderr": ""
          }
        }
      ]
    },
    {
      "id": "bounded_parallel_calls_keep_session_and_guest_state_isolated",
      "hosts": [
        "typescript"
      ],
      "world": {
        "runtimes": [
          {
            "name": "pyodide",
            "config": {
              "max_concurrency": 2
            }
          },
          "workspace"
        ],
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "one/input.txt": "one\n",
              "two/input.txt": "two\n",
              "three/input.txt": "three\n"
            }
          }
        }
      },
      "steps": [
        {
          "parallel": [
            {
              "command": "cd /data/one; LABEL=one python3 -c \"import builtins, os; from pathlib import Path; print(os.environ['LABEL'], Path('input.txt').read_text().strip(), hasattr(builtins, 'mirage_parallel_token')); builtins.mirage_parallel_token = os.environ['LABEL']; Path('result.txt').write_text(os.environ['LABEL'] + chr(10))\"",
              "expect": {
                "exit": 0,
                "stdout": "one one False\n",
                "stderr": ""
              }
            },
            {
              "command": "cd /data/two; LABEL=two python3 -c \"import builtins, os; from pathlib import Path; print(os.environ['LABEL'], Path('input.txt').read_text().strip(), hasattr(builtins, 'mirage_parallel_token')); builtins.mirage_parallel_token = os.environ['LABEL']; Path('result.txt').write_text(os.environ['LABEL'] + chr(10))\"",
              "expect": {
                "exit": 0,
                "stdout": "two two False\n",
                "stderr": ""
              }
            },
            {
              "command": "cd /data/three; LABEL=three python3 -c \"import builtins, os; from pathlib import Path; print(os.environ['LABEL'], Path('input.txt').read_text().strip(), hasattr(builtins, 'mirage_parallel_token')); builtins.mirage_parallel_token = os.environ['LABEL']; Path('result.txt').write_text(os.environ['LABEL'] + chr(10))\"",
              "expect": {
                "exit": 0,
                "stdout": "three three False\n",
                "stderr": ""
              }
            }
          ]
        },
        {
          "command": "cat /data/one/result.txt /data/two/result.txt /data/three/result.txt",
          "expect": {
            "exit": 0,
            "stdout": "one\ntwo\nthree\n"
          }
        },
        {
          "command": "python3 -c \"import builtins; print(hasattr(builtins, 'mirage_parallel_token'))\"",
          "expect": {
            "exit": 0,
            "stdout": "False\n",
            "stderr": ""
          }
        }
      ]
    },
    {
      "id": "local_time_is_the_sessions_zone",
      "note": "A session with no TZ runs on UTC and a TZ moves the guest's clock, wherever the server is.",
      "hosts": [
        "typescript"
      ],
      "world": {
        "runtimes": [
          "pyodide",
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "python3 -c \"import datetime; print(datetime.datetime.fromtimestamp(0).isoformat())\"",
          "expect": {
            "exit": 0,
            "stdout": "1970-01-01T00:00:00\n"
          }
        },
        {
          "command": "TZ=Asia/Tokyo python3 -c \"import datetime; print(datetime.datetime.fromtimestamp(0).isoformat())\"",
          "expect": {
            "exit": 0,
            "stdout": "1970-01-01T09:00:00\n"
          }
        }
      ]
    },
    {
      "id": "names_itself_as_the_workspace",
      "note": "The name `hostname` prints, with the platform left as it is for the packages that check it.",
      "hosts": [
        "typescript"
      ],
      "world": {
        "runtimes": [
          "pyodide",
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "python3 -c \"import os, platform, socket; print(socket.gethostname(), platform.node(), os.uname().sysname)\"",
          "expect": {
            "exit": 0,
            "stdout": "mirage mirage Emscripten\n"
          }
        }
      ]
    },
    {
      "id": "a_run_grows_only_as_far_as_the_workspaces_memory",
      "note": "What the interpreter takes to start is not charged; growth past the workspace's room fails the run and the next one starts fresh.",
      "hosts": [
        "typescript"
      ],
      "world": {
        "runtimes": [
          "pyodide",
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "python3 -c \"print(len('a' * (8 << 20)))\"",
          "expect": {
            "exit": 0,
            "stdout": "8388608\n"
          }
        },
        {
          "command": "python3 -c \"print(len('a' * (200 << 20)))\"",
          "expect": {
            "exit": 1,
            "stderr_contains": "MemoryError: the run passed max_memory"
          }
        },
        {
          "command": "python3 -c \"print(1)\"",
          "expect": {
            "exit": 0,
            "stdout": "1\n"
          }
        }
      ]
    }
  ]
}
