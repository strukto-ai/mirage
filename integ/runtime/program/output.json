{
  "cases": [
    {
      "id": "pipe_to_grep",
      "runtimes": [
        "monty",
        "wasi",
        "pyodide",
        "quickjs",
        "local"
      ],
      "steps": [
        {
          "command": {
            "python": "python3 -c \"print('alpha'); print('beta')\" | grep beta",
            "js": "node -e \"console.log('alpha'); console.log('beta')\" | grep beta"
          },
          "expect": {
            "exit": 0,
            "stdout": "beta\n"
          }
        }
      ]
    },
    {
      "id": "endless_writer_stops_at_its_reader",
      "runtimes": [
        "monty",
        "wasi",
        "pyodide",
        "quickjs",
        "local"
      ],
      "steps": [
        {
          "command": {
            "python": "python3 -c \"while True: print('y')\" | head -n 2",
            "js": "node -e \"for (;;) console.log('y')\" | head -n 2"
          },
          "expect": {
            "exit": 0,
            "stdout": "y\ny\n"
          }
        }
      ]
    },
    {
      "id": "output_survives_failure_and_reuse",
      "runtimes": [
        "monty",
        "wasi",
        "pyodide",
        "quickjs",
        "local"
      ],
      "steps": [
        {
          "command": {
            "python": "python3 -c \"print('before failure'); raise ValueError('original failure')\"",
            "js": "js -e \"console.log('before failure'); throw new Error('original failure')\""
          },
          "expect": {
            "exit": 1,
            "stdout": "before failure\n",
            "stderr_contains": "original failure"
          }
        },
        {
          "command": {
            "python": "python3 -c \"print('next')\"",
            "js": "js -e \"console.log('next')\""
          },
          "expect": {
            "exit": 0,
            "stdout": "next\n",
            "stderr": ""
          }
        }
      ]
    },
    {
      "id": "closed_output_and_reuse",
      "runtimes": [
        "wasi",
        "pyodide",
        "local"
      ],
      "world": {
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        }
      },
      "steps": [
        {
          "command": {
            "python": "python3 -c \"import sys; print('out'); sys.stderr.write('err'); sys.stdout.close(); sys.stderr.close(); assert sys.stdout.closed and sys.stderr.closed\""
          },
          "expect": {
            "exit": 0,
            "stdout": "out\n",
            "stderr": "err"
          }
        },
        {
          "command": {
            "python": "python3 -c \"import sys; print('next'); sys.stderr.write('next err')\""
          },
          "expect": {
            "exit": 0,
            "stdout": "next\n",
            "stderr": "next err"
          }
        },
        {
          "command": {
            "python": "python3 -c \"import sys; sys.stdout.buffer.write(b'binary'); sys.stdout.buffer.close()\""
          },
          "expect": {
            "exit": 0,
            "stdout": "binary",
            "stderr": ""
          }
        },
        {
          "command": {
            "python": "python3 -c \"import sys; print('before exit'); sys.stdout.close(); sys.stderr.close(); sys.exit(7)\""
          },
          "expect": {
            "exit": 7,
            "stdout": "before exit\n",
            "stderr": ""
          }
        },
        {
          "command": {
            "python": "python3 -c \"print('after exit')\""
          },
          "expect": {
            "exit": 0,
            "stdout": "after exit\n",
            "stderr": ""
          }
        }
      ]
    },
    {
      "id": "output_into_a_mount_lands_whole",
      "note": "Over 1 MiB of output, redirected into a file and appended to, on stores that take a stream and those that take one body. QuickJS writes it in one call: qjs flushes each console.log, and on the python host each flush waits on the host's loop.",
      "runtimes": [
        "monty",
        "wasi",
        "pyodide",
        "quickjs",
        "local"
      ],
      "backends": [
        "ram",
        "disk",
        "ssh",
        "s3",
        "redis",
        "ram+cache",
        "disk+cache",
        "redis+cache"
      ],
      "world": {
        "mounts": {
          "/data": {
            "vfs": "ram"
          }
        }
      },
      "steps": [
        {
          "command": {
            "python": "python3 -c \"for i in range(1, 200001):\n    print(i)\" > /data/out.txt",
            "js": "node -e \"console.log(Array.from({ length: 200000 }, (_, i) => i + 1).join('\\n'))\" > /data/out.txt"
          },
          "expect": {
            "exit": 0,
            "stdout": ""
          }
        },
        {
          "command": "wc -c < /data/out.txt",
          "expect": {
            "exit": 0,
            "stdout": "1288895\n"
          }
        },
        {
          "command": {
            "python": "python3 -c \"print('tail')\" >> /data/out.txt",
            "js": "node -e \"console.log('tail')\" >> /data/out.txt"
          },
          "expect": {
            "exit": 0,
            "stdout": ""
          }
        },
        {
          "command": "tail -n 2 /data/out.txt",
          "expect": {
            "exit": 0,
            "stdout": "200000\ntail\n"
          }
        }
      ]
    }
  ]
}
