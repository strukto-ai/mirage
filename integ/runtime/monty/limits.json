{
  "cases": [
    {
      "id": "limit_timeout",
      "world": {
        "runtimes": [
          "monty",
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram",
            "files": {
              "slow.py": "n = 0\nfor i in range(300000000):\n    n = n + 1\n"
            },
            "limits": {
              "python3": {
                "timeout_seconds": 1
              }
            }
          }
        }
      },
      "steps": [
        {
          "command": "python3 /ram/slow.py",
          "expect": {
            "exit": 124,
            "stderr_contains": "timed out after"
          }
        }
      ]
    }
  ]
}
