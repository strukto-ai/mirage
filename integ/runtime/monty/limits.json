{
  "cases": [
    {
      "id": "limit_timeout",
      "world": {
        "runtimes": [
          "monty",
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram",
            "files": {
              "slow.py": "n = 0\nfor i in range(300000000):\n    n = n + 1\n"
            }
          }
        },
        "command_limits": {
          "@line": {
            "timeout_seconds": 1
          }
        }
      },
      "steps": [
        {
          "command": "python3 /ram/slow.py",
          "expect": {
            "exit": 124,
            "stderr_contains": "timed out after"
          }
        }
      ]
    },
    {
      "id": "many_file_calls_finish",
      "world": {
        "runtimes": [
          "monty",
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram",
            "files": {
              "a.txt": "x",
              "loop.py": "n = 0\nfor i in range(1500):\n    with open('/ram/a.txt') as f:\n        n = n + len(f.read())\nprint(n)\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "python3 /ram/loop.py",
          "expect": {
            "exit": 0,
            "stdout": "1500\n",
            "stderr": ""
          }
        }
      ]
    }
  ]
}
