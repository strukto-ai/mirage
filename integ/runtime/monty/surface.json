{
  "cases": [
    {
      "id": "cpython_surface_known_gaps_1077",
      "world": {
        "runtimes": [
          "monty",
          "workspace"
        ],
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "in.json": "{\"a\":1}"
            }
          }
        }
      },
      "steps": [
        {
          "command": "python3 -c 'print(len([1,2]), sum([1,2]), sorted([3,1,2]))'",
          "expect": {
            "exit": 0,
            "stdout": "2 3 [1, 2, 3]\n"
          }
        },
        {
          "command": "python3 -c 'import json; print([n for n in ('\"'\"'load'\"'\"','\"'\"'loads'\"'\"','\"'\"'dump'\"'\"','\"'\"'dumps'\"'\"') if hasattr(json,n)])'",
          "expect": {
            "exit": 0,
            "stdout": "['load', 'loads', 'dump', 'dumps']\n"
          }
        },
        {
          "command": "python3 -c 'print(dir(list))'",
          "expect": {
            "exit": 1,
            "stderr_contains": "NameError: name 'dir' is not defined"
          }
        },
        {
          "command": "python3 -c 'import json; print(dir(json))'",
          "expect": {
            "exit": 1,
            "stderr_contains": "NameError: name 'dir' is not defined"
          }
        },
        {
          "command": "python3 -c 'import json; print(json.load(open('\"'\"'/data/in.json'\"'\"')))'",
          "expect": {
            "exit": 0,
            "stdout": "{'a': 1}\n"
          }
        },
        {
          "command": "python3 -c 'import json; json.dump({'\"'\"'a'\"'\"': 1}, open('\"'\"'/data/out.json'\"'\"', '\"'\"'w'\"'\"'))'",
          "expect": {
            "exit": 0,
            "stdout": ""
          }
        },
        {
          "command": "cat /data/out.json",
          "expect": {
            "exit": 0,
            "stdout": "{\"a\": 1}"
          }
        },
        {
          "command": "python3 -c 'import json; print(json.loads(open('\"'\"'/data/in.json'\"'\"').read())); f = open('\"'\"'/data/out.json'\"'\"', '\"'\"'w'\"'\"'); f.write(json.dumps({'\"'\"'a'\"'\"': 2})); f.close()'",
          "expect": {
            "exit": 0,
            "stdout": "{'a': 1}\n"
          }
        },
        {
          "command": "cat /data/out.json",
          "expect": {
            "exit": 0,
            "stdout": "{\"a\": 2}"
          }
        }
      ]
    },
    {
      "id": "monty_023_python_surface",
      "world": {
        "runtimes": [
          "monty",
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "python3 -c 'from itertools import accumulate, batched, zip_longest; print('\"'\"'total={:04d}'\"'\"'.format(6)); print(list(accumulate([1,2,3]))); print(list(batched([1,2,3], 2))); print(list(zip_longest([1,2], [3], fillvalue=0)))'",
          "expect": {
            "exit": 0,
            "stdout": "total=0006\n[1, 3, 6]\n[(1, 2), (3,)]\n[(1, 3), (2, 0)]\n",
            "stderr": ""
          }
        }
      ]
    },
    {
      "id": "os_urandom",
      "world": {
        "runtimes": [
          "monty",
          "workspace"
        ],
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "item": "hello"
            }
          }
        }
      },
      "steps": [
        {
          "command": "python3 -c \"import os; print([(type(os.urandom(n)).__name__, len(os.urandom(n))) for n in [0, 8, 65537, 1048576]])\"",
          "expect": {
            "exit": 0,
            "stdout": "[('bytes', 0), ('bytes', 8), ('bytes', 65537), ('bytes', 1048576)]\n"
          }
        },
        {
          "command": "python3 -c \"import os; os.urandom(1048577)\"",
          "expect": {
            "exit": 1,
            "stderr_contains": "MemoryError: os.urandom() size exceeds max_urandom_bytes (1048576)"
          }
        },
        {
          "command": "python3 -c \"import os; os.urandom(-1)\"",
          "expect": {
            "exit": 1,
            "stderr_contains": "ValueError"
          }
        },
        {
          "command": "python3 -c \"import os; os.urandom(1.5)\"",
          "expect": {
            "exit": 1,
            "stderr_contains": "TypeError"
          }
        }
      ]
    },
    {
      "id": "file_modules_reach_the_mount",
      "note": "csv, tomllib, hashlib and os.path read and write workspace files through the same calls open() makes.",
      "world": {
        "runtimes": [
          "monty",
          "workspace"
        ],
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "in.csv": "x,y\n1,2\n",
              "c.toml": "name = \"m\"\n[t]\nn = 3\n",
              "mods.py": "import csv, hashlib, os, tomllib\nwith open('/data/in.csv', newline='') as f:\n    print(list(csv.reader(f)))\nwith open('/data/out.csv', 'w', newline='') as f:\n    csv.writer(f).writerows([['a', 'b'], [1, 2]])\nwith open('/data/c.toml', 'rb') as f:\n    print(tomllib.load(f))\nwith open('/data/in.csv', 'rb') as f:\n    print(hashlib.sha256(f.read()).hexdigest()[:12])\nprint(os.path.exists('/data/in.csv'), os.path.isdir('/data'), os.path.splitext('/data/c.toml'))\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "python3 /data/mods.py",
          "expect": {
            "exit": 0,
            "stdout": "[['x', 'y'], ['1', '2']]\n{'name': 'm', 't': {'n': 3}}\n81bf9fa83c6f\nTrue True ('/data/c', '.toml')\n",
            "stderr": ""
          }
        },
        {
          "command": "cat /data/out.csv",
          "expect": {
            "exit": 0,
            "stdout": "a,b\r\n1,2\r\n"
          }
        }
      ]
    }
  ]
}
