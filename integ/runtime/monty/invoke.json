{
  "cases": [
    {
      "id": "default_world_python3",
      "world": {},
      "steps": [
        {
          "command": "python3 -c \"print(6 * 7)\"",
          "expect": {
            "exit": 0,
            "stdout": "42\n",
            "stderr": ""
          }
        }
      ]
    },
    {
      "id": "python_alias",
      "world": {
        "runtimes": [
          "monty",
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "python -c 'print(6 * 7)'",
          "expect": {
            "exit": 0,
            "stdout": "42\n"
          }
        }
      ]
    },
    {
      "id": "python3_file_names_its_runtime",
      "world": {
        "runtimes": [
          "monty",
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "cat /usr/bin/python3",
          "expect": {
            "exit": 0,
            "stdout": "#!/bin/sh\n# python3 runs on the workspace's monty runtime.\ncommand python3 \"$@\"\n",
            "stderr": ""
          }
        }
      ]
    },
    {
      "id": "module_flag_refused_by_name",
      "world": {
        "runtimes": [
          "monty",
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "python3 -m nosuchmodule",
          "expect": {
            "exit": 1,
            "stderr": "python3: -m is not supported by the 'monty' runtime\n"
          }
        },
        {
          "command": "python -m json.tool",
          "expect": {
            "exit": 1,
            "stderr": "python: -m is not supported by the 'monty' runtime\n"
          }
        }
      ]
    },
    {
      "id": "option_refusals_follow_cpython",
      "world": {
        "runtimes": [
          "monty",
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "python3 -zz -c 'print(1)'",
          "expect": {
            "exit": 2,
            "stdout": "",
            "stderr": "Unknown option: -z\nusage: python3 [option] ... [-c cmd | -m mod | file | -] [arg] ...\nTry `python -h' for more information.\n"
          }
        },
        {
          "command": "python3 -c",
          "expect": {
            "exit": 2,
            "stdout": "",
            "stderr": "Argument expected for the -c option\nusage: python3 [option] ... [-c cmd | -m mod | file | -] [arg] ...\nTry `python -h' for more information.\n"
          }
        }
      ]
    },
    {
      "id": "version_names_the_monty_guest",
      "world": {
        "runtimes": [
          "monty",
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram",
            "files": {
              "version.py": "print(argv[-1])\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "for n in python python3; do for f in --version -V -VV; do $n $f; done; done",
          "expect": {
            "exit": 0,
            "stdout": "Python 3.14.0 (monty)\nPython 3.14.0 (monty)\nPython 3.14.0 (monty)\nPython 3.14.0 (monty)\nPython 3.14.0 (monty)\nPython 3.14.0 (monty)\n",
            "stderr": ""
          }
        },
        {
          "command": "python3 -c 'print(argv[-1])' --version",
          "expect": {
            "exit": 0,
            "stdout": "--version\n",
            "stderr": ""
          }
        },
        {
          "command": "python3 /ram/version.py --version",
          "expect": {
            "exit": 0,
            "stdout": "--version\n",
            "stderr": ""
          }
        },
        {
          "command": "echo 'print(argv[-1])' | python3 - --version",
          "expect": {
            "exit": 0,
            "stdout": "--version\n",
            "stderr": ""
          }
        }
      ]
    },
    {
      "id": "invoked_name_errors_and_help",
      "world": {
        "runtimes": [
          "monty",
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "python /missing-script",
          "expect": {
            "exit": 1,
            "stdout": "",
            "stderr": "python: /missing-script: No such file\n"
          }
        },
        {
          "command": "python3 /missing-script",
          "expect": {
            "exit": 1,
            "stdout": "",
            "stderr": "python3: /missing-script: No such file\n"
          }
        },
        {
          "command": "python3 -h",
          "expect": {
            "exit": 0,
            "stdout_contains": "Usage: python3"
          }
        }
      ]
    },
    {
      "id": "shadowing_function_takes_the_words_as_typed",
      "world": {
        "runtimes": [
          "monty",
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "python3() { echo \"$@\"; }",
          "expect": {
            "exit": 0
          }
        },
        {
          "command": "python3 -c payload -u x",
          "expect": {
            "exit": 0,
            "stdout": "-c payload -u x\n",
            "stderr": ""
          }
        }
      ]
    },
    {
      "id": "unknown_long_option_follows_cpython",
      "world": {
        "runtimes": [
          "monty",
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "python3 --nope",
          "expect": {
            "exit": 2,
            "stdout": "",
            "stderr": "Unknown option: --nope\nusage: python3 [option] ... [-c cmd | -m mod | file | -] [arg] ...\nTry `python -h' for more information.\n"
          }
        }
      ]
    }
  ]
}
