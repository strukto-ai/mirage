{
  "cases": [
    {
      "id": "env",
      "world": {
        "machines": {
          "monty": {
            "provider": "worker"
          }
        }
      },
      "steps": [
        {
          "command": "export GREETING=hello-runtime && python3 -c \"import os; print(os.getenv('GREETING'))\"",
          "expect": {
            "exit": 0,
            "stdout": "hello-runtime\n"
          }
        }
      ]
    },
    {
      "id": "local_time_is_the_sessions_zone",
      "note": "A TZ moves a naive now; with none it is UTC.",
      "world": {
        "machines": {
          "monty": {
            "provider": "worker"
          }
        }
      },
      "steps": [
        {
          "command": "python3 -c \"from datetime import datetime, timezone; print(datetime.now().hour == datetime.now(timezone.utc).hour)\"",
          "expect": {
            "exit": 0,
            "stdout": "True\n"
          }
        },
        {
          "command": "TZ=Asia/Tokyo python3 -c \"from datetime import datetime, timezone; print(round((datetime.now() - datetime.now(timezone.utc).replace(tzinfo=None)).total_seconds() / 3600))\"",
          "expect": {
            "exit": 0,
            "stdout": "9\n"
          }
        }
      ]
    }
  ]
}
