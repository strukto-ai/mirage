{
  "cases": [
    {
      "name": "mount and index TTL 1e3",
      "yaml": "mounts: {/d: {vfs: ram, read: bounded, ttl: 1e3, index: {type: ram, ttl: 1e3}}}\nindex: {type: ram, ttl: 1e3}\n",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram",
            "read": "bounded",
            "ttl": 1000,
            "index": {
              "type": "ram",
              "ttl": 1000
            }
          }
        },
        "index": {
          "type": "ram",
          "ttl": 1000
        }
      }
    },
    {
      "name": "mount and index TTL 1E+3",
