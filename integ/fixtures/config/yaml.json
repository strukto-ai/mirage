    {
      "name": "fractional exponent index TTL",
      "yaml": "mounts: {/d: {vfs: ram}}\nindex: {type: ram, ttl: 1e-3}\n",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "index": {
          "type": "ram",
          "ttl": 0.001
        }
      }
    },
    {
      "name": "quoted exponents remain strings",
      "yaml": "mounts: {/d: {vfs: ram}}\nenv: {SINGLE: '1e3', DOUBLE: \"1e3\", TAGGED: !!str 1e3}\n",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "env": {
          "SINGLE": "1e3",
          "DOUBLE": "1e3",
          "TAGGED": "1e3"
        }
      }
    },
    {
      "name": "fractional mount TTL is refused",
      "yaml": "mounts: {/d: {vfs: ram, read: bounded, ttl: 1e-3}}\n"
    },
    {
      "name": "quoted mount TTL is refused",
      "yaml": "mounts: {/d: {vfs: ram, read: bounded, ttl: \"1e3\"}}\n"
