{
  "note": "Workspace configs both loaders must accept, for commands.deny. The verb differs from ask only in what the gate does with the rule, so the grammar covered here is the same one ask.json covers, and the two files exist so a shape accepted for one verb and refused for the other cannot pass unnoticed. Read with allow/ask and blocks.json by the same gate in both languages; see blocks.json for what the pair is for.",
  "cases": [
    {
      "name": "deny: a bare pattern is a whole-line rule with the default reason",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "profiles": {
          "p": {
            "commands": {
              "deny": [
                "shred",
                "git push --force"
              ]
            }
          }
        }
      }
    },
    {
      "name": "deny: a mapping scopes each command to its own paths",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "profiles": {
          "p": {
            "commands": {
              "deny": [
                {
                  "reason": "prod",
                  "commands": {
                    "rm": [
                      "/d/prod/*"
                    ],
                    "mv": [
                      "/d/prod/*",
                      "/d/docs"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "name": "deny: a rule may state paths alone, which reaches the op door too",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "profiles": {
          "p": {
            "commands": {
              "deny": [
                {
                  "reason": "sealed",
                  "paths": [
                    "/d/sealed/*"
                  ]
                }
              ]
            }
          }
        }
      }
    },
    {
      "name": "deny: a rule may state commands alone, which refuses whatever the operands are",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "profiles": {
          "p": {
            "commands": {
              "deny": [
                {
                  "reason": "no history edits",
                  "commands": [
                    "git commit",
                    "git reset --hard"
                  ]
                }
              ]
            }
          }
        }
      }
    },
    {
      "name": "deny: reason is optional, and a name pattern is a path entry",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "profiles": {
          "p": {
            "commands": {
              "deny": [
                {
                  "commands": {
                    "rm": [
                      "/d/*"
                    ]
                  }
                },
                {
                  "paths": [
                    "*.key"
                  ]
                }
              ]
            }
          }
        }
      }
    },
    {
      "name": "deny: a mount section takes the same rules, its paths under that root",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "profiles": {
          "p": {
            "mounts": {
              "/d": {
                "mode": "read",
                "commands": {
                  "deny": [
                    {
                      "reason": "read-only history",
                      "commands": [
                        "git push"
                      ]
                    },
                    {
                      "reason": "prod",
                      "commands": {
                        "rm": [
                          "/d/prod/*"
                        ]
                      }
                    },
                    {
                      "reason": "keys",
                      "paths": [
                        "*.key"
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "deny: an exact path entry, its subtree, and the root of a mount",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "profiles": {
          "p": {
            "commands": {
              "deny": [
                {
                  "reason": "vault",
                  "paths": [
                    "/d/vault",
                    "/d/a/b/c/*",
                    "/d"
                  ]
                }
              ]
            }
          }
        }
      }
    }
  ]
}
