          }
        },
        "store": {
          "type": "ram",
          "namespace": {
            "type": "s3",
            "bucket": "b"
          }
        }
      }
    },
    {
      "name": "store s3 group: hosts only sessions+meta, not the observer plane",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
