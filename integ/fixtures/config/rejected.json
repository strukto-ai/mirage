    },
    {
      "name": "command rule: reason is a string",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "profiles": {
          "p": {
            "commands": {
              "deny": [
                {
                  "reason": 1,
