    {
      "name": "command rule lists commands beside paths",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "profiles": {
          "p": {
            "commands": {
              "deny": [
                {
                  "reason": "x",
                  "commands": [
                    "rm",
                    "mv"
                  ],
                  "paths": [
                    "/d/a"
                  ]
                }
              ]
            }
          }
        }
      }
    },
    {
      "name": "command rule maps commands and also lists paths",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "profiles": {
          "p": {
            "commands": {
              "deny": [
                {
                  "reason": "x",
                  "commands": {
                    "rm": [
                      "/d/a"
                    ]
                  },
                  "paths": [
                    "/d/b"
                  ]
                }
              ]
            }
          }
        }
      }
    },
    {
      "name": "command rule names no command and no path",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "profiles": {
          "p": {
            "commands": {
              "deny": [
                {
                  "reason": "x"
                }
              ]
            }
          }
        }
      }
    },
    {
      "name": "command rule maps a command to no path",
