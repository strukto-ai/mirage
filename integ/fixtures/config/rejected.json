    },
    {
      "name": "commands: ask is a list, not a scalar",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "profiles": {
          "p": {
            "commands": {
              "ask": "git push"
            }
          }
        }
      }
    },
    {
      "name": "command rule: a blank mapping key names no command",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "profiles": {
          "p": {
            "commands": {
              "deny": [
                {
                  "reason": "x",
                  "commands": {
