        }
      }
    },
    {
      "name": "profile: extends is gone, so a chain cannot be spelled at all",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "profiles": {
          "a": {
            "extends": "b"
          },
          "b": {
            "extends": "a"
          }
        }
      }
    },
    {
      "name": "profile: an ask rule follows the same grammar",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "profiles": {
          "p": {
            "commands": {
              "ask": [
                {
                  "reason": "x",
