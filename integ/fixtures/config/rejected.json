    },
    {
      "name": "mount section: a rule there follows the same grammar",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "profiles": {
          "p": {
            "mounts": {
              "/d": {
                "commands": {
                  "deny": [
                    {
                      "reason": "x",
