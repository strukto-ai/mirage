{
  "note": "Workspace configs both loaders must refuse. Python forbids extra keys on every config block (config.py's ConfigDict(extra='forbid')); the TypeScript loader mirrors those tables in server/src/config.ts. A config that loads in one language and not the other is the bug this fixture exists to catch, so the spellings here are Python's canonical snake_case ones \u2014 a camelCase alias TypeScript would otherwise accept for free is just as unportable as a typo.",
  "cases": [
    {
      "name": "mount block: mount_point for mountpoint",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram",
            "mount_point": "/mnt/x"
          }
        }
      }
    },
    {
      "name": "mount block: resourse for VFS",
      "config": {
        "mounts": {
          "/d": {
            "resourse": "ram"
          }
        }
      }
    },
    {
      "name": "mount block: an unknown read policy",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram",
            "read": "banana"
          }
        }
      }
    },
    {
      "name": "mount block: ttl without read",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram",
            "ttl": 30
          }
        }
      }
    },
    {
      "name": "mount block: bounded without a bound",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram",
            "read": "bounded"
          }
        }
      }
    },
    {
      "name": "mount block: a quoted bound",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram",
            "read": "bounded",
            "ttl": "30"
          }
        }
      }
    },
    {
      "name": "mount block: a boolean bound",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram",
            "read": "bounded",
            "ttl": true
          }
        }
      }
    },
    {
      "name": "mount block: a fractional bound",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram",
            "read": "bounded",
            "ttl": 1.5
          }
        }
      }
    },
    {
      "name": "mount block: a zero bound",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram",
            "read": "bounded",
            "ttl": 0
          }
        }
      }
    },
    {
      "name": "mount block: a negative bound",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram",
            "read": "bounded",
            "ttl": -1
          }
        }
      }
    },
    {
      "name": "cache block: limitt for limit",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "cache": {
          "type": "ram",
          "limitt": "1MB"
        }
      }
    },
    {
      "name": "index block: camelCase keyPrefix",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "index": {
          "type": "redis",
          "keyPrefix": "x:"
        }
      }
    },
    {
      "name": "cache block: camelCase maxDrainBytes",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "cache": {
          "type": "ram",
          "maxDrainBytes": 8
        }
      }
    },
    {
      "name": "clis entry: a cli takes no mode",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "clis": {
          "sl": {
            "cli": "slack",
            "mode": "write"
          }
        }
      }
    },
    {
      "name": "store block: key_prefixx for key_prefix",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "store": {
          "type": "ram",
          "key_prefixx": "m:"
        }
      }
    },
    {
      "name": "store group: urlz for url",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "store": {
          "type": "ram",
          "observer": {
            "type": "redis",
            "urlz": "redis://x"
          }
        }
      }
    },
    {
      "name": "cache block: type is the union discriminator, not optional",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "cache": {
          "limit": "1MB"
        }
      }
    },
    {
      "name": "index block: type is the union discriminator, not optional",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "index": {
          "ttl": 5
        }
      }
    },
    {
      "name": "cache block: no such backend",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "cache": {
          "type": "memcached"
        }
      }
    },
    {
      "name": "store block: s3 hosts only the workspace group, never the default",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "store": {
          "type": "s3"
        }
      }
    },
    {
      "name": "deny rule: path for paths",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "profiles": {
          "p": {
            "commands": {
              "deny": [
                {
                  "reason": "no",
                  "path": [
                    "/x"
                  ]
                }
              ]
            }
          }
        }
      }
    },
    {
      "name": "deny rule: commands is a list, not a scalar",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "profiles": {
          "p": {
            "commands": {
              "deny": [
                {
                  "reason": "no",
                  "commands": "rm"
                }
              ]
            }
          }
        }
      }
    },
    {
      "name": "commands: deny is a list, not a scalar",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "profiles": {
          "p": {
            "commands": {
              "deny": "rm"
            }
          }
        }
      }
    },
    {
      "name": "profile: mounts is a mapping, never a bare list",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "profiles": {
          "p": {
            "mounts": [
              "/d",
              7
            ]
          }
        }
      }
    },
    {
      "name": "profile: a mount mode is a mode name, not a list",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "profiles": {
          "p": {
            "mounts": {
              "/d": {
                "mode": [
                  "read"
                ]
              }
            }
          }
        }
      }
    },
    {
      "name": "profile: the old hidden_paths spelling",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "profiles": {
          "a": {
            "hidden_paths": {
              "paths": [
                "/x"
              ]
            }
          }
        }
      }
    },
    {
      "name": "profile: commands block takes no hide arm",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "profiles": {
          "a": {
            "commands": {
              "hide": [
                "rm"
              ]
            }
          }
        }
      }
    },
    {
      "name": "commands: allow is a list, not a scalar",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "profiles": {
          "p": {
            "commands": {
              "allow": "ls"
            }
          }
        }
      }
    },
    {
      "name": "commands: a blank allow pattern would install every command",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "profiles": {
          "p": {
            "commands": {
              "allow": [
                "ls",
                " "
              ]
            }
          }
        }
      }
    },
    {
      "name": "ask rule: a blank pattern would ask about every command",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "profiles": {
          "p": {
            "commands": {
              "ask": [
                ""
              ]
            }
          }
        }
      }
    },
    {
      "name": "ask rule: mount is the compiler's field, never typed",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "profiles": {
          "p": {
            "commands": {
              "ask": [
                {
                  "reason": "x",
                  "commands": [
                    "rm"
                  ],
                  "mount": "/d"
                }
              ]
            }
          }
        }
      }
    },
    {
      "name": "mount section: no allow list, visibility is not per mount",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "profiles": {
          "p": {
            "mounts": {
              "/d": {
                "commands": {
                  "allow": [
                    "ls"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "profile: extends is gone, a role is the whole document",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "profiles": {
          "p": {
            "extends": "gone"
          }
        }
      }
    },
    {
      "name": "store s3 group: a typo in a backend key is still a load error",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "store": {
          "type": "ram",
          "workspace": {
            "type": "s3",
            "bucket": "b",
            "endpoint_urll": "http://x"
          }
        }
      }
    },
    {
      "name": "store s3 group: hosts only sessions+meta, not the namespace plane",
