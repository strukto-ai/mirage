{
  "note": "Workspace configs both loaders must accept, for commands.ask. The verb differs from deny only in what the gate does with the rule, so the grammar covered here is the same one deny.json covers, and the two files exist so a shape accepted for one verb and refused for the other cannot pass unnoticed. Read with allow/deny and blocks.json by the same gate in both languages; see blocks.json for what the pair is for.",
  "cases": [
    {
      "name": "ask: a bare pattern is a whole-line rule with the default reason",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "profiles": {
          "p": {
            "commands": {
              "ask": [
                "git push",
                "rm"
              ]
            }
          }
        }
      }
    },
    {
      "name": "ask: a mapping scopes each command to its own paths",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "profiles": {
          "p": {
            "commands": {
              "ask": [
                {
                  "reason": "sign-off",
                  "commands": {
                    "rm": [
                      "/d/shared/*"
                    ],
                    "mv": [
                      "/d/shared/*",
                      "/d/docs"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "name": "ask: a rule may state paths alone, which asks about every command",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "profiles": {
          "p": {
            "commands": {
              "ask": [
                {
                  "reason": "under review",
                  "paths": [
                    "/d/review/*"
                  ]
                }
              ]
            }
          }
        }
      }
    },
    {
      "name": "ask: a rule may state commands alone, which asks whatever the operands are",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "profiles": {
          "p": {
            "commands": {
              "ask": [
                {
                  "reason": "history",
                  "commands": [
                    "git commit",
                    "git reset --hard"
                  ]
                }
              ]
            }
          }
        }
      }
    },
    {
      "name": "ask: reason is optional, and a name pattern is a path entry",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "profiles": {
          "p": {
            "commands": {
              "ask": [
                {
                  "commands": {
                    "git push": [
                      "/d/*"
                    ]
                  }
                },
                {
                  "paths": [
                    "*.pem"
                  ]
                }
              ]
            }
          }
        }
      }
    },
    {
      "name": "ask: a mount section takes the same rules, its paths under that root",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "profiles": {
          "p": {
            "mounts": {
              "/d": {
                "commands": {
                  "ask": [
                    "git rebase",
                    {
                      "reason": "prod",
                      "commands": {
                        "rm": [
                          "/d/prod/*"
                        ]
                      }
                    },
                    {
                      "reason": "keys",
                      "paths": [
                        "*.pem"
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  ]
}
