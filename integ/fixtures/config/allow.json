{
  "note": "Workspace configs both loaders must accept, for the one arm of a role's commands block that installs rather than restricts: commands.allow. It is a list of command patterns and nothing else, it exists only at the role level (a mount section stating one is in rejected.json, since visibility is not per mount), and stating none is not the same as stating an empty one. Read with allow/ask/deny and blocks.json by the same gate in both languages; see blocks.json for what the pair is for.",
  "cases": [
    {
      "name": "allow: a list of command patterns, one word and two",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "profiles": {
          "p": {
            "commands": {
              "allow": [
                "ls",
                "cat",
                "git log",
                "git push origin"
              ]
            }
          }
        }
      }
    },
    {
      "name": "allow: a wildcard token stands for any one word",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "profiles": {
          "p": {
            "commands": {
              "allow": [
                "git *",
                "*"
              ]
            }
          }
        }
      }
    },
    {
      "name": "allow: an empty list installs nothing, which is not the same as stating none",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "profiles": {
          "listed": {
            "commands": {
              "allow": []
            }
          },
          "unlisted": {
            "commands": {
              "deny": [
                "shred"
              ]
            }
          }
        }
      }
    },
    {
      "name": "allow: stands beside ask and deny in one block",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "profiles": {
          "p": {
            "commands": {
              "allow": [
                "ls",
                "rm"
              ],
              "ask": [
                "rm"
              ],
              "deny": [
                {
                  "reason": "sealed",
                  "commands": {
                    "rm": [
                      "/d/sealed/*"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    }
  ]
}
