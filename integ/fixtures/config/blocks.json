{
  "note": "Workspace configs both loaders must accept, for every block that is not a permission verb: mounts, cache, index, store, clis, console and the top level. The counterpart to rejected.json, and the reason it exists: TypeScript checks keys against hand-written tables that mirror Python's pydantic models, so a field added on the Python side would be silently refused by TypeScript until a config using it turned up. Every key of every block appears in the accepted set at least once, which turns that drift into a failing test. The three verbs of a role's commands block have a file each (allow.json, ask.json, deny.json), because a rule grammar accepted for one verb and refused for another is exactly the kind of drift a single mixed file hides. Values are only as real as validation demands \u2014 no VFS is built and no script is read, both loaders stop at the shape.",
  "cases": [
    {
      "name": "top level: every key",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "clis": {
          "sl": {
            "cli": "slack"
          }
        },
        "runtimes": [
          "node"
        ],
        "route_policy": "policy.py",
        "profiles": {
          "default": {
            "cwd": "/d",
            "env": {
              "PAGER": "cat"
            },
            "mounts": {
              "/d": "rw"
            },
            "commands": {
              "allow": [
                "ls",
                "cat",
                "git",
                "rm"
              ],
              "ask": [
                "git push",
                {
                  "reason": "sign-off",
                  "commands": {
                    "rm": [
                      "/d/shared/*"
                    ]
                  }
                }
              ],
              "deny": [
                {
                  "reason": "no rm here",
                  "commands": {
                    "rm": [
                      "/d/*"
                    ]
                  }
                },
                "shred"
              ]
            },
            "paths": {
              "hide": [
                "/d/finance",
                "*.key"
              ]
            }
          },
          "reviewer": {
            "mounts": {
              "/d": {
                "mode": "read",
                "paths": {
                  "hide": [
                    "/d/.env",
                    "*.pem"
                  ]
                },
                "commands": {
                  "ask": [
                    "git rebase"
                  ],
                  "deny": [
                    {
                      "reason": "read-only history",
                      "commands": [
                        "git push"
                      ]
                    }
                  ]
                }
              }
            },
            "paths": {
              "hide": [
                "/d/docs"
              ]
            },
            "vars": {
              "hide": [
                "AWS_*"
              ]
            },
            "commands": {
              "allow": [
                "ls",
                "git log"
              ],
              "ask": [
                "git *"
              ],
              "deny": [
                "rm"
              ]
            }
          }
        },
        "mode": "write",
        "read": "fresh",
        "default_session_id": "s1",
        "default_agent_id": "a1",
        "workspace_id": "w1",
        "cache": {
          "type": "ram"
        },
        "index": {
          "type": "ram"
        },
        "store": {
          "type": "ram"
        },
        "profile": "default"
      }
    },
    {
      "name": "mount block: every key",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram",
            "mode": "read",
            "config": {
              "root": "/tmp/x"
            },
            "command_limits": {
              "cat": {
                "max_bytes": 1024,
                "on_exceed": "error"
              }
            },
            "backend": "workspace",
            "mountpoint": "/mnt/d",
            "read": "bounded",
            "ttl": 600
          }
        }
      }
    },
    {
      "name": "mount block: an integral float bound",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram",
            "read": "bounded",
            "ttl": 60.0
          }
        }
      }
    },
    {
      "name": "cache and index: every ram key",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "cache": {
          "type": "ram",
          "limit": "1MB",
          "max_drain_bytes": 8
        },
        "index": {
          "type": "ram",
          "ttl": 5
        }
      }
    },
    {
      "name": "cache and index: every redis key",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "cache": {
          "type": "redis",
          "limit": "1MB",
          "max_drain_bytes": 8,
          "url": "redis://localhost:6379/0",
          "key_prefix": "mirage:cache:"
        },
        "index": {
          "type": "redis",
          "ttl": 5,
          "url": "redis://localhost:6379/0",
          "key_prefix": "mirage:index:"
        }
      }
    },
    {
      "name": "store: every key, one backend per plane",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "store": {
          "type": "redis",
          "url": "redis://localhost:6379/0",
          "key_prefix": "mirage:",
          "root": "/tmp/state",
          "namespace": {
            "type": "ram"
          },
          "observer": {
            "type": "disk",
            "root": "/tmp/observer"
          },
          "workspace": {
            "type": "s3",
            "bucket": "b",
            "region": "us-east-1",
            "endpoint_url": "http://localhost:9000",
            "path_style": true,
            "timeout": 5,
            "key_prefix": "mirage/"
          }
        }
      }
    },
    {
      "name": "clis entry: the script form takes a runtime and a config",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "clis": {
          "tool": {
            "script": "tool.py",
            "runtime": "py",
            "config": {
              "token": "t"
            }
          }
        }
      }
    },
    {
      "name": "clis entry: the cli form takes a file reference",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "clis": {
          "tally": {
            "cli": "./cli/tally.py:TALLY",
            "config": {
              "unit": "kg"
            }
          }
        }
      }
    },
    {
      "name": "clis entry: the cli form takes a module reference",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "clis": {
          "jira": {
            "cli": "my_clis:JIRA"
          }
        }
      }
    },
    {
      "name": "console block: ram form",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "console": {
          "type": "ram"
        }
      }
    },
    {
      "name": "console block: redis form, every key",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "console": {
          "type": "redis",
          "url": "redis://localhost:6379/5",
          "key_prefix": "c:",
          "ttl_seconds": 3600
        }
      }
    },
    {
      "name": "console block: null ttl keeps keys forever",
      "config": {
        "mounts": {
          "/d": {
            "vfs": "ram"
          }
        },
        "console": {
          "type": "redis",
          "ttl_seconds": null
        }
      }
    }
  ]
}
