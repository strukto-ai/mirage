{
  "cases": [
    {
      "id": "git_search_setup",
      "seq": 569500,
      "targets": [
        "git-disk",
        "git-ram"
      ],
      "command": "git init -q -b main /repo/search-case && mkdir -p /repo/search-case/docs && printf 'x = 1\\n' > /repo/search-case/a.py && printf 'alpha\\nbeta\\n' > /repo/search-case/docs/note.txt && git -C /repo/search-case add . && GIT_AUTHOR_NAME=Search GIT_AUTHOR_EMAIL=search@example.com GIT_COMMITTER_NAME=Search GIT_COMMITTER_EMAIL=search@example.com git -C /repo/search-case commit -qm one && printf 'remove_caching_layer = True\\n' >> /repo/search-case/a.py && git -C /repo/search-case add . && GIT_AUTHOR_NAME=Search GIT_AUTHOR_EMAIL=search@example.com GIT_COMMITTER_NAME=Search GIT_COMMITTER_EMAIL=search@example.com git -C /repo/search-case commit -qm two && printf 'x = 1\\n' > /repo/search-case/a.py && git -C /repo/search-case add . && GIT_AUTHOR_NAME=Search GIT_AUTHOR_EMAIL=search@example.com GIT_COMMITTER_NAME=Search GIT_COMMITTER_EMAIL=search@example.com git -C /repo/search-case commit -qm three",
      "expect": {
        "exit": 0,
        "stdout": "",
        "stderr": ""
      }
    },
    {
      "id": "git_search_historical",
      "seq": 569501,
      "targets": [
        "git-disk",
        "git-ram"
      ],
      "command": "git -C /repo/search-case grep -n remove_caching_layer HEAD~1",
      "expect": {
        "exit": 0,
        "stdout": "HEAD~1:a.py:2:remove_caching_layer = True\n",
        "stderr": ""
      }
    },
    {
      "id": "git_search_worktree_no_match",
      "seq": 569502,
      "targets": [
        "git-disk",
        "git-ram"
      ],
      "command": "git -C /repo/search-case grep -n remove_caching_layer",
      "expect": {
        "exit": 1,
        "stdout": "",
        "stderr": ""
      }
    },
    {
