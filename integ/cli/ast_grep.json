{
  "cases": [
    {
      "id": "ast_grep_setup",
      "seq": 568750,
      "targets": [
        "ast-grep-sql"
      ],
      "command": "cd /repo && mkdir -p src rules && printf 'export function main() {\\n  console.log(42)\\n}\\n' > src/a.ts && printf 'def main():\\n    print(42)\\n' > src/b.py && printf 'console.log(42)\\n' > src/c.jsx && printf '%s\\n' '{id: log, language: TypeScript, severity: warning, message: log $A, rule: {pattern: console.log($A)}, fix: emit($A)}' > rules/log.yml && printf 'ruleDirs: [rules]\\n' > sgconfig.yml",
      "expect": {
        "exit": 0,
        "stdout": "",
        "stderr": ""
      }
    },
    {
      "id": "ast_grep_shorthand",
      "seq": 568751,
      "targets": [
        "ast-grep-sql"
      ],
      "command": "cd /repo && ast-grep -p 'console.log($A)' -l ts src",
      "expect": {
        "exit": 0,
        "stdout": "src/a.ts:2:  console.log(42)\n",
        "stderr": ""
      }
    },
    {
      "id": "ast_grep_kind",
      "seq": 568752,
      "targets": [
        "ast-grep-sql"
      ],
      "command": "cd /repo && ast-grep run -k function_definition -l py --files-with-matches src",
      "expect": {
        "exit": 0,
        "stdout": "src/b.py\n",
        "stderr": ""
      }
    },
    {
      "id": "ast_grep_outline",
      "seq": 568753,
      "targets": [
        "ast-grep-sql"
      ],
      "command": "cd /repo && ast-grep outline src/b.py --match main",
      "expect": {
        "exit": 0,
        "stdout": "src/b.py\n1: def main():\n",
        "stderr": ""
      }
    },
    {
      "id": "ast_grep_scan_inline",
      "seq": 568754,
      "targets": [
        "ast-grep-sql"
      ],
      "command": "cd /repo && ast-grep scan --inline-rules '{id: log, language: TypeScript, severity: warning, message: log $A, rule: {pattern: console.log($A)}, fix: emit($A)}' --report-style short src/a.ts",
      "expect": {
        "exit": 0,
        "stdout": "src/a.ts:2:3: warning[log]: log 42\n",
        "stderr": ""
      }
    },
    {
      "id": "ast_grep_scan_rule",
      "seq": 568755,
      "targets": [
        "ast-grep-sql"
      ],
      "command": "cd /repo && ast-grep scan -r rules/log.yml --report-style short src/a.ts",
      "expect": {
        "exit": 0,
        "stdout": "src/a.ts:2:3: warning[log]: log 42\n",
        "stderr": ""
      }
    },
    {
      "id": "ast_grep_scan_project",
      "seq": 568756,
      "targets": [
        "ast-grep-sql"
      ],
      "command": "cd /repo && ast-grep scan --report-style short src",
      "expect": {
        "exit": 0,
        "stdout": "src/a.ts:2:3: warning[log]: log 42\n",
        "stderr": ""
      }
    },
    {
      "id": "ast_grep_preview",
      "seq": 568757,
      "targets": [
        "ast-grep-sql"
      ],
      "command": "cd /repo && ast-grep -p 'console.log($A)' -r 'emit($A)' -l ts src && cat src/a.ts",
      "expect": {
        "exit": 0,
        "stdout": "src/a.ts\n@@ -0,3 +0,3 @@\n1 1│ export function main() {\n2  │-  console.log(42)\n  2│+  emit(42)\n3 3│ }\nexport function main() {\n  console.log(42)\n}\n",
        "stderr": ""
      }
    },
    {
      "id": "ast_grep_update",
      "seq": 568758,
      "targets": [
        "ast-grep-sql"
      ],
      "command": "cd /repo && ast-grep run -p 'console.log($A)' -l js -r 'emit($A)' -U src && cat src/c.jsx",
      "expect": {
