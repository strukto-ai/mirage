    {
      "id": "ast_grep_bounded_rewrite",
      "seq": 568765,
      "targets": [
        "ast-grep-sql"
      ],
      "command": "cd /repo && yes 'foo(1);' | head -n 100000 > dense.ts && ast-grep -p 'foo($X)' -r 'bar($X)' -U dense.ts",
      "expect": {
        "exit": 1,
        "stdout": "",
        "stderr": "ast-grep: parser resource limit exceeded\n"
