      ],
      "command": "cd /repo && mkdir -p ignored && echo 'skip.ts' > ignored/.ignore && echo 'emit(99)' > ignored/skip.ts && echo 'emit(42)' > ignored/keep.ts && ast-grep -p 'emit($A)' -r 'log($A)' -U ignored && cat ignored/skip.ts ignored/keep.ts",
      "expect": {
        "exit": 0,
        "stdout": "emit(99)\nlog(42)\n",
