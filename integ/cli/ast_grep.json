    {
      "id": "ast_grep_scan_update",
      "seq": 568759,
      "targets": [
        "ast-grep-sql"
      ],
      "command": "cd /repo && ast-grep scan -r rules/log.yml -U src && cat src/a.ts",
      "expect": {
