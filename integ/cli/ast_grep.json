    {
      "id": "ast_grep_recovery",
      "seq": 568766,
      "targets": [
        "ast-grep-sql"
      ],
      "command": "cd /repo && head -n 1 dense.ts && ast-grep -p 'emit($X)' src/a.ts",
      "expect": {
        "exit": 0,
        "stdout": "foo(1);\nsrc/a.ts:2:  emit(42)\n",
        "stderr": ""
