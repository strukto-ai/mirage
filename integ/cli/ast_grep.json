    {
      "id": "ast_grep_explicit_glob",
      "seq": 568763,
      "targets": [
        "ast-grep-sql"
      ],
      "command": "cd /repo && ast-grep -p 'emit($A)' --globs '*.jsx' src",
      "expect": {
        "exit": 0,
        "stdout": "src/c.jsx:1:emit(42)\n",
        "stderr": ""
      }
    },
    {
      "id": "ast_grep_readonly",
      "seq": 568764,
      "targets": [
        "ast-grep-sql"
      ],
      "command": "ast-grep -p 'emit($A)' -r 'log($A)' -U /repo/src/a.ts",
      "expect": {
        "exit": 1,
        "stdout": "",
