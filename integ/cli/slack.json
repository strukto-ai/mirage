{
  "cases": [
    {
      "id": "sl_help_head",
      "seq": 564000,
      "targets": ["cli-slack"],
      "command": "slack --help | head -n 1",
      "expect": {
        "exit": 0,
        "stdout": "slack: Slack Web API client\n",
        "stderr": ""
      }
    },
    {
      "id": "sl_unknown_verb",
      "seq": 564001,
      "targets": ["cli-slack"],
      "command": "slack frobnicate",
      "expect": {
        "exit": 1,
        "stdout": "",
        "stderr": "slack: 'frobnicate' is not a slack command. See 'slack --help'.\n"
      }
    },
    {
      "id": "sl_missing_required",
      "seq": 564002,
      "targets": ["cli-slack"],
      "command": "slack send-message --text hi",
      "expect": {
        "exit": 2,
        "stdout": "",
        "stderr": "slack send-message: option '--channel' is required\nTry 'slack send-message --help' for more information.\n"
      }
    },
    {
      "id": "sl_member_info",
