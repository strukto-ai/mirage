      ],
      "command": "hf download integ/repo-cli one_byte.txt --revision main --cache-dir /scratch/c2 --quiet > /dev/null && cat /scratch/c2/models--integ--repo-cli/refs/main | head -c 8",
      "expect": {
        "exit": 0,
        "stdout": "00000000",
        "stderr": ""
      }
    },
    {
      "id": "hf_a_local_mount_is_the_writable_copy",
