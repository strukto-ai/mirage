      ],
      "command": "hf download integ/repo-cli one_byte.txt --local-dir /scratch/wt --quiet > /dev/null && echo -n xy > /scratch/wt/one_byte.txt && hf upload integ/repo-cli /scratch/wt/one_byte.txt one_byte.txt --commit-message edit --quiet > /dev/null && hf download integ/repo-cli one_byte.txt --local-dir /scratch/rt --quiet > /dev/null && cat /scratch/rt/one_byte.txt",
      "expect": {
        "exit": 0,
        "stdout": "xy",
