      }
    },
    {
      "id": "hf_upload_a_directory_spreads_under_the_operand",
      "seq": 960118,
      "targets": [
        "cli-hf"
      ],
      "command": "mkdir -p /scratch/d/sub && echo -n a > /scratch/d/a.txt && echo -n b > /scratch/d/sub/b.txt && hf upload integ/repo-cli /scratch/d dst --commit-message dir --quiet > /dev/null && hf download integ/repo-cli --include 'dst/*' --local-dir /scratch/dl --quiet > /dev/null && cat /scratch/dl/dst/a.txt /scratch/dl/dst/sub/b.txt",
      "expect": {
        "exit": 0,
        "stdout": "ab",
        "stderr": ""
      }
    },
    {
      "id": "hf_download_to_the_cache_lays_out_blobs_refs_and_a_snapshot_link",
      "seq": 960119,
      "targets": [
        "cli-hf"
      ],
      "command": "hf download integ/repo-cli one_byte.txt --revision c3d4e5f60718293a4b5c6d7e8f90213243546576 --cache-dir /scratch/c --quiet > /dev/null && find /scratch/c -type f | sort && find /scratch/c -type l | sort",
      "expect": {
        "exit": 0,
        "stdout": "/scratch/c/models--integ--repo-cli/blobs/c1b0730e0133447badcfd47fd144e254807b06e1\n/scratch/c/models--integ--repo-cli/snapshots/c3d4e5f60718293a4b5c6d7e8f90213243546576/one_byte.txt\n",
        "stderr": ""
      }
    },
    {
      "id": "hf_download_takes_a_commit_sha_as_the_revision",
      "seq": 960120,
      "targets": [
        "cli-hf"
      ],
      "command": "hf download integ/repo-cli one_byte.txt --revision c3d4e5f60718293a4b5c6d7e8f90213243546576 --local-dir /scratch/bysha --quiet > /dev/null && cat /scratch/bysha/one_byte.txt",
      "expect": {
        "exit": 0,
        "stdout": "x",
        "stderr": ""
      }
    },
    {
      "id": "hf_download_to_the_cache_writes_a_ref_for_a_symbolic_revision",
      "seq": 960121,
