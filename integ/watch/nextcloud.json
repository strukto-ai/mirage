{
  "resource": "nextcloud",
  "mount": "/nc",
  "watch_dir": "/nc/data",
  "poll_interval": 1.0,
  "seed": ["keep.txt"],
  "cases": [
    {
      "id": "create_file",
      "mutate": {"op": "write", "path": "data/new.txt", "body": "hello"},
      "expect": {"kind": "create", "path": "/nc/data/new.txt"},
      "verify": {"cmd": "cat /nc/data/new.txt", "contains": "hello"}
    },
    {
      "id": "update_file",
      "mutate": {"op": "write", "path": "data/new.txt", "body": "hello-v2"},
      "expect": {"kind": "update", "path": "/nc/data/new.txt"},
      "verify": {"cmd": "cat /nc/data/new.txt", "contains": "hello-v2"}
    },
    {
      "id": "create_nested",
      "mutate": {"op": "write", "path": "data/sub/deep.txt", "body": "deep"},
      "expect": {"kind": "create", "path": "/nc/data/sub/deep.txt"},
      "verify": {"cmd": "cat /nc/data/sub/deep.txt", "contains": "deep"}
    },
    {
      "id": "delete_file",
      "mutate": {"op": "delete", "path": "data/new.txt"},
      "expect": {"kind": "delete", "path": "/nc/data/new.txt"},
      "verify": {"cmd": "ls /nc/data", "absent": "new.txt"}
    }
  ]
}
