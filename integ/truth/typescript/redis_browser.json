{
  "runs": {
    "typescript": {
      "command": [
        "pnpm",
        "-C",
        "examples/typescript",
        "exec",
        "tsx",
        "redis/redis_browser.ts"
      ]
    }
  },
  "exit": 0,
  "lines": [
    "=== browser mount, over REST ===",
    "$ mkdir /data/notes",
    "$ echo \"hello from the browser\" | tee /data/notes/hello.txt",
    "hello from the browser",
    "$ printf 'alpha\\nbeta\\ngamma\\n' > /data/notes/words.txt",
    "$ ls /data/notes",
    "hello.txt",
    "words.txt",
    "$ cat /data/notes/hello.txt",
    "hello from the browser",
    "$ grep -n beta /data/notes/words.txt",
    "2:beta",
    "$ find /data -type f",
    "/data/notes/hello.txt",
    "/data/notes/words.txt",
    "$ du -a /data/notes",
    "23\t/data/notes/hello.txt",
    "17\t/data/notes/words.txt",
    "40\t/data/notes",
    "",
    "=== bytes survive the REST hop ===",
    "$ printf '\\x00\\xff\\x89' > /data/notes/bytes.bin",
    "$ wc -c /data/notes/bytes.bin",
    "3 /data/notes/bytes.bin",
    "$ xxd /data/notes/bytes.bin",
    "00000000: 00ff 89                                  ...",
    "$ touch /data/notes/empty",
    "$ wc -c /data/notes/empty",
    "0 /data/notes/empty",
    "",
    "=== a file above the request cap goes out as SET + APPENDs ===",
    "$ seq 1 40 > /data/notes/seq.txt",
    "$ wc -c /data/notes/seq.txt",
    "111 /data/notes/seq.txt",
    "$ md5sum /data/notes/seq.txt",
    "298e3f842e8329c42b1b88a64a818754  /data/notes/seq.txt",
    "",
    "=== attributes persist in the attrs hash ===",
    "$ chmod 640 /data/notes/hello.txt",
    "$ stat -c '%a %s %n' /data/notes/hello.txt",
    "640 23 /data/notes/hello.txt",
    "",
    "=== the node mount reads the same keys over the redis protocol ===",
    "$ cat /data/notes/hello.txt",
    "hello from the browser",
    "$ xxd /data/notes/bytes.bin",
    "00000000: 00ff 89                                  ...",
    "$ md5sum /data/notes/seq.txt",
    "298e3f842e8329c42b1b88a64a818754  /data/notes/seq.txt",
    "$ stat -c '%a %s %n' /data/notes/hello.txt",
    "640 23 /data/notes/hello.txt",
    "$ echo \"written by node\" | tee /data/notes/from-node.txt",
    "written by node",
    "",
    "=== and the browser mount sees what node wrote ===",
    "$ cat /data/notes/from-node.txt",
    "written by node",
    "$ ls /data/notes",
    "bytes.bin",
    "empty",
    "from-node.txt",
    "hello.txt",
    "seq.txt",
    "words.txt",
    "",
    "=== cleanup ===",
    "$ rm -r /data/notes",
    "$ ls /data"
  ]
}
