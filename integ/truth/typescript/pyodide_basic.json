{
  "runs": {
    "typescript": {
      "command": [
        "pnpm",
        "-C",
        "examples/typescript",
        "exec",
        "tsx",
        "pyodide/basic.ts"
      ]
    }
  },
  "exit": 0,
  "lines": [
    "python3 in @mirage-ai — Pyodide-backed, three invocation modes",
    "(each command starts a fresh Pyodide interpreter)",
    "",
    "=== python3 -c \"print(2+3)\" ===",
    "5",
    "exit: 0",
    "",
    "=== python3 -c with multi-statement code ===",
    "{\"ok\": true}",
    "exit: 0",
    "",
    "=== python3 -c with args (sys.argv) ===",
    "['alpha', 'beta']",
    "exit: 0",
    "",
    "=== echo \"print(1+1)\" | python3 (stdin-code mode) ===",
    "2",
    "exit: 0",
    "",
    "=== SystemExit honored ===",
    "exit: 3 (expect 3)",
    "",
    "=== uncaught exception → traceback on stderr, exit 1 ===",
    "exit: 1 (expect 1)",
    "stderr tail: RuntimeError: boom",
    ""
  ]
}
