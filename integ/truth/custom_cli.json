{
  "runs": {
    "python": {
      "command": [
        "./python/.venv/bin/python",
        "examples/python/cli/pager.py"
      ]
    },
    "typescript": {
      "command": [
        "pnpm",
        "-C",
        "examples/typescript",
        "exec",
        "tsx",
        "cli/pager.ts"
      ]
    }
  },
  "exit": 0,
  "lines": [
    "$ type -t pager-eng",
    "file",
    "",
    "$ pager-eng --help",
    "usage: pager-eng [-h] {list,ack} ...",
    "",
    "Task-specific incident CLI",
    "",
    "commands:",
    "  list  List incidents for this installed account",
    "  ack   Acknowledge an incident",
    "",
    "options:",
    "  -h, --help  Show this help and exit",
    "",
    "$ pager-eng list",
    "[engineering] INC-101 open Database latency",
    "",
    "$ pager-support list",
    "[support] INC-202 open Checkout retries",
    "",
    "$ pager-eng list INC-101 INC-404 --state open",
    "[engineering] INC-101 open Database latency",
    "",
    "$ pager-eng list --state invalid",
    "pager-eng list: invalid argument 'invalid' for '--state'",
    "Valid arguments are:",
    "  - 'open'",
    "  - 'acknowledged'",
    "Try 'pager-eng list --help' for more information.",
    "",
    "$ pager-eng ack --by Mina",
    "usage: pager-eng ack --by BY [-h] INCIDENT_ID",
    "pager-eng ack: error: the following arguments are required: INCIDENT_ID",
    "",
    "$ pager-eng ack __proto__ --by Mina",
    "pager: unknown incident __proto__",
    "",
    "$ pager-eng ack INC-101 --by Mina",
    "[engineering] acknowledged INC-101 by Mina",
    "",
    "$ pager-eng list --state acknowledged INC-101",
    "[engineering] INC-101 acknowledged-by=Mina Database latency",
    "",
    "$ pager-eng list INC-101 --state open",
    "",
    "$ pager-eng list",
    "[engineering] INC-101 acknowledged-by=Mina Database latency",
    "",
    "$ pager-support list",
    "[support] INC-202 open Checkout retries",
    ""
  ]
}
