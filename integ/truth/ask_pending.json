{
  "runs": {
    "python": {
      "command": [
        "./python/.venv/bin/python",
        "examples/python/policy/ask_pending.py"
      ]
    },
    "typescript": {
      "command": [
        "pnpm",
        "-C",
        "examples/typescript",
        "exec",
        "tsx",
        "policy/ask_pending.ts"
      ]
    }
  },
  "exit": 0,
  "lines": [
    "cat /data/secret.txt: refused (pending), exit 126",
    "rm /data/a.txt: refused (pending), exit 126",
    {
      "re": "host: \\S+ asks cat /data/secret\\.txt \\(secrets are reviewed\\): allow once"
    },
    {
      "re": "host: \\S+ asks rm /data/a\\.txt \\(deletes are reviewed\\): allow session"
    },
    "cat /data/secret.txt: ran, exit 0",
    "rm /data/a.txt: ran, exit 0",
    "cat /data/secret.txt: refused (pending), exit 126",
    "rm /data/a.txt: ran, exit 0"
  ]
}
