{
  "runs": {
    "python": {
      "command": [
        "./python/.venv/bin/python",
        "examples/python/vfs/ram/ram_python.py"
      ]
    },
    "typescript": {
      "command": [
        "pnpm",
        "-C",
        "examples/typescript",
        "exec",
        "tsx",
        "vfs/ram/ram_python.ts"
      ]
    }
  },
  "exit": 0,
  "lines": [
    "=== python3 -c (basic) ===",
    "stdout: 42  (expected: 42)",
    "",
    "=== python3 -c with argv (flag-conditional) ===",
    "argv after -c: ['alpha', 'beta']  (expected: ['alpha', 'beta'])",
    "",
    "=== python3 /ram/script.py (abs path → dispatch read) ===",
    "stdout: hello from vfs  (expected: hello from vfs)",
    "",
    "=== python3 /abs/script.py arg1 arg2 (script + argv) ===",
    "argv after script: ['one', 'two']  (expected: ['one', 'two'])",
    "",
    "=== python3 bare-name script via cwd ===",
    "stdout: hello from vfs  (expected: hello from vfs)",
    "",
    "=== echo code | python3 (stdin) ===",
    "stdout: 42  (expected: 42)",
    "",
    "=== heredoc ===",
    "stdout: 3  (expected: 3)",
    "",
    "=== session env passthrough ===",
    "stdout: hello_mirage  (expected: hello_mirage)"
  ]
}
