{
 "description": "The access corpus. Every way into a workspace (in-app, HTTP, the CLI, MCP over HTTP and mirage mcp, RPC over HTTP and mirage rpc, SSH) must give the in-app answer for every case its protocol can express. The ops table says which accesses have which operation; it is the matrix on docs/home/access/overview.mdx. Each suite runs in order on a fresh workspace per access, built from the suite's config and setup lines; a suite's deployments, when given, are the only ones its server accesses run on. expect pins the in-app answer.",
 "ops": {
  "shell": ["inapp", "http", "cli", "mcp", "mcp_stdio", "rpc", "rpc_stdio", "ssh", "ssh_proxy"],
  "stdin": ["inapp", "http", "cli", "rpc", "rpc_stdio", "ssh", "ssh_proxy"],
  "tool": ["inapp", "http", "cli", "mcp", "mcp_stdio", "rpc", "rpc_stdio"],
  "bytes": ["inapp", "rpc", "rpc_stdio", "ssh", "ssh_proxy"],
  "cancel": ["inapp", "http", "cli", "mcp", "mcp_stdio", "rpc", "rpc_stdio", "ssh", "ssh_proxy"],
  "session": ["inapp", "http", "cli", "mcp", "mcp_stdio", "rpc", "rpc_stdio", "ssh"],
  "workspace": ["inapp", "http", "cli"],
  "session_admin": ["inapp", "http", "cli"],
  "snapshot": ["inapp", "http", "cli"],
  "ask": ["inapp", "http", "cli"],
  "job": ["http", "cli"],
  "auth": ["http", "cli", "mcp", "mcp_stdio", "rpc", "rpc_stdio", "ssh", "ssh_proxy"],
  "server": ["http"]
 },
 "matrix": {
  "Create, list, delete workspaces": "workspace",
  "Create, list, delete sessions": "session_admin",
  "Run a line": "shell",
  "Send stdin to a line": "stdin",
  "Cancel a running line": "cancel",
  "Cancel or kill all of a session's or workspace's work": "session_admin",
  "VFS.md, SKILL.md and session profiles": "session_admin",
  "The seven agent tools": "tool",
  "File operations on bytes": "bytes",
  "Snapshots": "snapshot",
  "Asks": "ask",
  "Jobs": "job"
 },
 "workspace": {
  "mounts": {
   "/": {
    "vfs": "ram",
    "mode": "write"
   },
   "/vault": {
    "vfs": "ram",
    "mode": "write"
   }
  },
  "profiles": {
   "guarded": {
    "paths": {
     "hide": ["/vault"]
    },
    "commands": {
     "allow": ["cat", "ls", "echo", "rm"],
     "deny": [
      {
       "reason": "no deletes here",
       "commands": ["rm"]
      }
     ]
    }
   },
   "asker": {
    "commands": {
     "ask": [
      {
       "reason": "removal needs sign-off",
       "commands": ["rm"]
      }
     ]
    }
   },
   "reader": {
    "paths": {
     "hide": ["/vault"]
    }
   }
  }
 },
 "suites": [
  {
   "id": "shell",
   "op": "shell",
   "setup": ["mkdir -p /src", "printf 'Needle\\nhay\\n' > /src/a.py", "echo key > /vault/key.txt"],
   "cases": [
    {"id": "runs_a_line", "input": {"command": "echo hi"}, "expect": {"text": "hi\n", "is_error": false}},
    {"id": "runs_a_pipeline", "input": {"command": "printf 'a\\nb\\nc\\n' | wc -l"}, "expect": {"text": "3\n", "is_error": false}},
    {"id": "reports_a_failure", "input": {"command": "cat /src/none.txt"}, "expect": {"text": "cat: /src/none.txt: No such file or directory\n", "is_error": true}},
    {"id": "reports_an_exit_status", "input": {"command": "exit 3"}, "expect": {"text": "", "is_error": true}},
    {"id": "keeps_stdout_and_stderr", "input": {"command": "echo out; echo err >&2"}, "expect": {"text": "out\n\nerr\n", "is_error": false}},
    {"id": "keeps_unicode", "input": {"command": "echo 'α β'"}, "expect": {"text": "α β\n", "is_error": false}},
    {"id": "reads_a_file", "input": {"command": "grep -c e /src/a.py"}, "expect": {"text": "1\n", "is_error": false}},
    {"id": "sees_every_mount", "input": {"command": "cat /vault/key.txt"}, "expect": {"text": "key\n", "is_error": false}}
   ]
  },
  {
   "id": "stdin",
   "op": "stdin",
   "setup": [],
   "cases": [
    {"id": "counts_bytes", "input": {"command": "wc -c", "stdin": "abc"}, "expect": {"text": "3\n", "is_error": false}},
    {"id": "passes_lines_through", "input": {"command": "cat", "stdin": "line one\nline two\n"}, "expect": {"text": "line one\nline two\n", "is_error": false}},
    {"id": "takes_empty_input", "input": {"command": "wc -l", "stdin": ""}, "expect": {"text": "0\n", "is_error": false}},
    {"id": "keeps_every_byte", "input": {"command": "md5sum", "stdin": {"repeat": "α\u0000\r\n", "times": 240000}}, "expect": {"text": "87b85f6a2c70337c90a0a5f0a7a8fe10  -\n", "is_error": false}},
    {"id": "matches_unicode_in_bulk", "input": {"command": "grep -o α | wc -l", "stdin": {"repeat": "α x\n", "times": 16000}}, "expect": {"text": "16000\n", "is_error": false}},
    {"id": "streams_into_a_running_line", "accesses": ["inapp", "http", "cli", "ssh"], "input": {"command": "head -n 1", "stream": ["first\n", "second\n"]}, "expect": {"text": "first\n", "is_error": false}},
    {"id": "starts_before_its_stdin_sends_a_byte", "accesses": ["inapp", "http", "cli", "ssh"], "input": {"command": "echo started", "stream": ["", "unread\n"]}, "expect": {"text": "started\n", "is_error": false}}
   ]
  },
  {
   "id": "tool",
   "op": "tool",
   "setup": ["mkdir -p /src/deep", "printf 'Needle\\nhay\\n' > /src/a.py", "printf 'needle\\n' > /src/b.txt", "printf 'x\\n' > /src/deep/c.py", "printf 'a.b\\naxb\\n' > /src/deep/dots.txt", "printf '1\\n2\\n3\\n' > /src/deep/three.txt"],
   "cases": [
    {"id": "shell_runs_a_line", "input": {"tool": "shell", "arguments": {"command": "echo hi"}}, "expect": {"text": "hi\n", "is_error": false}},
    {"id": "shell_reports_a_failure", "input": {"tool": "shell", "arguments": {"command": "cat /src/none.txt"}}, "expect": {"text": "cat: /src/none.txt: No such file or directory\n", "is_error": true}},
    {"id": "read_numbers_lines", "input": {"tool": "read", "arguments": {"path": "/src/a.py"}}, "expect": {"text": "     1\tNeedle\n     2\thay\n", "is_error": false}},
    {"id": "read_takes_a_window", "input": {"tool": "read", "arguments": {"path": "/src/a.py", "offset": 1, "limit": 1}}, "expect": {"text": "     2\thay\n", "is_error": false}},
    {"id": "read_reports_a_missing_file", "input": {"tool": "read", "arguments": {"path": "/src/none.txt"}}, "expect": {"text": "Error: file '/src/none.txt' not found", "is_error": true}},
    {"id": "ls_lists_a_directory", "input": {"tool": "ls", "arguments": {"path": "/src"}}, "expect": {"text": "a.py\nb.txt\ndeep\n", "is_error": false}},
    {"id": "grep_searches_recursively", "input": {"tool": "grep", "arguments": {"pattern": "needle", "path": "/src"}}, "expect": {"text": "/src/b.txt:1:needle\n", "is_error": false}},
    {"id": "grep_ignores_case_in_included_files", "input": {"tool": "grep", "arguments": {"pattern": "needle", "path": "/src", "ignore_case": true, "include": "*.py"}}, "expect": {"text": "/src/a.py:1:Needle\n", "is_error": false}},
    {"id": "grep_names_matching_files", "input": {"tool": "grep", "arguments": {"pattern": "e", "path": "/src", "files_with_matches": true}}, "expect": {"text": "/src/a.py\n/src/b.txt\n", "is_error": false}},
    {"id": "grep_counts_matching_lines", "input": {"tool": "grep", "arguments": {"pattern": "e", "path": "/src/a.py", "count": true}}, "expect": {"text": "1\n", "is_error": false}},
    {"id": "grep_reads_a_fixed_string", "input": {"tool": "grep", "arguments": {"pattern": "a.b", "path": "/src/deep", "fixed_strings": true}}, "expect": {"text": "/src/deep/dots.txt:1:a.b\n", "is_error": false}},
    {"id": "grep_finding_nothing_is_not_an_error", "input": {"tool": "grep", "arguments": {"pattern": "zzz", "path": "/src"}}, "expect": {"text": "", "is_error": false}},
    {"id": "glob_matches_any_depth", "input": {"tool": "glob", "arguments": {"pattern": "**/*.py", "path": "/src"}}, "expect": {"text": "/src/a.py\n/src/deep/c.py\n", "is_error": false}},
    {"id": "glob_matches_one_level", "input": {"tool": "glob", "arguments": {"pattern": "*.py", "path": "/src"}}, "expect": {"text": "/src/a.py\n", "is_error": false}},
    {"id": "glob_takes_an_absolute_pattern", "input": {"tool": "glob", "arguments": {"pattern": "/src/deep/*"}}, "expect": {"text": "/src/deep/c.py\n/src/deep/dots.txt\n/src/deep/three.txt\n", "is_error": false}},
    {"id": "write_creates_parents", "input": {"tool": "write", "arguments": {"path": "/out/new.txt", "content": "one\n"}}, "expect": {"text": "Written: /out/new.txt", "is_error": false}},
    {"id": "write_refuses_an_unread_file", "input": {"tool": "write", "arguments": {"path": "/src/b.txt", "content": "x\n"}}, "expect": {"text": "Error: file '/src/b.txt' exists; read all of it before overwriting it", "is_error": true}},
    {"id": "read_before_overwriting", "input": {"tool": "read", "arguments": {"path": "/src/b.txt"}}, "expect": {"text": "     1\tneedle\n", "is_error": false}},
    {"id": "write_overwrites_a_read_file", "input": {"tool": "write", "arguments": {"path": "/src/b.txt", "content": "pin\n"}}, "expect": {"text": "Written: /src/b.txt", "is_error": false}},
    {"id": "read_a_few_lines", "input": {"tool": "read", "arguments": {"path": "/src/deep/three.txt", "limit": 1}}, "expect": {"text": "     1\t1\n", "is_error": false}},
    {"id": "write_refuses_a_partly_read_file", "input": {"tool": "write", "arguments": {"path": "/src/deep/three.txt", "content": "x\n"}}, "expect": {"text": "Error: file '/src/deep/three.txt' exists; read all of it before overwriting it", "is_error": true}},
    {"id": "edit_refuses_an_ambiguous_string", "input": {"tool": "edit", "arguments": {"path": "/src/a.py", "old_string": "e", "new_string": "E"}}, "expect": {"text": "Error: string appears 3 times. Pass replace_all=true", "is_error": true}},
    {"id": "edit_replaces_every_occurrence", "input": {"tool": "edit", "arguments": {"path": "/src/a.py", "old_string": "e", "new_string": "E", "replace_all": true}}, "expect": {"text": "Edited: /src/a.py (3 occurrence(s))", "is_error": false}},
    {"id": "shell_sees_the_edit", "input": {"tool": "shell", "arguments": {"command": "cat /src/a.py /src/b.txt"}}, "expect": {"text": "NEEdlE\nhay\npin\n", "is_error": false}},
    {"id": "shell_moves_a_file_underneath", "input": {"tool": "shell", "arguments": {"command": "echo moved > /src/b.txt"}}, "expect": {"text": "", "is_error": false}},
    {"id": "edit_refuses_a_stale_file", "input": {"tool": "edit", "arguments": {"path": "/src/b.txt", "old_string": "moved", "new_string": "x"}}, "expect": {"text": "Error: File changed since it was last read: /src/b.txt. Read the file again before modifying it.", "is_error": true}},
    {"id": "shell_links_a_file", "input": {"tool": "shell", "arguments": {"command": "ln -s /src/a.py /src/link.py"}}, "expect": {"text": "", "is_error": false}},
    {"id": "glob_follows_a_link_to_a_file", "input": {"tool": "glob", "arguments": {"pattern": "*.py", "path": "/src"}}, "expect": {"text": "/src/a.py\n/src/link.py\n", "is_error": false}}
   ]
  },
