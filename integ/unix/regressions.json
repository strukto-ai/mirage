  "cases": [
    {
      "id": "pipeline_stops_compound_producer",
      "seq": 9901202,
      "targets": [
        "ram",
        "opfs",
        "disk"
      ],
      "command": "rm -f /data/pipe-produced; for i in {1..20}; do echo x >> /data/pipe-produced; echo \"$i\"; sleep 0.02; done | head -n 1; produced=$(wc -l < /data/pipe-produced); test \"$produced\" -ge 1 && test \"$produced\" -lt 20",
      "expect": {
        "exit": 0,
        "stdout": "1\n",
        "stderr": ""
      }
    },
    {
      "id": "pipefail_keeps_a_producer_that_finished_before_head_closed",
      "seq": 9901205,
      "targets": [
        "ram",
        "opfs",
        "disk"
      ],
      "command": "set -o pipefail; for i in 1 2 3; do echo \"$i\"; done | { sleep 0.05; head -n 1; }; echo \"status=$? pipestatus=${PIPESTATUS[*]}\"; set +o pipefail",
      "expect": {
        "exit": 0,
        "stdout": "1\nstatus=0 pipestatus=0 0\n",
        "stderr": ""
      }
    },
    {
      "id": "pipefail_reports_a_write_after_head_closed",
