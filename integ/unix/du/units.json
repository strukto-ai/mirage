        "box"
      ],
      "command": "mkdir -p /data/dub/s && printf x > /data/dub/a && head -c 5000 /dev/zero > /data/dub/s/b && : > /data/dub/e && ln -s a /data/dub/l && cd /data && du dub; du -a dub; du -S dub; du -b dub; du --apparent-size dub; du -h dub; du --inodes dub; rm -r /data/dub",
      "expect": {
        "exit": 0,
        "stdout": "12\tdub/s\n20\tdub\n4\tdub/a\n0\tdub/e\n0\tdub/l\n8\tdub/s/b\n12\tdub/s\n20\tdub\n12\tdub/s\n8\tdub\n5000\tdub/s\n5002\tdub\n5\tdub/s\n5\tdub\n12K\tdub/s\n20K\tdub\n2\tdub/s\n6\tdub\n",
        "stderr": ""
      },
      "flags": [
        "a",
        "S",
        "b",
        "apparent-size",
        "h",
        "inodes"
      ],
      "note": "By default du counts the 1024-byte blocks each file holds, whole 4 KiB blocks for its bytes and none when empty or a short symlink, and a block for each folder; -b and --apparent-size count bytes and a folder as nothing (debian:stable-slim on ext4)."
