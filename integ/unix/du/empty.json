{
  "cases": [
    {
      "id": "du_empty_dirs_prep",
      "seq": 1301080,
      "targets": [
        "disk",
        "ssh",
        "ram",
        "redis",
        "opfs"
      ],
      "command": "mkdir -p /data/due/e /data/due/g/h && echo hi > /data/due/f",
      "expect": {
        "exit": 0,
        "stdout": "",
        "stderr": ""
      }
    },
    {
      "id": "du_empty_dirs_get_rows",
      "seq": 1301081,
      "targets": [
        "disk",
        "ssh"
      ],
      "command": "du /data/due",
      "expect": {
        "exit": 0,
        "stdout": "0\t/data/due/e\n0\t/data/due/g/h\n0\t/data/due/g\n3\t/data/due\n",
        "stderr": ""
      },
      "note": "The shared readdir walk, which disk and ssh use, prints a row for every directory, an empty one included (0 bytes under -ab, as GNU does), children before their parent and siblings sorted."
    },
    {
      "id": "du_empty_dirs_native_op_has_no_row",
      "seq": 1301082,
      "targets": [
        "ram",
        "redis",
        "opfs"
      ],
      "command": "du /data/due",
      "expect": {
        "exit": 0,
        "stdout": "3\t/data/due\n",
        "stderr": ""
      },
      "note": "Accepted divergence: ram and redis answer du from one pass over the stored files, so a directory holding no file (/data/due/e, /data/due/g, /data/due/g/h) gets no row; GNU and the walk print 0 for each. See du_entries on BaseVFS."
    },
    {
      "id": "du_empty_dirs_with_files",
      "seq": 1301083,
      "targets": [
        "disk",
        "ssh"
      ],
      "command": "du -a /data/due",
      "expect": {
        "exit": 0,
        "stdout": "0\t/data/due/e\n3\t/data/due/f\n0\t/data/due/g/h\n0\t/data/due/g\n3\t/data/due\n",
        "stderr": ""
      }
    },
    {
      "id": "du_empty_operand_is_zero",
      "seq": 1301086,
      "targets": [
        "disk",
        "ssh",
        "ram",
        "redis",
        "opfs"
      ],
      "command": "mkdir /data/cre && du /data/cre; du -s /data/cre; rmdir /data/cre",
      "expect": {
        "exit": 0,
        "stdout": "0\t/data/cre\n0\t/data/cre\n",
        "stderr": ""
      }
    },
    {
      "id": "du_empty_dirs_depth_limit",
      "seq": 1301084,
      "targets": [
        "disk",
        "ssh"
      ],
      "command": "du --max-depth=1 /data/due",
      "expect": {
        "exit": 0,
        "stdout": "0\t/data/due/e\n0\t/data/due/g\n3\t/data/due\n",
        "stderr": ""
      }
    },
    {
      "id": "du_empty_dirs_across_mounts",
      "seq": 1301085,
      "targets": [
        "disk",
        "ssh"
      ],
      "command": "du / | grep '/due'",
      "expect": {
        "exit": 0,
        "stdout": "0\t/data/due/e\n0\t/data/due/g/h\n0\t/data/due/g\n3\t/data/due\n",
        "stderr": ""
      },
      "note": "A walk from / folds every mount's rows into one tree; an empty directory prints like an empty file there, so the merge asks the dispatcher which each lone 0 row is."
    },
    {
      "id": "du_empty_dirs_cleanup",
      "seq": 1301087,
      "targets": [
        "disk",
        "ssh",
        "ram",
        "redis",
        "opfs"
      ],
      "command": "rm -rf /data/due && test ! -e /data/due && echo gone",
      "expect": {
        "exit": 0,
        "stdout": "gone\n",
        "stderr": ""
      }
    }
  ]
}
