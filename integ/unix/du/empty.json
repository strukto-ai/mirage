{
  "cases": [
    {
      "id": "du_empty_dirs_prep",
      "seq": 1301080,
      "targets": [
        "disk",
        "ssh",
        "tidb-filesystem",
        "ram",
        "redis",
        "opfs"
      ],
      "command": "mkdir -p /data/due/e /data/due/g/h && echo hi > /data/due/f",
      "expect": {
        "exit": 0,
        "stdout": "",
        "stderr": ""
      }
    },
    {
      "id": "du_empty_dirs_get_rows",
      "seq": 1301081,
      "targets": [
        "disk",
        "ssh",
        "tidb-filesystem",
        "ram",
        "redis",
        "opfs"
      ],
      "command": "du /data/due",
      "expect": {
        "exit": 0,
        "stdout": "0\t/data/due/e\n0\t/data/due/g/h\n0\t/data/due/g\n3\t/data/due\n",
        "stderr": ""
      },
      "note": "Every directory gets a row, an empty one included (0 bytes under -ab, as GNU does), children before their parent and siblings sorted, whether the walk lists each directory or the mount's read_tree lists the subtree."
    },
    {
      "id": "du_empty_dirs_with_files",
      "seq": 1301083,
      "targets": [
        "disk",
        "ssh",
        "tidb-filesystem",
        "ram",
        "redis",
        "opfs"
      ],
      "command": "du -a /data/due",
      "expect": {
        "exit": 0,
        "stdout": "0\t/data/due/e\n3\t/data/due/f\n0\t/data/due/g/h\n0\t/data/due/g\n3\t/data/due\n",
        "stderr": ""
      }
    },
    {
      "id": "du_empty_operand_is_zero",
      "seq": 1301086,
      "targets": [
        "disk",
        "ssh",
        "tidb-filesystem",
        "ram",
        "redis",
        "opfs"
      ],
      "command": "mkdir /data/cre && du /data/cre; du -s /data/cre; rmdir /data/cre",
      "expect": {
        "exit": 0,
        "stdout": "0\t/data/cre\n0\t/data/cre\n",
        "stderr": ""
      }
    },
    {
      "id": "du_empty_dirs_depth_limit",
      "seq": 1301084,
      "targets": [
        "disk",
        "ssh",
        "tidb-filesystem",
        "ram",
        "redis",
        "opfs"
      ],
      "command": "du --max-depth=1 /data/due",
      "expect": {
        "exit": 0,
        "stdout": "0\t/data/due/e\n0\t/data/due/g\n3\t/data/due\n",
        "stderr": ""
      }
    },
    {
      "id": "du_empty_dirs_across_mounts",
      "seq": 1301085,
      "targets": [
        "disk",
        "ssh",
        "tidb-filesystem",
        "ram",
        "redis",
        "opfs"
      ],
      "command": "du / 2>/dev/null | grep '/due'",
      "expect": {
        "exit": 0,
        "stdout": "0\t/data/due/e\n0\t/data/due/g/h\n0\t/data/due/g\n3\t/data/due\n",
        "stderr": ""
      },
      "note": "A walk from / folds every mount's rows into one tree; an empty directory prints like an empty file there, so the merge asks the dispatcher which each lone 0 row is. Its stderr is dropped: a remote /data past its walk_limit stops the walk with a note there."
    },
    {
      "id": "du_empty_dirs_cleanup",
      "seq": 1301087,
      "targets": [
        "disk",
        "ssh",
        "tidb-filesystem",
        "ram",
        "redis",
        "opfs"
      ],
      "command": "rm -rf /data/due && test ! -e /data/due && echo gone",
      "expect": {
        "exit": 0,
        "stdout": "gone\n",
        "stderr": ""
      }
    }
  ]
}
