    {
      "id": "base64_stream_no_wrap",
      "seq": 960400,
      "command": "printf abc | base64 -w 0",
      "expect": {
        "exit": 0,
        "stdout": "YWJj",
        "stderr": ""
      }
    },
    {
      "id": "base64_stream_padded_blocks",
      "seq": 960401,
      "command": "printf 'YQ==Yg==' | base64 -d",
      "expect": {
        "exit": 0,
        "stdout": "ab",
        "stderr": ""
      }
    },
    {
      "id": "base64_stream_unpadded_tail",
      "seq": 960402,
      "command": "printf 'YWI' | base64 -d",
      "expect": {
        "exit": 0,
        "stdout": "ab",
        "stderr": ""
      }
    },
    {
      "id": "base64_stream_incomplete_padding",
      "seq": 960403,
      "command": "printf 'YQ=' | base64 -d",
      "expect": {
        "exit": 1,
        "stdout": "a",
        "stderr": "base64: invalid input\n"
      }
    },
    {
      "id": "base64_stream_invalid_suffix_keeps_prefix",
      "seq": 960404,
      "command": "printf 'YWJj!ZA==' | base64 -d",
      "expect": {
        "exit": 1,
        "stdout": "abc",
        "stderr": "base64: invalid input\n"
      }
    },
    {
      "id": "base64_stream_space_is_not_a_newline",
