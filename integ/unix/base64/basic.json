        "exit": 1,
        "stdout": "a",
        "stderr": "base64: invalid input\n"
      }
    },
    {
      "id": "base64_stream_extra_padding",
      "seq": 960406,
      "command": "printf 'YQ===' | base64 -d",
      "expect": {
        "exit": 1,
        "stdout": "a",
        "stderr": "base64: invalid input\n"
      }
    },
    {
      "id": "base64_stream_split_padding",
      "seq": 960407,
      "command": "printf 'YQ=\\n=' | base64 -d",
      "expect": {
        "exit": 0,
        "stdout": "a",
        "stderr": ""
      }
    },
    {
      "id": "base64_stream_nonzero_padding_bits",
      "seq": 960408,
      "command": "printf 'YWF=Yg==' | base64 -d",
      "expect": {
        "exit": 1,
        "stdout": "aa",
        "stderr": "base64: invalid input\n"
      }
    },
