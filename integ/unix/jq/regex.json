{
  "cases": [
    {
      "id": "jq_regex_capture_named_groups",
      "seq": 18610001,
      "targets": [
        "ram",
        "disk",
        "redis",
        "opfs"
      ],
      "command": "printf '\"2023-01-15T10:30:00Z\"' | jq -c 'capture(\"(?<y>\\\\d{4})-(?<m>\\\\d{2})-(?<d>\\\\d{2})\")'",
      "expect": {
        "exit": 0,
        "stdout": "{\"y\":\"2023\",\"m\":\"01\",\"d\":\"15\"}\n",
        "stderr": ""
      }
    },
    {
      "id": "jq_regex_match_offsets_count_characters",
      "seq": 18610002,
      "targets": [
        "ram",
        "disk",
        "redis",
        "opfs"
      ],
      "command": "printf '\"\\303\\251t\\303\\251 bar\"' | jq -c '[match(\"\\\\w+\"; \"g\") | [.offset, .length, .string]]'",
      "expect": {
        "exit": 0,
        "stdout": "[[0,3,\"été\"],[4,3,\"bar\"]]\n",
        "stderr": ""
      }
    },
    {
      "id": "jq_regex_gsub_with_named_capture_and_flags",
      "seq": 18610003,
      "targets": [
        "ram",
        "disk",
        "redis",
        "opfs"
      ],
      "command": "printf '\"Hello World\"' | jq -r 'gsub(\"(?<c>o)\"; \"[\\(.c)]\"; \"i\")'",
      "expect": {
        "exit": 0,
        "stdout": "Hell[o] W[o]rld\n",
        "stderr": ""
      }
    },
    {
      "id": "jq_regex_split_splits_and_scan",
      "seq": 18610004,
      "targets": [
        "ram",
        "disk",
        "redis",
        "opfs"
      ],
      "command": "printf '\"a1b22c333\"' | jq -c '[split(\"\\\\d+\"; null), [splits(\"[a-c]\")], [scan(\"\\\\d+\")]]'",
      "expect": {
        "exit": 0,
        "stdout": "[[\"a\",\"b\",\"c\",\"\"],[\"\",\"1\",\"22\",\"333\"],[\"1\",\"22\",\"333\"]]\n",
        "stderr": ""
      }
    },
    {
      "id": "jq_regex_test_on_a_file",
      "seq": 18610005,
      "targets": [
        "ram",
        "disk",
        "redis",
        "opfs"
      ],
      "command": "jq '.name | test(\"^AL\"; \"i\")' /data/user.json",
      "expect": {
        "exit": 0,
        "stdout": "true\n",
        "stderr": ""
      }
    },
    {
      "id": "jq_regex_zero_width_matches_advance_one_past",
      "seq": 18610006,
      "targets": [
        "ram",
        "disk",
        "redis",
        "opfs"
      ],
      "command": "printf '\"qux\"' | jq -c '[match(\"(?=u)\"; \"g\")], gsub(\"\"; \"-\")'",
      "expect": {
        "exit": 0,
        "stdout": "[{\"offset\":1,\"length\":0,\"string\":\"\",\"captures\":[]}]\n\"-q-u-x-\"\n",
        "stderr": ""
      }
    },
    {
      "id": "jq_regex_invalid_pattern_reports_the_regex_failure",
      "seq": 18610007,
      "targets": [
        "ram",
        "disk",
        "redis",
        "opfs"
      ],
      "command": "printf '\"x\"' | jq 'test(\"(\")'; echo rc=$?",
      "expect": {
        "exit": 0,
        "stdout": "rc=5\n",
        "stderr": "jq: error (at <stdin>:0): Regex failure: end pattern with unmatched parenthesis\n"
      }
    },
    {
      "id": "jq_regex_invalid_modifier_is_an_error",
      "seq": 18610008,
      "targets": [
        "ram",
        "disk",
        "redis",
        "opfs"
      ],
      "command": "printf '\"x\"' | jq 'test(\"x\"; \"gq\")'; echo rc=$?",
      "expect": {
        "exit": 0,
        "stdout": "rc=5\n",
        "stderr": "jq: error (at <stdin>:0): gq is not a valid modifier string\n"
      }
    },
    {
      "id": "jq_regex_backtracking_stops_at_the_retry_limit",
      "seq": 18610009,
      "targets": [
        "ram",
        "disk",
        "redis",
        "opfs"
      ],
      "command": "printf '\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa!\"' | jq 'test(\"^(a+)+$\")'; echo rc=$?",
      "expect": {
        "exit": 0,
        "stdout": "rc=5\n",
        "stderr": "jq: error (at <stdin>:0): Regex failure: retry-limit-in-match over\n"
      }
    },
    {
      "id": "jq_regex_folds_sharp_s_to_ss",
      "seq": 18610010,
      "targets": [
        "ram",
        "disk",
        "redis",
        "opfs"
      ],
      "command": "printf '[\"ß\",\"ss\",\"SS\",\"sſ\",\"ẞ\",\"s\"]' | jq -c 'map(test(\"^ss$\";\"i\")), map(test(\"^ß$\";\"i\"))'",
      "expect": {
        "exit": 0,
        "stdout": "[true,true,true,true,true,false]\n[true,true,true,true,true,false]\n",
        "stderr": ""
      }
    },
    {
      "id": "jq_regex_folds_a_ligature_to_its_letters",
      "seq": 18610011,
      "targets": [
        "ram",
        "disk",
        "redis",
        "opfs"
      ],
      "command": "printf '[\"ﬃ\",\"ffi\",\"FFI\",\"ﬀi\",\"ﬁ\"]' | jq -c 'map(test(\"^ffi$\";\"i\")), map(test(\"^[ﬃ]$\";\"i\"))'",
      "expect": {
        "exit": 0,
        "stdout": "[true,true,true,false,false]\n[true,true,true,false,false]\n",
        "stderr": ""
      }
    },
    {
      "id": "jq_regex_fold_covers_one_literal_run",
      "seq": 18610012,
      "targets": [
        "ram",
        "disk",
        "redis",
        "opfs"
      ],
      "command": "printf '\"ß\"' | jq -c '[test(\"(s)s\";\"i\"), test(\"(?:s)s\";\"i\"), test(\"ss+\";\"i\"), test(\"s(?i)s\";\"i\"), test(\"(?i:s)s\";\"i\"), test(\"[s]s\";\"i\")]'",
      "expect": {
        "exit": 0,
        "stdout": "[false,true,false,true,false,false]\n",
        "stderr": ""
      }
    },
    {
      "id": "jq_regex_folds_a_class_member_to_several",
      "seq": 18610013,
      "targets": [
        "ram",
        "disk",
        "redis",
        "opfs"
      ],
      "command": "printf '\"ssßSS\"' | jq -c '[match(\"[ß]\";\"gi\") | [.offset, .length, .string]], [match(\"[^ß]\";\"gi\") | .string]'",
      "expect": {
        "exit": 0,
        "stdout": "[[0,2,\"ss\"],[2,1,\"ß\"],[3,2,\"SS\"]]\n[\"s\",\"s\",\"S\",\"S\"]\n",
        "stderr": ""
      }
    },
    {
      "id": "jq_regex_global_match_folds_each_way",
      "seq": 18610014,
      "targets": [
        "ram",
        "disk",
        "redis",
        "opfs"
      ],
      "command": "printf '\"Strasse STRASSE Straße\"' | jq -c '[match(\"ß\";\"gi\") | .string], [match(\"ss\";\"gi\") | .string]'",
      "expect": {
        "exit": 0,
        "stdout": "[\"ss\",\"SS\",\"ß\"]\n[\"ss\",\"SS\",\"ß\"]\n",
        "stderr": ""
      }
    },
    {
      "id": "jq_regex_backreference_folds_by_the_bytes",
      "seq": 18610015,
      "targets": [
        "ram",
        "disk",
        "redis",
        "opfs"
      ],
      "command": "printf '[\"ßß\",\"ßss\",\"ssß\"]' | jq -c 'map(test(\"^(ss)\\\\1$\";\"i\")), map(test(\"^(ß)\\\\1$\";\"i\"))'",
      "expect": {
        "exit": 0,
        "stdout": "[true,false,false]\n[true,false,false]\n",
        "stderr": ""
      }
    },
    {
      "id": "jq_regex_look_behind_folds_one_to_one",
      "seq": 18610016,
      "targets": [
        "ram",
        "disk",
        "redis",
        "opfs"
      ],
      "command": "printf '[\"xß\",\"xss\",\"xẞ\"]' | jq -c 'map(test(\"(?<=ss)$\";\"i\")), map(test(\"(?<=ß)$\";\"i\"))'",
      "expect": {
        "exit": 0,
        "stdout": "[false,true,false]\n[true,false,true]\n",
        "stderr": ""
      }
    },
    {
      "id": "jq_regex_look_behind_rejects_a_class_folding_to_several",
      "seq": 18610017,
      "targets": [
        "ram",
        "disk",
        "redis",
        "opfs"
      ],
      "command": "printf '\"ss\"' | jq 'test(\"(?<=[ß])$\";\"i\")'; echo rc=$?",
      "expect": {
        "exit": 0,
        "stdout": "rc=5\n",
        "stderr": "jq: error (at <stdin>:0): Regex failure: invalid pattern in look-behind\n"
      }
    },
    {
      "id": "jq_regex_sub_folds_dotted_i_and_apostrophe_n",
      "seq": 18610018,
      "targets": [
        "ram",
        "disk",
        "redis",
        "opfs"
      ],
      "command": "printf '[\"İ\",\"i̇\",\"ŉ\",\"ʼN\"]' | jq -c 'map(sub(\"i̇\";\"I\";\"i\")), map(test(\"^ŉ$\";\"i\"))'",
      "expect": {
        "exit": 0,
        "stdout": "[\"I\",\"I\",\"ŉ\",\"ʼN\"]\n[false,false,true,true]\n",
