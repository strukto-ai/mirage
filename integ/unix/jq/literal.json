    {
      "id": "jq_keeps_the_literal_of_each_number_it_reads",
      "seq": 701073,
      "targets": [
        "ram",
        "disk",
        "redis",
        "opfs"
      ],
      "command": "mkdir -p /data/qjql && printf '1.000 1e2 -0 100000000000000000001 0.00001 1E-7 1e17 1.5e1 100e-2 .5 +1 01 1. 1e1000 -1e1000 0e10 -0.0 1.0e0 123456789012345678901234567890' > /data/qjql/n.json && jq -c . /data/qjql/n.json",
      "expect": {
        "exit": 0,
        "stdout": "1.000\n1E+2\n-0\n100000000000000000001\n0.00001\n1E-7\n1E+17\n15\n1.00\n0.5\n1\n1\n1\n1E+1000\n-1E+1000\n0E+10\n-0.0\n1.0\n123456789012345678901234567890\n",
        "stderr": ""
      },
      "flags": [
        "c"
      ]
    },
