        "stderr": ""
      },
      "flags": [
        "n",
        "c"
      ]
    },
    {
      "id": "jq_slice_nested_subtraction",
      "seq": 18612006,
      "targets": [
        "ram",
        "disk",
        "redis",
        "opfs"
      ],
      "command": "jq -nc '[range(1000)] as $a | [$a, [$a[] | . + 1], $a] - [$a] | map(length)'",
      "expect": {
        "exit": 0,
        "stdout": "[1000]\n",
        "stderr": ""
      },
      "flags": [
        "n",
        "c"
      ]
    },
    {
      "id": "jq_slice_nan_equality_and_grouping",
      "seq": 18612007,
      "targets": [
        "ram",
        "disk",
        "redis",
        "opfs"
      ],
      "command": "jq -nc '[[nan] == [nan], ([nan] as $a | $a == $a), ([1,nan,nan] | group_by(.) | map(length)), ([[nan],[nan],[1]] - [[nan]])]'",
      "expect": {
        "exit": 0,
        "stdout": "[false,true,[1,1,1],[[null],[null],[1]]]\n",
        "stderr": ""
      },
      "flags": [
        "n",
        "c"
      ]
    }
  ]
