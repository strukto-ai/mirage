      "targets": [
        "statvfs"
      ],
      "command": "id; id -u; id -un; id -G; id -uz | od -An -c",
      "expect": {
        "exit": 0,
        "stdout": "uid=1000(ops) gid=1000(ops) groups=1000(ops)\n1000\nops\n1000\n   1   0   0   0  \\0\n",
        "stderr": ""
      }
    },
    {
      "id": "id_session_profile_is_the_group",
      "seq": 16100212,
      "targets": [
        "statvfs"
      ],
      "session": "auditor",
      "command": "id; id -gn",
      "expect": {
        "exit": 0,
        "stdout": "uid=1000(auditor) gid=1000(auditor) groups=1000(auditor)\nauditor\n",
        "stderr": ""
      }
    },
    {
      "id": "id_named_user",
      "seq": 16100213,
      "targets": [
        "statvfs"
      ],
      "command": "id ops; id -u nobody ops; id ''",
      "expect": {
        "exit": 1,
        "stdout": "uid=1000(ops) gid=1000(ops) groups=1000(ops)\n65534\n1000\n",
        "stderr": "id: '': no such user: No such file or directory\n"
      }
    },
    {
      "id": "id_refusals",
      "seq": 16100214,
      "targets": [
        "statvfs"
      ],
      "command": "id -Z -u -g; id -u -g; id -n; id -r; id -z",
      "expect": {
        "exit": 1,
        "stdout": "",
        "stderr": "id: --context (-Z) works only on an SELinux-enabled kernel\nid: cannot print \"only\" of more than one choice\nid: printing only names or real IDs requires -u, -g, or -G\nid: printing only names or real IDs requires -u, -g, or -G\nid: option --zero not permitted in default format\n"
      }
    },
    {
      "id": "id_a_profile_is_uid_1000_with_a_home",
      "seq": 16100217,
      "targets": [
        "statvfs"
      ],
      "command": "echo $UID $EUID ~ ~ops; whoami; stat -c '%U %u %G %g' /vfs",
      "expect": {
