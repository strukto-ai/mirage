      "id": "zgrep_bytes_spellings",
      "seq": 14470400,
      "command": "( export LC_ALL=C; printf 'A\\302\\240B\\302\\240C\\n' | gzip > /data/bytes.gz; zgrep -c $'\\xc2\\xa0' /data/bytes.gz; zgrep -boP '\\xa0' /data/bytes.gz | od -An -tx1 )",
      "expect": {
        "exit": 0,
        "stdout": "1\n 32 3a a0 0a 35 3a a0 0a\n",
        "stderr": ""
      }
    },
    {
      "id": "zgrep_bytes_invalid",
      "seq": 14470401,
      "command": "( export LC_ALL=C; printf 'A\\377B\\n' | gzip > /data/bytes.gz; zgrep -o $'\\xff' /data/bytes.gz | od -An -tx1 )",
      "expect": {
        "exit": 0,
        "stdout": " ff 0a\n",
        "stderr": ""
      }
