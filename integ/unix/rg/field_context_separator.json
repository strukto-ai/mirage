      "command": "rg -n -A1 --field-context-separator '|' world /data/a.txt; rg -H -n -B1 --field-context-separator='\\x3d' --field-match-separator ': ' world /data/a.txt; rg --field-context-separator '\\t' -n -A1 world /data/a.txt | od -An -tx1",
