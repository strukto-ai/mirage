        "databricks-prefix",
        "sharepoint-prefix"
      ],
      "command": "mkdir -p /data/qcmo && printf 'b\\na\\nc\\n' > /data/qcmo/u && printf 'a\\nb\\nc\\n' > /data/qcmo/s && comm --total /data/qcmo/u /data/qcmo/s",
      "expect": {
        "exit": 1,
        "stdout": "\ta\n\t\tb\na\n\t\tc\n1\t1\t2\ttotal\n",
        "stderr": "comm: file 1 is not in sorted order\ncomm: input is not in sorted order\n"
      },
      "flags": [
        "total"
      ],
      "note": "GNU's default checks order once a line unique to one file has printed: it warns once per file, prints everything, and closes with 'input is not in sorted order', exit 1. Pinned in debian:stable-slim."
    },
