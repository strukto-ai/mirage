    {
      "id": "cmp_skips_the_bytes_its_operands_name",
      "seq": 1311026,
      "targets": [
        "ram",
        "disk",
        "redis",
        "opfs",
        "s3",
        "databricks",
        "gridfs",
        "s3-prefix",
        "databricks-prefix",
        "gridfs-prefix",
        "hf",
        "hf-prefix",
        "dropbox",
        "dropbox-root",
        "onedrive",
        "sharepoint",
        "sharepoint-prefix",
        "ssh",
        "nextcloud",
        "gdrive",
        "gdrive-folder",
        "box"
      ],
      "command": "cmp /data/a.txt /data/a.txt 6 6; echo rc=$?; cmp /data/a.txt /data/a.txt 0 6; echo rc=$?",
      "expect": {
        "exit": 0,
        "stdout": "rc=0\n/data/a.txt /data/a.txt differ: char 1, line 1\nrc=1\n",
        "stderr": ""
      }
