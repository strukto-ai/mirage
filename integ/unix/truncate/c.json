{
  "cases": [
    {
      "id": "truncate_c_seed",
      "seq": 910070,
      "targets": [
        "ram",
        "disk",
        "redis",
        "opfs"
      ],
      "command": "mkdir -p /data/t2tc && printf abcdef > /data/t2tc/f && echo ok",
      "expect": {
        "exit": 0,
        "stdout": "ok\n",
        "stderr": ""
      }
    },
    {
      "id": "truncate_c_leaves_a_missing_file_alone",
      "seq": 910071,
      "targets": [
        "ram",
        "disk",
        "redis",
        "opfs"
      ],
      "flags": [
        "c",
        "s",
        "r",
        "reference"
      ],
      "command": "truncate -c -s 3 /data/t2tc/new; echo rc=$?; test -e /data/t2tc/new; echo new=$?; printf abcdefgh > /data/t2tc/fl1r; printf ab > /data/t2tc/fl1; truncate -r /data/t2tc/fl1r /data/t2tc/fl1; wc -c < /data/t2tc/fl1; truncate -r /data/t2tc/fl1r -s +2 /data/t2tc/fl1; wc -c < /data/t2tc/fl1; truncate --reference=/data/t2tc/nope /data/t2tc/fl1; echo rc=$?; rm /data/t2tc/fl1 /data/t2tc/fl1r",
      "expect": {
        "exit": 0,
        "stdout": "rc=0\nnew=1\n8\n10\nrc=1\n",
        "stderr": "truncate: cannot stat '/data/t2tc/nope': No such file or directory\n"
      }
    },
    {
      "id": "truncate_c_missing_parent_is_silent",
      "seq": 910072,
      "targets": [
        "ram",
        "disk",
        "redis",
        "opfs"
      ],
      "flags": [
        "c",
        "s"
      ],
