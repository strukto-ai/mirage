        },
        {
          "command": "cat /data/wp3new.txt /data/wp3.txt"
        },
        {
          "mutate": {
            "path": "/data/wp3c.txt",
            "content": "v1\n"
          }
        },
        {
          "command": "echo r > /data2/wp3r.txt; cp /data2/wp3r.txt /data/wp3c.txt; echo $?; cat /data/wp3c.txt"
        }
      ],
      "note": "With no version a write goes out plain: a new name is written, and so is a name mirage never read, by a redirect or a cp from another mount.",
      "expect": {
        "exit": 0,
        "stdout": "0\n0\nx\ny\n0\nr\n",
        "stderr": ""
      }
    },
    {
      "id": "write_conditional_redirect_rewrite",
      "seq": 310073,
      "targets": [
        "s3",
        "s3-prefix"
      ],
      "read": "bounded",
      "ttl": 600,
      "write": "conditional",
      "scenario": [
        {
          "command": "echo a > /data/wp4.txt"
        },
        {
          "mutate": {
            "path": "/data/wp4.txt",
            "content": "theirs\n"
          }
        },
        {
          "command": "echo b > /data/wp4.txt; echo $?"
        },
        {
          "command": "cat /data/wp4.txt"
        }
      ],
      "note": "A redirect keeps the version its own PUT returned, so after another writer changes the file the next redirect carries If-Match and is refused; a plain write would land.",
      "expect": {
        "exit": 0,
        "stdout": "1\ntheirs\n",
        "stderr": "/data/wp4.txt: changed since it was read; read it again before writing\n"
      }
    },
    {
      "id": "write_conditional_minio_refuses_copy_and_delete",
      "seq": 310074,
      "targets": [
        "object-storage-prefix"
      ],
      "read": "bounded",
      "ttl": 600,
      "write": "conditional",
      "scenario": [
        {
          "mutate": {
            "path": "/minio/wp5.txt",
            "content": "v1\n"
          }
        },
        {
          "command": "cat /minio/wp5.txt; cp /minio/wp5.txt /minio/wp5b.txt; echo $?"
        },
        {
          "command": "rm /minio/wp5.txt; echo $?"
        },
        {
          "command": "cat /minio/wp5.txt; ls /minio"
        }
      ],
      "note": "MinIO ignores copy and delete conditions (measured 2026-10-06), so the minio row has none and mirage refuses the copy and the delete itself, before any request; both leave the file as it was.",
      "expect": {
        "exit": 0,
        "stdout": "v1\n1\n1\nv1\nwp5.txt\n",
        "stderr": "cp: cannot create regular file '/minio/wp5b.txt': Operation not supported\nrm: cannot remove '/minio/wp5.txt': Operation not supported\n"
      }
    },
