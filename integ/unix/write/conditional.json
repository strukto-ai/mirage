    {
      "id": "write_conditional_a_grep_keeps_the_version",
      "seq": 310076,
      "targets": [
        "s3",
        "s3-prefix"
      ],
      "read": "bounded",
      "ttl": 600,
      "write": "conditional",
      "scenario": [
        {
          "mutate": {
            "path": "/data/wp7.txt",
            "content": "v1\n"
          }
        },
        {
          "mutate": {
            "path": "/data/wp7h.txt",
            "content": "v1\n"
          }
        },
        {
          "command": "grep -c v /data/wp7.txt; head -n1 /data/wp7h.txt"
        },
        {
          "mutate": {
            "path": "/data/wp7.txt",
            "content": "v2\n"
          }
        },
        {
          "mutate": {
            "path": "/data/wp7h.txt",
            "content": "v2\n"
          }
        },
        {
          "command": "echo z > /data/wp7.txt; echo $?; echo z > /data/wp7h.txt; echo $?"
        },
        {
          "command": "cat /data/wp7.txt /data/wp7h.txt"
        }
      ],
      "note": "grep and head keep no bytes, but the version each read is kept, so a later line's overwrite of a changed file carries If-Match and is refused.",
      "expect": {
        "exit": 0,
        "stdout": "1\nv1\n1\n1\nv2\nv2\n",
        "stderr": "/data/wp7.txt: changed since it was read; read it again before writing\n/data/wp7h.txt: changed since it was read; read it again before writing\n"
      }
    },
