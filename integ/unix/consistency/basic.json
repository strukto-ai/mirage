{
  "cases": [
    {
      "id": "read_bounded_serves_stale",
      "seq": 310000,
      "targets": [
        "s3",
        "s3-prefix",
        "hf",
        "dropbox",
        "onedrive",
        "sharepoint",
        "sharepoint-prefix",
        "ssh"
      ],
      "read": "bounded",
      "ttl": 600,
      "scenario": [
        {
          "mutate": {
            "path": "/data/cons.txt",
            "content": "v1\n"
          }
        },
        {
          "command": "cat /data/cons.txt"
        },
        {
          "mutate": {
            "path": "/data/cons.txt",
            "content": "v2\n"
          }
        },
        {
          "command": "cat /data/cons.txt"
        }
      ],
      "expect": {
        "exit": 0,
        "stdout": "v1\nv1\n",
        "stderr": ""
      }
    },
    {
      "id": "read_fresh_revalidates",
      "seq": 310001,
      "targets": [
        "s3",
        "s3-prefix"
      ],
      "read": "fresh",
      "scenario": [
        {
          "mutate": {
            "path": "/data/cons.txt",
            "content": "v1\n"
          }
        },
        {
          "command": "cat /data/cons.txt"
        },
        {
          "mutate": {
            "path": "/data/cons.txt",
            "content": "v2\n"
          }
        },
        {
          "command": "cat /data/cons.txt"
        }
      ],
      "expect": {
        "exit": 0,
        "stdout": "v1\nv2\n",
        "stderr": ""
      },
      "note": "Narrowed to the backends that may declare `read: fresh`: the other five cache reads but stamp no comparable content token, so the mount-time verdict refuses the policy and the workspace never constructs. The bounded control keeps the full list."
    }
  ]
}
