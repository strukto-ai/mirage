{
  "cases": [
    {
      "id": "listing_ttl_bounded_new_file_appears",
      "seq": 310060,
      "targets": [
        "s3",
        "s3-prefix",
        "hf",
        "hf-prefix",
        "dropbox",
        "onedrive",
        "sharepoint",
        "sharepoint-prefix",
        "gdrive",
        "gdrive-folder",
        "box",
        "ssh"
      ],
      "read": "bounded",
      "ttl": 3,
      "scenario": [
        {
          "mutate": {
            "command": "mkdir -p /data/lt1"
          }
        },
        {
          "mutate": {
            "path": "/data/lt1/a.txt",
            "content": "a\n"
          }
        },
        {
          "command": "ls /data/lt1"
        },
        {
          "mutate": {
            "path": "/data/lt1/b.txt",
            "content": "bb\n"
          }
        },
        {
          "command": "ls /data/lt1"
        },
        {
          "command": "sleep 4"
        },
        {
          "command": "ls /data/lt1"
        },
        {
          "command": "cat /data/lt1/a.txt"
        },
        {
          "command": "stat -c %s /data/lt1/b.txt"
        }
      ],
      "expect": {
        "exit": 0,
        "stdout": "a.txt\na.txt\na.txt\nb.txt\na\n3\n",
        "stderr": ""
      },
      "note": "Listings stay cached before ttl and include remote additions after expiry. GitHub and HF Hub use overwrite cases in integ/vfs/github/listing_ttl.json and integ/vfs/hf_hub/listing_ttl.json because their fakes retain state. Mail/gapps have no shadow /data mount."
    },
