          "command": "cat /data/lt2/a.txt"
        },
        {
          "command": "stat -c %s /data/lt2/b.txt"
        }
      ],
      "expect": {
        "exit": 0,
        "stdout": "/data/lt2/a.txt\na.txt\na.txt\nb.txt\na\n3\n",
        "stderr": ""
      },
      "note": "Shell glob expansion seeds the listing through the mount's view; subsequent ls must obey the same ttl cap. Setup and target exclusions match listing_ttl_bounded_new_file_appears."
    },
