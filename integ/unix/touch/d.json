{
  "cases": [
    {
      "id": "touch_d_mtime",
      "seq": 601090,
      "targets": [
        "ram",
        "disk",
        "redis",
        "opfs",
        "ssh",
        "nextcloud",
        "gdrive"
      ],
      "command": "mkdir -p /data/ptch1 && printf 'x' > /data/ptch1/a.txt && ls /data/ptch1 > /dev/null && touch -d '2021-06-15T12:00:00' /data/ptch1/a.txt",
      "check": {
        "stat": "/data/ptch1/a.txt",
        "fields": [
          "mtime"
        ]
      },
      "expect": {
        "exit": 0,
        "stdout": "",
        "stderr": "",
        "check": "mtime=2021-06-15T12:00:00\n"
      },
      "flags": [
        "d"
      ]
    },
    {
      "id": "touch_r_ref",
      "seq": 601091,
      "targets": [
        "ram",
        "disk",
        "redis",
        "opfs"
      ],
      "command": "mkdir -p /data/ptch2 && printf 'x' > /data/ptch2/ref.txt && touch -d '2020-01-02T03:04:05' /data/ptch2/ref.txt && printf 'y' > /data/ptch2/b.txt && touch -r /data/ptch2/ref.txt /data/ptch2/b.txt",
      "check": {
        "stat": "/data/ptch2/b.txt",
        "fields": [
          "mtime"
        ]
      },
      "expect": {
        "exit": 0,
        "stdout": "",
        "stderr": "",
        "check": "mtime=2020-01-02T03:04:05\n"
      },
      "flags": [
        "d"
      ]
    },
    {
      "id": "touch_d_then_mv_v",
      "seq": 601092,
      "targets": [
        "ram",
        "disk",
        "redis",
        "opfs"
      ],
      "command": "mkdir -p /data/ptch3 && printf 'x' > /data/ptch3/a.txt && touch -d '2019-05-06T07:08:09' /data/ptch3/a.txt && mv -v /data/ptch3/a.txt /data/ptch3/b.txt",
      "check": {
        "stat": "/data/ptch3/b.txt",
        "fields": [
          "mtime"
        ]
      },
      "expect": {
        "exit": 0,
        "stdout": "renamed '/data/ptch3/a.txt' -> '/data/ptch3/b.txt'\n",
        "stderr": "",
        "check": "mtime=2019-05-06T07:08:09\n"
      },
      "flags": [
        "d"
      ]
    },
    {
      "id": "touch_usage_refusals_name_the_hint",
      "seq": 601093,
      "targets": [
        "ram",
        "disk",
        "redis",
        "opfs"
      ],
      "command": "touch; echo rc=$?; touch -Q /data/r10touch; echo rc=$?; ls /data/r10touch",
      "expect": {
        "exit": 2,
        "stdout": "rc=1\nrc=1\n",
        "stderr": "touch: missing file operand\nTry 'touch --help' for more information.\ntouch: invalid option -- 'Q'\nTry 'touch --help' for more information.\nls: cannot access '/data/r10touch': No such file or directory\n"
      }
    }
  ]
}
