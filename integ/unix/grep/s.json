      },
      "flags": [
        "s",
        "f"
      ]
    },
    {
      "id": "grep_s_binary_match_notice",
      "seq": 1516013,
      "command": "printf 'hit\\000tail\\n' > /data/grep-s-dir/binary; grep -s hit /data/grep-s-dir/binary",
      "expect": {
        "exit": 0,
