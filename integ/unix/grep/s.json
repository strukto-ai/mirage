        "exit": 0,
        "stdout": "",
        "stderr": ""
      },
      "flags": [
        "s"
      ]
    },
    {
      "id": "grep_s_quiet_no_match",
      "seq": 1516007,
      "command": "grep -sq absent /data/grep-s-missing /data/grep-s-dir/good.txt",
      "expect": {
        "exit": 2,
        "stdout": "",
        "stderr": ""
      },
      "flags": [
        "s"
      ]
    },
    {
      "id": "grep_s_no_match",
      "seq": 1516008,
      "command": "grep -s absent /data/grep-s-dir/good.txt",
      "expect": {
        "exit": 1,
        "stdout": "",
        "stderr": ""
      },
      "flags": [
        "s"
      ]
    },
    {
      "id": "grep_s_invalid_regexp",
      "seq": 1516009,
      "command": "grep -s '[' /data/grep-s-dir/good.txt",
      "expect": {
        "exit": 2,
