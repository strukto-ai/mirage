  "cases": [
    {
      "id": "grep_s_setup",
      "seq": 1516001,
      "command": "mkdir -p /data/grep-s-dir; printf 'hit\\n' > /data/grep-s-dir/good.txt",
      "expect": {
        "exit": 0,
        "stdout": "",
        "stderr": ""
      }
    },
    {
      "id": "grep_s_missing",
      "seq": 1516002,
      "command": "grep -s hit /data/grep-s-missing",
      "expect": {
        "exit": 2,
        "stdout": "",
        "stderr": ""
      },
      "flags": [
        "s"
      ]
    },
    {
      "id": "grep_s_long_missing",
      "seq": 1516003,
      "command": "grep --no-messages hit /data/grep-s-missing",
      "expect": {
        "exit": 2,
        "stdout": "",
        "stderr": ""
      },
      "flags": [
        "no-messages"
      ]
    },
    {
      "id": "grep_s_directory",
      "seq": 1516004,
      "command": "grep -s hit /data/grep-s-dir",
      "expect": {
        "exit": 2,
        "stdout": "",
        "stderr": ""
      },
      "flags": [
        "s"
      ]
    },
    {
