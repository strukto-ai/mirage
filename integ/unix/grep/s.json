      },
      "flags": [
        "s"
      ]
    },
    {
      "id": "grep_s_invalid_option",
      "seq": 1516010,
      "command": "grep -s --bogus hit /data/grep-s-dir/good.txt",
      "expect": {
        "exit": 2,
        "stdout": "",
