{
  "cases": [
    {
      "id": "grep_bre_plus_is_literal",
      "seq": 500300,
      "targets": ["ram", "disk"],
      "command": "printf 'a+b\\naab\\n' > /data/bre.txt && grep 'a+b' /data/bre.txt",
      "expect": {
        "exit": 0,
        "stdout": "a+b\n",
        "stderr": ""
      }
    },
    {
      "id": "grep_bre_escaped_plus_is_the_quantifier",
      "seq": 500301,
      "targets": ["ram", "disk"],
      "command": "printf 'a+b\\naab\\n' > /data/bre.txt && grep 'a\\+b' /data/bre.txt",
      "expect": {
        "exit": 0,
        "stdout": "aab\n",
        "stderr": ""
      }
    },
