{
  "cases": [
    {
      "id": "grep_short_version",
      "seq": 14490032,
      "targets": [
        "ram",
        "disk",
        "redis",
        "opfs",
        "s3",
        "databricks",
        "gridfs",
        "s3-prefix",
        "databricks-prefix",
        "gridfs-prefix",
        "hf",
        "hf-prefix",
        "dropbox",
        "dropbox-root",
        "onedrive",
        "sharepoint",
        "sharepoint-prefix",
        "ssh",
        "nextcloud",
        "tidb-filesystem",
        "gdrive",
        "gdrive-folder",
        "box"
      ],
      "command": "grep -V | cut -d' ' -f1,2; grep -V -e x | cut -d' ' -f1,2; grep -V --bogus; echo rc=$?",
      "expect": {
        "exit": 0,
        "stdout": "grep (Mirage)\ngrep (Mirage)\nrc=2\n",
        "stderr": "grep: unrecognized option '--bogus'\nTry 'grep --help' for more information.\n"
      },
      "flags": [
        "V"
      ]
    },
    {
      "id": "grep_V_after_a_bad_value",
      "seq": 14490062,
      "targets": [
        "ram",
        "disk",
        "redis",
        "opfs",
        "s3",
        "databricks",
        "gridfs",
        "s3-prefix",
        "databricks-prefix",
        "gridfs-prefix",
        "hf",
        "hf-prefix",
        "dropbox",
        "dropbox-root",
        "onedrive",
        "sharepoint",
        "sharepoint-prefix",
        "ssh",
        "nextcloud",
        "tidb-filesystem",
        "gdrive",
        "gdrive-folder",
        "box"
      ],
      "command": "grep -D bogus -V; echo rc=$?; grep -V -A bogus; echo rc=$?; grep --help --binary-files=bogus; echo rc=$?; grep -d bogus -V 2>/dev/null; echo rc=$?",
      "expect": {
        "exit": 0,
        "stdout": "rc=2\nrc=2\nrc=2\nrc=1\n",
        "stderr": "grep: unknown devices method\ngrep: bogus: invalid context length argument\ngrep: unknown binary-files type\n"
      },
      "flags": [
        "V",
        "D",
        "A",
        "binary-files",
        "d",
        "help"
      ]
    },
    {
      "id": "grep_version_beats_help",
      "seq": 14490239,
      "targets": [
        "ram",
        "disk",
        "redis",
        "opfs",
        "s3",
        "databricks",
        "gridfs",
        "s3-prefix",
        "databricks-prefix",
        "gridfs-prefix",
        "hf",
