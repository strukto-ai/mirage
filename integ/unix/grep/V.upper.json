        "sharepoint-prefix",
        "ssh",
        "nextcloud",
        "tidb-filesystem",
        "gdrive",
        "gdrive-folder",
        "box"
      ],
      "command": "grep --help --version | grep -ci '^usage'; grep --version --help | grep -ci '^usage'; grep --help -V | grep -ci '^usage'; grep --help | grep -ci '^usage'",
      "expect": {
        "exit": 0,
        "stdout": "0\n0\n0\n1\n",
