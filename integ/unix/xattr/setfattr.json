      "command": "setfattr -n user.note -v 0x00ff /data/xattr.txt && getfattr -d -m '^user\\.(note|tag)$' /data/xattr.txt",
      "expect": {
        "exit": 0,
        "stdout": "# file: data/xattr.txt\nuser.note=0sAP8=\nuser.tag=\"blue\"\n\n",
