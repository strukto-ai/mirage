{
  "cases": [
    {
      "id": "xattr_set_then_get",
      "seq": 900001,
      "targets": [
        "ram",
        "disk",
        "redis",
        "opfs",
        "s3",
        "databricks",
        "gridfs",
        "s3-prefix",
        "databricks-prefix",
        "gridfs-prefix",
        "hf",
        "hf-prefix",
        "dropbox",
        "dropbox-root",
        "onedrive",
        "sharepoint",
        "sharepoint-prefix",
        "ssh",
        "nextcloud",
        "gdrive",
        "gdrive-folder",
        "box"
      ],
      "command": "setfattr -n user.tag -v blue /data/xattr.txt && getfattr -n user.tag /data/xattr.txt",
      "expect": {
        "exit": 0,
        "stdout": "# file: data/xattr.txt\nuser.tag=\"blue\"\n\n",
        "stderr": "getfattr: Removing leading '/' from absolute path names\n"
      }
    },
    {
