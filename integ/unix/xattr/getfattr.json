{
  "cases": [
    {
      "id": "xattr_hex_encoding",
      "seq": 900003,
      "targets": [
        "ram",
        "disk",
        "redis",
        "opfs",
        "s3",
        "databricks",
        "gridfs",
        "s3-prefix",
        "databricks-prefix",
        "gridfs-prefix",
        "hf",
        "hf-prefix",
        "dropbox",
        "dropbox-root",
        "onedrive",
        "sharepoint",
        "sharepoint-prefix",
        "ssh",
        "nextcloud",
        "tidb-filesystem",
        "gdrive",
        "gdrive-folder",
        "box"
      ],
      "command": "getfattr -n user.tag -e hex /data/xattr.txt",
      "expect": {
        "exit": 0,
        "stdout": "# file: data/xattr.txt\nuser.tag=0x626c7565\n\n",
        "stderr": "getfattr: Removing leading '/' from absolute path names\n"
      }
    },
    {
      "id": "xattr_only_values",
      "seq": 900004,
      "targets": [
        "ram",
        "disk",
        "redis",
        "opfs",
        "s3",
        "databricks",
        "gridfs",
        "s3-prefix",
        "databricks-prefix",
