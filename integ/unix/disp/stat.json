      ],
      "command": "stat /data/a.txt | sed -n '1p;2s/.*IO Block: *[^ ]* */Type: /p;4s/  Uid:.*//p'",
      "expect": {
        "exit": 0,
        "stdout": "  File: /data/a.txt\nType: regular file\nAccess: (0644/-rw-r--r--)\n",
        "stderr": ""
      }
