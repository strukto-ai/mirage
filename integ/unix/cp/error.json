        "disk",
        "redis",
        "opfs",
        "s3",
        "databricks",
        "gridfs",
        "s3-prefix",
        "databricks-prefix",
        "gridfs-prefix",
        "dropbox",
        "dropbox-root",
        "onedrive",
        "sharepoint",
        "sharepoint-prefix",
        "ssh",
        "nextcloud",
        "gdrive",
        "gdrive-folder",
        "box"
      ],
      "command": "cp /data/a.txt /data/b.txt /data/c.txt; ln -s /data/cpdangle_t /data/cpdangle && cp /data/a.txt /data/cpdangle; cp -r /data/sub /data/cpdangle; test ! -e /data/cpdangle_t && rm /data/cpdangle",
      "expect": {
        "exit": 0,
        "stdout": "",
        "stderr": "cp: target '/data/c.txt': Not a directory\ncp: not writing through dangling symlink '/data/cpdangle'\ncp: cannot overwrite non-directory '/data/cpdangle' with directory '/data/sub'\n"
      }
    },
