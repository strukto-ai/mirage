{
  "cases": [
    {
      "id": "readfail_denied_scoped_dir_stats",
      "seq": 15900001,
      "targets": [
        "s3-denied"
      ],
      "command": "stat -c %F /data/rd",
      "expect": {
        "exit": 0,
        "stdout": "directory\n",
        "stderr": ""
      },
      "note": "The reader's grant covers rd/* alone, so a HEAD on the bare key rd answers 403 as on AWS; the keys below it still prove the directory. These cases run first, before a listing tells the index what rd is."
    },
    {
      "id": "readfail_denied_scoped_dir_tests",
      "seq": 15900002,
      "targets": [
        "s3-denied"
      ],
      "command": "test -d /data/rd && echo dir",
      "expect": {
        "exit": 0,
        "stdout": "dir\n",
        "stderr": ""
      }
    },
    {
      "id": "readfail_denied_scoped_dir_cd",
      "seq": 15900003,
      "targets": [
        "s3-denied"
      ],
      "command": "cd /data/rd && cat a.txt",
      "expect": {
        "exit": 0,
        "stdout": "needle a\n",
        "stderr": ""
      }
    },
    {
      "id": "readfail_denied_cp_falls_back",
      "seq": 15900004,
      "targets": [
        "s3-denied"
      ],
      "command": "cp /data/rd/b.txt /data/rd/x.txt || echo fallback",
      "expect": {
        "exit": 0,
        "stdout": "fallback\n",
        "stderr": "cp: cannot stat '/data/rd/b.txt': Permission denied\n"
      },
      "note": "The store refuses GetObject on rd/b.txt, so its HEAD answers 403 while the listing still names it: GNU's file in a directory it may read but not search (coreutils 9.7, debian 13.6, as nobody). The stat-shaped cases run first, before a listing tells the index the key's size."
    },
    {
      "id": "readfail_denied_stat",
      "seq": 15900005,
      "targets": [
        "s3-denied"
      ],
      "command": "stat -c %s /data/rd/b.txt",
      "expect": {
        "exit": 1,
        "stdout": "",
        "stderr": "stat: cannot statx '/data/rd/b.txt': Permission denied\n"
      }
    },
    {
      "id": "readfail_denied_mv",
      "seq": 15900006,
      "targets": [
        "s3-denied"
      ],
      "command": "mv /data/rd/b.txt /data/rd/m.txt",
      "expect": {
        "exit": 1,
        "stdout": "",
        "stderr": "mv: cannot stat '/data/rd/b.txt': Permission denied\n"
      }
    },
    {
      "id": "readfail_denied_test_reads_absent",
      "seq": 15900007,
      "targets": [
        "s3-denied"
      ],
      "command": "test -e /data/rd/b.txt; echo rc:$?",
      "expect": {
        "exit": 0,
        "stdout": "rc:1\n",
        "stderr": ""
      },
      "note": "GNU bash 5.2.37 reads a file test whose stat fails EACCES as false, silently, and the line goes on."
    },
    {
      "id": "readfail_denied_bracket_reads_absent",
      "seq": 15900008,
      "targets": [
        "s3-denied"
      ],
      "command": "[ -f /data/rd/b.txt ] || echo no",
      "expect": {
        "exit": 0,
        "stdout": "no\n",
        "stderr": ""
      }
    },
    {
      "id": "readfail_denied_test_slashed_reads_absent",
      "seq": 15900009,
      "targets": [
        "s3-denied"
      ],
      "command": "test -e /data/rd/b.txt/; echo rc:$?",
      "expect": {
        "exit": 0,
        "stdout": "rc:1\n",
        "stderr": ""
      }
    },
    {
      "id": "readfail_denied_test_dotted_reads_absent",
      "seq": 15900010,
      "targets": [
        "s3-denied"
      ],
      "command": "test -e /data/rd/b.txt/../a.txt; echo rc:$?",
