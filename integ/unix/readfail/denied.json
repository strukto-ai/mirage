    {
      "id": "readfail_denied_cat_reads_on",
      "seq": 15900011,
      "targets": [
        "s3-denied"
      ],
      "command": "cat /data/rd/a.txt /data/rd/b.txt /data/rd/c.txt",
      "expect": {
        "exit": 1,
        "stdout": "needle a\nneedle c\n",
        "stderr": "cat: /data/rd/b.txt: Permission denied\n"
