        "onedrive",
        "sharepoint",
        "sharepoint-prefix",
        "ssh",
        "nextcloud",
        "gdrive",
        "gdrive-folder",
        "box"
      ],
      "command": "(cd /data && mkdir -p r16mvdot/s/sub r16mvdot/t && printf a > r16mvdot/s/a && cd r16mvdot && mv s/. t; echo rc=$?; mv s/sub/.. t; echo rc=$?; mv s/. s; echo rc=$?; mv -T s/. n; echo rc=$?; find s t | sort; cd /data && rm -r r16mvdot)",
      "expect": {
        "exit": 0,
        "stdout": "rc=1\nrc=1\nrc=1\nrc=1\ns\ns/a\ns/sub\nt\n",
        "stderr": "mv: cannot move 's/.' to 't/.': Device or resource busy\nmv: cannot move 's/sub/..' to 't/..': Device or resource busy\nmv: 's/.' and 's/.' are the same file\nmv: cannot move 's/.' to 'n': Device or resource busy\n"
      },
      "note": "Across mounts GNU copies the contents and then refuses to remove '.' or '..'; mirage refuses with EBUSY before copying (documented in mv's generic)."
    }
  ]
