{
  "cases": [
    {
      "id": "find_prune_aging_provision",
      "seq": 789,
      "targets": [
        "ram",
        "disk",
        "redis"
      ],
      "command": "mkdir -p /data/aging/old/x /data/aging/new/y && touch /data/aging/old/x/f /data/aging/new/y/g /data/aging/old/o.txt && touch -d 2000-01-01 /data/aging/old",
      "expect": {
        "exit": 0,
        "stdout": "",
        "stderr": ""
      }
    },
    {
      "id": "find_prune_after_a_time_test_fires_only_where_it_holds",
      "seq": 790,
      "targets": [
        "ram",
        "disk",
        "redis"
      ],
      "command": "find /data/aging -mindepth 1 -newermt 2010-01-01 -prune",
      "expect": {
        "exit": 0,
        "stdout": "/data/aging/new\n/data/aging/old/o.txt\n/data/aging/old/x\n",
        "stderr": ""
      },
      "flags": [
        "mindepth",
        "newermt",
        "prune"
      ]
    },
    {
      "id": "find_prune_before_a_time_test_fires_regardless",
      "seq": 790,
      "targets": [
        "ram",
        "disk",
        "redis"
      ],
      "command": "find /data/aging -mindepth 1 -prune -newermt 2010-01-01",
      "expect": {
        "exit": 0,
        "stdout": "/data/aging/new\n",
        "stderr": ""
      },
      "flags": [
        "mindepth",
        "prune",
        "newermt"
      ]
    },
    {
      "id": "find_prune_after_mtime_plus_keeps_the_old_directory_closed",
      "seq": 790,
      "targets": [
        "ram",
        "disk",
        "redis"
      ],
      "command": "find /data/aging -mindepth 1 -mtime +3650 -prune",
      "expect": {
        "exit": 0,
        "stdout": "/data/aging/old\n",
        "stderr": ""
      },
      "flags": [
        "mindepth",
        "mtime",
        "prune"
      ]
    },
    {
      "id": "find_prune_between_two_time_tests_answers_to_the_first",
      "seq": 790,
      "targets": [
        "ram",
        "disk",
        "redis"
      ],
      "command": "find /data/aging -mindepth 1 -newermt 1990-01-01 -prune -newermt 2010-01-01",
      "expect": {
        "exit": 0,
        "stdout": "/data/aging/new\n",
        "stderr": ""
      },
      "flags": [
        "mindepth",
        "newermt",
        "prune"
      ]
    },
    {
      "id": "find_prune_on_the_arm_a_time_test_fails_into",
      "seq": 790,
      "targets": [
        "ram",
        "disk",
        "redis"
      ],
      "command": "find /data/aging -mindepth 1 \\( -mtime -3650 -print \\) -o -prune",
      "expect": {
        "exit": 0,
        "stdout": "/data/aging/new\n/data/aging/new/y\n/data/aging/new/y/g\n",
        "stderr": ""
      },
      "flags": [
        "mindepth",
        "mtime",
        "print",
        "prune"
      ]
