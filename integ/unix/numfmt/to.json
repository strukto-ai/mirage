{
  "cases": [
    {
      "id": "numfmt_to_iec_i_renders_a_bare_number",
      "seq": 15500013,
      "targets": [
        "ram",
        "opfs",
        "disk"
      ],
      "command": "numfmt --to=iec-i 1000 1024 2048 0",
      "expect": {
        "exit": 0,
        "stdout": "1000\n1.0Ki\n2.0Ki\n0\n",
        "stderr": ""
      },
      "flags": [
        "to"
      ]
    },
    {
      "id": "numfmt_prints_a_zero_unsigned_and_keeps_every_digit",
      "seq": 15500016,
      "targets": [
        "ram",
        "opfs",
        "disk"
      ],
      "command": "numfmt -- -0 -0.0; numfmt --to=si -- -0 -0.04 1000000000000000000001 1000.00000001",
      "expect": {
        "exit": 0,
        "stdout": "0\n0.0\n0\n-0\n1.1Z\n1.1k\n",
        "stderr": ""
      },
      "flags": [
        "to"
      ]
    },
    {
      "id": "numfmt_quotes_and_passes_through_raw_bytes",
      "seq": 15500017,
      "targets": [
        "ram",
        "opfs",
        "disk"
      ],
      "command": "printf 'x\\377 12\\n' | numfmt; echo rc=$?; printf '1000 \\377\\n' | numfmt --to=si | od -An -tx1",
      "expect": {
        "exit": 0,
        "stdout": "rc=2\n 31 2e 30 6b 20 ff 0a\n",
        "stderr": "numfmt: invalid number: 'x\\377'\n"
      },
      "flags": [
        "to"
      ]
    }
  ]
}
