{
  "cases": [
    {
      "id": "numfmt_tier2_conversion",
      "seq": 910002,
      "targets": [
        "ram",
        "opfs",
        "disk"
      ],
      "command": "numfmt --from=si --to=iec-i --suffix=B 2KB",
      "expect": {
        "exit": 0,
        "stdout": "2.0KiB\n",
        "stderr": ""
      },
      "flags": [
        "from",
        "to",
        "suffix"
      ]
    },
    {
      "id": "numfmt_tier2_grouping",
      "seq": 910003,
      "targets": [
        "ram",
        "opfs",
        "disk"
      ],
      "command": "numfmt --grouping 1234567",
      "expect": {
        "exit": 0,
        "stdout": "1234567\n",
        "stderr": ""
      },
      "flags": [
        "grouping"
      ]
    },
    {
      "id": "numfmt_tier2_stdin_preserves_fields",
      "seq": 910045,
      "targets": [
        "ram",
        "opfs",
        "disk"
      ],
      "command": "printf '1000 foo\\n2000   bar baz\\n' | numfmt --to=si",
      "expect": {
        "exit": 0,
        "stdout": "1.0k foo\n2.0k   bar baz\n",
        "stderr": ""
      },
      "flags": [
        "to"
      ]
    },
    {
      "id": "numfmt_keeps_output_before_an_invalid_number",
      "seq": 910046,
      "targets": [
        "ram",
        "opfs",
        "disk"
      ],
      "command": "numfmt 1 abc 2; echo rc=$?; printf '1\\nabc\\n2\\n' | numfmt; echo rc=$?; numfmt --from=si 1K abc; echo rc=$?",
      "expect": {
        "exit": 0,
        "stdout": "1\nrc=2\n1\nrc=2\n1000\nrc=2\n",
        "stderr": "numfmt: invalid number: 'abc'\nnumfmt: invalid number: 'abc'\nnumfmt: invalid number: 'abc'\n"
      }
    },
    {
      "id": "numfmt_grouping_groups_nothing_in_the_c_locale",
      "seq": 910047,
      "targets": [
        "ram",
        "opfs",
        "disk"
      ],
      "command": "numfmt --grouping --suffix=B 1234B; echo rc=$?; numfmt --grouping --to=si 1000; echo rc=$?; numfmt --grouping --from=si 1K; echo rc=$?",
      "expect": {
        "exit": 0,
        "stdout": "1234B\nrc=0\nrc=1\n1000\nrc=0\n",
        "stderr": "numfmt: grouping cannot be combined with --to\n"
      }
    }
  ]
}
