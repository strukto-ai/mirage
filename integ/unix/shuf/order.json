    {
      "id": "shuf_a_bad_n_between_two_i_wins",
      "seq": 991047,
      "targets": [
        "ram",
        "disk",
        "redis",
        "opfs",
        "s3",
        "gridfs",
        "s3-prefix",
        "gridfs-prefix",
        "hf",
        "hf-prefix",
        "dropbox",
        "dropbox-root",
        "onedrive",
        "sharepoint",
        "ssh",
        "nextcloud",
        "tidb-filesystem",
        "gdrive",
        "gdrive-folder",
        "box"
      ],
      "command": "shuf -i 1-2 -n abc -i 3-4",
      "expect": {
        "exit": 1,
        "stdout": "",
        "stderr": "shuf: multiple -i options specified\n"
      },
      "flags": [
        "i",
        "n"
      ],
      "note": "Deliberate divergence: GNU names the count, validating the line in getopt order. mirage checks every value of an accumulating option in the order the options were first typed, so the second -i is seen before -n; keeping the line's own order would take a per-occurrence record across options, which neither argparse nor the parser keeps."
    },
