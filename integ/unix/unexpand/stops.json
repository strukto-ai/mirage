{
  "cases": [
    {
      "id": "unexpand_t_accumulates_and_implies_a",
      "seq": 9100106,
      "targets": [
        "ram",
        "opfs",
        "disk",
        "redis",
        "s3",
        "databricks",
        "gridfs",
        "s3-prefix",
        "databricks-prefix",
        "gridfs-prefix",
        "hf",
        "hf-prefix",
        "dropbox",
        "dropbox-root",
        "onedrive",
        "sharepoint",
        "sharepoint-prefix",
        "ssh",
        "nextcloud",
        "gdrive",
        "gdrive-folder",
        "box"
      ],
      "command": "printf 'a       b       c\\n' | unexpand -t 4 -t 8 | od -An -c; printf 'a       b       c\\n' | unexpand -t 2,4 -t 6 | od -An -c",
      "expect": {
        "exit": 0,
        "stdout": "   a  \\t  \\t   b                               c  \\n\n   a  \\t  \\t  \\t           b                               c  \\n\n",
        "stderr": ""
      },
      "flags": [
        "t"
      ]
    },
