{
  "cases": [
    {
      "id": "printf_unrecognized_long_option",
      "seq": 991042,
      "targets": [
        "ram",
        "opfs",
        "disk"
      ],
      "command": "printf --zzz",
      "expect": {
        "exit": 2,
        "stdout": "",
        "stderr": "bash: printf: --: invalid option\nprintf: usage: printf [-v var] format [arguments]\n"
      }
    },
    {
      "id": "printf_help_prints_to_stdout_and_exits_2",
      "seq": 991058,
      "targets": [
        "ram",
        "opfs",
        "disk"
      ],
      "command": "printf --help",
      "expect": {
        "exit": 2,
        "stdout": "printf: printf [-v var] format [arguments]\n    Print arguments under the control of a format.\n    \n    Prints the ARGUMENTS as FORMAT describes, using the conversions printf(1)\n    knows, plus %b, which expands backslash escapes in its argument, and %q,\n    which quotes its argument for the shell to read back. FORMAT is used again\n    for as long as arguments remain.\n    \n    Options:\n      -v var\tstore the output in VAR instead of printing it\n    \n    Exit Status:\n    0 unless an option is invalid or writing fails.\n",
        "stderr": ""
      }
    },
