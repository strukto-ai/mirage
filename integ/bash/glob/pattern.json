    {
      "id": "globignore_path_components",
      "seq": 1380027,
      "targets": [
        "ram",
        "disk",
        "redis",
        "opfs",
        "s3",
        "databricks",
        "gridfs",
        "s3-prefix",
        "databricks-prefix",
        "gridfs-prefix",
        "hf",
        "hf-prefix",
        "dropbox",
        "dropbox-root",
        "onedrive",
        "sharepoint",
        "sharepoint-prefix",
        "ssh",
        "nextcloud",
        "tidb-filesystem",
        "gdrive",
        "gdrive-folder",
        "box"
      ],
      "command": "(D={mount}/globignore_path_components; mkdir -p $D/d; touch $D/keep $D/skip $D/.dot $D/d/keep $D/d/skip; cd $D; GLOBIGNORE=skip:d/skip; printf '<%s>\\n' * d/*; shopt -q dotglob; echo dot:$?; shopt -u dotglob; printf '<%s>\\n' *; GLOBIGNORE='d*'; printf '[%s]\\n' d/*; GLOBIGNORE='*p'; printf '[%s]\\n' d/*; unset GLOBIGNORE; printf '<%s>\\n' *)",
      "expect": {
        "exit": 0,
        "stdout": "<.dot>\n<d>\n<keep>\n<d/keep>\ndot:0\n<d>\n<keep>\n[d/*]\n[d/keep]\n[d/skip]\n<d>\n<keep>\n<skip>\n",
        "stderr": ""
      }
    }
  ]
}
