      "seq": 960808,
      "targets": [
        "ram",
        "disk"
      ],
      "command": "bash -c 'shopt -s extglob; eval '\"'\"'p='\"'\"'\"'\"'\"'\"'\"'\"'/data/@(a|b).txt'\"'\"'\"'\"'\"'\"'\"'\"'; printf '\"'\"'\"'\"'\"'\"'\"'\"'<%s>\\n'\"'\"'\"'\"'\"'\"'\"'\"' $p; printf '\"'\"'\"'\"'\"'\"'\"'\"'<%s>\\n'\"'\"'\"'\"'\"'\"'\"'\"' /data/@(a b|a).txt; [[ '\"'\"'\"'\"'\"'\"'\"'\"'a(b)'\"'\"'\"'\"'\"'\"'\"'\"' == @(a(b)|c) ]]; echo $?'\"'\"''",
