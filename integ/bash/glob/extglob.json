    {
      "id": "extglob_quoted_bang",
      "seq": 960809,
      "targets": [
        "ram",
        "disk"
      ],
      "command": "bash -c 'shopt -s extglob; eval '\"'\"'[[ '\"'\"'\"'\"'\"'\"'\"'\"'!'\"'\"'\"'\"'\"'\"'\"'\"' == '\"'\"'\"'\"'\"'\"'\"'\"'!'\"'\"'\"'\"'\"'\"'\"'\"' ]]; echo $?; p='\"'\"'\"'\"'\"'\"'\"'\"'(a|b)'\"'\"'\"'\"'\"'\"'\"'\"'; [[ '\"'\"'\"'\"'\"'\"'\"'\"'!(a|b)'\"'\"'\"'\"'\"'\"'\"'\"' == '\"'\"'\"'\"'\"'\"'\"'\"'!'\"'\"'\"'\"'\"'\"'\"'\"'$p ]]; echo $?; [[ c == '\"'\"'\"'\"'\"'\"'\"'\"'!'\"'\"'\"'\"'\"'\"'\"'\"'$p ]]; echo $?; case '\"'\"'\"'\"'\"'\"'\"'\"'a!(a|b)'\"'\"'\"'\"'\"'\"'\"'\"' in @(a'\"'\"'\"'\"'\"'\"'\"'\"'!'\"'\"'\"'\"'\"'\"'\"'\"'$p|d)) echo quoted;; esac; x='\"'\"'\"'\"'\"'\"'\"'\"'a!b'\"'\"'\"'\"'\"'\"'\"'\"'; printf '\"'\"'\"'\"'\"'\"'\"'\"'<%s>\\n'\"'\"'\"'\"'\"'\"'\"'\"' \"${x##a'\"'\"'\"'\"'\"'\"'\"'\"'!'\"'\"'\"'\"'\"'\"'\"'\"'b}\"; mkdir /data/extglob-bang; touch '\"'\"'\"'\"'\"'\"'\"'\"'/data/extglob-bang/a!b'\"'\"'\"'\"'\"'\"'\"'\"' '\"'\"'\"'\"'\"'\"'\"'\"'/data/extglob-bang/a!c'\"'\"'\"'\"'\"'\"'\"'\"'; printf '\"'\"'\"'\"'\"'\"'\"'\"'<%s>\\n'\"'\"'\"'\"'\"'\"'\"'\"' /data/extglob-bang/a'\"'\"'\"'\"'\"'\"'\"'\"'!'\"'\"'\"'\"'\"'\"'\"'\"'?; rm -r /data/extglob-bang'\"'\"''",
      "expect": {
