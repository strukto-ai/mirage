{
  "cases": [
    {
      "id": "extglob_operators",
      "seq": 960800,
      "targets": [
        "ram",
        "disk"
      ],
      "command": "bash -c 'shopt -s extglob; eval '\"'\"'mkdir /data/extglob-ops; touch /data/extglob-ops/a /data/extglob-ops/b /data/extglob-ops/c; printf \"<%s>\\n\" /data/extglob-ops/@(a|b) /data/extglob-ops/+(a|b) /data/extglob-ops/!(a|b); rm -r /data/extglob-ops'\"'\"''",
      "expect": {
        "exit": 0,
        "stdout": "</data/extglob-ops/a>\n</data/extglob-ops/b>\n</data/extglob-ops/a>\n</data/extglob-ops/b>\n</data/extglob-ops/c>\n",
        "stderr": ""
      }
    },
    {
      "id": "extglob_nested",
      "seq": 960801,
      "targets": [
        "ram",
        "disk"
      ],
      "command": "bash -c 'shopt -s extglob; eval '\"'\"'printf \"<%s>\\n\" /data/@(a|+(b|c)).txt'\"'\"''",
      "expect": {
        "exit": 0,
        "stdout": "</data/a.txt>\n</data/b.txt>\n</data/c.txt>\n",
        "stderr": ""
      }
    },
    {
      "id": "extglob_quotes",
      "seq": 960802,
      "targets": [
        "ram",
        "disk"
      ],
      "command": "bash -c 'shopt -s extglob; eval '\"'\"'x=a; printf '\"'\"'\"'\"'\"'\"'\"'\"'<%s>\\n'\"'\"'\"'\"'\"'\"'\"'\"' /data/@(\"$x\"|$(printf b)).txt '\"'\"'\"'\"'\"'\"'\"'\"'/data/@(a|b).txt'\"'\"'\"'\"'\"'\"'\"'\"' /data/@(a\"|\"b|c).txt'\"'\"''",
      "expect": {
        "exit": 0,
        "stdout": "</data/a.txt>\n</data/b.txt>\n</data/@(a|b).txt>\n</data/c.txt>\n",
        "stderr": ""
      }
    },
    {
      "id": "extglob_conditional",
      "seq": 960803,
      "targets": [
        "ram",
        "disk"
      ],
      "command": "bash -c 'shopt -s extglob; eval '\"'\"'[[ ab == +(a|b) ]]; echo $?; [[ a == !(a)* ]]; echo $?; [[ 123 == +([[:digit:]]) ]]; echo $?; [[ '\"'\"'\"'\"'\"'\"'\"'\"'@(a|b)'\"'\"'\"'\"'\"'\"'\"'\"' == \"@(a|b)\" ]]; echo $?'\"'\"''",
      "expect": {
        "exit": 0,
        "stdout": "0\n0\n0\n0\n",
        "stderr": ""
      }
    },
    {
      "id": "extglob_case",
      "seq": 960804,
      "targets": [
        "ram",
        "disk"
      ],
      "command": "bash -c 'shopt -s extglob; eval '\"'\"'case ab in +(a|b)) echo repeated;; *) echo missed;; esac; case c in !(a|b)) echo negative;; esac'\"'\"''",
      "expect": {
        "exit": 0,
        "stdout": "repeated\nnegative\n",
        "stderr": ""
      }
    },
    {
      "id": "extglob_parameter",
      "seq": 960805,
      "targets": [
        "ram",
        "disk"
      ],
      "command": "bash -c 'shopt -s extglob; eval '\"'\"'x=aaab; printf '\"'\"'\"'\"'\"'\"'\"'\"'<%s>\\n'\"'\"'\"'\"'\"'\"'\"'\"' \"${x##+(a)}\" \"${x//+(a)/X}\"; x=abc; echo \"${x^^@(a|c)}\"'\"'\"''",
      "expect": {
        "exit": 0,
        "stdout": "<b>\n<Xb>\nAbC\n",
        "stderr": ""
      }
    },
