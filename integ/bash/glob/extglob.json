{
  "cases": [
    {
      "id": "extglob_operators",
      "seq": 960800,
      "targets": [
        "ram",
        "disk"
      ],
      "command": "bash -c 'shopt -s extglob; eval '\"'\"'mkdir /data/extglob-ops; touch /data/extglob-ops/a /data/extglob-ops/b /data/extglob-ops/c; printf \"<%s>\\n\" /data/extglob-ops/@(a|b) /data/extglob-ops/+(a|b) /data/extglob-ops/!(a|b); rm -r /data/extglob-ops'\"'\"''",
      "expect": {
        "exit": 0,
        "stdout": "</data/extglob-ops/a>\n</data/extglob-ops/b>\n</data/extglob-ops/a>\n</data/extglob-ops/b>\n</data/extglob-ops/c>\n",
        "stderr": ""
      }
    },
    {
      "id": "extglob_nested",
      "seq": 960801,
      "targets": [
        "ram",
        "disk"
      ],
      "command": "bash -c 'shopt -s extglob; eval '\"'\"'printf \"<%s>\\n\" /data/@(a|+(b|c)).txt'\"'\"''",
      "expect": {
