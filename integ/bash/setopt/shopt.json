    {
      "id": "nocasematch_shell_patterns",
      "seq": 1380026,
      "targets": [
        "ram",
        "disk",
        "opfs"
      ],
      "command": "(shopt -s nocasematch; v=FoO; [[ $v == f* ]] && echo glob; [[ $v =~ ^(f.o)$ ]] && echo \"${BASH_REMATCH[1]}\"; case $v in f*) echo case;; esac; echo \"${v//o/[_&]}\"; [[ a == [[:upper:]] ]]; echo class:$?; shopt -u nocasematch; [[ $v == f* ]]; echo off:$?)",
      "expect": {
        "exit": 0,
        "stdout": "glob\nFoO\ncase\nF[_o][_O]\nclass:1\noff:1\n",
        "stderr": ""
      }
    },
    {
      "id": "localvar_inherit_follows_the_callers_local",
      "seq": 1380028,
      "targets": [
        "ram",
        "disk",
        "opfs"
      ],
      "command": "(f() { local v; echo \"${v-unset}\"; }; g() { local v=outer; shopt -s localvar_inherit; f; shopt -u localvar_inherit; f; echo \"$v\"; }; g)",
      "expect": {
        "exit": 0,
        "stdout": "outer\nunset\nouter\n",
        "stderr": ""
      }
    }
