        "onedrive",
        "sharepoint",
        "sharepoint-prefix",
        "ssh",
        "nextcloud",
        "gdrive",
        "gdrive-folder",
        "box"
      ],
      "command": "shopt -s bogus; echo rc=$?; shopt -su nullglob; echo rc=$?; shopt -z; echo rc=$?",
      "expect": {
        "exit": 0,
        "stdout": "rc=1\nrc=1\nrc=2\n",
        "stderr": "bash: shopt: bogus: invalid shell option name\nbash: shopt: cannot set and unset shell options simultaneously\nbash: shopt: -z: invalid option\nshopt: usage: shopt [-pqsu] [-o] [optname ...]\n"
      }
    },
