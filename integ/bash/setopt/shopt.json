{
  "cases": [
    {
      "id": "shopt_set_unset_query",
      "seq": 940020,
      "targets": [
        "ram",
        "disk",
        "redis",
        "opfs",
        "s3",
        "databricks",
        "gridfs",
        "s3-prefix",
        "databricks-prefix",
        "gridfs-prefix",
        "hf",
        "hf-prefix",
        "dropbox",
        "dropbox-root",
        "onedrive",
        "sharepoint",
        "sharepoint-prefix",
        "ssh",
        "nextcloud",
        "tidb-filesystem",
        "gdrive",
        "gdrive-folder",
        "box"
      ],
      "command": "shopt -q nullglob; echo rc=$?; shopt -s nullglob; shopt nullglob; shopt -p nullglob; shopt -u nullglob; shopt nullglob; echo rc=$?",
      "expect": {
        "exit": 0,
        "stdout": "rc=1\nnullglob       \ton\nshopt -s nullglob\nnullglob       \toff\nrc=1\n",
        "stderr": ""
      }
    },
    {
      "id": "shopt_refuses_bad_name_and_conflict",
