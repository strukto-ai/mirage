        "onedrive",
        "sharepoint",
        "sharepoint-prefix",
        "ssh",
        "nextcloud",
        "gdrive",
        "gdrive-folder",
        "box"
      ],
      "command": "( exec echo hi; echo x ); echo \"after $?\"; ( exec false; echo x ); echo \"rc=$?\"; ( exec echo a b > /data/ex.txt; echo x ); cat /data/ex.txt; rm /data/ex.txt; echo \"[$(exec echo inner; echo x)]\"; bash -c 'exec echo hi; echo x'; echo \"after $?\"",
      "expect": {
        "exit": 0,
        "stdout": "hi\nafter 0\nrc=1\na b\n[inner]\nhi\nafter 0\n",
        "stderr": ""
      }
    },
