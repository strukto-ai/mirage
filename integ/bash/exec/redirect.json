        "gdrive",
        "gdrive-folder",
        "box"
      ],
      "command": "( exec 0<&-; exec 0<&0; echo rc=$? ); ( exec 1>&-; exec 1>&1; echo rc=$? >&2 ); ( exec 0>/data/ef; echo rc=$?; cat; echo rc=$? ); ( printf 'l1\\n' > /data/eg; exec 1</data/eg; echo hi; echo rc=$? >&2 ); ( exec 2</data/eg; echo hi >&2; echo rc=$? ); rm /data/ef /data/eg",
      "expect": {
        "exit": 0,
        "stdout": "rc=0\nrc=0\nrc=1\nrc=1\n",
        "stderr": "rc=0\ncat: -: Bad file descriptor\necho: write error: Bad file descriptor\nrc=1\n"
      },
      "note": "Pinned on bash 5.2: a closed descriptor dups onto itself as a no-op; `exec 0>f` leaves fd 0 write-only (a read is EBADF); `exec 1<f` / `exec 2<f` leave the stream read-only (a write fails). Not modelled: a transient `>&0` reaching the file after `exec 0>f`, or `<&1` reading it after `exec 1<f`."
    }
