      "targets": [
        "ram",
        "disk",
        "opfs"
      ],
      "command": "printf hello > >(tr a-z A-Z); wait",
      "expect": {
        "exit": 0,
        "stdout": "HELLO",
        "stderr": ""
      }
    },
    {
