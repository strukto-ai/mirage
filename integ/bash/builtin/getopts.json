      "command": "OPTIND=1; set -- -a -b; getopts ab o; bash -c 'declare -p OPTIND OPTERR; env | grep -c ^OPT; set -- -a x y; shift $((OPTIND-1)); echo \"$# $1\"; f() { local OPTIND; getopts a o -a; echo \"$o $OPTIND\"; }; f; echo \"$OPTIND\"; OPTIND=abc; echo \"[$OPTIND]\"'",
