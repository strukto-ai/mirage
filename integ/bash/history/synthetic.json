{
  "cases": [
    {
      "id": "bash_history_has_synthetic",
      "seq": 310024,
      "targets": [
        "ram-history"
      ],
      "command": "grep -c 'synthetic entry one' /.bash_history",
      "expect": {
        "exit": 0,
        "stdout": "2\n",
        "stderr": ""
      }
    },
    {
      "id": "find_view_by_name",
      "seq": 310025,
      "targets": [
        "ram-history"
      ],
      "command": "find /.bash_history -name '*bash*'",
      "expect": {
        "exit": 0,
        "stdout": "/.bash_history\n",
        "stderr": ""
      }
    },
    {
      "id": "history_head_reports_and_continues",
      "seq": 310049,
      "targets": [
        "ram-history"
      ],
      "command": "head -c 1 /.bash_history /nope",
      "expect": {
        "exit": 1,
        "stdout": "==> /.bash_history <==\n#",
        "stderr": "head: /nope: No such file or directory\n"
      }
    },
    {
      "id": "history_tail_reports_and_continues",
      "seq": 310050,
      "targets": [
        "ram-history"
      ],
      "command": "tail -c 1 /.bash_history /nope",
      "expect": {
        "exit": 1,
        "stdout": "==> /.bash_history <==\n\n",
        "stderr": "tail: /nope: No such file or directory\n"
      }
    }
  ]
}
