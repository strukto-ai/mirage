      "targets": [
        "ram-history"
      ],
      "command": "grep marker-s2 /.bash_history",
      "expect": {
        "exit": 1,
        "stdout": "",
        "stderr": ""
      }
    },
    {
      "id": "bash_history_timestamp_lines",
      "seq": 310010,
      "targets": [
