      ],
      "command": "cat /.bash_history | grep -c marker-one",
      "expect": {
        "exit": 0,
        "stdout": "1\n",
        "stderr": ""
      }
    },
    {
      "id": "ls_root_hides_dotfile",
      "seq": 310012,
      "targets": [
        "ram-history"
      ],
      "command": "ls /",
      "expect": {
        "exit": 0,
        "stdout": "data\ndev\nusr\n",
        "stderr": ""
      }
    },
    {
      "id": "ls_a_root_shows_dotfile",
      "seq": 310013,
      "targets": [
