{
  "cases": [
    {
      "id": "history_syntax_error_line",
      "seq": 310056,
      "targets": ["ram-history"],
      "session": "s2",
      "command": "if then",
      "expect": {
        "exit": 2,
        "stdout": "",
        "stderr": "mirage: syntax error near 'then'\n"
      }
    },
    {
      "id": "syntax_error_sets_status",
      "seq": 310057,
      "targets": ["ram-history"],
      "session": "s2",
      "command": "echo \"status=$?\"",
      "expect": {
        "exit": 0,
        "stdout": "status=2\n",
        "stderr": ""
      }
    },
    {
      "id": "bash_history_keeps_the_syntax_error_line",
      "seq": 310058,
      "targets": ["ram-history"],
      "command": "grep -c '^if then$' /.bash_history",
      "expect": {
        "exit": 0,
        "stdout": "1\n",
        "stderr": ""
      }
    }
  ]
}
