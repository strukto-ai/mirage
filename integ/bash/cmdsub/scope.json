        "dropbox",
        "dropbox-root",
        "onedrive",
        "sharepoint",
        "sharepoint-prefix",
        "ssh",
        "nextcloud",
        "gdrive",
        "gdrive-folder",
        "box"
      ],
      "command": "bash -c 'X=parent; f() { echo parent; }; echo \"$(X=child; f() { echo child; }; set -- inner; f)\"; echo \"$X\"; f; echo \"$#\"'",
      "expect": {
        "exit": 0,
        "stdout": "child\nparent\nparent\n0\n",
        "stderr": ""
