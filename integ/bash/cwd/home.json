    {
      "id": "cwd_home_is_the_session_users",
      "seq": 499500,
      "note": "A session starts with its user's home in HOME, set but not exported as PATH is, so a program on a machine keeps the home its machine gives it; a nested bash gets it exported, as a login hands it.",
      "targets": [
        "ram",
        "disk",
        "redis",
        "opfs",
        "s3",
        "databricks",
        "gridfs",
        "s3-prefix",
        "databricks-prefix",
