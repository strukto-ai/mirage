        "dropbox",
        "dropbox-root",
        "onedrive",
        "sharepoint",
        "sharepoint-prefix",
        "ssh",
        "nextcloud",
        "tidb-filesystem",
        "gdrive",
        "gdrive-folder",
        "box"
      ],
      "command": "echo \"$HOME\"; printenv HOME || echo not exported; bash -c 'echo \"$HOME\"'",
      "expect": {
        "exit": 0,
        "stdout": "/root\nnot exported\n/root\n",
