        "stderr": "timed\n"
      }
    },
    {
      "id": "time_redirect_scope",
      "seq": 511009,
      "targets": [
        "ram",
        "opfs",
        "disk"
      ],
      "command": "TIMEFORMAT=timed; { time echo hi > {mount}/time-redirect-out; } 2> {mount}/time-redirect-timing; cat {mount}/time-redirect-out {mount}/time-redirect-timing; rm {mount}/time-redirect-out {mount}/time-redirect-timing",
      "expect": {
        "exit": 0,
        "stdout": "hi\ntimed\n",
