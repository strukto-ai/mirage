{
  "cases": [
    {
      "id": "time_pipeline_status",
      "seq": 511000,
      "targets": [
        "ram",
        "opfs",
        "disk"
      ],
      "command": "TIMEFORMAT=timed; time false | true; echo \"$? ${PIPESTATUS[*]}\"",
      "expect": {
        "exit": 0,
        "stdout": "0 1 0\n",
        "stderr": "timed\n"
      }
    },
    {
      "id": "time_group_state",
      "seq": 511001,
      "targets": [
        "ram",
        "opfs",
        "disk"
      ],
      "command": "TIMEFORMAT=timed; time { x=kept; echo hi; }; echo $x",
      "expect": {
        "exit": 0,
        "stdout": "hi\nkept\n",
        "stderr": "timed\n"
      }
    },
    {
      "id": "time_false_status",
      "seq": 511002,
      "targets": [
        "ram",
        "opfs",
        "disk"
      ],
      "command": "TIMEFORMAT=timed; time false",
      "expect": {
        "exit": 1,
        "stdout": "",
        "stderr": "timed\n"
      }
    },
    {
      "id": "time_negated_pipeline",
      "seq": 511003,
      "targets": [
        "ram",
        "opfs",
        "disk"
      ],
      "command": "TIMEFORMAT=timed; time ! false | true; echo $?",
      "expect": {
        "exit": 0,
        "stdout": "1\n",
        "stderr": "timed\n"
      }
    },
    {
      "id": "time_function",
      "seq": 511004,
      "targets": [
        "ram",
        "opfs",
        "disk"
      ],
      "command": "TIMEFORMAT=timed; f() { echo hi; }; time f",
      "expect": {
        "exit": 0,
        "stdout": "hi\n",
        "stderr": "timed\n"
      }
    },
    {
