        "disk"
      ],
      "command": "TIMEFORMAT=timed; echo \"$(time echo hi)\"",
      "expect": {
        "exit": 0,
        "stdout": "hi\n",
        "stderr": "timed\n"
      }
    },
    {
      "id": "time_nested",
      "seq": 511006,
      "targets": [
        "ram",
        "opfs",
        "disk"
      ],
      "command": "TIMEFORMAT=timed; time time echo hi",
      "expect": {
        "exit": 0,
        "stdout": "hi\n",
        "stderr": "timed\n"
      }
    },
    {
      "id": "time_empty_format",
      "seq": 511007,
      "targets": [
        "ram",
        "opfs",
        "disk"
      ],
