    {
      "id": "rg_o_directory_empty_match_still_exits_0",
      "cmd": "mkdir -p /data/rgo5; printf 'ab\\n' > /data/rgo5/z.txt; rg -o '[0-9]*' /data/rgo5",
      "matrix": {
        "python": ["ram", "disk", "redis"],
