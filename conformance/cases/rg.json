    {
      "id": "rg_b_offset_is_the_line_start",
      "cmd": "printf 'abc\\ndefabc\\nabc abc\\n' > /data/rgb.txt; rg -b abc /data/rgb.txt",
      "matrix": {
        "python": ["ram", "disk", "redis"],
        "typescript": ["ram", "disk", "redis"]
      },
      "expect": {
        "exit": 0,
        "stdout_text": "0:abc\n4:defabc\n11:abc abc\n",
        "stderr_text": ""
      }
    },
    {
      "id": "rg_ob_offset_is_the_match",
      "cmd": "printf 'abc\\ndefabc\\nabc abc\\n' > /data/rgb.txt; rg -ob abc /data/rgb.txt",
      "matrix": {
        "python": ["ram", "disk", "redis"],
        "typescript": ["ram", "disk", "redis"]
      },
      "expect": {
        "exit": 0,
        "stdout_text": "0:abc\n7:abc\n11:abc\n15:abc\n",
        "stderr_text": ""
      }
    },
    {
      "id": "rg_bn_field_order_is_line_then_byte",
      "cmd": "printf 'abc\\ndefabc\\nabc abc\\n' > /data/rgb.txt; rg -bn abc /data/rgb.txt",
      "matrix": {
        "python": ["ram", "disk", "redis"],
        "typescript": ["ram", "disk", "redis"]
      },
      "expect": {
        "exit": 0,
        "stdout_text": "1:0:abc\n2:4:defabc\n3:11:abc abc\n",
        "stderr_text": ""
      }
    },
    {
      "id": "rg_ob_empty_matches_dropped_around_a_real_one",
      "cmd": "rg -ob '[0-9]*'",
      "matrix": {
        "python": ["ram", "disk", "redis"],
        "typescript": ["ram", "disk", "redis"]
      },
      "stdin_text": "a1b\n",
