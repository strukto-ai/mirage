    {
      "id": "rg_m_is_per_file_in_a_walk",
      "cmd": "mkdir -p /data/cmw && printf 'a1\\na2\\n' > /data/cmw/x.txt && printf 'a3\\na4\\n' > /data/cmw/y.txt && rg -m1 a /data/cmw",
      "matrix": {
        "python": ["ram", "disk", "redis"],
        "typescript": ["ram", "disk", "redis"]
      },
      "expect": {
        "exit": 0,
        "stdout_text": "/data/cmw/x.txt:a1\n/data/cmw/y.txt:a3\n",
        "stderr_text": ""
