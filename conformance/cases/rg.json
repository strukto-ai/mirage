      "cmd": "printf 'a\\r\\nb\\r\\n' > /data/rccrlf.txt; rg -c -v zqxjv /data/rccrlf.txt",
      "matrix": {
        "python": ["ram", "disk", "redis"],
        "typescript": ["ram", "disk", "redis"]
