        "stderr_text": "rg: /data/nosuch.txt: No such file or directory\n"
      }
    },
    {
      "id": "rg_context_missing_among_files_exits_2",
      "cmd": "rg -A1 hello /data/a.txt /data/nosuch.txt",
      "matrix": {
        "python": ["ram", "disk", "redis"],
        "typescript": ["ram", "disk", "redis"]
      },
      "expect": {
