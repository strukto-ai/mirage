{
  "command": "rg",
  "cases": [
    {
      "id": "rg_o_every_match_on_the_line",
      "cmd": "rg -o '[0-9]'",
      "matrix": {
        "python": ["ram", "disk", "redis"],
        "typescript": ["ram", "disk", "redis"]
      },
      "stdin_text": "a1b2c\n",
      "expect": {
        "exit": 0,
        "stdout_text": "1\n2\n",
        "stderr_text": ""
      }
    },
    {
      "id": "rg_o_non_empty_matches_across_lines",
      "cmd": "printf 'error: disk full\\nwarning: low memory\\ninfo: all good\\nerror: timeout\\nnote: done\\n' > /data/rglog.txt; rg -o 'err[a-z]*' /data/rglog.txt",
      "matrix": {
        "python": ["ram", "disk", "redis"],
        "typescript": ["ram", "disk", "redis"]
      },
      "expect": {
        "exit": 0,
        "stdout_text": "error\nerror\n",
        "stderr_text": ""
      }
    },
    {
      "id": "rg_o_empty_match_prints_nothing",
      "cmd": "rg -o '[0-9]*'",
      "matrix": {
        "python": ["ram", "disk", "redis"],
        "typescript": ["ram", "disk", "redis"]
      },
      "stdin_text": "ab\n",
      "expect": {
        "exit": 0,
        "stdout_text": "",
        "stderr_text": ""
      }
    },
    {
