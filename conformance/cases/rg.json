      "id": "rg_b_counts_bytes_not_characters",
      "cmd": "printf 'caf\\303\\251 abc\\nx\\303\\251y abc\\n' > /data/rc5.txt; rg -b abc /data/rc5.txt",
      "matrix": {
        "python": ["ram", "disk", "redis"],
        "typescript": ["ram", "disk", "redis"]
      },
      "expect": {
        "exit": 0,
        "stdout_text": "0:caf\u00e9 abc\n10:x\u00e9y abc\n",
