      "id": "rg_b_after_context_counts_an_invalid_byte_as_one",
      "cmd": "printf 'one\\n\\377\\ntwo abc\\nthree\\n' > /data/rccx.bin; rg -b -A1 abc /data/rccx.bin",
      "matrix": {
        "python": ["ram", "disk", "redis"],
        "typescript": ["ram", "disk", "redis"]
