      "id": "rg_bo_counts_bytes_not_characters",
      "cmd": "printf 'caf\\303\\251 abc\\nx\\303\\251y abc\\n' > /data/rc5.txt; rg -bo abc /data/rc5.txt",
      "matrix": {
        "python": ["ram", "disk", "redis"],
        "typescript": ["ram", "disk", "redis"]
      },
      "expect": {
        "exit": 0,
        "stdout_text": "6:abc\n15:abc\n",
