    {
      "id": "rg_oc_still_counts_the_selected_line",
      "cmd": "rg -oc '[0-9]*'",
      "matrix": {
        "python": ["ram", "disk", "redis"],
        "typescript": ["ram", "disk", "redis"]
      },
      "stdin_text": "ab\n",
      "expect": {
        "exit": 0,
