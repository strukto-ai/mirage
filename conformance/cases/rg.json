      }
    },
    {
      "id": "rg_b_counts_an_invalid_byte_as_one",
      "cmd": "printf '\\377\\na\\n' > /data/rcinv.bin; rg -b a /data/rcinv.bin",
      "matrix": {
        "python": ["ram", "disk", "redis"],
        "typescript": ["ram", "disk", "redis"]
      },
      "expect": {
        "exit": 0,
        "stdout_text": "2:a\n",
        "stderr_text": ""
      }
    },
    {
      "id": "rg_b_counts_an_invalid_byte_as_one_over_two_operands",
      "cmd": "printf '\\377\\na\\n' > /data/rcinv.bin; printf 'zzz\\n' > /data/rcz.txt; rg -b a /data/rcinv.bin /data/rcz.txt",
      "matrix": {
        "python": ["ram", "disk", "redis"],
        "typescript": ["ram", "disk", "redis"]
      },
      "expect": {
        "exit": 0,
        "stdout_text": "/data/rcinv.bin:2:a\n",
        "stderr_text": ""
      }
    },
    {
      "id": "rg_bo_counts_an_invalid_byte_as_one",
      "cmd": "printf '\\377a\\n' > /data/rcinv2.bin; rg -bo a /data/rcinv2.bin",
      "matrix": {
        "python": ["ram", "disk", "redis"],
