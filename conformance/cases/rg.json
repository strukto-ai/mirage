      "id": "rg_bn_context_gets_every_field_right",
      "cmd": "printf 'one\\n\\377\\ntwo abc\\nthree\\n' > /data/rccx.bin; rg -bn -A1 -B1 abc /data/rccx.bin",
      "matrix": {
        "python": ["ram", "disk", "redis"],
        "typescript": ["ram", "disk", "redis"]
      },
      "expect": {
        "exit": 0,
        "stdout_text": "2-4-\ufffd\n3:6:two abc\n4-14-three\n",
        "stderr_text": ""
