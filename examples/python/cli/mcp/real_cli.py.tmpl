#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["mcp>=2.3,<3"]
# ///
"""__NAME__: a CLI over an MCP server, generated by mcp_to_cli.py.

Each subcommand is one MCP tool. Pass the tool's arguments as one JSON
object; `__NAME__ <command> --help` prints the object's schema.
"""

import asyncio
import json
import logging
import os
import re
import sys
import tempfile

from mcp import Client, StdioServerParameters, stdio_client

NAME = __NAME_LITERAL__
SERVER = __SERVER__
TOOLS = __TOOLS__
COMMANDS = {tool["name"].replace("_", "-"): tool for tool in TOOLS}
OPTIONS = ("options:", [("-h, --help", "Show this help and exit")])


def help_text(usage, description, tables, epilog=""):
    lines = [usage]
    if description:
        lines += ["", description]
    for title, rows in tables:
        width = max(len(label) for label, _ in rows)
        lines += ["", title]
        lines += [f"  {label.ljust(width)}  {text}".rstrip() for label, text in rows]
    if epilog:
        lines += ["", epilog.rstrip("\n")]
    return "\n".join(lines) + "\n"


def summary(tool):
    first, _, rest = tool["description"].strip().partition("\n")
    return first, rest.strip()


def group_help():
    return help_text(
        f"usage: {NAME} [-h] {{{','.join(COMMANDS)}}} ...",
        f"{NAME} MCP server tools",
        [
            ("commands:", [(c, summary(t)[0]) for c, t in COMMANDS.items()]),
            OPTIONS,
        ],
    )


def tool_help(command, tool):
    first, rest = summary(tool)
    schema = json.dumps(tool["inputSchema"], indent=2, ensure_ascii=False)
    return help_text(
        f"usage: {NAME} {command} [-h] [JSON]",
        first,
        [
            ("positional arguments:", [("JSON", "the tool's arguments as one object")]),
            OPTIONS,
        ],
        f"{rest}\n\nJSON arguments (schema):\n{schema}".lstrip(),
    )


def connect(errlog):
    if "url" in SERVER:
        return Client(SERVER["url"])
    command = SERVER["command"]
    params = StdioServerParameters(
        command=command[0],
        args=command[1:],
        env=dict(os.environ),
        cwd=SERVER["cwd"],
    )
    return Client(stdio_client(params, errlog=errlog))


async def call(tool, arguments, errlog):
    async with connect(errlog) as client:
        return await client.call_tool(tool, arguments)


def causes(error):
    if isinstance(error, BaseExceptionGroup):
        for inner in error.exceptions:
            yield from causes(inner)
    else:
        yield f"{type(error).__name__}: {error}"


def compact(value):
    return json.dumps(value, ensure_ascii=False, separators=(",", ":"))


def render(result):
    parts = []
    for block in result.content:
        if block.type == "text":
            parts.append(block.text)
        else:
            parts.append(compact(block.model_dump(
                mode="json", by_alias=True, exclude_none=True
            )))
    if not parts and result.structured_content is not None:
        parts.append(compact(result.structured_content))
    text = "\n".join(parts)
    return text if not text or text.endswith("\n") else text + "\n"


def refuse(message, code):
    sys.stderr.write(f"{message}\n")
    return code


def asks_help(word):
    return word == "-h" or (len(word) > 2 and "--help".startswith(word))


def is_number(word):
    return re.fullmatch(r"-[0-9]+", word) is not None


def group_refusal(word):
    if not word.startswith("--"):
        return f"unknown option: {word[:2]}"
    name, equals, _ = word.partition("=")
    if equals and asks_help(name):
        return "error: option '--help' takes no value"
    return f"unknown option: {name}"


def main(argv):
    if argv[:1] == ["--"]:
        argv = argv[1:]
        if not argv:
            sys.stdout.write(group_help())
            return 1
    elif not argv:
        sys.stdout.write(group_help())
        return 1
    elif asks_help(argv[0]):
        sys.stdout.write(group_help())
        return 0
    elif argv[0].startswith("-") and argv[0] != "-":
        return refuse(f"{group_refusal(argv[0])}\n\n{group_help()}".rstrip(), 129)
    command, rest = argv[0], argv[1:]
    tool = COMMANDS.get(command)
    if tool is None:
        return refuse(
            f"{NAME}: '{command}' is not a {NAME} command. "
            f"See '{NAME} --help'.",
            1,
        )
    prefix = f"{NAME} {command}"
    options = rest[:rest.index("--")] if "--" in rest else rest
    if any(asks_help(word) or re.fullmatch(r"-h+", word) for word in options):
        sys.stdout.write(tool_help(command, tool))
        return 0
    words = []
    for index, word in enumerate(rest):
        if word == "--":
            words += rest[index + 1:]
            break
        if word.startswith("--"):
            name, equals, _ = word.partition("=")
            problem = (
                "option '--help' doesn't allow an argument"
                if equals and asks_help(name)
                else f"unrecognized option '{word}'"
            )
            return refuse(
                f"{prefix}: {problem}\n"
                f"Try '{prefix} --help' for more information.",
                2,
            )
        if word.startswith("-") and len(word) > 1 and not is_number(word):
            bad = [letter for letter in word[1:] if letter != "h"]
            return refuse(
                f"{prefix}: invalid option -- '{bad[0]}'\n"
                f"Try '{prefix} --help' for more information.",
                2,
            )
        words.append(word)
    if len(words) > 1:
        return refuse(f"{prefix}: takes one JSON object", 2)
    try:
        arguments = json.loads(words[0]) if words else {}
    except json.JSONDecodeError as error:
        return refuse(f"{prefix}: invalid JSON: {error}", 2)
    if not isinstance(arguments, dict):
        return refuse(f"{prefix}: JSON must be an object", 2)
    logging.disable(logging.WARNING)
    with tempfile.TemporaryFile("w+") as errlog:
        try:
            result = asyncio.run(call(tool["name"], arguments, errlog))
        except Exception as error:
            errlog.seek(0)
            server_log = "".join(errlog.readlines()[-20:])
            reason = "; ".join(causes(error))
            return refuse(f"{server_log}{NAME}: MCP server failed: {reason}", 1)
    out = render(result)
    if result.is_error:
        sys.stderr.write(out)
        return 1
    sys.stdout.write(out)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
