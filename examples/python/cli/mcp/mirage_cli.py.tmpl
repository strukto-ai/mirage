"""__NAME__: a Mirage virtual CLI over an MCP server, generated by
mcp_to_mirage.py.

Each subcommand is one MCP tool taking the tool's arguments as one JSON
object. Install it with `ws.register_cli("__NAME__", __ATTR__, config)`.
"""

import functools
import json
import tempfile
from typing import Any

from mcp import Client, StdioServerParameters, stdio_client
from pydantic import BaseModel, ConfigDict, SecretStr

from mirage import CLI, Argument, CLIHandler, CommandSpec, Context, PathSpec
from mirage.accessor import NOOPAccessor
from mirage.io import IOResult

NAME = __NAME_LITERAL__
SERVER = __SERVER__
TOOLS = __TOOLS__


class ServerConfig(BaseModel):
    """Where the MCP server is, and the environment a stdio server gets."""

    model_config = ConfigDict(extra="forbid")

    command: list[str] | None = SERVER.get("command")
    cwd: str | None = SERVER.get("cwd")
    url: str | None = SERVER.get("url")
    env: dict[str, SecretStr] = {}


def connect(config: ServerConfig, errlog: Any) -> Client:
    if config.url:
        return Client(config.url)
    params = StdioServerParameters(
        command=config.command[0],
        args=config.command[1:],
        env={key: value.get_secret_value() for key, value in config.env.items()},
        cwd=config.cwd,
    )
    return Client(stdio_client(params, errlog=errlog))


def causes(error: BaseException):
    if isinstance(error, BaseExceptionGroup):
        for inner in error.exceptions:
            yield from causes(inner)
    else:
        yield f"{type(error).__name__}: {error}"


def compact(value: Any) -> str:
    return json.dumps(value, ensure_ascii=False, separators=(",", ":"))


def render(result: Any) -> str:
    parts = []
    for block in result.content:
        if block.type == "text":
            parts.append(block.text)
        else:
            parts.append(compact(block.model_dump(
                mode="json", by_alias=True, exclude_none=True
            )))
    if not parts and result.structured_content is not None:
        parts.append(compact(result.structured_content))
    text = "\n".join(parts)
    return text if not text or text.endswith("\n") else text + "\n"


def refuse(message: str, code: int) -> tuple[None, IOResult]:
    return None, IOResult(exit_code=code, stderr=f"{message}\n".encode())


async def call_tool(
    tool: str,
    accessor: NOOPAccessor,
    paths: list[PathSpec],
    texts: list[str],
    ctx: Context,
) -> tuple[bytes | None, IOResult]:
    prefix = f"{NAME} {tool.replace('_', '-')}"
    if len(texts) > 1:
        return refuse(f"{prefix}: takes one JSON object", 2)
    try:
        arguments = json.loads(texts[0]) if texts else {}
    except json.JSONDecodeError as error:
        return refuse(f"{prefix}: invalid JSON: {error}", 2)
    if not isinstance(arguments, dict):
        return refuse(f"{prefix}: JSON must be an object", 2)
    # shortcut: one server connection per call; keep one per install
    # when a server is slow to start.
    with tempfile.TemporaryFile("w+") as errlog:
        try:
            async with connect(accessor.config, errlog) as client:
                result = await client.call_tool(tool, arguments)
        except Exception as error:
            errlog.seek(0)
            server_log = "".join(errlog.readlines()[-20:])
            reason = "; ".join(causes(error))
            return refuse(f"{server_log}{NAME}: MCP server failed: {reason}", 1)
    out = render(result).encode()
    if result.is_error:
        return None, IOResult(exit_code=1, stderr=out)
    return out, IOResult()


def leaf(tool: dict[str, Any]) -> CommandSpec:
    first, _, rest = tool["description"].strip().partition("\n")
    schema = json.dumps(tool["inputSchema"], indent=2, ensure_ascii=False)
    return CommandSpec(
        name=tool["name"].replace("_", "-"),
        description=first,
        epilog=f"{rest.strip()}\n\nJSON arguments (schema):\n{schema}".lstrip(),
        arguments=(
            Argument(
                "JSON", nargs="?", help="the tool's arguments as one object"
            ),
        ),
    )


__ATTR__ = CLI(
    spec=CommandSpec(
        name=NAME,
        description=f"{NAME} MCP server tools",
        subcommands=tuple(leaf(tool) for tool in TOOLS),
    ),
    handlers={
        tool["name"].replace("_", "-"): CLIHandler(
            fn=functools.partial(call_tool, tool["name"]),
            write=not tool["annotations"].get("readOnlyHint", False),
        )
        for tool in TOOLS
    },
    config_model=ServerConfig,
)
