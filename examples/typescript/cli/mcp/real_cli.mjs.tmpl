#!/usr/bin/env node
// __NAME__: a CLI over an MCP server, generated by mcp_to_cli.ts.
//
// Each subcommand is one MCP tool. Pass the tool's arguments as one JSON
// object; `__NAME__ <command> --help` prints the object's schema. It needs
// @modelcontextprotocol/client installed where it runs.

import { Client, StreamableHTTPClientTransport } from '@modelcontextprotocol/client'
import { StdioClientTransport } from '@modelcontextprotocol/client/stdio'

const NAME = __NAME_LITERAL__
const SERVER = __SERVER__
const TOOLS = __TOOLS__
const COMMANDS = new Map(TOOLS.map((tool) => [tool.name.replaceAll('_', '-'), tool]))
const OPTIONS = ['options:', [['-h, --help', 'Show this help and exit']]]

function helpText(usage, description, tables, epilog = '') {
  const lines = [usage]
  if (description) lines.push('', description)
  for (const [title, rows] of tables) {
    const width = Math.max(...rows.map(([label]) => label.length))
    lines.push('', title)
    for (const [label, text] of rows) lines.push(`  ${label.padEnd(width)}  ${text}`.trimEnd())
  }
  if (epilog) lines.push('', epilog.replace(/\n+$/, ''))
  return `${lines.join('\n')}\n`
}

function summary(tool) {
  const text = tool.description.trim()
  const end = text.indexOf('\n')
  return end < 0 ? [text, ''] : [text.slice(0, end), text.slice(end + 1).trim()]
}

function groupHelp() {
  const rows = [...COMMANDS].map(([command, tool]) => [command, summary(tool)[0]])
  return helpText(
    `usage: ${NAME} [-h] {${[...COMMANDS.keys()].join(',')}} ...`,
    `${NAME} MCP server tools`,
    [['commands:', rows], OPTIONS],
  )
}

function toolHelp(command, tool) {
  const [first, rest] = summary(tool)
  const schema = JSON.stringify(tool.inputSchema, null, 2)
  return helpText(
    `usage: ${NAME} ${command} [-h] [JSON]`,
    first,
    [['positional arguments:', [['JSON', "the tool's arguments as one object"]]], OPTIONS],
    `${rest}\n\nJSON arguments (schema):\n${schema}`.trimStart(),
  )
}

function transport(log) {
  if (SERVER.url) return new StreamableHTTPClientTransport(new URL(SERVER.url))
  const [command, ...args] = SERVER.command
  const env = Object.fromEntries(Object.entries(process.env).filter(([, value]) => value !== undefined))
  const stdio = new StdioClientTransport({ command, args, env, cwd: SERVER.cwd ?? undefined, stderr: 'pipe' })
  stdio.stderr?.on('data', (chunk) => keepTail(log, String(chunk)))
  return stdio
}

// Keep the last 20 lines of a server's stderr, all a failure prints.
function keepTail(log, chunk) {
  log.splice(0, log.length, ...`${log.join('')}${chunk}`.split(/(?<=\n)/).slice(-20))
}

async function call(tool, args, log) {
  const client = new Client({ name: NAME, version: '1.0.0' })
  try {
    await client.connect(transport(log))
    return await client.callTool({ name: tool, arguments: args })
  } finally {
    await client.close()
  }
}

function causes(error) {
  if (error instanceof AggregateError) return error.errors.flatMap(causes)
  if (!(error instanceof Error)) return [String(error)]
  const line = `${error.name}: ${error.message}`
  return error.cause === undefined ? [line] : [line, ...causes(error.cause)]
}

function tail(log) {
  return log.join('').split(/(?<=\n)/).slice(-20).join('')
}

function render(result) {
  const parts = result.content.map((block) => (block.type === 'text' ? block.text : JSON.stringify(block)))
  if (parts.length === 0 && result.structuredContent !== undefined) parts.push(JSON.stringify(result.structuredContent))
  const text = parts.join('\n')
  return text === '' || text.endsWith('\n') ? text : `${text}\n`
}

function refuse(message, code) {
  process.stderr.write(`${message}\n`)
  return code
}

function asksHelp(word) {
  return word === '-h' || (word.length > 2 && '--help'.startsWith(word))
}

function isNumber(word) {
  return /^-[0-9]+$/.test(word)
}

function groupRefusal(word) {
  if (!word.startsWith('--')) return `unknown option: ${word.slice(0, 2)}`
  const [name] = word.split('=', 1)
  if (word.includes('=') && asksHelp(name)) return "error: option '--help' takes no value"
  return `unknown option: ${name}`
}

async function main(argv) {
  if (argv[0] === '--') {
    argv = argv.slice(1)
    if (argv.length === 0) {
      process.stdout.write(groupHelp())
      return 1
    }
  } else if (argv.length === 0) {
    process.stdout.write(groupHelp())
    return 1
  } else if (asksHelp(argv[0])) {
    process.stdout.write(groupHelp())
    return 0
  } else if (argv[0].startsWith('-') && argv[0] !== '-') {
    return refuse(`${groupRefusal(argv[0])}\n\n${groupHelp()}`.trimEnd(), 129)
  }
  const [command, ...rest] = argv
  const tool = COMMANDS.get(command)
  if (tool === undefined) {
    return refuse(`${NAME}: '${command}' is not a ${NAME} command. See '${NAME} --help'.`, 1)
  }
  const prefix = `${NAME} ${command}`
  const options = rest.includes('--') ? rest.slice(0, rest.indexOf('--')) : rest
  if (options.some((word) => asksHelp(word) || /^-h+$/.test(word))) {
    process.stdout.write(toolHelp(command, tool))
    return 0
  }
  const words = []
  for (const [index, word] of rest.entries()) {
    if (word === '--') {
      words.push(...rest.slice(index + 1))
      break
    }
    if (word.startsWith('--')) {
      const [name] = word.split('=', 1)
      const problem =
        word.includes('=') && asksHelp(name)
          ? "option '--help' doesn't allow an argument"
          : `unrecognized option '${word}'`
      return refuse(`${prefix}: ${problem}\nTry '${prefix} --help' for more information.`, 2)
    }
    if (word.startsWith('-') && word.length > 1 && !isNumber(word)) {
      const bad = [...word.slice(1)].filter((letter) => letter !== 'h')
      return refuse(`${prefix}: invalid option -- '${bad[0]}'\nTry '${prefix} --help' for more information.`, 2)
    }
    words.push(word)
  }
  if (words.length > 1) return refuse(`${prefix}: takes one JSON object`, 2)
  let args = {}
  if (words.length === 1) {
    try {
      args = JSON.parse(words[0])
    } catch (error) {
      return refuse(`${prefix}: invalid JSON: ${error.message}`, 2)
    }
  }
  if (typeof args !== 'object' || args === null || Array.isArray(args)) {
    return refuse(`${prefix}: JSON must be an object`, 2)
  }
  const log = []
  let result
  try {
    result = await call(tool.name, args, log)
  } catch (error) {
    return refuse(`${tail(log)}${NAME}: MCP server failed: ${causes(error).join('; ')}`, 1)
  }
  const out = render(result)
  if (result.isError) {
    process.stderr.write(out)
    return 1
  }
  process.stdout.write(out)
  return 0
}

process.exitCode = await main(process.argv.slice(2))
