// __NAME__: a Mirage virtual CLI over an MCP server, generated by mcp_to_mirage.ts.
//
// Each subcommand is one MCP tool taking the tool's arguments as one JSON
// object. Install it with `ws.registerCli('__NAME__', __ATTR__, config)`.

import { Client, StreamableHTTPClientTransport, type Transport } from '@modelcontextprotocol/client'
import { StdioClientTransport } from '@modelcontextprotocol/client/stdio'
import {
  type Accessor,
  Argument,
  CLI,
  CLIHandler,
  type CommandFnResult,
  CommandSpec,
  IOResult,
  secretStr,
  z,
} from '@struktoai/mirage-node'

interface Tool {
  name: string
  description: string
  inputSchema: unknown
  annotations: Record<string, unknown>
}

interface Block {
  type: string
  text?: string
}

const NAME = __NAME_LITERAL__
const SERVER: { command?: string[]; cwd?: string | null; url?: string } = __SERVER__
const TOOLS: Tool[] = __TOOLS__

const ServerConfig = z
  .object({
    command: z.array(z.string()).nullable().default(SERVER.command ?? null),
    cwd: z.string().nullable().default(SERVER.cwd ?? null),
    url: z.string().nullable().default(SERVER.url ?? null),
    env: z.record(z.string(), secretStr()).default({}),
  })
  .strict()
type ServerConfig = z.infer<typeof ServerConfig>

const enc = new TextEncoder()

function transport(config: ServerConfig, log: string[]): Transport {
  if (config.url !== null) return new StreamableHTTPClientTransport(new URL(config.url))
  const [command = '', ...args] = config.command ?? []
  const stdio = new StdioClientTransport({
    command,
    args,
    env: config.env,
    cwd: config.cwd ?? undefined,
    stderr: 'pipe',
  })
  stdio.stderr?.on('data', (chunk: Buffer) => log.push(String(chunk)))
  return stdio
}

function causes(error: unknown): string[] {
  if (error instanceof AggregateError) return error.errors.flatMap(causes)
  if (!(error instanceof Error)) return [String(error)]
  const line = `${error.name}: ${error.message}`
  return error.cause === undefined ? [line] : [line, ...causes(error.cause)]
}

function tail(log: string[]): string {
  return log.join('').split(/(?<=\n)/).slice(-20).join('')
}

function render(result: { content?: Block[]; structuredContent?: unknown }): string {
  const parts = (result.content ?? []).map((block) =>
    block.type === 'text' ? (block.text ?? '') : JSON.stringify(block),
  )
  if (parts.length === 0 && result.structuredContent !== undefined) {
    parts.push(JSON.stringify(result.structuredContent))
  }
  const text = parts.join('\n')
  return text === '' || text.endsWith('\n') ? text : `${text}\n`
}

function refuse(message: string, exitCode: number): CommandFnResult {
  return [null, new IOResult({ exitCode, stderr: enc.encode(`${message}\n`) })]
}

async function callTool(tool: string, accessor: Accessor, texts: string[]): Promise<CommandFnResult> {
  const prefix = `${NAME} ${tool.replaceAll('_', '-')}`
  if (texts.length > 1) return refuse(`${prefix}: takes one JSON object`, 2)
  let args: unknown = {}
  if (texts[0] !== undefined) {
    try {
      args = JSON.parse(texts[0])
    } catch (error) {
      return refuse(`${prefix}: invalid JSON: ${(error as Error).message}`, 2)
    }
  }
  if (typeof args !== 'object' || args === null || Array.isArray(args)) {
    return refuse(`${prefix}: JSON must be an object`, 2)
  }
  const config = (accessor as unknown as { config: ServerConfig }).config
  const log: string[] = []
  // shortcut: one server connection per call; keep one per install when a
  // server is slow to start.
  const client = new Client({ name: NAME, version: '1.0.0' })
  let result
  let failure: unknown[] = []
  try {
    await client.connect(transport(config, log))
    result = await client.callTool({ name: tool, arguments: args as Record<string, unknown> })
  } catch (error) {
    failure = [error]
  } finally {
    await client.close()
  }
  if (result === undefined) {
    return refuse(`${tail(log)}${NAME}: MCP server failed: ${failure.flatMap(causes).join('; ')}`, 1)
  }
  const out = enc.encode(render(result as { content?: Block[]; structuredContent?: unknown }))
  if (result.isError === true) return [null, new IOResult({ exitCode: 1, stderr: out })]
  return [out, new IOResult()]
}

function leaf(tool: Tool): CommandSpec {
  const text = tool.description.trim()
  const end = text.indexOf('\n')
  const [first, rest] = end < 0 ? [text, ''] : [text.slice(0, end), text.slice(end + 1).trim()]
  const schema = JSON.stringify(tool.inputSchema, null, 2)
  return new CommandSpec({
    name: tool.name.replaceAll('_', '-'),
    description: first,
    epilog: `${rest}\n\nJSON arguments (schema):\n${schema}`.trimStart(),
    arguments: [new Argument('JSON', { nargs: '?', help: "the tool's arguments as one object" })],
  })
}

const cli = new CLI({
  spec: new CommandSpec({
    name: NAME,
    description: `${NAME} MCP server tools`,
    subcommands: TOOLS.map(leaf),
  }),
  handlers: Object.fromEntries(
    TOOLS.map((tool) => [
      tool.name.replaceAll('_', '-'),
      new CLIHandler({
        fn: (accessor, _paths, texts) => callTool(tool.name, accessor, texts),
        write: tool.annotations.readOnlyHint !== true,
      }),
    ]),
  ),
  configModel: ServerConfig,
})

// An export alias binds no local name, so any --name is safe here.
export { cli as __ATTR__ }
