from collections.abc import Callable, Mapping, Sequence
from typing import Any, TypeAlias

class StreamError(Exception): ...

class Stream:
    def __init__(self, kind: str, config: bytes) -> None: ...
    def feed(self, data: bytes) -> bytes: ...
    def finish(self) -> bytes: ...
    def wants(self) -> int | None: ...
    def feed_input(self, index: int, data: bytes) -> bytes: ...
    def end_input(self, index: int) -> bytes: ...
    def busy(self) -> bool: ...
    def cancel(self) -> bool: ...
    def drain(self) -> bytes: ...
    def begin(self, config: bytes) -> None: ...
    def test(self, data: bytes) -> bool: ...
    def done(self) -> bool: ...
    def status(self) -> int: ...
    def metadata(self) -> bytes: ...
    def take_stderr(self) -> bytes: ...
    def request(self) -> tuple[bytes, bytes] | None: ...
    def respond(self, reply: bytes, data: bytes) -> bytes: ...

class NFSServer:
    def __init__(self, config: bytes) -> None: ...
    def feed(self, conn: int, data: bytes) -> bytes: ...
    def requests(self) -> bytes: ...
    def complete(
        self, id: int, reply: bytes, data: bytes
    ) -> tuple[int | None, bytes]: ...
    def close(self, conn: int) -> None: ...

class ShellTree:
    def __init__(
        self, source: bytes, aliases: list[str] = ..., extglob: bool = ...
    ) -> None: ...
    @property
    def root_node(self) -> ShellNode: ...
    @property
    def error(self) -> tuple[int, int] | None: ...
    @property
    def source(self) -> bytes: ...
    @property
    def heredocs(self) -> list[ShellHeredoc]: ...

class ShellHeredoc:
    @property
    def at(self) -> int: ...
    @property
    def operator_start(self) -> int: ...
    @property
    def word_end(self) -> int: ...
    @property
    def word(self) -> bytes: ...
    @property
    def delimiter(self) -> bytes: ...
    @property
    def quoted(self) -> bool: ...
    @property
    def dash(self) -> bool: ...
    @property
    def body_start(self) -> int: ...
    @property
    def end(self) -> int: ...
    @property
    def body(self) -> bytes: ...
    @property
    def terminated(self) -> bool: ...

class ShellNode:
    @property
    def type(self) -> str: ...
    @property
    def text(self) -> bytes: ...
    @property
    def id(self) -> int: ...
    @property
    def start_byte(self) -> int: ...
    @property
    def end_byte(self) -> int: ...
    @property
    def start_point(self) -> tuple[int, int]: ...
    @property
    def end_point(self) -> tuple[int, int]: ...
    @property
    def children(self) -> list[ShellNode]: ...
    @property
    def named_children(self) -> list[ShellNode]: ...
    @property
    def child_count(self) -> int: ...
    def child(self, index: int) -> ShellNode | None: ...
    @property
    def parent(self) -> ShellNode | None: ...
    @property
    def next_sibling(self) -> ShellNode | None: ...
    @property
    def prev_sibling(self) -> ShellNode | None: ...
    @property
    def is_named(self) -> bool: ...
    @property
    def heredoc(self) -> ShellHeredoc | None: ...
    @property
    def source_text(self) -> bytes: ...
    @property
    def inlined(self) -> bytes: ...
    @property
    def offsets(self) -> list[int]: ...
    def warnings(self, head: bytes, first: int) -> bytes: ...
    @property
    def error(self) -> tuple[int, int] | None: ...
    def refusal(self, head: bytes, first: int, utf8: bool) -> bytes | None: ...
    def child_by_field_name(self, name: str) -> ShellNode | None: ...
    def field_name_for_child(self, index: int) -> str | None: ...

Text: TypeAlias = str | bytes
RawValue: TypeAlias = str | dict[int, str] | dict[str, str] | None
Managed: TypeAlias = tuple[str, str, str, bool]
Record: TypeAlias = tuple[RawValue, str, Managed | None]
Ask: TypeAlias = tuple[Any, ...]

class ShellTask:
    def step(self) -> Ask | None: ...
    def answer_substituted(
        self, stdout: bytes, stderr: bytes, status: int
    ) -> None: ...
    def answer_path(self, path: Text) -> None: ...
    def answer_gate(self, denied: tuple[str, int] | None) -> None: ...
    def answer_resumed(self) -> None: ...
    def answer_failed(self) -> None: ...
    def finish(self) -> tuple[tuple[Any, ...], list[str | bytes]]: ...
    def more(self) -> bool: ...
    def slice(self) -> list[str]: ...

class Shell:
    def __init__(self, ids_source: Callable[[], int]) -> None: ...
    def use_ids(self, ids_source: Callable[[], int]) -> None: ...
    def get(self, name: str) -> Record | None: ...
    def visible(self, name: str) -> Record | None: ...
    def place(self, name: str, record: Record | None) -> Record | None: ...
    def visible_names(self, kind: str) -> list[str]: ...
    def same_vars(self, other: Shell) -> bool: ...
    def indexed(self, name: str) -> dict[int, str] | None: ...
    def rendered(self, name: str) -> str | None: ...
    def names(self) -> list[str]: ...
    def records(self) -> list[tuple[str, Record]]: ...
    def __len__(self) -> int: ...
    def __contains__(self, name: str) -> bool: ...
    def held(self) -> int: ...
    def hide(self, names: Sequence[str], patterns: Sequence[str]) -> None: ...
    def hidden(self, name: str) -> bool: ...
    def nameref_target(self, name: str) -> str | None: ...
    def deref(self, name: str) -> str: ...
    def target(self, name: str) -> str: ...
    def is_readonly(self, name: str, follow_ref: bool) -> bool: ...
    def frozen(self, name: str) -> str | None: ...
    def exported(self) -> list[tuple[str, str]]: ...
    def seed(
        self, name: str, value: RawValue, assoc: bool = False
    ) -> None: ...
    def set_attr(self, name: str, letter: str | None, on: bool) -> None: ...
    def enter(self) -> int | None: ...
    def leave(self, outer: int | None) -> None: ...
    def in_function(self) -> bool: ...
    def is_local(self, name: str) -> bool: ...
    def shadow(self, name: str, inherit: bool) -> None: ...
    def open_temp(self) -> int: ...
    def save_temp(self, index: int, name: str) -> None: ...
    def close_temp(self, index: int) -> None: ...
    def outlive_call(self, name: str) -> None: ...
    def in_call_env(self, name: str) -> bool: ...
    def reach_global(self, names: Sequence[str]) -> None: ...
    def unreach(self) -> None: ...
    def step_back(self) -> None: ...
    def step_forward(self) -> None: ...
    def next_random(self) -> int | None | tuple[Any, ...]: ...
    def frame(
        self,
        *,
        positional: Sequence[Text],
        calls: Sequence[Sequence[Text]],
        status: int,
        pid: int,
        last_job: int | None,
        argv0: Text,
        options: Mapping[str, bool],
        shopts: Mapping[str, bool],
        env_limit: int | None,
        outside: int,
        pipe_status: Sequence[int],
        function_names: Sequence[Text] | None,
        paren: bool,
        memory_room: int | None,
        line: int,
        bash_pid: int,
        voice: str,
    ) -> None: ...
    def conversion_scalar(
        self, name: str
    ) -> str | None | tuple[str, tuple[Any, ...]]: ...
    @property
    def status(self) -> int: ...
    def take_substituted(self) -> int | None: ...
    def fork(self) -> Shell: ...
    def subshell(self) -> Shell: ...
    def expand(
        self, node: ShellNode, mode: str, listens: bool
    ) -> ShellTask: ...
    def set(
        self,
        name: str,
        value: RawValue,
        *,
        assoc: bool = False,
        follow_ref: bool = True,
        assigned: Sequence[int | str] | None = None,
        added: Text | None = None,
        listens: bool = False,
        warns: bool = True,
    ) -> ShellTask: ...
    def unset(
        self, name: str, *, follow_ref: bool = True, listens: bool = False
    ) -> ShellTask: ...
    def mark(
        self,
        name: str,
        letter: str | None,
        on: bool,
        *,
        follow_ref: bool = True,
        listens: bool = False,
    ) -> ShellTask: ...
    def index(
        self, subscript: Text, *, listens: bool = False
    ) -> ShellTask: ...
    def is_set(
        self, reference: Text, *, listens: bool = False
    ) -> ShellTask: ...
    def element(
        self,
        name: str,
        subscript: Text | None,
        value: Text,
        *,
        append: bool = False,
        listens: bool = False,
        warns: bool = True,
    ) -> ShellTask: ...
    def arith(self, text: Text, *, listens: bool = False) -> ShellTask: ...
    def integer(
        self, text: Text, added: Text | None = None, *, listens: bool = False
    ) -> ShellTask: ...
