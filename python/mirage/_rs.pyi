from collections.abc import Sequence
from typing import TypeAlias

PolicyText: TypeAlias = Sequence[int]
PolicyRule: TypeAlias = tuple[
    PolicyText, Sequence[PolicyText], Sequence[PolicyText], PolicyText | None
]
PolicyRules: TypeAlias = tuple[
    Sequence[PolicyText] | None, Sequence[PolicyRule], Sequence[PolicyRule]
]
PolicyScope: TypeAlias = tuple[Sequence[PolicyText], Sequence[PolicyText]]
PolicyShow: TypeAlias = tuple[PolicyText, int | None]
PolicyReason: TypeAlias = tuple[Sequence[PolicyText], PolicyText]
PolicyVisibilityValue: TypeAlias = tuple[
    PolicyScope, Sequence[PolicyShow], PolicyScope
]
PolicyPaths: TypeAlias = tuple[
    Sequence[PolicyText], Sequence[PolicyShow], Sequence[PolicyReason]
]
PolicyMount: TypeAlias = tuple[
    PolicyText, int | None, PolicyRules | None, PolicyPaths | None
]
PolicyProfile: TypeAlias = tuple[
    PolicyRules | None,
    PolicyPaths | None,
    Sequence[PolicyText] | None,
    Sequence[PolicyMount] | None,
]
PolicyPlan: TypeAlias = tuple[
    PolicyRules | None,
    PolicyVisibilityValue,
    Sequence[tuple[PolicyText, int]],
    Sequence[PolicyReason],
]
PolicyPath: TypeAlias = tuple[PolicyText, PolicyText]
PolicyFacts: TypeAlias = tuple[
    PolicyText,
    Sequence[PolicyText],
    bool,
    PolicyText,
    Sequence[PolicyPath],
    Sequence[PolicyPath],
    bool,
    PolicyText | None,
]
PolicySubject: TypeAlias = tuple[PolicyPath | None, bool, bool]
PolicyLinkStep: TypeAlias = tuple[int, PolicyText, bool]
PolicyRuling: TypeAlias = tuple[
    int, int | None, PolicyText | None, bool, Sequence[int]
]

class PolicyAdmission:
    def __init__(self, value: PolicyRules, ecma: bool) -> None: ...
    def head_allowed(self, name: PolicyText) -> bool: ...
    def line_allowed(
        self, tokens: Sequence[PolicyText], tool: bool
    ) -> bool: ...
    def has_rules(self) -> bool: ...
    def reads_args(self, name: PolicyText) -> bool: ...
    def scopes_paths(self, name: PolicyText) -> bool: ...
    def decide(self, value: PolicyFacts) -> PolicyRuling: ...
    def rule_applies(self, id: int, value: PolicyFacts) -> bool: ...
    def rule_reach(self, id: int, value: PolicySubject) -> int | None: ...
    def hidden_depth(self, id: int, value: PolicyText) -> int: ...
    def covers_depth(
        self, id: int, value: PolicyText, ancestors: bool
    ) -> int: ...
    def match_io(
        self,
        id: int,
        tokens: Sequence[PolicyText],
        value: PolicyText,
        subtree: bool,
    ) -> bool: ...
    def io_reach(
        self, tokens: Sequence[PolicyText], value: PolicyText
    ) -> bool: ...
    def io_refusal(
        self,
        tokens: Sequence[PolicyText],
        value: PolicyText,
        granted: Sequence[int],
    ) -> int | None: ...
    def posix_level(self, id: int) -> bool: ...
    def op_reach(
        self, id: int, op: PolicyText, value: PolicyText
    ) -> int | None: ...
    def op_ruling(
        self, op: PolicyText, value: PolicyText, granted: Sequence[int]
    ) -> tuple[int, bool] | None: ...

class PolicyVisibility:
    def __init__(self, value: PolicyVisibilityValue) -> None: ...
    def hide_depth(self, value: PolicyText) -> int | None: ...
    def show_depth(self, value: PolicyText) -> int | None: ...
    def path_visible(self, value: PolicyText) -> bool: ...
    def shown_mode(self, value: PolicyText) -> tuple[int, int] | None: ...
    def path_covers(self, value: PolicyText, ancestors: bool) -> bool: ...
    def hides_intersect(self, value: PolicyText) -> bool: ...
    def move_reveals(self, src: PolicyText, dst: PolicyText) -> bool: ...
    def link_trace_hidden(self, value: Sequence[PolicyLinkStep]) -> bool: ...
    def visible_links(
        self, value: Sequence[tuple[PolicyText, Sequence[PolicyLinkStep]]]
    ) -> Sequence[bool]: ...
    def var_hidden(self, value: PolicyText) -> bool: ...
    def effective_mode(
        self,
        value: PolicyText,
        prefix: PolicyText,
        configured: int,
        cap: int | None,
    ) -> int: ...
    def strongest_mode(
        self, prefix: PolicyText, configured: int, cap: int | None
    ) -> int: ...
    def readonly_below(
        self,
        value: PolicyText,
        prefix: PolicyText,
        configured: int,
        cap: int | None,
    ) -> PolicyText | None: ...

def policy_compile(value: PolicyProfile) -> PolicyPlan: ...
def policy_restrict(
    base: PolicyProfile | None, inline: PolicyProfile | None
) -> PolicyProfile | None: ...
def policy_pattern(
    value: PolicyText, tokens: Sequence[PolicyText], ecma: bool
) -> tuple[Sequence[PolicyText], bool, bool]: ...
def policy_paths(value: Sequence[PolicyText]) -> PolicyScope: ...
def policy_vars(value: Sequence[PolicyText]) -> PolicyScope: ...
def policy_is_glob(value: PolicyText) -> bool: ...
def policy_anchor_depth(value: PolicyText) -> int: ...
def policy_show_head(value: PolicyText) -> PolicyText: ...
def policy_subjects(value: PolicyFacts) -> Sequence[PolicySubject]: ...

class StreamError(Exception): ...

class Stream:
    def __init__(self, kind: str, config: bytes) -> None: ...
    def feed(self, data: bytes) -> bytes: ...
    def finish(self) -> bytes: ...
    def wants(self) -> int | None: ...
    def feed_input(self, index: int, data: bytes) -> bytes: ...
    def end_input(self, index: int) -> bytes: ...
    def busy(self) -> bool: ...
    def cancel(self) -> bool: ...
    def drain(self) -> bytes: ...
    def begin(self, config: bytes) -> None: ...
    def done(self) -> bool: ...
    def status(self) -> int: ...
    def metadata(self) -> bytes: ...
    def take_stderr(self) -> bytes: ...
    def request(self) -> tuple[bytes, bytes] | None: ...
    def respond(self, reply: bytes, data: bytes) -> bytes: ...

class NFSServer:
    def __init__(self, config: bytes) -> None: ...
    def feed(self, conn: int, data: bytes) -> bytes: ...
    def requests(self) -> bytes: ...
    def complete(
        self, id: int, reply: bytes, data: bytes
    ) -> tuple[int | None, bytes]: ...
    def close(self, conn: int) -> None: ...
